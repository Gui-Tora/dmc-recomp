diff --git a/ps2xRuntime/src/lib/Kernel/sched_host_debt.h b/ps2xRuntime/src/lib/Kernel/sched_host_debt.h
new file mode 100644
index 0000000..6c1e3b6
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/sched_host_debt.h
@@ -0,0 +1,34 @@
+#pragma once
+// Opt-in bound on the wall-clock debt of the VBlank chain.
+// Private to ps2xRuntime (not included by generated code or by public runtime headers).
+//
+// The host (wall-clock) deadline of each VBlankStart is chained as "previous host deadline + period". After a slow
+// phase the chain lags behind the wall clock and the following VBlanks fire back to back until the debt is paid
+// (bursts of up to ~3x real time measured in Devil May Cry, SCHED_PAL_001). With a bound L the next host deadline is
+// based on max(previous host deadline, now - L): at most L of debt is caught up and the rest is dropped.
+// Only host deadlines change; EE-cycle deadlines, the number of VBlanks and their order in guest time are untouched,
+// and nothing is serialized (a checkpoint load already re-derives host deadlines from the remaining cycles).
+//   PS2X_SCHED_MAX_HOST_LAG_MS=L   unset: unbounded (historical behaviour); 0..10000 ms otherwise
+//                                  (50 is the value measured for Devil May Cry)
+
+#include <chrono>
+#include <optional>
+
+namespace ps2x::sched
+{
+    // nullopt = unbounded (historical).
+    std::optional<std::chrono::microseconds> maxHostLag();
+
+    template <typename TimePoint>
+    TimePoint boundHostDebt(TimePoint previousHostDeadline, TimePoint now)
+    {
+        const std::optional<std::chrono::microseconds> lag = maxHostLag();
+        if (!lag)
+            return previousHostDeadline;
+        const TimePoint floor = now - *lag;
+        return previousHostDeadline < floor ? floor : previousHostDeadline;
+    }
+
+    // Test hook: nullopt restores the unbounded behaviour.
+    void setMaxHostLagForTest(std::optional<std::chrono::microseconds> lag);
+}
