     CodeGenerator::~CodeGenerator() = default;
 
+    namespace
+    {
+        // VU0 vf0 is hardwired to (0, 0, 0, 1): a guest write to it has no effect. Every
+        // translated statement that assigns ctx->vu0_vf[0] is followed by restoring the
+        // constant, which is equivalent to discarding the write.
+        std::string discardVu0Vf0Write(std::string code)
+        {
+            if (code.find("ctx->vu0_vf[0] =") != std::string::npos)
+                code += " ctx->vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f); /* vf0 is hardwired */";
+            return code;
+        }
+    }
+
     std::string CodeGenerator::translateInstruction(const Instruction &inst)
     {
-        return InstructionTranslator(*this).translate(inst, {});
+        return discardVu0Vf0Write(InstructionTranslator(*this).translate(inst, {}));
     }
 
