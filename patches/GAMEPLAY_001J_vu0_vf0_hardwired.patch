diff --git a/ps2xRuntime/src/lib/checkpoint/checkpoint_sections.cpp b/ps2xRuntime/src/lib/checkpoint/checkpoint_sections.cpp
index 10f44d9..02dfbf5 100644
--- a/ps2xRuntime/src/lib/checkpoint/checkpoint_sections.cpp
+++ b/ps2xRuntime/src/lib/checkpoint/checkpoint_sections.cpp
@@ -313,11 +313,22 @@ namespace ps2x::checkpoint
 
     void writeR5900Context(ByteWriter &w, const R5900Context &c)
     {
-        writeR5900(w, c);
+        // vf0/vi0 are hardwired on VU0 and are not state: always serialize the
+        // constant so save/restore round-trips stay byte-identical.
+        R5900Context canonical = c;
+        canonical.vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+        canonical.vi[0] = 0;
+        writeR5900(w, canonical);
     }
     bool readR5900Context(ByteReader &r, R5900Context &c)
     {
-        return readR5900(r, c);
+        if (!readR5900(r, c))
+            return false;
+        // vf0/vi0 are hardwired on VU0; checkpoints saved by runtimes that left them
+        // zero in thread/invocation contexts must not restore that invalid state.
+        c.vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+        c.vi[0] = 0;
+        return true;
     }
 
