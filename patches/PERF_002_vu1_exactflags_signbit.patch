+    // Sign bit of an IEEE-754 binary64 value read from its representation. On MSVC, std::signbit(long double)
+    // is an out-of-line UCRT call (_ldsign); where long double is binary64 (MSVC x64) bit 63 is the same sign
+    // for every class (+-0, subnormal, normal, Inf, NaN with any payload). Other models keep std::signbit.
+    template <typename T>
+    inline bool signBit(T value)
+    {
+        if constexpr (sizeof(T) == sizeof(uint64_t) && std::numeric_limits<T>::is_iec559 &&
+                      std::numeric_limits<T>::digits == 53)
+            return (std::bit_cast<uint64_t>(value) >> 63) != 0u;
+        else
+            return std::signbit(value);
+    }
+#if defined(_MSC_VER) && defined(_M_X64)
+    static_assert(sizeof(long double) == sizeof(uint64_t) && std::numeric_limits<long double>::is_iec559 &&
+                      std::numeric_limits<long double>::digits == 53,
+                  "MSVC x64: long double is expected to be IEEE-754 binary64");
+#endif
