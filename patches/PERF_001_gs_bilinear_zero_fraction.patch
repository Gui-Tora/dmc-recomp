index cd8bf0d..d88dd6f 100644
--- a/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
@@ -1038,6 +1038,13 @@ uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t,
     const float fx = sampleU - static_cast<float>(u0);
     const float fy = sampleV - static_cast<float>(v0);
 
+    // Both weights exactly zero (texel-centred sample): lerpChannel(c00, c10, c01, c11, 0, 0) evaluates
+    // c00 + d * 0 = c00 exactly for every channel (c in 0..255, d finite), and lround/clampU8 return it
+    // unchanged, so the filtered texel is c00 bit for bit. samplePoint only reads, so skipping the other
+    // three taps has no side effect. NaN/Inf weights compare unequal and keep the general path.
+    if (fx == 0.0f && fy == 0.0f)
+        return samplePoint(u0, v0);
+
     const uint32_t c00 = samplePoint(u0, v0);
     const uint32_t c10 = samplePoint(u1, v0);
     const uint32_t c01 = samplePoint(u0, v1);
