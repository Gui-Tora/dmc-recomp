+        mutable std::mutex m_errorMutex;
+        std::exception_ptr m_error;
+        std::string m_errorText;
+        std::mutex m_sleepMutex;
+        std::condition_variable m_consumerCv, m_producerCv;
+        std::thread m_thread;
+        // producer state (m_producerMutex)
+        std::mutex m_producerMutex;
+        std::thread::id m_producerId{};
+        bool m_vramPresent = false;
+        bool m_haveMarkTick = false;
+        uint64_t m_markTick = 0;
+        uint64_t m_enqueueStart = 0;
+        uint64_t m_prologueCount = 0;
+        std::chrono::steady_clock::time_point m_lastStats;
+        Stats m_stats;
+        // consumer state
+        alignas(64) ConsumerStats m_cstats;
+        // triple buffer: m_back (consumer), m_middle (shared, index | kFresh), m_front (presenter)
+        std::array<Frame, 3> m_frames;
+        uint32_t m_back = 0;
+        alignas(64) std::atomic<uint32_t> m_middle{1};
+        // presenter state (m_presenterMutex)
+        mutable std::mutex m_presenterMutex;
+        uint32_t m_front = 2;
+        PresentationFrame m_cachedFrame;
+        // presentation mailbox (presenter -> producer)
+        std::mutex m_mailboxMutex;
+        std::atomic<bool> m_mailboxPending{false};
+        GSPresentationRequest m_mailboxRequest{};
+        uint64_t m_mailboxTick = 0;
+        uint64_t m_cachedTick = 0;
+        PresenterStats m_pstats;
+    };
+
+    // GSRasterBackend facade. The consumer thread shares the core, so a detached (test-policy) consumer never touches
+    // freed backend state; under the default policy a hang terminates the process instead.
+    class GSAsyncBackend final : public GSRasterBackend
+    {
+    public:
+        explicit GSAsyncBackend(Options options = {}, std::unique_ptr<GSRasterBackend> inner = std::make_unique<GSCpuBackend>())
+            : m_core(std::make_shared<Core>(std::move(inner), std::move(options)))
+        {
+            m_core->start();
+        }
+        ~GSAsyncBackend() override { m_core->shutdown(); }
+
+        void Initialize(uint8_t *vram, uint32_t vramSize) override { m_core->Initialize(vram, vramSize); }
+        void Reset() override { m_core->Reset(); }
+        void Submit(const GSPrimitiveBatch &batch) override { m_core->Submit(batch); }
+        void BeginTransfer(const GSTransferCommand &command) override { m_core->BeginTransfer(command); }
+        void UploadImage(const uint8_t *data, uint32_t sizeBytes) override { m_core->UploadImage(data, sizeBytes); }
+        void Flush() override { m_core->Flush(); }
+        void TextureFlush() override { m_core->TextureFlush(); }
+        void Sync(GSSyncReason reason) override { m_core->Sync(reason); }
+        PresentationFrame Present(const GSPresentationRequest &request) override { return m_core->Present(request); }
+        bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override { return m_core->ClearFramebuffer(context, rgba); }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override { return m_core->ConsumeLocalToHostBytes(dst, maxBytes); }
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override { return m_core->ReadVram(psm, base, bw, x, y); }
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override { m_core->WriteVram(psm, base, bw, x, y, value); }
+        void SnapshotVram(std::vector<uint8_t> &out) const override { m_core->SnapshotVram(out); }
+        GSTransferSnapshot GetTransferSnapshot() const override { return m_core->GetTransferSnapshot(); }
+
+        std::future<PresentResult> PresentAsync(const GSPresentationRequest &request) { return m_core->PresentAsync(request); }
+        void drain(DrainReason reason = DrainReason::Explicit) { m_core->drain(reason); }
+        Stats stats() const { return m_core->stats(); }
+        bool failed() const { return m_core->failed(); }
+        uint64_t lastPresentedTick() const { return m_core->lastPresentedTick(); }
+        std::string failureMessage() const { return m_core->failureMessage(); }
+        size_t capacity() const { return m_core->capacity(); }
+        static size_t slotBytes() { return Core::slotBytes(); }
+        size_t retainedUploadBytes() const { return m_core->retainedUploadBytes(); }
+        size_t frameBufferBytes() const { return m_core->frameBufferBytes(); }
+        std::thread::native_handle_type nativeHandle() { return m_core->nativeHandle(); }
+        uint64_t producerCoreMask() const { return m_core->producerCoreMask(); }
+        uint64_t consumerCoreMask() const { return m_core->consumerCoreMask(); }
+
+    private:
+        std::shared_ptr<Core> m_core;
+    };
+} // namespace gsasync
