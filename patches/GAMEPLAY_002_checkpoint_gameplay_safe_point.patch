+    // GAMEPLAY_002: PS2X_CHECKPOINT_DEFER_VSYNCS=<N> keeps a save request
+    // pending while the safe-point validation refuses it, and retries it at
+    // every later boundary for up to N VSync ticks. The validation only reads
+    // state, so a pending request does not change what the guest executes.
+    // Unset or 0: the original single attempt. Executor thread only.
+    // Logging only: the first refusal is printed, then at most one line every
+    // kCheckpointDeferLogVsyncs ticks with the number of refusals not printed.
+    constexpr uint64_t kCheckpointDeferLogVsyncs = 60u;
+    struct CheckpointDeferState
+    {
+        bool waiting = false;
+        uint64_t firstTick = 0u;
+        uint64_t attempts = 0u;
+        uint64_t lastLogTick = 0u;
+        uint64_t skippedLogs = 0u;
+    };
+    CheckpointDeferState g_checkpointDefer;
+
+    uint64_t checkpointDeferVsyncs()
+    {
+        static const uint64_t value = []() -> uint64_t {
+            const char *env = std::getenv("PS2X_CHECKPOINT_DEFER_VSYNCS");
+            return (env && *env) ? std::strtoull(env, nullptr, 0) : 0u;
+        }();
+        return value;
+    }
