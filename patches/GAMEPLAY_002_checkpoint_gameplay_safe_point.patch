+        tc.Run("DMC CDMODULE allows a checkpoint once the movie stream is drained", [](TestCase &t)
+        {
+            // GAMEPLAY_002: after a movie ends naturally DMC never sends fno=0xC, so the session stays
+            // active with every byte consumed (fno=0xD answers alive=0). That state is serialized whole and
+            // must not refuse a checkpoint; a stream with bytes left still must.
+            FakeIopHost host;
+            std::vector<uint8_t> disc(2048u + 0x30u);
+            for (size_t i = 0; i < disc.size(); ++i)
+                disc[i] = static_cast<uint8_t>(i * 7u + 3u);
+            host.hostFileContents["fake/disc.iso"] = disc;
+            ps2x::iop::IopSubsystem subsystem(host);
+            std::string error;
+            t.IsTrue(subsystem.configure({"SLES_503.58", 0x00100008u, 0x77654AD2u}, &error),
+                     "DMC profile should configure");
+
+            constexpr uint32_t kSend = 0x1000u;
+            constexpr uint32_t kRecv = 0x2000u;
+            constexpr uint32_t kDest = 0x3000u;
+            const auto call = [&](uint32_t function, uint32_t word8)
+            {
+                const uint32_t words[8] = {0x231u, 1u, word8, kDest, 0u, 1u, 0u, 0u};
+                host.writeGuest(kSend, words, sizeof(words));
+                ps2x::iop::RpcRequest request{};
+                request.sid = 0x12345678u;
+                request.function = function;
+                request.send = {kSend, sizeof(words)};
+                request.receive = {kRecv, 16u};
+                const ps2x::iop::RpcResult result = subsystem.handleRpc(request);
+                uint32_t value = 0u;
+                host.readGuest(kRecv, &value, sizeof(value));
+                return result.handled ? value : 0xFFFFFFFFu;
+            };
+            std::string reason;
+            t.IsTrue(subsystem.validateCheckpointSafe(reason), "no movie: safe");
+
+            t.Equals(call(9u, 0x30u), 0x30u, "fno=9 starts the movie session");
+            t.IsFalse(subsystem.validateCheckpointSafe(reason), "a started stream with bytes left refuses");
+            t.Equals(call(0xAu, 0x20u), 0x20u, "fno=0xA copies the first chunk");
+            t.IsFalse(subsystem.validateCheckpointSafe(reason), "a partly consumed stream refuses");
+            t.Equals(reason, std::string("CDMODULE: movie stream active"), "refusal names the movie stream");
+            std::vector<uint8_t> partial;
+            t.IsFalse(subsystem.serializeCheckpointState(partial, error), "serialization also refuses it");
+
+            t.Equals(call(0xAu, 0x20u), 0x20u, "fno=0xA echoes the requested size at the end of the file");
+            t.Equals(call(0xDu, 0u), 0u, "fno=0xD reports alive=0 once every byte was consumed");
+            t.IsTrue(subsystem.validateCheckpointSafe(reason), "a drained stream left open is safe");
+
+            std::vector<uint8_t> saved;
+            t.IsTrue(subsystem.serializeCheckpointState(saved, error), "the drained session serializes");
+            t.Equals(call(9u, 0x30u), 0x30u, "a new movie changes the session after the snapshot");
+            t.IsTrue(subsystem.deserializeCheckpointState(saved, error), "the drained session restores");
+            t.IsTrue(subsystem.validateCheckpointSafe(reason), "the restored session is still safe");
+            t.Equals(call(0xDu, 0u), 0u, "the restored session still answers alive=0");
+
+            std::vector<uint8_t> fill(0x20u, 0xA5u);
+            host.writeGuest(kDest, fill.data(), fill.size());
+            t.Equals(call(0xAu, 0x20u), 0x20u, "a transfer after restore still echoes the request");
+            std::vector<uint8_t> after(0x20u);
