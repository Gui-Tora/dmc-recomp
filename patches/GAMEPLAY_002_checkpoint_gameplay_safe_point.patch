+        tc.Run("GS checkpoint restores a partially filled vertex queue exactly", [](TestCase &t)
+        {
+            // GAMEPLAY_002: queued vertices are part of the serialized GS state, so a checkpoint taken with
+            // vertices pending (a strip/fan tail, or a primitive whose remaining vertices arrive later) must
+            // continue on restore exactly as the original GS does.
+            struct Case
+            {
+                const char *name;
+                uint8_t prim;
+                int before; // vertices sent before the checkpoint
+                int after;  // vertices sent after it
+            };
+            const Case cases[] = {
+                {"tristrip tail", GS_PRIM_TRISTRIP, 4, 2},
+                {"trifan tail", GS_PRIM_TRIFAN, 3, 2},
+                {"triangle with one vertex queued", GS_PRIM_TRIANGLE, 1, 2},
+                {"triangle with two vertices queued", GS_PRIM_TRIANGLE, 2, 1},
+                {"linestrip tail", GS_PRIM_LINESTRIP, 2, 2},
+            };
+            const uint16_t xs[] = {4, 40, 8, 56, 20, 60};
+            const uint16_t ys[] = {2, 4, 28, 20, 30, 2};
+            auto sendVertex = [&](GS &gs, int i)
+            {
+                gs.writeRegister(GS_REG_RGBAQ, static_cast<uint64_t>(0x20u + 37u * i) |
+                                                   (static_cast<uint64_t>(0xF0u - 29u * i) << 8) |
+                                                   (static_cast<uint64_t>(0x40u + 51u * i) << 16) |
+                                                   (0x80ull << 24) | (0x3F800000ull << 32));
+                gs.writeRegister(GS_REG_XYZ2, (static_cast<uint64_t>(xs[i]) << 4) |
+                                                  (static_cast<uint64_t>(ys[i]) << 4 << 16));
+            };
+            auto setup = [](GS &gs, uint8_t prim)
+            {
+                gs.writeRegister(GS_REG_FRAME_1, (1ull << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24));
+                gs.writeRegister(GS_REG_ZBUF_1, (1ull << 32));
+                gs.writeRegister(GS_REG_SCISSOR_1, (63ull << 16) | (31ull << 48));
+                gs.writeRegister(GS_REG_XYOFFSET_1, 0ull);
+                gs.writeRegister(GS_REG_TEST_1, 0x30000ull);
+                gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(prim) | (1ull << 3));
+            };
+            for (const Case &c : cases)
+            {
+                std::vector<uint8_t> vramA(PS2_GS_VRAM_SIZE, 0u);
+                GS a;
+                a.init(vramA.data(), static_cast<uint32_t>(vramA.size()), nullptr);
+                setup(a, c.prim);
+                for (int i = 0; i < c.before; ++i)
+                    sendVertex(a, i);
+
+                std::string reason;
+                t.IsTrue(a.checkpointIdle(reason), std::string(c.name) + ": queued vertices must not refuse the save");
+                ps2x::checkpoint::ByteWriter w;
+                std::string error;
+                t.IsTrue(a.serializeCheckpointState(w, error), std::string(c.name) + ": GS state should serialize");
+
+                std::vector<uint8_t> vramB = vramA;
+                GS b;
+                b.init(vramB.data(), static_cast<uint32_t>(vramB.size()), nullptr);
+                ps2x::checkpoint::ByteReader r(w.buffer().data(), w.buffer().size());
+                t.IsTrue(b.deserializeCheckpointState(r, error), std::string(c.name) + ": GS state should restore");
+
+                // Control: the same registers without the restored queue.
+                std::vector<uint8_t> vramC = vramA;
+                GS control;
+                control.init(vramC.data(), static_cast<uint32_t>(vramC.size()), nullptr);
+                setup(control, c.prim);
+
+                const std::vector<uint8_t> beforeFrame(vramA.begin(), vramA.begin() + 8192);
+                for (int i = c.before; i < c.before + c.after; ++i)
+                {
+                    sendVertex(a, i);
+                    sendVertex(b, i);
+                    sendVertex(control, i);
+                }
+                t.IsTrue(std::equal(vramA.begin(), vramA.begin() + 8192, vramB.begin()),
+                         std::string(c.name) + ": restored GS must draw exactly what the original draws");
+                t.IsFalse(std::equal(beforeFrame.begin(), beforeFrame.end(), vramA.begin()),
+                          std::string(c.name) + ": the vertices after the checkpoint must draw something");
+                t.IsFalse(std::equal(vramA.begin(), vramA.begin() + 8192, vramC.begin()),
+                          std::string(c.name) + ": without the restored queue the frame must differ");
+            }
+        });
