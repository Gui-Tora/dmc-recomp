@@ -273,4 +275,420 @@ namespace ps2x::iop::audio
         uint64_t m_done = 0, m_chunksRead = 0;
         bool m_failed = false;
     };
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // AUDIO_002-3 (patch 38): TSNDDRVM XAG voice volume, reconstructed from TSNDDRVM.IRX (SHA-256 c00b17f0...):
+    //   channel record +0x02 flags (0x1/0x2 volume dirty, 0x10 fade active, 0x20 fade-out = stop at the end),
+    //   +0x04 entry volume (Tsnd_xag_tbl word 2 low half), +0x06 volume, +0x08 fade target, +0x0A fade step,
+    //   +0x0C channel volume[i] (0x80 = unity), +0x54 pan[i] (copied from the entry's pan table); global XagMVol.
+    //   XagSetVol@0x74CC, XagSetFade@0x77A8, XagSetFadeout@0x7868, XagSetMVol@0x7C5C, xag_default@0x6B10,
+    //   xag_atick@0x7028 (fade step + level), xag_setvol@0x9844 / calc_pan_vol_r@0x97E4 (SPU VOLL/VOLR).
+    //   xag_atick runs from the ATick thread, woken by a hardware timer (TsndInitTimer@0x2238: source 1, compare
+    //   0x25800 = 153600 IOP cycles -> 240 Hz at 36.864 MHz), i.e. once per 200 output frames at 48 kHz.
+    // Everything is integer and depends only on the command sequence and its position in samples, so the guest
+    // service (logical state) and the audio source (gain) evolve identically.
+
+    inline constexpr uint32_t kXagATickRate = 240u;
+    inline constexpr uint32_t kXagATickFrames = kMixRate / kXagATickRate; // 200
+    // Phase of the 240 Hz timer relative to the start of a voice: not observable from the IRX (free-running timer).
+    // Half a period keeps every atick strictly inside a field (960 * k mod 200 is never 100), so a command applied
+    // at a field start never ties with an atick.
+    inline constexpr uint32_t kXagATickPhase = kXagATickFrames / 2u;
+    inline constexpr uint16_t kXagFlagDirty = 0x0003u;
+    inline constexpr uint16_t kXagFlagFade = 0x0010u;
+    inline constexpr uint16_t kXagFlagFadeout = 0x0020u;
+    inline constexpr size_t kXagPanLawSize = 0x81u; // xag_pan_tbl: 129 halfwords, 0x1000 = unity
+
+    // Position (frames since the voice started) of atick number n (1-based).
+    inline constexpr uint64_t xagATickPosition(uint64_t n)
+    {
+        return n * kXagATickFrames - kXagATickPhase;
+    }
+
+    struct XagVoiceParams
+    {
+        int16_t entryVolume = 0x3FFF;      // record +0x04
+        uint32_t channels = 2u;            // 1 or 2
+        std::array<uint8_t, 2> pan{0x00u, 0x80u};
+        const int16_t *panLaw = nullptr;   // kXagPanLawSize entries; null -> silent
+        bool mono = false;                 // calc_pan_vol_r global mono flag (forces pan 0x40)
+    };
+
+    // Guest-deterministic state of one XAG channel's volume (IRX record subset) plus the SPU voice volumes it wrote.
+    struct XagVolumeState
+    {
+        int16_t vol = 0x4000;
+        int16_t target = 0;
+        int16_t step = 0;
+        uint16_t flags = 0u;
+        std::array<uint8_t, 2> chVol{0x80u, 0x80u};
+        int32_t masterVol = 0;              // XagMVol (global in the IRX; mirrored in each channel)
+        std::array<int16_t, 4> regs{};      // VOLL/VOLR of channel 0, VOLL/VOLR of channel 1 (15-bit, 0x3FFF max)
+        std::array<int16_t, 4> prevRegs{};  // values before the last change (start of the anti-click ramp)
+        uint64_t rampStart = 0u;            // position of the last change
+        bool ramping = false;
+        uint64_t aticks = 0u;               // aticks executed since the voice started playing
+
+        bool operator==(const XagVolumeState &) const = default;
+    };
+
+    inline int32_t xagLevel(int32_t vol, int32_t entryVolume, int32_t masterVol)
+    {
+        int32_t p = vol * entryVolume;
+        if (p < 0)
+            p += 0x3FFF;
+        p >>= 14;
+        const uint32_t t = static_cast<uint32_t>(p * masterVol);
+        return static_cast<int32_t>((t >> 14) & 0xFFFFu);
+    }
+
+    inline int32_t xagPanVolume(int32_t level, uint32_t pan, const XagVoiceParams &params)
+    {
+        if (!params.panLaw)
+            return 0;
+        pan &= 0xFFu;
+        if (params.mono)
+            pan = 0x40u;
+        else if (pan > 0x80u)
+            pan = 0x80u;
+        int32_t v = static_cast<int32_t>(static_cast<uint32_t>(level) & 0xFFFFu) * params.panLaw[pan];
+        if (v < 0)
+            v += 0xFFF;
+        return (v >> 12) & 0xFFFF;
+    }
+
+    // xag_setvol: per channel, VOLR from pan, VOLL from 0x80 - pan, scaled by the channel volume, clamped to 0x3FFF.
+    inline std::array<int16_t, 4> xagVoiceRegs(int32_t level, const XagVolumeState &s, const XagVoiceParams &params)
+    {
+        std::array<int16_t, 4> regs{};
+        for (uint32_t i = 0; i < params.channels && i < 2u; ++i)
+        {
+            const uint32_t pan = params.pan[i];
+            int32_t r = xagPanVolume(level, pan, params) * s.chVol[i];
+            if (r < 0)
+                r += 0x7F;
+            r >>= 7;
+            int32_t l = xagPanVolume(level, (0x80u - pan) & 0xFFu, params) * s.chVol[i];
+            if (l < 0)
+                l += 0x7F;
+            l >>= 7;
+            if (static_cast<uint32_t>(r) >= 0x4000u)
+                r = 0x3FFF;
+            if (static_cast<uint32_t>(l) >= 0x4000u)
+                l = 0x3FFF;
+            regs[2u * i] = static_cast<int16_t>(l);
+            regs[2u * i + 1u] = static_cast<int16_t>(r);
+        }
+        return regs;
+    }
+
+    inline void xagWriteRegs(XagVolumeState &s, const XagVoiceParams &params, uint64_t position)
+    {
+        const std::array<int16_t, 4> regs =
+            xagVoiceRegs(xagLevel(s.vol, params.entryVolume, s.masterVol), s, params);
+        if (regs == s.regs)
+            return;
+        s.prevRegs = s.regs;
+        s.regs = regs;
+        s.rampStart = position;
+        s.ramping = true;
+    }
+
+    // xag_default (volume part; the service also clears its loop/skip fields).
+    inline void xagDefault(XagVolumeState &s)
+    {
+        s.vol = 0x4000;
+        s.chVol = {0x80u, 0x80u};
+    }
+
+    inline void xagSetVol(XagVolumeState &s, int16_t vol)
+    {
+        s.vol = vol;
+        s.flags |= 0x0001u;
+    }
+
+    // XagSetFade: ignored while a fade-out runs; step = (target - vol) / time truncated, at least +-1.
+    inline void xagSetFade(XagVolumeState &s, int16_t target, uint16_t time)
+    {
+        if (s.flags & kXagFlagFadeout)
+            return;
+        const int32_t diff = static_cast<int32_t>(target) - s.vol;
+        int32_t step = time == 0u ? diff : diff / static_cast<int32_t>(time);
+        if (step == 0)
+            step = target == 0 ? -1 : (diff >= 0 ? 1 : -1);
+        s.step = static_cast<int16_t>(step);
+        s.target = target;
+        s.flags |= kXagFlagFade;
+    }
+
+    inline void xagSetFadeout(XagVolumeState &s, uint16_t time)
+    {
+        xagSetFade(s, 0, time);
+        s.flags |= kXagFlagFade | kXagFlagFadeout;
+    }
+
+    // XagSetMVol: global value clamped to [0, 0x4000]; only the current core's record is marked dirty.
+    inline void xagSetMasterVol(XagVolumeState &s, int32_t value, bool currentCore)
+    {
+        s.masterVol = std::clamp(value, 0, 0x4000);
+        if (currentCore)
+            s.flags |= 0x0001u;
+    }
+
+    // XagControl@0x90A0: SPU volumes written when the stream is prepared (no ramp: the voice is not sounding yet).
+    inline void xagPrepare(XagVolumeState &s, const XagVoiceParams &params)
+    {
+        s.regs = xagVoiceRegs(xagLevel(s.vol, params.entryVolume, s.masterVol), s, params);
+        s.prevRegs = s.regs;
+        s.ramping = false;
+        s.rampStart = 0u;
+        s.aticks = 0u;
+    }
+
+    // One xag_atick (states 3/5). Returns true when a fade-out reached its target: the IRX calls xag_stop and
+    // writes no new volume. Per-channel fades (0x40, XagSetChFade) and pitch are not sent by DMC: not modelled.
+    inline bool xagATick(XagVolumeState &s, const XagVoiceParams &params)
+    {
+        ++s.aticks;
+        const uint64_t position = xagATickPosition(s.aticks);
+        const uint16_t flags = s.flags;
+        if (flags == 0u)
+            return false;
+        if (flags & kXagFlagFade)
+        {
+            int32_t vol = s.vol + s.step;
+            if (s.step < 0)
+            {
+                if (vol < s.target)
+                    vol = s.target;
+            }
+            else if (s.target < vol)
+                vol = s.target;
+            if (vol == s.target)
+            {
+                s.flags &= static_cast<uint16_t>(~kXagFlagFade);
+                if (s.flags & kXagFlagFadeout)
+                {
+                    s.flags &= static_cast<uint16_t>(~kXagFlagFadeout);
+                    return true;
+                }
+            }
+            s.vol = static_cast<int16_t>(vol);
+            xagWriteRegs(s, params, position);
+            s.flags &= static_cast<uint16_t>(~kXagFlagDirty);
+            return false;
+        }
+        if (flags & kXagFlagDirty)
+        {
+            xagWriteRegs(s, params, position);
+            s.flags &= static_cast<uint16_t>(~kXagFlagDirty);
+        }
+        return false;
+    }
+
+    // A volume command that can reach a sounding voice.
+    struct XagVolumeCommand
+    {
+        enum class Op : uint8_t
+        {
+            SetVol,     // 0x38: a = volume
+            SetFade,    // 0x36: a = target, b = time (aticks)
+            Fadeout,    // 0x37: b = time (aticks)
+            MasterVol,  // 0x72: a = value, current = record of the current core
+            Default,    // 0x70: XagDefault
+        };
+        Op op = Op::SetVol;
+        int32_t a = 0;
+        uint32_t b = 0u;
+        bool current = false;
+        uint64_t position = 0u; // frames since the voice started (guest timeline)
+    };
+
+    inline void xagApply(XagVolumeState &s, const XagVolumeCommand &c)
+    {
+        switch (c.op)
+        {
+        case XagVolumeCommand::Op::SetVol: xagSetVol(s, static_cast<int16_t>(c.a)); break;
+        case XagVolumeCommand::Op::SetFade:
+            xagSetFade(s, static_cast<int16_t>(c.a), static_cast<uint16_t>(c.b));
+            break;
+        case XagVolumeCommand::Op::Fadeout: xagSetFadeout(s, static_cast<uint16_t>(c.b)); break;
+        case XagVolumeCommand::Op::MasterVol: xagSetMasterVol(s, c.a, c.current); break;
+        case XagVolumeCommand::Op::Default:
+            if (!(s.flags & kXagFlagFadeout))
+                xagDefault(s);
+            break;
+        }
+    }
+
+    // Commands posted by the service to a sounding voice: one bounded FIFO for the guest-timed source (applied at
+    // their sample position) and one for the free-running copy (applied on arrival). A full FIFO drops the command
+    // and counts it (the EE sends a handful per voice; 64 is never reached in practice).
+    class XagVoiceControl
+    {
+    public:
+        static constexpr size_t kCapacity = 64u;
+
+        void post(const XagVolumeCommand &command)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            const bool guestKept = push(m_guest, command);
+            const bool freeKept = push(m_free, command);
+            if (!guestKept || !freeKept)
+                ++m_dropped;
+        }
+
+        // Pops, in order, the guest commands positioned before `end`.
+        template <typename F>
+        void takeGuest(uint64_t end, F &&apply)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            while (m_guest.count != 0u && m_guest.items[m_guest.head].position < end)
+            {
+                apply(m_guest.items[m_guest.head]);
+                pop(m_guest);
+            }
+        }
+
+        template <typename F>
+        void takeFree(F &&apply)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            while (m_free.count != 0u)
+            {
+                apply(m_free.items[m_free.head]);
+                pop(m_free);
+            }
+        }
+
+        [[nodiscard]] uint64_t dropped() const
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            return m_dropped;
+        }
+
+    private:
+        struct Fifo
+        {
+            std::array<XagVolumeCommand, kCapacity> items{};
+            size_t head = 0u, count = 0u;
+        };
+
+        static bool push(Fifo &fifo, const XagVolumeCommand &command)
+        {
+            if (fifo.count == kCapacity)
+                return false;
+            fifo.items[(fifo.head + fifo.count) % kCapacity] = command;
+            ++fifo.count;
+            return true;
+        }
+
+        static void pop(Fifo &fifo)
+        {
+            fifo.head = (fifo.head + 1u) % kCapacity;
+            --fifo.count;
+        }
+
+        mutable std::mutex m_mutex;
+        Fifo m_guest, m_free;
+        uint64_t m_dropped = 0u;
+    };
+
+    // Applies an XAG voice's SPU volumes to resampled frames (interleaved stereo at kMixRate; channel 0 left and
+    // channel 1 right of a 2-channel clip, channel 0 duplicated for a mono clip), running the 240 Hz aticks and the
+    // commands at their positions. Volume changes are ramped linearly over one atick period (200 frames) to avoid
+    // the clicks of the SPU's immediate register writes. A fade-out that reaches 0 ramps to silence and stops.
+    // Output = sum over channels of sample * VOL >> 14 per side (SPU fixed volume: register * 2 / 2^15), saturated.
+    class XagGainRenderer
+    {
+    public:
+        XagGainRenderer() = default;
+        XagGainRenderer(const XagVoiceParams &params, const XagVolumeState &state, uint64_t position)
+            : m_params(params), m_state(state), m_position(position)
+        {
+        }
+
+        [[nodiscard]] uint64_t position() const { return m_position; }
+        [[nodiscard]] bool stopped() const { return m_stopped; }
+        [[nodiscard]] const XagVolumeState &state() const { return m_state; }
+
+        // nextCommand(uint64_t position, XagVolumeCommand &out) -> bool: the earliest pending command at or
+        // before `position`, if any (the caller pops it).
+        template <typename NextCommand>
+        size_t process(int16_t *stereo, size_t frames, NextCommand &&nextCommand)
+        {
+            size_t done = 0;
+            for (; done < frames; ++done)
+            {
+                const uint64_t k = m_position;
+                while (!m_stopping && xagATickPosition(m_state.aticks + 1u) <= k)
+                {
+                    if (xagATick(m_state, m_params))
+                        beginStop(xagATickPosition(m_state.aticks));
+                }
+                XagVolumeCommand command;
+                while (!m_stopping && nextCommand(k, command))
+                    xagApply(m_state, command);
+                if (m_stopping && k >= m_stopAt)
+                {
+                    m_stopped = true;
+                    break;
+                }
+                const int32_t x0 = stereo[done * 2u];
+                const int32_t x1 = stereo[done * 2u + 1u];
+                int32_t left, right;
+                if (m_params.channels == 1u)
+                {
+                    left = (x0 * gain(0, k)) >> 14;
+                    right = (x0 * gain(1, k)) >> 14;
+                }
+                else
+                {
+                    left = ((x0 * gain(0, k)) >> 14) + ((x1 * gain(2, k)) >> 14);
+                    right = ((x0 * gain(1, k)) >> 14) + ((x1 * gain(3, k)) >> 14);
+                }
+                stereo[done * 2u] = static_cast<int16_t>(std::clamp(left, -32768, 32767));
+                stereo[done * 2u + 1u] = static_cast<int16_t>(std::clamp(right, -32768, 32767));
+                ++m_position;
+            }
+            return done;
+        }
+
+    private:
+        void beginStop(uint64_t position)
+        {
+            m_stopping = true;
+            m_state.prevRegs = currentRegs(position);
+            m_state.regs = {};
+            m_state.rampStart = position;
+            m_state.ramping = true;
+            m_stopAt = position + kXagATickFrames;
+        }
+
+        std::array<int16_t, 4> currentRegs(uint64_t k) const
+        {
+            std::array<int16_t, 4> regs{};
+            for (size_t i = 0; i < 4u; ++i)
+                regs[i] = static_cast<int16_t>(gain(i, k));
+            return regs;
+        }
+
+        int32_t gain(size_t reg, uint64_t k) const
+        {
+            const int32_t to = m_state.regs[reg];
+            if (!m_state.ramping || k >= m_state.rampStart + kXagATickFrames)
+                return to;
+            const int32_t from = m_state.prevRegs[reg];
+            const int64_t j = static_cast<int64_t>(k - m_state.rampStart) + 1;
+            return from + static_cast<int32_t>((static_cast<int64_t>(to - from) * j) /
+                                               static_cast<int64_t>(kXagATickFrames));
+        }
+
+        XagVoiceParams m_params{};
+        XagVolumeState m_state{};
+        uint64_t m_position = 0u;
+        uint64_t m_stopAt = 0u;
+        bool m_stopping = false;
+        bool m_stopped = false;
+    };
 }
