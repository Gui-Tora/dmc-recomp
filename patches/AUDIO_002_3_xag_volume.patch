diff --git a/ps2xTest/src/audio_xag_volume_tests.cpp b/ps2xTest/src/audio_xag_volume_tests.cpp
new file mode 100644
index 0000000..b86913a
--- /dev/null
+++ b/ps2xTest/src/audio_xag_volume_tests.cpp
@@ -0,0 +1,310 @@
+// AUDIO_002-3 (patch 38): TSNDDRVM XAG voice volume model (audio_dsp.h) and its gain renderer.
+#include "MiniTest.h"
+#include "ps2x/iop/audio_dsp.h"
+
+#include <atomic>
+#include <cmath>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+using namespace ps2x::iop::audio;
+
+namespace
+{
+    std::vector<int16_t> sinePanLaw()
+    {
+        std::vector<int16_t> law(kXagPanLawSize);
+        for (size_t p = 0; p < law.size(); ++p)
+            law[p] = static_cast<int16_t>(std::lround(4096.0 * std::sin(static_cast<double>(p) * 3.14159265358979323846 / 256.0)));
+        return law;
+    }
+
+    const std::vector<int16_t> &panLaw()
+    {
+        static const std::vector<int16_t> law = sinePanLaw();
+        return law;
+    }
+
+    XagVoiceParams stereoParams()
+    {
+        XagVoiceParams p{};
+        p.entryVolume = 0x3FFF;
+        p.channels = 2u;
+        p.pan = {0x00u, 0x80u};
+        p.panLaw = panLaw().data();
+        return p;
+    }
+
+    XagVolumeState startState(int16_t vol, int32_t mvol, const XagVoiceParams &params)
+    {
+        XagVolumeState s{};
+        s.vol = vol;
+        s.masterVol = mvol;
+        xagPrepare(s, params);
+        return s;
+    }
+
+    // Renders `frames` frames of a constant input through the renderer in blocks of `block`, with the given commands.
+    std::vector<int16_t> renderConst(const XagVoiceParams &params, const XagVolumeState &start,
+                                     const std::vector<XagVolumeCommand> &commands, size_t frames, size_t block,
+                                     int16_t x0 = 20000, int16_t x1 = -12000)
+    {
+        XagGainRenderer gain(params, start, 0u);
+        std::vector<int16_t> out;
+        size_t next = 0;
+        std::vector<int16_t> buf;
+        while (out.size() / 2u < frames && !gain.stopped())
+        {
+            const size_t n = std::min(block, frames - out.size() / 2u);
+            buf.assign(n * 2u, 0);
+            for (size_t i = 0; i < n; ++i)
+            {
+                buf[i * 2u] = x0;
+                buf[i * 2u + 1u] = x1;
+            }
+            const size_t got = gain.process(buf.data(), n, [&](uint64_t k, XagVolumeCommand &c) {
+                if (next == commands.size() || commands[next].position > k)
+                    return false;
+                c = commands[next++];
+                return true;
+            });
+            out.insert(out.end(), buf.begin(), buf.begin() + static_cast<std::ptrdiff_t>(got * 2u));
+            if (got < n)
+                break;
+        }
+        return out;
+    }
+}
+
+void register_audio_xag_volume_tests()
+{
+    MiniTest::Case("XagVolume", [](TestCase &tc) {
+        tc.Run("pan law is the IRX sine table (0x1000 at 0x80, 0xB50 at 0x40)", [](TestCase &t) {
+            t.Equals(int(panLaw()[0]), 0, "p=0");
+            t.Equals(int(panLaw()[0x40]), 0xB50, "p=0x40");
+            t.Equals(int(panLaw()[0x80]), 0x1000, "p=0x80");
+        });
+        tc.Run("default chain: vol 0x4000, entry 0x3FFF, master 0x3FFF -> VOL 0x3FFE, hard L/R", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            const XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            t.Equals(xagLevel(0x4000, 0x3FFF, 0x3FFF), 0x3FFE, "level");
+            t.Equals(int(s.regs[0]), 0x3FFE, "ch0 VOLL");
+            t.Equals(int(s.regs[1]), 0, "ch0 VOLR");
+            t.Equals(int(s.regs[2]), 0, "ch1 VOLL");
+            t.Equals(int(s.regs[3]), 0x3FFE, "ch1 VOLR");
+        });
+        tc.Run("level is linear in volume and master volume (toward-zero shifts)", [](TestCase &t) {
+            t.Equals(xagLevel(0x2000, 0x3FFF, 0x4000), 0x1FFF, "half volume");
+            t.Equals(xagLevel(0x4000, 0x3FFF, 0x2000), 0x1FFF, "half master");
+            t.Equals(xagLevel(0x4000, 0x3FFF, 0), 0, "master 0 = silence (IRX .sdata value before SndInit)");
+            t.Equals(xagLevel(0, 0x3FFF, 0x3FFF), 0, "volume 0");
+            for (int v = 0; v <= 0x4000; v += 0x80)
+                t.IsTrue(xagLevel(v, 0x3FFF, 0x3FFF) <= xagLevel(v + 0x80, 0x3FFF, 0x3FFF), "monotonic");
+        });
+        tc.Run("centre pan (0x40) gives 0xB50/0x1000 on both sides; mono flag forces 0x40", [](TestCase &t) {
+            XagVoiceParams p = stereoParams();
+            p.pan = {0x40u, 0x40u};
+            const XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            const int expected = (0x3FFE * 0xB50) >> 12;
+            t.Equals(int(s.regs[0]), expected, "L");
+            t.Equals(int(s.regs[1]), expected, "R");
+            XagVoiceParams m = stereoParams();
+            m.mono = true;
+            const XagVolumeState sm = startState(0x4000, 0x3FFF, m);
+            t.Equals(int(sm.regs[0]), expected, "mono flag L");
+            t.Equals(int(sm.regs[3]), expected, "mono flag R");
+        });
+        tc.Run("XagSetFade step: truncated quotient, time 0 = whole difference, at least +-1", [](TestCase &t) {
+            XagVolumeState s{};
+            s.vol = 0x4000;
+            xagSetFade(s, 0, 120);
+            t.Equals(int(s.step), -136, "0x4000 / 120");
+            s = XagVolumeState{};
+            s.vol = 0x1000;
+            xagSetFade(s, 0x4000, 0);
+            t.Equals(int(s.step), 0x3000, "time 0");
+            s = XagVolumeState{};
+            s.vol = 0x1000;
+            xagSetFade(s, 0x1010, 1000);
+            t.Equals(int(s.step), 1, "small up -> +1");
+            s = XagVolumeState{};
+            s.vol = 0x1010;
+            xagSetFade(s, 0x1000, 1000);
+            t.Equals(int(s.step), -1, "small down -> -1");
+            s = XagVolumeState{};
+            s.vol = 0;
+            xagSetFade(s, 0, 10);
+            t.Equals(int(s.step), -1, "target 0 and no difference -> -1");
+            t.IsTrue((s.flags & kXagFlagFade) != 0u, "fade flag");
+        });
+        tc.Run("a fade-out ignores later fades and stops after ceil(vol / |step|) aticks without writing 0", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            xagSetFadeout(s, 120);
+            xagSetFade(s, 0x4000, 10); // ignored (0x20 set)
+            xagSetFadeout(s, 5);       // XagSetFade ignored, flags kept
+            t.Equals(int(s.step), -136, "first fade-out step kept");
+            int ticks = 0;
+            bool stopped = false;
+            while (!stopped && ticks < 1000)
+            {
+                ++ticks;
+                stopped = xagATick(s, p);
+            }
+            t.Equals(ticks, 121, "121 aticks for 0x4000 at -136");
+            t.IsTrue(s.vol > 0, "the last volume write is not 0 (xag_stop path writes nothing)");
+            t.Equals(int(s.flags & (kXagFlagFade | kXagFlagFadeout)), 0, "fade flags cleared");
+        });
+        tc.Run("XagSetVol applies at the next atick; master volume clamps and marks only the current core", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            const auto before = s.regs;
+            xagSetVol(s, 0x2000);
+            t.IsTrue(s.regs == before, "no immediate register write");
+            xagATick(s, p);
+            t.Equals(int(s.regs[0]), xagLevel(0x2000, 0x3FFF, 0x3FFF), "written at the atick");
+            XagVolumeState other = startState(0x4000, 0x3FFF, p);
+            xagSetMasterVol(other, 0x7FFF, false);
+            t.Equals(other.masterVol, 0x4000, "clamped to 0x4000");
+            t.Equals(int(other.flags), 0, "not dirty on the other core");
+            xagSetMasterVol(other, -5, true);
+            t.Equals(other.masterVol, 0, "negative -> 0");
+            t.IsTrue((other.flags & 1u) != 0u, "dirty on the current core");
+        });
+        tc.Run("renderer output is independent of the block size", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            const XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            std::vector<XagVolumeCommand> cmds = {
+                {XagVolumeCommand::Op::SetVol, 0x1800, 0u, false, 960u * 3u},
+                {XagVolumeCommand::Op::Fadeout, 0, 60u, false, 960u * 20u},
+            };
+            const auto a = renderConst(p, s, cmds, 960u * 60u, 1u);
+            const auto b = renderConst(p, s, cmds, 960u * 60u, 7u);
+            const auto c = renderConst(p, s, cmds, 960u * 60u, 960u);
+            const auto d = renderConst(p, s, cmds, 960u * 60u, 4096u);
+            t.IsTrue(a == b && b == c && c == d, "same output for blocks 1, 7, 960, 4096");
+        });
+        tc.Run("ramps: per-frame change bounded, target reached after 200 frames, silence after a fade-out", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            const XagVolumeState s = startState(0x4000, 0x3FFF, p);
+            std::vector<XagVolumeCommand> cmds = {{XagVolumeCommand::Op::SetVol, 0x0400, 0u, false, 960u}};
+            const auto out = renderConst(p, s, cmds, 960u * 4u, 960u, 32767, 32767);
+            int maxStep = 0;
+            for (size_t i = 2; i < out.size(); i += 2)
+                maxStep = std::max(maxStep, std::abs(out[i] - out[i - 2]));
+            const int jump = (32767 * 0x3FFE >> 14) - (32767 * xagLevel(0x0400, 0x3FFF, 0x3FFF) >> 14);
+            t.IsTrue(maxStep <= jump / 200 + 2, "no click: per-frame change <= jump / 200");
+            const int settled = (32767 * xagLevel(0x0400, 0x3FFF, 0x3FFF)) >> 14;
+            t.Equals(int(out[2u * (960u * 3u)]), settled, "settled level");
+            std::vector<XagVolumeCommand> fade = {{XagVolumeCommand::Op::Fadeout, 0, 24u, false, 0u}};
+            XagGainRenderer g(p, s, 0u);
+            std::vector<int16_t> buf(2u * 20000u, 1000);
+            size_t next = 0;
+            const size_t got = g.process(buf.data(), 20000u, [&](uint64_t k, XagVolumeCommand &c) {
+                if (next == fade.size() || fade[next].position > k)
+                    return false;
+                c = fade[next++];
+                return true;
+            });
+            t.IsTrue(g.stopped(), "stopped");
+            // 0x4000 / 24 = 682 -> 25 aticks (the 25th ends the fade-out at 25*200-100), then a 200-frame ramp.
+            t.Equals(uint64_t(got), uint64_t(25u * 200u - 100u + 200u), "ends 200 frames after the stopping atick");
+            t.Equals(int(buf[2u * (got - 1u)]), 0, "last frame silent");
+        });
+        tc.Run("renderer and guest-side aticks agree at every field boundary (service vs source)", [](TestCase &t) {
+            const XagVoiceParams p = stereoParams();
+            const XagVolumeState s0 = startState(0x4000, 0x3FFF, p);
+            // Commands at field starts (as the service posts them): fade down, set volume, master volume, fade-out.
+            const std::vector<std::pair<uint64_t, XagVolumeCommand>> byTick = {
+                {5u, {XagVolumeCommand::Op::SetFade, 0x1000, 50u}},
+                {30u, {XagVolumeCommand::Op::SetVol, 0x3000}},
+                {31u, {XagVolumeCommand::Op::MasterVol, 0x2000, 0u, true}},
+                {60u, {XagVolumeCommand::Op::Fadeout, 0, 120u}},
+            };
+            std::vector<XagVolumeCommand> cmds;
+            for (auto [tick, c] : byTick)
+            {
+                c.position = tick * 960u;
+                cmds.push_back(c);
+            }
+            // Guest side: per tick, aticks strictly before the field start, then the tick's commands.
+            XagVolumeState g = s0;
+            uint64_t stopTick = 0;
+            for (uint64_t tick = 1; tick < 200u && stopTick == 0u; ++tick)
+            {
+                const uint64_t pos = tick * 960u;
+                while (xagATickPosition(g.aticks + 1u) < pos)
+                    if (xagATick(g, p))
+                    {
+                        stopTick = tick;
+                        break;
+                    }
+                for (const auto &[ct, c] : byTick)
+                    if (ct == tick && stopTick == 0u)
+                        xagApply(g, c);
+            }
+            XagGainRenderer r(p, s0, 0u);
+            std::vector<int16_t> buf(2u * 960u, 1000);
+            size_t next = 0;
+            uint64_t rendered = 0;
+            while (!r.stopped() && rendered < 300u * 960u)
+            {
+                std::fill(buf.begin(), buf.end(), int16_t(1000));
+                rendered += r.process(buf.data(), 960u, [&](uint64_t k, XagVolumeCommand &c) {
+                    if (next == cmds.size() || cmds[next].position > k)
+                        return false;
+                    c = cmds[next++];
+                    return true;
+                });
+            }
+            t.IsTrue(stopTick != 0u, "the guest side stopped");
+            const uint64_t stopAtick = xagATickPosition(g.aticks);
+            t.Equals(rendered, stopAtick + kXagATickFrames, "source stops 200 frames after the same atick");
+            t.Equals(stopTick, stopAtick / 960u + 1u, "guest sees state 0 at the first field after the atick");
+            t.Equals(int(r.state().vol), int(g.vol), "same last volume");
+            t.Equals(r.state().aticks, g.aticks, "same atick count");
+        });
+        tc.Run("command FIFO is bounded, ordered and safe across threads", [](TestCase &t) {
+            XagVoiceControl full;
+            for (uint32_t i = 0; i < 100u; ++i)
+                full.post({XagVolumeCommand::Op::SetVol, int32_t(i), 0u, false, i});
+            t.Equals(full.dropped(), uint64_t(36u), "64 kept, 36 dropped");
+            std::vector<int32_t> seen;
+            full.takeGuest(10u, [&](const XagVolumeCommand &c) { seen.push_back(c.a); });
+            t.Equals(seen.size(), size_t(10u), "positions < 10");
+            t.IsTrue(seen.front() == 0 && seen.back() == 9, "in order");
+            XagVoiceControl c;
+            std::atomic<bool> done{false};
+            std::atomic<int> consumed{0};
+            int expect = 0;
+            std::thread consumer([&]() {
+                while (consumed.load() < 20000)
+                {
+                    c.takeFree([&](const XagVolumeCommand &cmd) {
+                        if (cmd.a == expect)
+                            ++expect;
+                        consumed.fetch_add(1);
+                    });
+                    std::this_thread::yield();
+                }
+            });
+            for (int i = 0; i < 20000; ++i)
+            {
+                while (true)
+                {
+                    // keep at most 32 in flight so nothing is dropped
+                    if (i - consumed.load() < 32)
+                        break;
+                    std::this_thread::yield();
+                }
+                c.post({XagVolumeCommand::Op::SetVol, i});
+                c.takeGuest(UINT64_MAX, [](const XagVolumeCommand &) {});
+            }
+            done = true;
+            consumer.join();
+            t.Equals(expect, 20000, "every command once, in order");
+            t.Equals(c.dropped(), uint64_t(0u), "no drops");
+        });
+    });
+}
