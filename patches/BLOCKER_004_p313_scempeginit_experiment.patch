+        // ============================================================
+        // P3.13 experimental ownership matrix (temporary, causal probe only).
+        // See analysis/notes/BLOCKER_004_P313_SCEMPEGINIT_OWNERSHIP_MATRIX.md.
+        // Opt-in via DMC_P313_INIT_MODE; absent/invalid -> baseline, which is
+        // byte-for-byte the current P3.12 sceMpegInit behavior (callers never
+        // invoke applyP313OwnershipMode for baseline at all). Not a production
+        // design: MODE D in particular preserves state the original's real
+        // IPU/DMA hardware reset would not have an equivalent for.
+        // ============================================================
+        enum class P313InitMode
+        {
+            Baseline,
+            Ownership,
+            Queued,
+            Full
+        };
+
+        P313InitMode parseP313InitMode()
+        {
+            const char *raw = std::getenv("DMC_P313_INIT_MODE");
+            if (!raw || !*raw)
+            {
+                return P313InitMode::Baseline;
+            }
+            const std::string mode(raw);
+            if (mode == "baseline") return P313InitMode::Baseline;
+            if (mode == "ownership") return P313InitMode::Ownership;
+            if (mode == "queued") return P313InitMode::Queued;
+            if (mode == "full") return P313InitMode::Full;
+            std::cerr << "[P313:init] INVALID DMC_P313_INIT_MODE='" << mode
+                      << "' (expected baseline|ownership|queued|full) -- using baseline"
+                      << std::endl;
+            return P313InitMode::Baseline;
+        }
+
+        const char *p313ModeName(P313InitMode mode)
+        {
+            switch (mode)
+            {
+                case P313InitMode::Baseline: return "baseline";
+                case P313InitMode::Ownership: return "ownership";
+                case P313InitMode::Queued: return "queued";
+                case P313InitMode::Full: return "full";
+            }
+            return "?";
+        }
+
+        // Builds the POST-init replacement for one playback session from its
+        // PRE-init snapshot (oldPlayback), per the selected experimental mode.
+        // Only called for ownership/queued/full -- baseline never rebuilds a
+        // session at all (matches current P3.12: the map simply stays empty
+        // after resetMpegStubStateUnlocked(), exactly as today).
+        MpegPlaybackState applyP313OwnershipMode(P313InitMode mode, MpegPlaybackState &oldPlayback)
+        {
+            MpegPlaybackState fresh = makeFreshPlaybackState();
+            // MODE B (ownership) fields: logical software-session ownership and
+            // configuration -- state the ORIGINAL sceMpegInit's real hardware
+            // reset (stack/MMIO only, see BLOCKER_004_ASTRA_P311_OVERNIGHT.md
+            // section "Hallazgo estatico: contrato ORIGINAL") never touches in
+            // guest RAM, so it has no reason to disappear from the game's own
+            // point of view. Deliberately NOT copied here (left at fresh/reset
+            // defaults for every non-baseline mode): decoder, decodedFrames,
+            // streamEnded, decoderFailed, waitingForVideoSequenceHeader,
+            // videoSequenceSyncBuffer, frameRateCode/frameRateExtensionN/D/
+            // hasFrameRateExtension, videoTimingScanBuffer, pictureIntervalQ32,
+            // nextPictureTickQ32, presentationEndTickQ32, firstPresentedPts90k,
+            // ptsPresentationBaseTickQ32 -- all codec/parser/presentation
+            // pipeline state tied to the decoder object being destroyed (see
+            // the field table in the P3.13 report for the per-field
+            // justification).
+            fresh.width = oldPlayback.width;
+            fresh.height = oldPlayback.height;
+            fresh.decodeMode = oldPlayback.decodeMode;
+            fresh.imageBufferAddr = oldPlayback.imageBufferAddr;
+            fresh.sawInput = oldPlayback.sawInput;
+            fresh.sawSequenceEnd = oldPlayback.sawSequenceEnd;
+            fresh.picturesServed = oldPlayback.picturesServed;
+            fresh.pssBuffer = oldPlayback.pssBuffer;
+            fresh.pssGuestAddrs = oldPlayback.pssGuestAddrs;
+            // fresh.cdStreamGeneration is already correct: makeFreshPlaybackState()
+            // set it from g_mpeg_stub_state.cdStreamGeneration, which by the time
+            // this runs has already been restored to its pre-reset value by
+            // sceMpegInit. Intentionally NOT copied from oldPlayback -- see the
+            // generation audit in the P3.13 report.
+
+            if (mode == P313InitMode::Queued || mode == P313InitMode::Full)
+            {
+                // MODE C: bridge only the already-decoded OUTPUT queue, not the
+                // decoder that produced it. No presentation-timing field needs
+                // to accompany it: presentationTickForFrame()'s fresh defaults
+                // (nextPictureTickQ32==max, firstPresentedPts90k<0) already make
+                // the FIRST queued frame due immediately relative to "now" --
+                // verified by reading that function, not assumed.
+                fresh.decodedFrames = oldPlayback.decodedFrames;
+            }
+
+            if (mode == P313InitMode::Full)
+            {
+                // MODE D: full continuity, including the live decoder object and
+                // every remaining codec/parser/presentation field MODE B/C leave
+                // fresh. Experimental upper bound only.
+                fresh.decoder = std::move(oldPlayback.decoder);
+                fresh.streamEnded = oldPlayback.streamEnded;
+                fresh.decoderFailed = oldPlayback.decoderFailed;
+                fresh.waitingForVideoSequenceHeader = oldPlayback.waitingForVideoSequenceHeader;
+                fresh.videoSequenceSyncBuffer = oldPlayback.videoSequenceSyncBuffer;
+                fresh.frameRateCode = oldPlayback.frameRateCode;
+                fresh.frameRateExtensionN = oldPlayback.frameRateExtensionN;
+                fresh.frameRateExtensionD = oldPlayback.frameRateExtensionD;
+                fresh.hasFrameRateExtension = oldPlayback.hasFrameRateExtension;
+                fresh.videoTimingScanBuffer = oldPlayback.videoTimingScanBuffer;
+                fresh.pictureIntervalQ32 = oldPlayback.pictureIntervalQ32;
+                fresh.nextPictureTickQ32 = oldPlayback.nextPictureTickQ32;
+                fresh.presentationEndTickQ32 = oldPlayback.presentationEndTickQ32;
+                fresh.firstPresentedPts90k = oldPlayback.firstPresentedPts90k;
+                fresh.ptsPresentationBaseTickQ32 = oldPlayback.ptsPresentationBaseTickQ32;
+            }
+
+            return fresh;
+        }
