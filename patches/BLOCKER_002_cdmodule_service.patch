diff --git a/ps2xIOP/src/modules/cdmodule.cpp b/ps2xIOP/src/modules/cdmodule.cpp
new file mode 100644
index 0000000..f851940
--- /dev/null
+++ b/ps2xIOP/src/modules/cdmodule.cpp
@@ -0,0 +1,226 @@
+#include "module_factories.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kEeRamSize = 32u * 1024u * 1024u;
+
+        // HLE for a CDMODULE.IRX-style CD read RPC (sid registered by the game via
+        // sceSifRegisterRpc, one "read" function). This is a simplification of the
+        // original IOP protocol: the real module runs a dedicated read thread
+        // (Sema_cd/Thread_cd), reads through sceCdRead into an IOP-side buffer and
+        // transfers to EE RAM via sceSifSetDma/sceSifDmaStat in a bounded loop. Here
+        // the same observable contract (bytes appear at the requested EE destination,
+        // then the RPC completes) is reproduced directly: read the requested byte
+        // range from the CD image host file and write it straight to EE RAM through
+        // the existing IopHost abstraction, without simulating IOP threads, semaphores
+        // or chunked DMA.
+        class CdModuleService final : public IopService
+        {
+        public:
+            CdModuleService(IopHost &host, CdModuleBindings bindings)
+                : m_host(host), m_bindings(std::move(bindings)), m_sids{m_bindings.sid}
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override { return m_bindings.serviceName; }
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return m_sids; }
+
+            void reset() override {}
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result;
+                if (request.sid != m_bindings.sid)
+                {
+                    return result;
+                }
+                if (request.function != m_bindings.readFunction)
+                {
+                    // Any other CDMODULE function (init, seek-only, etc.) is left to
+                    // the existing generic RPC fallback: this service only models the
+                    // read path closed in FASE I/J.
+                    return result;
+                }
+
+                if (request.send.address == 0u ||
+                    request.send.size < m_bindings.minimumRequestBytes)
+                {
+                    logWarning("malformed request (send buffer missing or too short)");
+                    return result;
+                }
+
+                uint32_t resourceId = 0u;
+                uint32_t lba = 0u;
+                uint32_t size = 0u;
+                uint32_t dest = 0u;
+                uint8_t mode = 0u;
+                if (!m_host.readGuest(request.send.address + m_bindings.requestResourceIdOffset,
+                                      &resourceId, sizeof(resourceId)) ||
+                    !m_host.readGuest(request.send.address + m_bindings.requestLbaOffset,
+                                      &lba, sizeof(lba)) ||
+                    !m_host.readGuest(request.send.address + m_bindings.requestSizeOffset,
+                                      &size, sizeof(size)) ||
+                    !m_host.readGuest(request.send.address + m_bindings.requestDestOffset,
+                                      &dest, sizeof(dest)) ||
+                    !m_host.readGuest(request.send.address + m_bindings.requestModeOffset,
+                                      &mode, sizeof(mode)))
+                {
+                    logWarning("failed to read request fields from guest memory");
+                    return result;
+                }
+
+                if (size == 0u)
+                {
+                    // Nothing to transfer; treat as a trivially completed read rather
+                    // than an error.
+                    result.handled = true;
+                    result.resultAddress = request.receive.address;
+                    writeZeroResponse(request.receive);
+                    return result;
+                }
+
+                uint32_t normalizedDest = 0u;
+                if (dest == 0u ||
+                    !m_host.normalizeGuestAddress(dest, normalizedDest) ||
+                    normalizedDest >= kEeRamSize ||
+                    size > kEeRamSize - normalizedDest)
+                {
+                    logWarning("destination address/size out of EE RAM bounds");
+                    return result;
+                }
+
+                const std::string imagePath = m_host.hostPath(HostPathKind::CdImage);
+                if (imagePath.empty())
+                {
+                    logWarning("no CD image configured (IoPaths::cdImage empty), "
+                               "cannot service real read");
+                    return result;
+                }
+
+                const uint64_t handle = m_host.openHostFile(imagePath);
+                if (handle == 0u)
+                {
+                    logWarning("failed to open CD image '" + imagePath + "'");
+                    return result;
+                }
+
+                uint64_t imageSize = 0u;
+                if (!m_host.hostFileSize(handle, imageSize))
+                {
+                    m_host.closeHostFile(handle);
+                    logWarning("failed to stat CD image '" + imagePath + "'");
+                    return result;
+                }
+
+                const uint64_t byteOffset = static_cast<uint64_t>(lba) * m_bindings.sectorSize;
+                if (byteOffset > imageSize || (imageSize - byteOffset) < size)
+                {
+                    m_host.closeHostFile(handle);
+                    logWarning("request LBA/size exceeds CD image bounds");
+                    return result;
+                }
+
+                const bool copied = copyHostRangeToGuest(handle, byteOffset, dest, size);
+                m_host.closeHostFile(handle);
+                if (!copied)
+                {
+                    logWarning("short read or guest write failure while servicing read");
+                    return result;
+                }
+
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+                writeZeroResponse(request.receive);
+
+                logSuccess(resourceId, lba, size, dest, mode);
+                return result;
+            }
+
+        private:
+            bool copyHostRangeToGuest(uint64_t handle, uint64_t offset, uint32_t destination, uint32_t byteCount)
+            {
+                std::array<uint8_t, 16 * 1024> chunk{};
+                uint32_t copied = 0u;
+                while (copied < byteCount)
+                {
+                    const size_t wanted = static_cast<size_t>(
+                        std::min<uint32_t>(static_cast<uint32_t>(chunk.size()), byteCount - copied));
+                    size_t got = 0u;
+                    if (!m_host.readHostFile(handle, offset + copied, chunk.data(), wanted, got) ||
+                        got != wanted ||
+                        !m_host.writeGuest(destination + copied, chunk.data(), wanted))
+                    {
+                        return false;
+                    }
+                    copied += static_cast<uint32_t>(wanted);
+                }
+                return true;
+            }
+
+            void writeZeroResponse(const GuestBuffer &receive) const
+            {
+                if (receive.address != 0u && receive.size != 0u)
+                {
+                    (void)m_host.zeroGuest(receive.address, std::min<uint32_t>(receive.size, 4u));
+                }
+            }
+
+            void logWarning(const std::string &message) const
+            {
+                m_host.log(LogLevel::Warning, '[' + m_bindings.serviceName + "] " + message);
+            }
+
+            void logSuccess(uint32_t resourceId, uint32_t lba, uint32_t size, uint32_t dest, uint8_t mode) const
+            {
+                std::ostringstream out;
+                out << '[' << m_bindings.serviceName << "] fno=" << m_bindings.readFunction
+                    << " resourceId=0x" << std::hex << resourceId
+                    << " lba=0x" << lba
+                    << " size=0x" << size
+                    << " dest=0x" << dest
+                    << std::dec << " mode=" << static_cast<uint32_t>(mode)
+                    << " bytesRead=0x" << std::hex << size << " status=ok";
+
+                std::array<uint8_t, 32> preview{};
+                if (m_host.readGuest(dest, preview.data(), preview.size()))
+                {
+                    out << " first32=";
+                    for (uint8_t byte : preview)
+                    {
+                        char buf[3];
+                        std::snprintf(buf, sizeof(buf), "%02x", byte);
+                        out << buf;
+                    }
+                }
+                m_host.log(LogLevel::Info, out.str());
+            }
+
+            IopHost &m_host;
+            CdModuleBindings m_bindings;
+            std::array<uint32_t, 1> m_sids;
+        };
+    }
+
+    std::unique_ptr<IopService> createCdModuleService(IopHost &host, CdModuleBindings bindings)
+    {
+        if (bindings.serviceName.empty() ||
+            bindings.sid == 0u ||
+            bindings.sectorSize == 0u)
+        {
+            return nullptr;
+        }
+        return std::make_unique<CdModuleService>(host, std::move(bindings));
+    }
+}
diff --git a/ps2xRuntime/src/main.cpp b/ps2xRuntime/src/main.cpp
