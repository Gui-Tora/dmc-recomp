         }

+        // Optional, generic (not game-specific): let ps2xIOP CD-image-backed
+        // services (see PS2Runtime::IoPaths::cdImage / ps2x::iop::IopHost)
+        // resolve a real disc image without hardcoding any path in the runtime.
+        // Unset by default; PS2Runtime::setIoPaths() leaves every other path
+        // (elfDirectory, cdRoot, mcRoot, hostRoot) untouched since they were
+        // already resolved by loadELF() above.
+        if (const char *cdImageEnv = std::getenv("PS2X_CD_IMAGE"))
+        {
+            PS2Runtime::IoPaths paths = PS2Runtime::getIoPaths();
+            paths.cdImage = std::filesystem::path(cdImageEnv);
+            PS2Runtime::setIoPaths(paths);
+        }
+
         runtime.run();

