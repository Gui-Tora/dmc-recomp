+            t.Equals(r.ownerChanges, 0u, what + ": owner of each pixel independent of the draw order");
+            if (expectedCovered)
+                t.Equals(r.covered, expectedCovered, what + ": covered pixel count");
+        };
+
+        tc.Run("adjacent_subpixel_triangles_cover_each_pixel_once", [](TestCase &t)
+        {
+            const Scissor sc;
+            const std::vector<Tri> tris = mesh(8.3125, 100.6875, 6.0625, 90.9375, 9, 7, 4.0f, 12345u);
+            exact(t, check(tris, rectangle(8.3125, 100.6875, 6.0625, 90.9375, sc), sc), 0u, "sub-pixel mesh, both windings");
+        });
+
+        tc.Run("edges_through_pixel_centres_follow_the_top_left_rule", [](TestCase &t)
+        {
+            // Horizontal, vertical and 45-degree edges through sample points: every edge pixel is an exact tie.
+            const Scissor sc;
+            const std::vector<Tri> tris = mesh(10.5, 106.5, 12.5, 108.5, 12, 12, 0.0f, 777u);
+            exact(t, check(tris, rectangle(10.5, 106.5, 12.5, 108.5, sc), sc), 96u * 96u, "mesh on pixel centres");
+            // One right triangle with its legs on pixel centres: left and top legs included, hypotenuse excluded.
+            const std::vector<Tri> one = {{{2.5f, 10.5f, 2.5f}, {2.5f, 2.5f, 10.5f}}};
+            std::vector<int> e(kW * kH, 0);
+            uint32_t n = 0;
+            for (uint32_t y = 0; y < kH; ++y)
+                for (uint32_t x = 0; x < kW; ++x)
+                    if (x >= 2u && y >= 2u && x + y < 12u)
+                    {
+                        e[y * kW + x] = 1;
+                        ++n;
+                    }
+            exact(t, check(one, e, sc), n, "single triangle on pixel centres");
+        });
+
+        tc.Run("fan_with_alternating_winding_has_no_doubles_or_gaps", [](TestCase &t)
+        {
+            const Scissor sc;
+            const float cx = 64.25f, cy = 63.75f;
+            constexpr int k = 48;
+            std::vector<std::pair<float, float>> ring;
+            for (int i = 0; i < k; ++i)
+            {
+                const double a = 2.0 * 3.14159265358979323846 * i / k;
+                ring.push_back({std::round(static_cast<float>(cx + 50.0 * std::cos(a)) * 16.0f) / 16.0f,
+                                std::round(static_cast<float>(cy + 47.0 * std::sin(a)) * 16.0f) / 16.0f});
+            }
+            std::vector<Tri> tris;
+            for (int i = 0; i < k; ++i)
+            {
+                Tri tr{{cx, ring[i].first, ring[(i + 1) % k].first}, {cy, ring[i].second, ring[(i + 1) % k].second}};
+                if (i & 1)
+                {
+                    std::swap(tr.x[1], tr.x[2]);
+                    std::swap(tr.y[1], tr.y[2]);
+                }
+                tris.push_back(tr);
+            }
+            std::vector<int> e(kW * kH, -1);
+            for (uint32_t y = 0; y < kH; ++y)
+                for (uint32_t x = 0; x < kW; ++x)
+                {
+                    int pos = 0, neg = 0;
+                    for (int i = 0; i < k; ++i)
+                    {
+                        const auto a = ring[i], b = ring[(i + 1) % k];
+                        const double s = (double(b.first) - a.first) * (y + 0.5 - a.second) -
+                                         (double(b.second) - a.second) * (x + 0.5 - a.first);
+                        pos += s > 0.0;
+                        neg += s < 0.0;
+                    }
+                    if (pos == k || neg == k)
+                        e[y * kW + x] = 1; // strictly inside the polygon
+                }
+            exact(t, check(tris, e, sc), 0u, "48-triangle fan");
+        });
+
+        tc.Run("tiny_and_degenerate_triangles", [](TestCase &t)
+        {
+            const Scissor sc;
+            const std::vector<Tri> tris = mesh(20.0625, 31.9375, 20.1875, 30.8125, 16, 16, 0.2f, 4242u);
+            exact(t, check(tris, rectangle(20.0625, 31.9375, 20.1875, 30.8125, sc), sc), 0u, "sub-pixel triangles");
+            const std::vector<Tri> collinear = {{{40.0f, 60.0f, 80.0f}, {40.0f, 50.0f, 60.0f}}};
+            const Report r = check(collinear, std::vector<int>(kW * kH, 0), sc);
+            t.Equals(r.covered, 0u, "a collinear triangle draws nothing");
+        });
+
+        tc.Run("scissor_clips_adjacent_triangles_without_doubles_or_gaps", [](TestCase &t)
+        {
+            Scissor sc;
+            sc.x0 = 21u;
+            sc.x1 = 69u;
+            sc.y0 = 15u;
+            sc.y1 = 60u;
+            const std::vector<Tri> tris = mesh(8.3125, 100.6875, 6.0625, 90.9375, 9, 7, 4.0f, 777u);
+            exact(t, check(tris, rectangle(8.3125, 100.6875, 6.0625, 90.9375, sc), sc), 0u, "scissored mesh");
+        });
+
+        tc.Run("additive_shared_edge_of_two_large_triangles_is_blended_once", [](TestCase &t)
+        {
+            // Two large adjacent triangles sharing a long, shallow edge (slope ~0.054), as in a sky dome. With an
+            // inclusive coverage test the shared edge produced a row of doubly blended (brighter) pixels.
+            const Scissor sc;
+            const float dx = 6.0f, dy = -30.0f;
+            const std::vector<Tri> tris = {
+                {{-65.0f + dx, 225.9375f + dx, 293.4375f + dx}, {47.5625f + dy, 470.125f + dy, 66.75f + dy}},
+                {{293.4375f + dx, 85.0625f + dx, -65.0f + dx}, {66.75f + dy, -368.0625f + dy, 47.5625f + dy}},
+            };
+            const double ax = -65.0 + dx, ay = 47.5625 + dy, bx = 293.4375 + dx, by = 66.75 + dy;
+            const double len = std::hypot(bx - ax, by - ay);
+            std::vector<int> e(kW * kH, -1);
+            for (uint32_t y = 0; y < kH; ++y)
+                for (uint32_t x = 0; x < kW; ++x)
+                    if (std::fabs(((bx - ax) * (y + 0.5 - ay) - (by - ay) * (x + 0.5 - ax)) / len) < 2.0)
+                        e[y * kW + x] = 1; // band around the shared edge, covered by one of the two triangles
+            exact(t, check(tris, e, sc), 0u, "shared edge of two large triangles");
+            const std::vector<uint32_t> count = render(tris, true, false, sc);
+            bool singleBlend = true;
+            for (uint32_t p = 0; p < kW * kH; ++p)
+                if (e[p] == 1 && (count[p] & 0x00FFFFFFu) != 1u)
+                    singleBlend = false;
+            t.IsTrue(singleBlend, "additive result along the shared edge is Cs + Cd once (R = 1)");
+        });
+    });
