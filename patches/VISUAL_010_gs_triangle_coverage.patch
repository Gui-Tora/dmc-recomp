+                    if (next() & 1u)
+                    {
+                        add(a, b, c);
+                        add(a, c, d);
+                    }
+                    else
+                    {
+                        add(a, b, d);
+                        add(b, c, d);
+                    }
+                }
+            return tris;
+        };
