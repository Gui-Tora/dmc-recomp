+    MiniTest::Case("PS2GSTriangleCoverage", [](TestCase &tc)
+    {
+        // Half-open (top-left) triangle coverage, as in PCSX2's GSRasterizer ([ceil(l), ceil(r)) x [ceil(t), ceil(b))
+        // at the backend's sample points): every pixel of an edge shared by two adjacent triangles is drawn exactly
+        // once, and adjacent triangles leave no gaps. Triangles go through the register path (PRIM, RGBAQ, XYZ2) into
+        // a 128x128 CT32 frame with TEST.ZTE = 0. A coverage count is drawn with additive blending (Cs * FIX / 128 + Cd,
+        // FIX = 128) of R = 1; the owner of each pixel is drawn without blending as the triangle id, in both orders.
+        struct Tri
+        {
+            float x[3];
+            float y[3];
+        };
+        constexpr uint32_t kW = 128u, kH = 128u, kFbw = kW / 64u;
+        struct Scissor
+        {
+            uint32_t x0 = 0u, x1 = kW - 1u, y0 = 0u, y1 = kH - 1u;
+        };
+        static const auto render = [](const std::vector<Tri> &tris, bool additive, bool reverse, const Scissor &sc)
+        {
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+            gs.writeRegister(GS_REG_FRAME_1, (static_cast<uint64_t>(kFbw) << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24));
+            gs.writeRegister(GS_REG_ZBUF_1, 64ull | (1ull << 32));
+            gs.writeRegister(GS_REG_SCISSOR_1, static_cast<uint64_t>(sc.x0) | (static_cast<uint64_t>(sc.x1) << 16) |
+                                                   (static_cast<uint64_t>(sc.y0) << 32) | (static_cast<uint64_t>(sc.y1) << 48));
+            // XYZ2 holds unsigned 12.4 coordinates: vertices are sent with a 1024-pixel origin and XYOFFSET removes it.
+            constexpr uint64_t kOrigin = 1024u * 16u;
+            gs.writeRegister(GS_REG_XYOFFSET_1, kOrigin | (kOrigin << 32));
+            gs.writeRegister(GS_REG_TEST_1, 0ull);
+            gs.writeRegister(GS_REG_ALPHA_1, 0x68ull | (128ull << 32)); // A = Cs, B = 0, C = FIX, D = Cd
+            gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(GS_PRIM_TRIANGLE) | (additive ? (1ull << 6) : 0ull));
+            for (size_t n = 0; n < tris.size(); ++n)
+            {
+                const size_t i = reverse ? tris.size() - 1u - n : n;
+                const uint64_t id = i + 1u;
+                const uint64_t rgba = additive ? (1ull | (0x80ull << 24))
+                                               : ((id & 0xFFu) | (((id >> 8) & 0xFFu) << 8) | (1ull << 16) | (0x80ull << 24));
+                gs.writeRegister(GS_REG_RGBAQ, rgba | (0x3F800000ull << 32));
+                for (int k = 0; k < 3; ++k)
+                    gs.writeRegister(GS_REG_XYZ2, static_cast<uint64_t>(std::lround(tris[i].x[k] * 16.0f) + kOrigin) |
+                                                      (static_cast<uint64_t>(std::lround(tris[i].y[k] * 16.0f) + kOrigin) << 16));
+            }
+            std::vector<uint32_t> out(kW * kH);
+            for (uint32_t y = 0; y < kH; ++y)
+                for (uint32_t x = 0; x < kW; ++x)
+                    out[y * kW + x] = readReferenceFramePSMCT32Pixel(vram, 0u, kFbw, x, y);
+            return out;
+        };
