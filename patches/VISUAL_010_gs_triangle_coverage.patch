+                    const bool inside = px >= x0 && px < x1 && py >= y0 && py < y1; // left and top edges inclusive
+                    e[y * kW + x] = inside && x >= sc.x0 && x <= sc.x1 && y >= sc.y0 && y <= sc.y1 ? 1 : 0;
