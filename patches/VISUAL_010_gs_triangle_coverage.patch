+        {
+            const std::vector<uint32_t> count = render(tris, true, false, sc);
+            const std::vector<uint32_t> forward = render(tris, false, false, sc);
+            const std::vector<uint32_t> backward = render(tris, false, true, sc);
+            Report r;
+            for (uint32_t p = 0; p < kW * kH; ++p)
+            {
+                const uint32_t n = count[p] & 0xFFu;
+                r.covered += n >= 1u;
+                r.doubles += n >= 2u;
+                r.holes += expected[p] == 1 && n == 0u;
+                r.extra += expected[p] == 0 && n != 0u;
+                r.ownerChanges += n == 1u && (forward[p] & 0xFFFFu) != (backward[p] & 0xFFFFu);
+            }
+            return r;
+        };
+        static const auto rectangle = [](double x0, double x1, double y0, double y1, const Scissor &sc)
