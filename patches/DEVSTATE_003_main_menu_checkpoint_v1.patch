diff --git a/ps2xIOP/src/checkpoint_bytes.h b/ps2xIOP/src/checkpoint_bytes.h
new file mode 100644
index 0000000..589f194
--- /dev/null
+++ b/ps2xIOP/src/checkpoint_bytes.h
@@ -0,0 +1,94 @@
+#pragma once
+// DEVSTATE_003C: tiny deterministic little-endian byte codec shared by IOP
+// service checkpoint implementations. Intentionally independent of
+// ps2xRuntime's checkpoint.h (ps2xIOP does not depend on ps2xRuntime).
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    inline void appendU8(std::vector<uint8_t> &out, uint8_t v) { out.push_back(v); }
+    inline void appendU16(std::vector<uint8_t> &out, uint16_t v)
+    {
+        out.push_back(static_cast<uint8_t>(v));
+        out.push_back(static_cast<uint8_t>(v >> 8));
+    }
+    inline void appendU32(std::vector<uint8_t> &out, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+    inline void appendU64(std::vector<uint8_t> &out, uint64_t v)
+    {
+        for (int i = 0; i < 8; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+    inline void appendBytes(std::vector<uint8_t> &out, const void *data, size_t size)
+    {
+        const uint8_t *p = static_cast<const uint8_t *>(data);
+        out.insert(out.end(), p, p + size);
+    }
+    inline void appendString(std::vector<uint8_t> &out, const std::string &s)
+    {
+        appendU32(out, static_cast<uint32_t>(s.size()));
+        appendBytes(out, s.data(), s.size());
+    }
+
+    inline bool readU8(const uint8_t *d, size_t size, size_t &pos, uint8_t &v)
+    {
+        if (size - pos < 1u)
+            return false;
+        v = d[pos];
+        pos += 1;
+        return true;
+    }
+    inline bool readU16(const uint8_t *d, size_t size, size_t &pos, uint16_t &v)
+    {
+        if (size - pos < 2u)
+            return false;
+        v = static_cast<uint16_t>(d[pos] | (d[pos + 1] << 8));
+        pos += 2;
+        return true;
+    }
+    inline bool readU32(const uint8_t *d, size_t size, size_t &pos, uint32_t &v)
+    {
+        if (size - pos < 4u)
+            return false;
+        v = 0;
+        for (int i = 0; i < 4; ++i)
+            v |= static_cast<uint32_t>(d[pos + i]) << (8 * i);
+        pos += 4;
+        return true;
+    }
+    inline bool readU64(const uint8_t *d, size_t size, size_t &pos, uint64_t &v)
+    {
+        if (size - pos < 8u)
+            return false;
+        v = 0;
+        for (int i = 0; i < 8; ++i)
+            v |= static_cast<uint64_t>(d[pos + i]) << (8 * i);
+        pos += 8;
+        return true;
+    }
+    inline bool readBytes(const uint8_t *d, size_t size, size_t &pos, void *out, size_t n)
+    {
+        if (size - pos < n)
+            return false;
+        std::memcpy(out, d + pos, n);
+        pos += n;
+        return true;
+    }
+    inline bool readString(const uint8_t *d, size_t size, size_t &pos, std::string &out)
+    {
+        uint32_t len = 0;
+        if (!readU32(d, size, pos, len) || size - pos < len)
+            return false;
+        out.assign(reinterpret_cast<const char *>(d + pos), len);
+        pos += len;
+        return true;
+    }
+}
