+
+    std::vector<uint8_t> CheckpointManager::serializeCore(const PS2Runtime &runtime)
+    {
+        ByteWriter w;
+        writeR5900(w, runtime.m_cpuContext);
+        writeVu1State(w, runtime.m_vu0.state());
+        writeVu1State(w, runtime.m_vu1.state());
+        return w.take();
+    }
+
+    CheckpointError CheckpointManager::deserializeCore(PS2Runtime &runtime,
+                                                       const std::vector<uint8_t> &payload)
+    {
+        ByteReader r(payload.data(), payload.size());
+        if (!readR5900(r, runtime.m_cpuContext))
+            return CheckpointError::failure("CORE: truncated R5900 context");
+        if (!readVu1State(r, runtime.m_vu0.state()))
+            return CheckpointError::failure("CORE: truncated VU0 state");
+        if (!readVu1State(r, runtime.m_vu1.state()))
+            return CheckpointError::failure("CORE: truncated VU1 state");
+        if (!r.atEnd())
+            return CheckpointError::failure("CORE: trailing bytes");
+        return CheckpointError::success();
+    }
+
+    // --- MEM ---------------------------------------------------------------
+    namespace
+    {
+        template <typename ArenaT>
+        void writeArena(ByteWriter &w, const ArenaT &a)
+        {
+            w.u32(a.base);
+            w.u32(a.end);
+            w.u32(a.limit);
+            w.u32(a.suggestedBase);
+            w.u8(a.configured ? 1u : 0u);
+            w.u8(a.unavailable ? 1u : 0u);
+            w.u32(static_cast<uint32_t>(a.blocks.size()));
+            for (const auto &b : a.blocks)
+            {
+                w.u32(b.addr);
+                w.u32(b.size);
+                w.u8(b.free ? 1u : 0u);
+            }
+        }
+
+        template <typename ArenaT>
+        bool readArena(ByteReader &r, ArenaT &a)
+        {
+            uint8_t b8 = 0;
+            uint32_t count = 0;
+            bool ok = r.u32(a.base) && r.u32(a.end) && r.u32(a.limit) &&
+                      r.u32(a.suggestedBase);
+            ok = ok && r.u8(b8);
+            a.configured = b8 != 0;
+            ok = ok && r.u8(b8);
+            a.unavailable = b8 != 0;
+            ok = ok && r.u32(count);
+            if (!ok || count > 1000000u)
+                return false;
+            a.blocks.clear();
+            a.blocks.reserve(count);
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                typename std::decay_t<decltype(a.blocks)>::value_type blk;
+                if (!r.u32(blk.addr) || !r.u32(blk.size) || !r.u8(b8))
+                    return false;
+                blk.free = b8 != 0;
+                a.blocks.push_back(blk);
+            }
+            return true;
+        }
+
+        struct MemRegionDesc
+        {
+            uint32_t tag;
+            uint64_t size;
+            uint8_t *data;
+        };
+
+        std::vector<MemRegionDesc> memRegions(const PS2Runtime &rt)
+        {
+            PS2Memory &mem = const_cast<PS2Runtime &>(rt).memory();
+            return {
+                {1u, PS2_RAM_SIZE, mem.m_rdram},
+                {2u, PS2_SCRATCHPAD_SIZE, mem.m_scratchpad},
+                {3u, 2u * 1024u * 1024u, mem.iop_ram},
+                {4u, PS2_VU0_CODE_SIZE, mem.m_vu0Code},
+                {5u, PS2_VU0_DATA_SIZE, mem.m_vu0Data},
+                {6u, PS2_VU1_CODE_SIZE, mem.m_vu1Code},
+                {7u, PS2_VU1_DATA_SIZE, mem.m_vu1Data},
+                {8u, PS2_GS_VRAM_SIZE, mem.m_gsVRAM},
+            };
+        }
+    }
+
+    std::vector<uint8_t> CheckpointManager::serializeMem(const PS2Runtime &runtime)
+    {
+        ByteWriter w;
+        const auto regions = memRegions(runtime);
+        w.u32(static_cast<uint32_t>(regions.size()));
+        for (const MemRegionDesc &reg : regions)
+        {
+            w.u32(reg.tag);
+            w.u64(reg.size);
+            w.bytes(reg.data, reg.size);
+        }
+        writeArena(w, runtime.m_gameHeapState);
+        writeArena(w, runtime.m_runtimeArena);
+        w.u32(static_cast<uint32_t>(runtime.m_loadedModules.size()));
+        for (const auto &mod : runtime.m_loadedModules)
+        {
+            w.u32(static_cast<uint32_t>(mod.name.size()));
+            w.bytes(mod.name.data(), mod.name.size());
+            w.u32(mod.baseAddress);
+            w.u64(static_cast<uint64_t>(mod.size));
+            w.u8(mod.active ? 1u : 0u);
+        }
+        return w.take();
+    }
+
+    CheckpointError CheckpointManager::deserializeMem(PS2Runtime &runtime,
+                                                      const std::vector<uint8_t> &payload)
+    {
+        ByteReader r(payload.data(), payload.size());
+        uint32_t regionCount = 0;
+        if (!r.u32(regionCount))
+            return CheckpointError::failure("MEM: missing region count");
+        auto regions = memRegions(runtime);
+        if (regionCount != regions.size())
+            return CheckpointError::failure("MEM: region count mismatch");
+        for (MemRegionDesc &reg : regions)
+        {
+            uint32_t tag = 0;
+            uint64_t size = 0;
+            if (!r.u32(tag) || !r.u64(size))
+                return CheckpointError::failure("MEM: truncated region header");
+            if (tag != reg.tag || size != reg.size)
+                return CheckpointError::failure("MEM: region tag/size mismatch");
+            if (!r.bytes(reg.data, static_cast<size_t>(size)))
+                return CheckpointError::failure("MEM: truncated region data");
+        }
+        if (!readArena(r, runtime.m_gameHeapState))
+            return CheckpointError::failure("MEM: bad game heap arena");
+        if (!readArena(r, runtime.m_runtimeArena))
+            return CheckpointError::failure("MEM: bad runtime arena");
+        uint32_t moduleCount = 0;
+        if (!r.u32(moduleCount) || moduleCount > 4096u)
+            return CheckpointError::failure("MEM: bad module count");
+        runtime.m_loadedModules.clear();
+        for (uint32_t i = 0; i < moduleCount; ++i)
+        {
+            uint32_t nameLen = 0;
+            if (!r.u32(nameLen) || nameLen > 4096u)
+                return CheckpointError::failure("MEM: bad module name length");
+            std::string name(nameLen, '\0');
+            uint64_t size = 0;
+            uint8_t active = 0;
+            uint32_t base = 0;
+            if (!r.bytes(name.data(), nameLen) || !r.u32(base) || !r.u64(size) || !r.u8(active))
+                return CheckpointError::failure("MEM: truncated module entry");
+            runtime.m_loadedModules.push_back(
+                {std::move(name), base, static_cast<size_t>(size), active != 0});
+        }
+        if (!r.atEnd())
+            return CheckpointError::failure("MEM: trailing bytes");
+        return CheckpointError::success();
+    }
+
+    // --- MMIO ---------------------------------------------------------------
+    std::vector<uint8_t> CheckpointManager::serializeMmio(const PS2Runtime &runtime)
+    {
+        PS2Memory &mem = const_cast<PS2Runtime &>(runtime).memory();
+        ByteWriter w;
+
+        // io registers, sorted by key for determinism
+        {
+            std::map<uint32_t, uint32_t> sorted(mem.m_ioRegisters.begin(),
+                                                mem.m_ioRegisters.end());
+            w.u32(static_cast<uint32_t>(sorted.size()));
+            for (const auto &kv : sorted)
+            {
+                w.u32(kv.first);
+                w.u32(kv.second);
+            }
+        }
+
+        // DMA channels (padding-free per static_assert in ps2_memory.h)
+        for (int i = 0; i < 10; ++i)
+        {
+            const DMARegisters &d = mem.dma_regs[i];
+            w.u32(d.chcr);
+            w.u32(d.madr);
+            w.u32(d.qwc);
+            w.u32(d.tadr);
+            w.u32(d.asr0);
+            w.u32(d.asr1);
+            w.u32(d.sadr);
+        }
+
+        // VIF0/VIF1 register blocks, field-by-field via raw u32 span: the
+        // structs are all-u32 (ps2_memory.h:219-240 static layout).
+        static_assert(sizeof(VIFRegisters) % sizeof(uint32_t) == 0,
+                      "VIFRegisters must remain all-u32");
+        auto writeVif = [&w](const VIFRegisters &v)
+        {
+            const uint32_t *words = reinterpret_cast<const uint32_t *>(&v);
+            for (size_t i = 0; i < sizeof(VIFRegisters) / 4u; ++i)
+                w.u32(words[i]);
+        };
+        writeVif(mem.vif0_regs);
+        writeVif(mem.vif1_regs);
+
+        // GS privileged registers (atomics by value)
+        {
+            const GSRegisters &g = mem.gs_regs;
+            w.u64(g.pmode);
+            w.u64(g.smode1);
+            w.u64(g.smode2);
+            w.u64(g.srfsh);
+            w.u64(g.synch1);
+            w.u64(g.synch2);
+            w.u64(g.syncv);
+            w.u64(g.dispfb1);
+            w.u64(g.display1);
+            w.u64(g.dispfb2);
+            w.u64(g.display2);
+            w.u64(g.extbuf);
+            w.u64(g.extdata);
+            w.u64(g.extwrite);
+            w.u64(g.bgcolor);
+            w.u64(g.csr.load(std::memory_order_acquire));
+            w.u64(g.vsyncTick.load(std::memory_order_acquire));
+            w.u64(g.imr);
+            w.u64(g.busdir);
+            w.u64(g.siglblid);
+        }
+
+        // TLB
+        w.u32(static_cast<uint32_t>(mem.m_tlbEntries.size()));
+        for (const auto &t : mem.m_tlbEntries)
+        {
+            w.u32(t.vpn);
+            w.u32(t.pfn);
+            w.u32(t.mask);
+            w.u8(t.valid ? 1u : 0u);
+        }
+
+        // EE timers (DEVSTATE_003A UNKNOWN-2 closure: fractional accumulator
+        // clockRemainder lives here, outside m_ioRegisters)
+        for (const auto &t : mem.m_eeTimers)
+        {
+            w.u32(t.count);
+            w.u32(t.mode);
+            w.u32(t.compare);
+            w.u32(t.hold);
+            w.u64(t.clockRemainder);
+        }
+
+        // path3 mask / VIF1 pending PATH2 bookkeeping
+        w.u8(mem.m_path3Masked ? 1u : 0u);
+        w.u32(mem.m_vif1PendingPath2ImageQwc);
+        w.u8(mem.m_vif1PendingPath2DirectHl ? 1u : 0u);
+        w.u32(static_cast<uint32_t>(mem.m_path3MaskedFifo.size()));
+        for (const auto &pkt : mem.m_path3MaskedFifo)
+        {
+            w.u32(static_cast<uint32_t>(pkt.size()));
+            w.bytes(pkt.data(), pkt.size());
+        }
+
+        // semantic counters / generations
+        w.u8(mem.m_seenGifCopy ? 1u : 0u);
+        w.u64(mem.m_dmaStartCount.load(std::memory_order_relaxed));
+        w.u64(mem.m_gifCopyCount.load(std::memory_order_relaxed));
+        w.u64(mem.m_gsWriteCount.load(std::memory_order_relaxed));
+        w.u64(mem.m_vifWriteCount.load(std::memory_order_relaxed));
+        w.u64(mem.m_vu0CodeGeneration.load(std::memory_order_relaxed));
+        w.u64(mem.m_vu1CodeGeneration.load(std::memory_order_relaxed));
+
+        // code regions (modified-bitmap included)
+        w.u32(static_cast<uint32_t>(mem.m_codeRegions.size()));
+        for (const auto &cr : mem.m_codeRegions)
+        {
+            w.u32(cr.start);
+            w.u32(cr.end);
+            w.u32(static_cast<uint32_t>(cr.modified.size()));
+            for (size_t i = 0; i < cr.modified.size(); ++i)
+                w.u8(cr.modified[i] ? 1u : 0u);
+        }
+
+        return w.take();
+    }
+
+    CheckpointError CheckpointManager::deserializeMmio(PS2Runtime &runtime,
+                                                       const std::vector<uint8_t> &payload)
+    {
+        PS2Memory &mem = runtime.memory();
+        ByteReader r(payload.data(), payload.size());
+        uint8_t b8 = 0;
+
+        uint32_t ioCount = 0;
+        if (!r.u32(ioCount) || ioCount > 1000000u)
+            return CheckpointError::failure("MMIO: bad io register count");
+        mem.m_ioRegisters.clear();
+        for (uint32_t i = 0; i < ioCount; ++i)
+        {
+            uint32_t k = 0, v = 0;
+            if (!r.u32(k) || !r.u32(v))
+                return CheckpointError::failure("MMIO: truncated io registers");
+            mem.m_ioRegisters[k] = v;
+        }
+
+        for (int i = 0; i < 10; ++i)
+        {
+            DMARegisters &d = mem.dma_regs[i];
+            if (!r.u32(d.chcr) || !r.u32(d.madr) || !r.u32(d.qwc) || !r.u32(d.tadr) ||
+                !r.u32(d.asr0) || !r.u32(d.asr1) || !r.u32(d.sadr))
+                return CheckpointError::failure("MMIO: truncated dma regs");
+        }
+
+        auto readVif = [&r](VIFRegisters &v) -> bool
+        {
+            uint32_t *words = reinterpret_cast<uint32_t *>(&v);
+            for (size_t i = 0; i < sizeof(VIFRegisters) / 4u; ++i)
+                if (!r.u32(words[i]))
+                    return false;
+            return true;
+        };
+        if (!readVif(mem.vif0_regs) || !readVif(mem.vif1_regs))
+            return CheckpointError::failure("MMIO: truncated vif regs");
+
+        {
+            GSRegisters &g = mem.gs_regs;
+            uint64_t csr = 0, vsync = 0;
+            bool ok = r.u64(g.pmode) && r.u64(g.smode1) && r.u64(g.smode2) && r.u64(g.srfsh) &&
+                      r.u64(g.synch1) && r.u64(g.synch2) && r.u64(g.syncv) && r.u64(g.dispfb1) &&
+                      r.u64(g.display1) && r.u64(g.dispfb2) && r.u64(g.display2) &&
+                      r.u64(g.extbuf) && r.u64(g.extdata) && r.u64(g.extwrite) &&
+                      r.u64(g.bgcolor) && r.u64(csr) && r.u64(vsync) && r.u64(g.imr) &&
+                      r.u64(g.busdir) && r.u64(g.siglblid);
+            if (!ok)
+                return CheckpointError::failure("MMIO: truncated gs regs");
+            g.csr.store(csr, std::memory_order_release);
+            g.vsyncTick.store(vsync, std::memory_order_release);
+        }
+
+        uint32_t tlbCount = 0;
+        if (!r.u32(tlbCount) || tlbCount > 4096u)
+            return CheckpointError::failure("MMIO: bad tlb count");
+        mem.m_tlbEntries.clear();
+        for (uint32_t i = 0; i < tlbCount; ++i)
+        {
+            PS2Memory::TLBEntry t{};
+            if (!r.u32(t.vpn) || !r.u32(t.pfn) || !r.u32(t.mask) || !r.u8(b8))
+                return CheckpointError::failure("MMIO: truncated tlb");
+            t.valid = b8 != 0;
+            mem.m_tlbEntries.push_back(t);
+        }
+
+        for (auto &t : mem.m_eeTimers)
+        {
+            if (!r.u32(t.count) || !r.u32(t.mode) || !r.u32(t.compare) || !r.u32(t.hold) ||
+                !r.u64(t.clockRemainder))
+                return CheckpointError::failure("MMIO: truncated ee timers");
+        }
+
+        if (!r.u8(b8))
+            return CheckpointError::failure("MMIO: truncated path3 flag");
+        mem.m_path3Masked = b8 != 0;
+        if (!r.u32(mem.m_vif1PendingPath2ImageQwc) || !r.u8(b8))
+            return CheckpointError::failure("MMIO: truncated vif1 pending");
+        mem.m_vif1PendingPath2DirectHl = b8 != 0;
+        uint32_t fifoCount = 0;
+        if (!r.u32(fifoCount) || fifoCount > 65536u)
+            return CheckpointError::failure("MMIO: bad path3 fifo count");
+        mem.m_path3MaskedFifo.clear();
+        for (uint32_t i = 0; i < fifoCount; ++i)
+        {
+            uint32_t len = 0;
+            if (!r.u32(len) || len > (64u << 20))
+                return CheckpointError::failure("MMIO: bad path3 packet length");
+            std::vector<uint8_t> pkt(len);
+            if (!r.bytes(pkt.data(), len))
+                return CheckpointError::failure("MMIO: truncated path3 packet");
+            mem.m_path3MaskedFifo.push_back(std::move(pkt));
+        }
+
+        if (!r.u8(b8))
+            return CheckpointError::failure("MMIO: truncated seenGifCopy");
+        mem.m_seenGifCopy = b8 != 0;
+        uint64_t v64 = 0;
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_dmaStartCount.store(v64, std::memory_order_relaxed);
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_gifCopyCount.store(v64, std::memory_order_relaxed);
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_gsWriteCount.store(v64, std::memory_order_relaxed);
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_vifWriteCount.store(v64, std::memory_order_relaxed);
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_vu0CodeGeneration.store(v64, std::memory_order_relaxed);
+        if (!r.u64(v64))
+            return CheckpointError::failure("MMIO: truncated counters");
+        mem.m_vu1CodeGeneration.store(v64, std::memory_order_relaxed);
+
+        uint32_t regionCount = 0;
+        if (!r.u32(regionCount) || regionCount > 65536u)
+            return CheckpointError::failure("MMIO: bad code region count");
+        mem.m_codeRegions.clear();
+        for (uint32_t i = 0; i < regionCount; ++i)
+        {
+            PS2Memory::CodeRegion cr{};
+            uint32_t bits = 0;
+            if (!r.u32(cr.start) || !r.u32(cr.end) || !r.u32(bits) || bits > (32u << 20))
+                return CheckpointError::failure("MMIO: truncated code region");
+            cr.modified.resize(bits);
+            for (uint32_t j = 0; j < bits; ++j)
+            {
+                if (!r.u8(b8))
+                    return CheckpointError::failure("MMIO: truncated modified bitmap");
+                cr.modified[j] = b8 != 0;
+            }
+            mem.m_codeRegions.push_back(std::move(cr));
+        }
+
+        if (!r.atEnd())
+            return CheckpointError::failure("MMIO: trailing bytes");
+
+        // v1 contract: the four private transfer queues start empty (design
+        // §4/§14). They are validated empty at SAVE and never serialized.
+        mem.m_pendingGifTransfers.clear();
+        mem.m_pendingVif0Transfers.clear();
+        mem.m_pendingVif1Transfers.clear();
+        {
+            std::lock_guard<std::mutex> lock(mem.m_completedDmacMutex);
+            mem.m_completedDmacCauses.clear();
+        }
+        return CheckpointError::success();
+    }
+
+    // --- SCHED / GS sections (DEVSTATE_003B) --------------------------------
+    CheckpointError CheckpointManager::serializeSched(PS2Runtime &runtime,
+                                                      std::vector<uint8_t> &out)
+    {
+        ByteWriter w;
+        std::string err;
+        if (!runtime.eeScheduler().serializeCheckpointState(w, err))
+            return CheckpointError::failure("SCHED serialize: " + err);
+        // Coherence gate: scheduler vsyncTick is authoritative and must match
+        // the GS privileged register mirror at the boundary (design PARTE 2).
+        const uint64_t gsTick =
+            runtime.memory().gs().vsyncTick.load(std::memory_order_acquire);
+        const uint64_t schedTick =
+            runtime.eeScheduler().collectCheckpointQuiescence().vsyncTick;
+        if (gsTick != schedTick)
+            return CheckpointError::failure(
+                "SCHED serialize: vsyncTick mismatch scheduler=" +
+                std::to_string(schedTick) + " gs=" + std::to_string(gsTick));
+        out = w.take();
+        return CheckpointError::success();
+    }
+
+    CheckpointError CheckpointManager::deserializeSched(PS2Runtime &runtime,
+                                                        const std::vector<uint8_t> &payload)
+    {
+        ByteReader r(payload.data(), payload.size());
+        std::string err;
+        if (!runtime.eeScheduler().deserializeCheckpointState(r, err))
+            return CheckpointError::failure("SCHED deserialize: " + err);
+        if (!r.atEnd())
+            return CheckpointError::failure("SCHED: trailing bytes");
+        // Restore the authoritative vsyncTick into the GS privileged mirror
+        // (MMIO already wrote it; this re-asserts coherence from the
+        // authoritative source).
+        const uint64_t schedTick =
+            runtime.eeScheduler().collectCheckpointQuiescence().vsyncTick;
+        runtime.memory().gs().vsyncTick.store(schedTick, std::memory_order_release);
+        return CheckpointError::success();
+    }
