     {
     }
 
+    bool IopSubsystem::serializeCheckpointState(std::vector<uint8_t> &out, std::string &error) const
+    {
+        out.clear();
+        std::string reason;
+        if (!validateCheckpointSafe(reason))
+        {
+            error = reason;
+            return false;
+        }
+        uint32_t countOffset = static_cast<uint32_t>(out.size());
+        detail::appendU32(out, 0u); // placeholder service count
+        uint32_t count = 0u;
+        auto appendList = [&](const detail::ServiceList &list)
+        {
+            for (const auto &svc : list)
+            {
+                if (!svc)
+                    continue;
+                const std::string_view name = svc->name();
+                detail::appendU16(out, static_cast<uint16_t>(name.size()));
+                out.insert(out.end(), name.begin(), name.end());
+                std::vector<uint8_t> payload;
+                svc->serializeCheckpointState(payload);
+                detail::appendU32(out, static_cast<uint32_t>(payload.size()));
+                out.insert(out.end(), payload.begin(), payload.end());
+                ++count;
+            }
+        };
+        appendList(m_impl->coreServices);
+        appendList(m_impl->profileServices);
+        // patch the placeholder (little-endian, matches putU32 byte order)
+        out[countOffset + 0] = static_cast<uint8_t>(count);
+        out[countOffset + 1] = static_cast<uint8_t>(count >> 8);
+        out[countOffset + 2] = static_cast<uint8_t>(count >> 16);
+        out[countOffset + 3] = static_cast<uint8_t>(count >> 24);
+        return true;
+    }
+
+    bool IopSubsystem::deserializeCheckpointState(const std::vector<uint8_t> &payload, std::string &error)
+    {
+        const uint8_t *d = payload.data();
+        const size_t size = payload.size();
+        size_t pos = 0;
+        uint32_t count = 0;
+        if (!detail::readU32(d, size, pos, count))
+        {
+            error = "IOP: truncated service count";
+            return false;
+        }
+        // Build a name -> service lookup over the currently configured
+        // services (already created by configure(), per the cold-load
+        // order -- this call never creates/destroys services).
+        std::unordered_map<std::string, detail::IopService *> byName;
+        for (auto &svc : m_impl->coreServices)
+            if (svc)
+                byName.emplace(std::string(svc->name()), svc.get());
+        for (auto &svc : m_impl->profileServices)
+            if (svc)
+                byName.emplace(std::string(svc->name()), svc.get());
+
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            uint16_t nameLen = 0;
+            if (!detail::readU16(d, size, pos, nameLen) || size - pos < nameLen)
+            {
+                error = "IOP: truncated service name";
+                return false;
+            }
+            std::string name(reinterpret_cast<const char *>(d + pos), nameLen);
+            pos += nameLen;
+            uint32_t payloadLen = 0;
+            if (!detail::readU32(d, size, pos, payloadLen) || size - pos < payloadLen)
+            {
+                error = "IOP: truncated service payload";
+                return false;
+            }
+            auto it = byName.find(name);
+            if (it == byName.end())
+            {
+                error = "IOP: checkpoint references unknown/unconfigured service '" + name + "'";
+                return false;
+            }
+            size_t consumed = 0;
+            std::string svcError;
+            if (!it->second->deserializeCheckpointState(d + pos, payloadLen, consumed, svcError))
+            {
+                error = "IOP: service '" + name + "' restore failed: " + svcError;
+                return false;
+            }
+            if (consumed != payloadLen)
+            {
+                error = "IOP: service '" + name + "' consumed " + std::to_string(consumed) +
+                        " of " + std::to_string(payloadLen) + " declared bytes";
+                return false;
+            }
+            pos += payloadLen;
+        }
+        if (pos != size)
+        {
+            error = "IOP: trailing bytes after all services";
+            return false;
+        }
+        return true;
+    }
+
+    bool IopSubsystem::validateCheckpointSafe(std::string &reason) const
+    {
+        for (const auto &svc : m_impl->coreServices)
+        {
+            if (svc && !svc->validateCheckpointSafe(reason))
+            {
+                reason = std::string(svc->name()) + ": " + reason;
+                return false;
+            }
+        }
+        for (const auto &svc : m_impl->profileServices)
+        {
+            if (svc && !svc->validateCheckpointSafe(reason))
+            {
+                reason = std::string(svc->name()) + ": " + reason;
+                return false;
+            }
+        }
+        return true;
+    }
+
     IopSubsystem::~IopSubsystem() = default;
     IopSubsystem::IopSubsystem(IopSubsystem &&) noexcept = default;
     IopSubsystem &IopSubsystem::operator=(IopSubsystem &&) noexcept = default;
