+    // DEVSTATE_003C: v1-complete required section set (12 sections). A
+    // checkpoint missing any of these (e.g. the 5-section DEVSTATE_003B
+    // artifact) must be rejected explicitly, not partially restored.
+    inline constexpr SectionId kRequiredSectionsV1[] = {
+        SectionId::Core,  SectionId::Mem,    SectionId::Mmio, SectionId::Gs,
+        SectionId::Sched, SectionId::Iop,    SectionId::SifRpc, SectionId::Cd,
