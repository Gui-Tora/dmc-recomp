+    void writePrim(ByteWriter &w, const GSPrimReg &p)
+    {
+        w.u8(static_cast<uint8_t>(p.type));
+        w.u8(p.iip ? 1u : 0u);
+        w.u8(p.tme ? 1u : 0u);
+        w.u8(p.fge ? 1u : 0u);
+        w.u8(p.abe ? 1u : 0u);
+        w.u8(p.aa1 ? 1u : 0u);
+        w.u8(p.fst ? 1u : 0u);
+        w.u8(p.ctxt ? 1u : 0u);
+        w.u8(p.fix ? 1u : 0u);
+    }
+    bool readPrim(ByteReader &r, GSPrimReg &p)
+    {
+        uint8_t v = 0;
+        if (!r.u8(v))
+            return false;
+        p.type = static_cast<GSPrimType>(v);
+        auto rb = [&r](bool &b) {
+            uint8_t x = 0;
+            if (!r.u8(x))
+                return false;
+            b = x != 0;
+            return true;
+        };
+        return rb(p.iip) && rb(p.tme) && rb(p.fge) && rb(p.abe) && rb(p.aa1) &&
+               rb(p.fst) && rb(p.ctxt) && rb(p.fix);
+    }
+
+    void writeContext(ByteWriter &w, const GSContext &c)
+    {
+        w.u32(c.frame.fbp);
+        w.u32(c.frame.fbw);
+        w.u8(c.frame.psm);
+        w.u32(c.frame.fbmsk);
+        w.u16(c.scissor.x0);
+        w.u16(c.scissor.x1);
+        w.u16(c.scissor.y0);
+        w.u16(c.scissor.y1);
+        w.u32(c.tex0.tbp0);
+        w.u8(c.tex0.tbw);
+        w.u8(c.tex0.psm);
+        w.u8(c.tex0.tw);
+        w.u8(c.tex0.th);
+        w.u8(c.tex0.tcc);
+        w.u8(c.tex0.tfx);
+        w.u32(c.tex0.cbp);
+        w.u8(c.tex0.cpsm);
+        w.u8(c.tex0.csm);
+        w.u8(c.tex0.csa);
+        w.u8(c.tex0.cld);
+        w.u16(c.xyoffset.ofx);
+        w.u16(c.xyoffset.ofy);
+        w.u32(c.zbuf.zbp);
+        w.u8(c.zbuf.psm);
+        w.u8(c.zbuf.zmask ? 1u : 0u);
+        w.u64(c.tex1);
+        w.u64(c.miptbp1);
+        w.u64(c.miptbp2);
+        w.u64(c.clamp);
+        w.u64(c.alpha);
+        w.u64(c.test);
+        w.u64(c.fba);
+    }
+    bool readContext(ByteReader &r, GSContext &c)
+    {
+        uint8_t v8 = 0;
+        bool ok = r.u32(c.frame.fbp) && r.u32(c.frame.fbw) && r.u8(c.frame.psm) &&
+                  r.u32(c.frame.fbmsk) && r.u16(c.scissor.x0) && r.u16(c.scissor.x1) &&
+                  r.u16(c.scissor.y0) && r.u16(c.scissor.y1) && r.u32(c.tex0.tbp0) &&
+                  r.u8(c.tex0.tbw) && r.u8(c.tex0.psm) && r.u8(c.tex0.tw) && r.u8(c.tex0.th) &&
+                  r.u8(c.tex0.tcc) && r.u8(c.tex0.tfx) && r.u32(c.tex0.cbp) &&
+                  r.u8(c.tex0.cpsm) && r.u8(c.tex0.csm) && r.u8(c.tex0.csa) &&
+                  r.u8(c.tex0.cld) && r.u16(c.xyoffset.ofx) && r.u16(c.xyoffset.ofy) &&
+                  r.u32(c.zbuf.zbp) && r.u8(c.zbuf.psm);
+        if (!ok || !r.u8(v8))
+            return false;
+        c.zbuf.zmask = v8 != 0;
+        return r.u64(c.tex1) && r.u64(c.miptbp1) && r.u64(c.miptbp2) && r.u64(c.clamp) &&
+               r.u64(c.alpha) && r.u64(c.test) && r.u64(c.fba);
+    }
+
+    void writeVertex(ByteWriter &w, const GSVertex &v)
+    {
+        w.f32(v.x);
+        w.f32(v.y);
+        uint64_t zbits = 0;
+        static_assert(sizeof(zbits) == sizeof(v.z), "z width");
+        std::memcpy(&zbits, &v.z, sizeof(zbits));
+        w.u64(zbits);
+        w.u8(v.r);
+        w.u8(v.g);
+        w.u8(v.b);
+        w.u8(v.a);
+        w.f32(v.q);
+        w.f32(v.s);
+        w.f32(v.t);
+        w.u16(v.u);
+        w.u16(v.v);
+        w.u8(v.fog);
+    }
+    bool readVertex(ByteReader &r, GSVertex &v)
+    {
+        uint64_t zbits = 0;
+        bool ok = r.f32(v.x) && r.f32(v.y) && r.u64(zbits) && r.u8(v.r) && r.u8(v.g) &&
+                  r.u8(v.b) && r.u8(v.a) && r.f32(v.q) && r.f32(v.s) && r.f32(v.t) &&
+                  r.u16(v.u) && r.u16(v.v) && r.u8(v.fog);
+        if (ok)
+            std::memcpy(&v.z, &zbits, sizeof(v.z));
+        return ok;
+    }
+}
+
+bool GS::checkpointIdle(std::string &reason) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_vtxCount != 0)
+    {
+        reason = "GS vertex queue holds a half-submitted primitive";
+        return false;
+    }
+    if (m_backend)
+    {
+        const GSTransferSnapshot t = m_backend->GetTransferSnapshot();
+        if (t.direction == 0u && t.copiedPixels < t.totalPixels)
+        {
+            reason = "GS host->local transfer partially complete";
+            return false;
+        }
+        if (t.localToHostPendingBytes != 0u)
+        {
+            reason = "GS local->host buffer not fully consumed";
+            return false;
+        }
+    }
+    return true;
+}
+
+bool GS::serializeCheckpointState(ps2x::checkpoint::ByteWriter &w,
+                                  std::string &error) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    std::string idleReason;
+    if (!checkpointIdle(idleReason))
+    {
+        error = idleReason;
+        return false;
+    }
+
+    writeContext(w, m_ctx[0]);
+    writeContext(w, m_ctx[1]);
+    writePrim(w, m_prim);
+    writePrim(w, m_primRegister);
+    writePrim(w, m_prmodeRegister);
+    w.u8(m_curR);
+    w.u8(m_curG);
+    w.u8(m_curB);
+    w.u8(m_curA);
+    w.f32(m_curQ);
+    w.f32(m_curS);
+    w.f32(m_curT);
+    w.u16(m_curU);
+    w.u16(m_curV);
+    w.u8(m_curFog);
+    w.u8(m_fogR);
+    w.u8(m_fogG);
+    w.u8(m_fogB);
+    w.u8(m_prmodecont ? 1u : 0u);
+    w.u8(m_pabe ? 1u : 0u);
+    w.u64(m_scanmsk);
+    w.u64(m_dimx);
+    w.u64(m_dthe);
+    w.u64(m_colclamp);
+    w.u8(m_texa.ta0);
+    w.u8(m_texa.aem ? 1u : 0u);
+    w.u8(m_texa.ta1);
+    w.u8(m_texclut.cbw);
+    w.u8(m_texclut.cou);
+    w.u16(m_texclut.cov);
+    w.u32(m_bitbltbuf.sbp);
+    w.u8(m_bitbltbuf.sbw);
+    w.u8(m_bitbltbuf.spsm);
+    w.u32(m_bitbltbuf.dbp);
+    w.u8(m_bitbltbuf.dbw);
+    w.u8(m_bitbltbuf.dpsm);
+    w.u16(m_trxpos.ssax);
+    w.u16(m_trxpos.ssay);
+    w.u16(m_trxpos.dsax);
+    w.u16(m_trxpos.dsay);
+    w.u8(m_trxpos.dir);
+    w.u16(m_trxreg.rrw);
+    w.u16(m_trxreg.rrh);
+    w.u32(m_trxdir);
+    w.u32(static_cast<uint32_t>(m_vtxCount));
+    w.u32(static_cast<uint32_t>(m_vtxIndex));
+    for (int i = 0; i < kMaxVerts; ++i)
+        writeVertex(w, m_vtxQueue[i]);
+    w.u32(m_lastDisplayBaseBytes);
+    return true;
+}
+
+bool GS::deserializeCheckpointState(ps2x::checkpoint::ByteReader &r,
+                                    std::string &error)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    auto fail = [&error](const char *what) {
+        error = what;
+        return false;
+    };
+    uint8_t v8 = 0;
+    if (!readContext(r, m_ctx[0]) || !readContext(r, m_ctx[1]))
+        return fail("GS: truncated contexts");
+    if (!readPrim(r, m_prim) || !readPrim(r, m_primRegister) || !readPrim(r, m_prmodeRegister))
+        return fail("GS: truncated prim regs");
+    if (!r.u8(m_curR) || !r.u8(m_curG) || !r.u8(m_curB) || !r.u8(m_curA) ||
+        !r.f32(m_curQ) || !r.f32(m_curS) || !r.f32(m_curT) || !r.u16(m_curU) ||
+        !r.u16(m_curV) || !r.u8(m_curFog) || !r.u8(m_fogR) || !r.u8(m_fogG) || !r.u8(m_fogB))
+        return fail("GS: truncated current regs");
+    if (!r.u8(v8))
+        return fail("GS: truncated prmodecont");
+    m_prmodecont = v8 != 0;
+    if (!r.u8(v8))
+        return fail("GS: truncated pabe");
+    m_pabe = v8 != 0;
+    if (!r.u64(m_scanmsk) || !r.u64(m_dimx) || !r.u64(m_dthe) || !r.u64(m_colclamp))
+        return fail("GS: truncated global regs");
+    if (!r.u8(m_texa.ta0) || !r.u8(v8))
+        return fail("GS: truncated texa");
+    m_texa.aem = v8 != 0;
+    if (!r.u8(m_texa.ta1) || !r.u8(m_texclut.cbw) || !r.u8(m_texclut.cou) ||
+        !r.u16(m_texclut.cov))
+        return fail("GS: truncated texclut");
+    if (!r.u32(m_bitbltbuf.sbp) || !r.u8(m_bitbltbuf.sbw) || !r.u8(m_bitbltbuf.spsm) ||
+        !r.u32(m_bitbltbuf.dbp) || !r.u8(m_bitbltbuf.dbw) || !r.u8(m_bitbltbuf.dpsm))
+        return fail("GS: truncated bitbltbuf");
+    if (!r.u16(m_trxpos.ssax) || !r.u16(m_trxpos.ssay) || !r.u16(m_trxpos.dsax) ||
+        !r.u16(m_trxpos.dsay) || !r.u8(m_trxpos.dir))
+        return fail("GS: truncated trxpos");
+    if (!r.u16(m_trxreg.rrw) || !r.u16(m_trxreg.rrh) || !r.u32(m_trxdir))
+        return fail("GS: truncated trxreg");
+    uint32_t vtxCount = 0, vtxIndex = 0;
+    if (!r.u32(vtxCount) || !r.u32(vtxIndex) || vtxCount > static_cast<uint32_t>(kMaxVerts))
+        return fail("GS: bad vertex queue");
+    m_vtxCount = static_cast<int>(vtxCount);
+    m_vtxIndex = static_cast<int>(vtxIndex);
+    for (int i = 0; i < kMaxVerts; ++i)
+        if (!readVertex(r, m_vtxQueue[i]))
+            return fail("GS: truncated vertex queue");
+    if (!r.u32(m_lastDisplayBaseBytes))
+        return fail("GS: truncated display base");
+
+    if (m_backend)
+    {
+        GSTransferCommand cmd{};
+        cmd.bitbltbuf = m_bitbltbuf;
+        cmd.trxpos = m_trxpos;
+        cmd.trxreg = m_trxreg;
+        cmd.direction = 3u;
+        m_backend->BeginTransfer(cmd);
+    }
+
+    {
+        std::lock_guard<std::mutex> snapLock(m_snapshotMutex);
+        m_displaySnapshot.clear();
+    }
+    m_hasPreferredDisplaySource = false;
+    m_preferredDisplaySourceFrame = {};
+    m_preferredDisplayDestFbp = 0;
+    {
+        std::lock_guard<std::mutex> presLock(m_presentationMutex);
+        m_hostPresentationFrame.clear();
+        m_hasHostPresentationFrame = false;
+        m_hostPresentationWidth = m_hostPresentationHeight = 0;
+    }
+    m_debugHistoryWrite = 0;
+    m_debugHistoryCount = 0;
+    return true;
+}
