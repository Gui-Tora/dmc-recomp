+        // ==============================================================
+        // DEVSTATE_003C checkpoint codec. Deliberately uses only raw byte
+        // buffers (no checkpoint.h dependency: ps2xIOP does not depend on
+        // ps2xRuntime's include tree). Default: no owned mutable state.
+        // Implementations append/consume little-endian fields identical in
+        // spirit to ps2x::checkpoint::ByteWriter/ByteReader.
+        // ==============================================================
+        virtual void serializeCheckpointState(std::vector<uint8_t> &out) const
+        {
+            (void)out;
+        }
+        // Reads exactly the bytes this service wrote; returns false on
+        // malformed/truncated input. `data`/`size` is the FULL remaining
+        // buffer; the service must report how many bytes it consumed.
+        virtual bool deserializeCheckpointState(const uint8_t *data, size_t size,
+                                                size_t &consumed, std::string &error)
+        {
+            (void)data;
+            (void)size;
+            consumed = 0;
+            error.clear();
+            return true;
+        }
+        // Safe-point gate: must return false (with a reason) if this
+        // service holds state that cannot be captured at the Main Menu v1
+        // checkpoint (e.g. an open host file handle, an in-flight transfer).
+        [[nodiscard]] virtual bool validateCheckpointSafe(std::string &reason) const
+        {
+            (void)reason;
+            return true;
+        }
     };
 
