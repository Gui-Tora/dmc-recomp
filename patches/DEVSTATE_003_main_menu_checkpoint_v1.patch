+void PS2AudioBackend::serializeCheckpointSampleBank(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    appendU32(out, m_mostRecentSampleKey);
+    // bank entries, sorted by key for determinism
+    std::vector<uint32_t> keys;
+    keys.reserve(m_sampleBank.size());
+    for (const auto &kv : m_sampleBank)
+        keys.push_back(kv.first);
+    std::sort(keys.begin(), keys.end());
+    appendU32(out, static_cast<uint32_t>(keys.size()));
+    for (uint32_t key : keys)
+    {
+        const DecodedSample &s = m_sampleBank.at(key);
+        appendU32(out, key);
+        appendU32(out, s.sampleRate);
+        appendU32(out, static_cast<uint32_t>(s.pcm.size()));
+        if (!s.pcm.empty())
+        {
+            const uint8_t *p = reinterpret_cast<const uint8_t *>(s.pcm.data());
+            out.insert(out.end(), p, p + s.pcm.size() * sizeof(int16_t));
+        }
+    }
+    // load order (parallel arrays: keys + the samples themselves, since a
+    // key may have been evicted from m_sampleBank by eviction policy while
+    // still present in load-order -- see onVagTransferFromBuffer)
+    appendU32(out, static_cast<uint32_t>(m_loadOrderSampleKeys.size()));
+    for (size_t i = 0; i < m_loadOrderSampleKeys.size(); ++i)
+    {
+        appendU32(out, m_loadOrderSampleKeys[i]);
+        const DecodedSample &s = m_loadOrderSamples[i];
+        appendU32(out, s.sampleRate);
+        appendU32(out, static_cast<uint32_t>(s.pcm.size()));
+        if (!s.pcm.empty())
+        {
+            const uint8_t *p = reinterpret_cast<const uint8_t *>(s.pcm.data());
+            out.insert(out.end(), p, p + s.pcm.size() * sizeof(int16_t));
+        }
+    }
+}
+
+bool PS2AudioBackend::deserializeCheckpointSampleBank(const uint8_t *data, size_t size,
+                                                       std::string &error)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    size_t pos = 0;
+    if (!readU32(data, size, pos, m_mostRecentSampleKey))
+    {
+        error = "AUDIO: truncated mostRecentSampleKey";
+        return false;
+    }
+    auto readSample = [&](DecodedSample &s) -> bool
+    {
+        uint32_t rate = 0, count = 0;
+        if (!readU32(data, size, pos, rate) || !readU32(data, size, pos, count) ||
+            count > (64u << 20))
+            return false;
+        s.sampleRate = rate;
+        s.pcm.resize(count);
+        if (count != 0u)
+        {
+            const size_t bytes = static_cast<size_t>(count) * sizeof(int16_t);
+            if (size - pos < bytes)
+                return false;
+            std::memcpy(s.pcm.data(), data + pos, bytes);
+            pos += bytes;
+        }
+        return true;
+    };
+    uint32_t bankCount = 0;
+    if (!readU32(data, size, pos, bankCount) || bankCount > 100000u)
+    {
+        error = "AUDIO: bad sample bank count";
+        return false;
+    }
+    m_sampleBank.clear();
+    for (uint32_t i = 0; i < bankCount; ++i)
+    {
+        uint32_t key = 0;
+        if (!readU32(data, size, pos, key))
+        {
+            error = "AUDIO: truncated sample bank key";
+            return false;
+        }
+        DecodedSample s;
+        if (!readSample(s))
+        {
+            error = "AUDIO: truncated sample bank entry";
+            return false;
+        }
+        m_sampleBank.emplace(key, std::move(s));
+    }
+    uint32_t loadCount = 0;
+    if (!readU32(data, size, pos, loadCount) || loadCount > 100000u)
+    {
+        error = "AUDIO: bad load-order count";
+        return false;
+    }
+    m_loadOrderSampleKeys.clear();
+    m_loadOrderSamples.clear();
+    m_loadOrderSampleKeys.reserve(loadCount);
+    m_loadOrderSamples.reserve(loadCount);
+    for (uint32_t i = 0; i < loadCount; ++i)
+    {
+        uint32_t key = 0;
+        if (!readU32(data, size, pos, key))
+        {
+            error = "AUDIO: truncated load-order key";
+            return false;
+        }
+        DecodedSample s;
+        if (!readSample(s))
+        {
+            error = "AUDIO: truncated load-order entry";
+            return false;
+        }
+        m_loadOrderSampleKeys.push_back(key);
+        m_loadOrderSamples.push_back(std::move(s));
+    }
+    if (pos != size)
+    {
+        error = "AUDIO: trailing bytes";
+        return false;
+    }
+    return true;
+}
