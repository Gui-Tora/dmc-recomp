diff --git a/ps2xRuntime/src/lib/checkpoint/checkpoint_io.cpp b/ps2xRuntime/src/lib/checkpoint/checkpoint_io.cpp
new file mode 100644
index 0000000..67d529b
--- /dev/null
+++ b/ps2xRuntime/src/lib/checkpoint/checkpoint_io.cpp
@@ -0,0 +1,394 @@
+// DEVSTATE_003A: checkpoint file framing -- CRC32, deterministic byte
+// writer/reader, atomic file commit (tmp + rename), full validating parser.
+// Design: analysis/notes/DEVSTATE_002_CHECKPOINT_SERIALIZATION_DESIGN.md §8/§14.
+
+#include "runtime/checkpoint/checkpoint.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <system_error>
+
+namespace ps2x::checkpoint
+{
+    // --- CRC-32 (IEEE, reflected, poly 0xEDB88320) -------------------------
+    namespace
+    {
+        const uint32_t *crcTable()
+        {
+            static uint32_t table[256];
+            static bool built = false;
+            if (!built)
+            {
+                for (uint32_t i = 0; i < 256u; ++i)
+                {
+                    uint32_t c = i;
+                    for (int k = 0; k < 8; ++k)
+                        c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+                    table[i] = c;
+                }
+                built = true;
+            }
+            return table;
+        }
+    }
+
+    uint32_t crc32(const uint8_t *data, size_t size, uint32_t seed)
+    {
+        const uint32_t *table = crcTable();
+        uint32_t c = seed ^ 0xFFFFFFFFu;
+        for (size_t i = 0; i < size; ++i)
+            c = table[(c ^ data[i]) & 0xFFu] ^ (c >> 8);
+        return c ^ 0xFFFFFFFFu;
+    }
+
+    // --- ByteWriter / ByteReader ------------------------------------------
+    void ByteWriter::u8(uint8_t v) { m_buffer.push_back(v); }
+    void ByteWriter::u16(uint16_t v)
+    {
+        m_buffer.push_back(static_cast<uint8_t>(v));
+        m_buffer.push_back(static_cast<uint8_t>(v >> 8));
+    }
+    void ByteWriter::u32(uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            m_buffer.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+    void ByteWriter::u64(uint64_t v)
+    {
+        for (int i = 0; i < 8; ++i)
+            m_buffer.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+    void ByteWriter::f32(float v)
+    {
+        uint32_t bits;
+        static_assert(sizeof(bits) == sizeof(v), "float width");
+        std::memcpy(&bits, &v, sizeof(bits));
+        u32(bits);
+    }
+    void ByteWriter::bytes(const void *data, size_t size)
+    {
+        const uint8_t *p = static_cast<const uint8_t *>(data);
+        m_buffer.insert(m_buffer.end(), p, p + size);
+    }
+
+    bool ByteReader::u8(uint8_t &v)
+    {
+        if (m_size - m_pos < 1u)
+            return false;
+        v = m_data[m_pos++];
+        return true;
+    }
+    bool ByteReader::u16(uint16_t &v)
+    {
+        if (m_size - m_pos < 2u)
+            return false;
+        v = static_cast<uint16_t>(m_data[m_pos] | (m_data[m_pos + 1] << 8));
+        m_pos += 2;
+        return true;
+    }
+    bool ByteReader::u32(uint32_t &v)
+    {
+        if (m_size - m_pos < 4u)
+            return false;
+        v = 0;
+        for (int i = 0; i < 4; ++i)
+            v |= static_cast<uint32_t>(m_data[m_pos + i]) << (8 * i);
+        m_pos += 4;
+        return true;
+    }
+    bool ByteReader::u64(uint64_t &v)
+    {
+        if (m_size - m_pos < 8u)
+            return false;
+        v = 0;
+        for (int i = 0; i < 8; ++i)
+            v |= static_cast<uint64_t>(m_data[m_pos + i]) << (8 * i);
+        m_pos += 8;
+        return true;
+    }
+    bool ByteReader::f32(float &v)
+    {
+        uint32_t bits = 0;
+        if (!u32(bits))
+            return false;
+        std::memcpy(&v, &bits, sizeof(v));
+        return true;
+    }
+    bool ByteReader::bytes(void *out, size_t size)
+    {
+        if (m_size - m_pos < size)
+            return false;
+        std::memcpy(out, m_data + m_pos, size);
+        m_pos += size;
+        return true;
+    }
+    bool ByteReader::skip(size_t size)
+    {
+        if (m_size - m_pos < size)
+            return false;
+        m_pos += size;
+        return true;
+    }
+
+    // --- Header helpers ----------------------------------------------------
+    namespace
+    {
+        void fillHeader(FileHeader &h, const CheckpointIdentity &identity,
+                        uint32_t sectionCount, uint64_t savedAtUnixMs)
+        {
+            std::memset(&h, 0, sizeof(h));
+            h.magic = kMagic;
+            h.formatVersion = kFormatVersion;
+            h.architectureId = kArchitectureId;
+            h.safePointId = kSafePointMainMenuV1;
+            const size_t idLen = identity.gameId.size() < sizeof(h.gameId)
+                                     ? identity.gameId.size()
+                                     : sizeof(h.gameId);
+            std::memcpy(h.gameId, identity.gameId.data(), idLen);
+            std::memcpy(h.elfSha256, identity.elfSha256, sizeof(h.elfSha256));
+            std::memcpy(h.runtimeBuildId, identity.runtimeBuildId, sizeof(h.runtimeBuildId));
+            h.savedAtUnixMs = savedAtUnixMs;
+            h.sectionCount = sectionCount;
+            h.headerCrc32 = 0u;
+            h.headerCrc32 = crc32(reinterpret_cast<const uint8_t *>(&h), sizeof(h));
+        }
+
+        bool headerCrcValid(const FileHeader &h)
+        {
+            FileHeader tmp = h;
+            const uint32_t stored = tmp.headerCrc32;
+            tmp.headerCrc32 = 0u;
+            return crc32(reinterpret_cast<const uint8_t *>(&tmp), sizeof(tmp)) == stored;
+        }
+    }
+
+    // --- CheckpointFileWriter ---------------------------------------------
+    CheckpointFileWriter::CheckpointFileWriter(CheckpointIdentity identity)
+        : m_identity(std::move(identity))
+    {
+    }
+
+    void CheckpointFileWriter::addSection(SectionId id, uint32_t version,
+                                          uint32_t flags, std::vector<uint8_t> payload)
+    {
+        m_sections.push_back(PendingSection{id, version, flags, std::move(payload)});
+    }
+
+    CheckpointError CheckpointFileWriter::commit(const std::filesystem::path &finalPath,
+                                                 uint64_t savedAtUnixMs)
+    {
+        FileHeader header{};
+        fillHeader(header, m_identity, static_cast<uint32_t>(m_sections.size()), savedAtUnixMs);
+
+        std::vector<SectionEntry> table(m_sections.size());
+        uint64_t offset = sizeof(FileHeader) + m_sections.size() * sizeof(SectionEntry);
+        for (size_t i = 0; i < m_sections.size(); ++i)
+        {
+            const PendingSection &s = m_sections[i];
+            SectionEntry &e = table[i];
+            std::memset(&e, 0, sizeof(e));
+            e.id = static_cast<uint32_t>(s.id);
+            e.version = s.version;
+            e.offset = offset;
+            e.size = s.payload.size();
+            e.crc32 = crc32(s.payload.data(), s.payload.size());
+            e.flags = s.flags;
+            offset += e.size;
+        }
+
+        // Write to a sibling temp file first; rename atomically on success
+        // (design §14: either a complete valid checkpoint exists, or nothing).
+        std::filesystem::path tmpPath = finalPath;
+        tmpPath += ".tmp";
+        {
+            std::ofstream out(tmpPath, std::ios::binary | std::ios::trunc);
+            if (!out)
+                return CheckpointError::failure("cannot open temp file for write: " +
+                                                tmpPath.string());
+            out.write(reinterpret_cast<const char *>(&header), sizeof(header));
+            out.write(reinterpret_cast<const char *>(table.data()),
+                      static_cast<std::streamsize>(table.size() * sizeof(SectionEntry)));
+            for (const PendingSection &s : m_sections)
+            {
+                out.write(reinterpret_cast<const char *>(s.payload.data()),
+                          static_cast<std::streamsize>(s.payload.size()));
+            }
+            out.flush();
+            if (!out.good())
+            {
+                out.close();
+                std::error_code ec;
+                std::filesystem::remove(tmpPath, ec);
+                return CheckpointError::failure("write failed for " + tmpPath.string());
+            }
+        }
+
+        std::error_code ec;
+        std::filesystem::rename(tmpPath, finalPath, ec);
+        if (ec)
+        {
+            // On Windows rename fails if the destination exists; replace via
+            // remove+rename, still never leaving a half-written final file
+            // (the temp file was fully written and flushed above).
+            std::error_code ec2;
+            std::filesystem::remove(finalPath, ec2);
+            std::filesystem::rename(tmpPath, finalPath, ec2);
+            if (ec2)
+            {
+                std::filesystem::remove(tmpPath, ec);
+                return CheckpointError::failure("atomic rename failed: " + ec2.message());
+            }
+        }
+        return CheckpointError::success();
+    }
+
+    // --- CheckpointFileReader ---------------------------------------------
+    CheckpointError CheckpointFileReader::parseAndValidate(
+        const std::filesystem::path &path, const CheckpointIdentity &expected,
+        ParsedCheckpoint &out)
+    {
+        out = ParsedCheckpoint{};
+        out.path = path;
+
+        std::ifstream in(path, std::ios::binary);
+        if (!in)
+            return CheckpointError::failure("cannot open checkpoint: " + path.string());
+        in.seekg(0, std::ios::end);
+        const uint64_t fileSize = static_cast<uint64_t>(in.tellg());
+        in.seekg(0, std::ios::beg);
+
+        if (fileSize < sizeof(FileHeader))
+            return CheckpointError::failure("truncated: smaller than header");
+        FileHeader header{};
+        in.read(reinterpret_cast<char *>(&header), sizeof(header));
+        if (!in.good())
+            return CheckpointError::failure("header read failed");
+
+        if (header.magic != kMagic)
+            return CheckpointError::failure("bad magic");
+        if (!headerCrcValid(header))
+            return CheckpointError::failure("header checksum mismatch");
+        if (header.formatVersion != kFormatVersion)
+            return CheckpointError::failure("unsupported format version");
+        if (header.architectureId != kArchitectureId)
+            return CheckpointError::failure("architecture mismatch");
+        if (header.safePointId != kSafePointMainMenuV1)
+            return CheckpointError::failure("unsupported safe-point id");
+
+        char gameId[sizeof(header.gameId) + 1] = {};
+        std::memcpy(gameId, header.gameId, sizeof(header.gameId));
+        if (expected.gameId != gameId)
+            return CheckpointError::failure("game identity mismatch");
+        if (std::memcmp(header.elfSha256, expected.elfSha256, 32) != 0)
+            return CheckpointError::failure("ELF identity mismatch");
+        if (std::memcmp(header.runtimeBuildId, expected.runtimeBuildId, 32) != 0)
+            return CheckpointError::failure("runtime build mismatch (v1 strict policy)");
+
+        if (header.sectionCount == 0u || header.sectionCount > 64u)
+            return CheckpointError::failure("implausible section count");
+        const uint64_t tableBytes =
+            static_cast<uint64_t>(header.sectionCount) * sizeof(SectionEntry);
+        if (fileSize < sizeof(FileHeader) + tableBytes)
+            return CheckpointError::failure("truncated: section table incomplete");
+
+        std::vector<SectionEntry> table(header.sectionCount);
+        in.read(reinterpret_cast<char *>(table.data()),
+                static_cast<std::streamsize>(tableBytes));
+        if (!in.good())
+            return CheckpointError::failure("section table read failed");
+
+        // v1 policy (design §15): unknown sections are rejected.
+        for (const SectionEntry &e : table)
+        {
+            if (e.id < static_cast<uint32_t>(SectionId::Core) ||
+                e.id > static_cast<uint32_t>(SectionId::Mpeg))
+                return CheckpointError::failure("unknown section id " + std::to_string(e.id));
+            if (e.offset < sizeof(FileHeader) + tableBytes)
+                return CheckpointError::failure("section offset overlaps header");
+            if (e.offset + e.size < e.offset || e.offset + e.size > fileSize)
+                return CheckpointError::failure("section exceeds file size (truncated?)");
+        }
+
+        // DEVSTATE_003C PART 8 step 8: validate required section presence.
+        // A v1-complete checkpoint must carry all 12 required sections; a
+        // file missing any of them (e.g. the DEVSTATE_003B 5-section
+        // artifact) is rejected explicitly here, before any payload is even
+        // checksum-verified -- never partially restored.
+        for (SectionId required : kRequiredSectionsV1)
+        {
+            bool found = false;
+            for (const SectionEntry &e : table)
+            {
+                if (static_cast<SectionId>(e.id) == required)
+                {
+                    found = true;
+                    break;
+                }
+            }
+            if (!found)
+            {
+                return CheckpointError::failure(
+                    "required section missing: id=" +
+                    std::to_string(static_cast<uint32_t>(required)));
+            }
+        }
+
+        // Validate EVERY payload checksum before reporting success -- no
+        // caller may mutate state based on a file that fails any checksum.
+        std::vector<uint8_t> payload;
+        for (const SectionEntry &e : table)
+        {
+            payload.resize(e.size);
+            in.seekg(static_cast<std::streamoff>(e.offset), std::ios::beg);
+            in.read(reinterpret_cast<char *>(payload.data()),
+                    static_cast<std::streamsize>(e.size));
+            if (!in.good())
+                return CheckpointError::failure("payload read failed");
+            if (crc32(payload.data(), payload.size()) != e.crc32)
+                return CheckpointError::failure("payload checksum mismatch in section " +
+                                                std::to_string(e.id));
+        }
+
+        out.header = header;
+        out.sections.reserve(table.size());
+        for (const SectionEntry &e : table)
+        {
+            SectionInfo info;
+            info.id = static_cast<SectionId>(e.id);
+            info.version = e.version;
+            info.offset = e.offset;
+            info.size = e.size;
+            info.crc32 = e.crc32;
+            info.flags = e.flags;
+            out.sections.push_back(info);
+        }
+        out.stage = CheckpointLoadStage::Parsed;
+        return CheckpointError::success();
+    }
+
+    CheckpointError CheckpointFileReader::readSectionPayload(
+        const ParsedCheckpoint &pc, SectionId id, std::vector<uint8_t> &out)
+    {
+        if (pc.stage == CheckpointLoadStage::None)
+            return CheckpointError::failure("checkpoint not parsed");
+        for (const SectionInfo &s : pc.sections)
+        {
+            if (s.id != id)
+                continue;
+            std::ifstream in(pc.path, std::ios::binary);
+            if (!in)
+                return CheckpointError::failure("cannot reopen checkpoint");
+            out.resize(s.size);
+            in.seekg(static_cast<std::streamoff>(s.offset), std::ios::beg);
+            in.read(reinterpret_cast<char *>(out.data()),
+                    static_cast<std::streamsize>(s.size));
+            if (!in.good())
+                return CheckpointError::failure("payload reread failed");
+            if (crc32(out.data(), out.size()) != s.crc32)
+                return CheckpointError::failure("payload checksum changed on disk");
+            return CheckpointError::success();
+        }
+        return CheckpointError::failure("section not present");
+    }
+}
