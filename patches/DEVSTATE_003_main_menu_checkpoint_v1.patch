+        if (!r.u32(bankLen) || r.remaining() < bankLen)
+            return CheckpointError::failure("AUDIO: truncated sample bank length");
+        std::vector<uint8_t> bank(bankLen);
+        if (bankLen != 0u && !r.bytes(bank.data(), bankLen))
+            return CheckpointError::failure("AUDIO: truncated sample bank");
+        if (!runtime.audioBackend().deserializeCheckpointSampleBank(bank.data(), bank.size(), err))
+            return CheckpointError::failure("AUDIO sample bank deserialize: " + err);
+        if (!r.atEnd())
+            return CheckpointError::failure("AUDIO: trailing bytes");
+        return CheckpointError::success();
+    }
