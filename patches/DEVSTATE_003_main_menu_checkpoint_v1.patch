+    void checkpointSerializeRpc(ps2x::checkpoint::ByteWriter &w)
+    {
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
+        std::vector<uint32_t> serverKeys;
+        serverKeys.reserve(g_rpc_servers.size());
+        for (const auto &kv : g_rpc_servers)
+            serverKeys.push_back(kv.first);
+        std::sort(serverKeys.begin(), serverKeys.end());
+        w.u32(static_cast<uint32_t>(serverKeys.size()));
+        for (uint32_t k : serverKeys)
+        {
+            const RpcServerState &s = g_rpc_servers.at(k);
+            w.u32(k);
+            w.u32(s.sid);
+            w.u32(s.sd_ptr);
+        }
+        std::vector<uint32_t> clientKeys;
+        clientKeys.reserve(g_rpc_clients.size());
+        for (const auto &kv : g_rpc_clients)
+            clientKeys.push_back(kv.first);
+        std::sort(clientKeys.begin(), clientKeys.end());
+        w.u32(static_cast<uint32_t>(clientKeys.size()));
+        for (uint32_t k : clientKeys)
+        {
+            const RpcClientState &c = g_rpc_clients.at(k);
+            w.u32(k);
+            w.u8(c.busy ? 1u : 0u);
+            w.u32(c.last_rpc);
+            w.u32(c.sid);
+        }
+        w.u8(g_rpc_initialized ? 1u : 0u);
+        w.u32(g_rpc_next_id);
+        w.u32(g_rpc_packet_index);
+        w.u32(g_rpc_server_index);
+        w.u32(g_rpc_active_queue);
+
+        // SIF module bindings (loaded-module tracking, guest-visible via
+        // sceSifLoadModule/sceSifSearchModuleByName).
+        std::lock_guard<std::mutex> moduleLock(g_sif_module_mutex);
+        std::vector<int32_t> moduleIds;
+        moduleIds.reserve(g_sif_modules_by_id.size());
+        for (const auto &kv : g_sif_modules_by_id)
+            moduleIds.push_back(kv.first);
+        std::sort(moduleIds.begin(), moduleIds.end());
+        w.u32(static_cast<uint32_t>(moduleIds.size()));
+        for (int32_t id : moduleIds)
+        {
+            const SifModuleRecord &rec = g_sif_modules_by_id.at(id);
+            w.u32(static_cast<uint32_t>(rec.id));
+            w.u32(static_cast<uint32_t>(rec.path.size()));
+            w.bytes(rec.path.data(), rec.path.size());
+            w.u32(static_cast<uint32_t>(rec.pathKey.size()));
+            w.bytes(rec.pathKey.data(), rec.pathKey.size());
+            w.u32(rec.refCount);
+            w.u8(rec.loaded ? 1u : 0u);
+        }
+        w.u32(static_cast<uint32_t>(g_next_sif_module_id));
+    }
+
+    bool checkpointDeserializeRpc(ps2x::checkpoint::ByteReader &r, std::string &error)
+    {
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
+        uint32_t serverCount = 0;
+        if (!r.u32(serverCount) || serverCount > 65536u)
+        {
+            error = "RPC: bad server count";
+            return false;
+        }
+        g_rpc_servers.clear();
+        for (uint32_t i = 0; i < serverCount; ++i)
+        {
+            uint32_t k = 0;
+            RpcServerState s{};
+            if (!r.u32(k) || !r.u32(s.sid) || !r.u32(s.sd_ptr))
+            {
+                error = "RPC: truncated server entry";
+                return false;
+            }
+            g_rpc_servers.emplace(k, s);
+        }
+        uint32_t clientCount = 0;
+        if (!r.u32(clientCount) || clientCount > 65536u)
+        {
+            error = "RPC: bad client count";
+            return false;
+        }
+        g_rpc_clients.clear();
+        for (uint32_t i = 0; i < clientCount; ++i)
+        {
+            uint32_t k = 0;
+            uint8_t busy = 0;
+            RpcClientState c{};
+            if (!r.u32(k) || !r.u8(busy) || !r.u32(c.last_rpc) || !r.u32(c.sid))
+            {
+                error = "RPC: truncated client entry";
+                return false;
+            }
+            c.busy = busy != 0u;
+            g_rpc_clients.emplace(k, c);
+        }
+        uint8_t initialized = 0;
+        if (!r.u8(initialized) || !r.u32(g_rpc_next_id) || !r.u32(g_rpc_packet_index) ||
+            !r.u32(g_rpc_server_index) || !r.u32(g_rpc_active_queue))
+        {
+            error = "RPC: truncated scalars";
+            return false;
+        }
+        g_rpc_initialized = initialized != 0u;
+
+        std::lock_guard<std::mutex> moduleLock(g_sif_module_mutex);
+        uint32_t moduleCount = 0;
+        if (!r.u32(moduleCount) || moduleCount > 65536u)
+        {
+            error = "RPC: bad module count";
+            return false;
+        }
+        g_sif_modules_by_id.clear();
+        g_sif_module_id_by_path.clear();
+        for (uint32_t i = 0; i < moduleCount; ++i)
+        {
+            uint32_t idRaw = 0, pathLen = 0, pathKeyLen = 0;
+            SifModuleRecord rec{};
+            uint8_t loaded = 0;
+            if (!r.u32(idRaw))
+            {
+                error = "RPC: truncated module id";
+                return false;
+            }
+            rec.id = static_cast<int32_t>(idRaw);
+            if (!r.u32(pathLen) || pathLen > (1u << 20))
+            {
+                error = "RPC: bad module path length";
+                return false;
+            }
+            rec.path.resize(pathLen);
+            if (!r.bytes(rec.path.data(), pathLen))
+            {
+                error = "RPC: truncated module path";
+                return false;
+            }
+            if (!r.u32(pathKeyLen) || pathKeyLen > (1u << 20))
+            {
+                error = "RPC: bad module pathKey length";
+                return false;
+            }
+            rec.pathKey.resize(pathKeyLen);
+            if (!r.bytes(rec.pathKey.data(), pathKeyLen) || !r.u32(rec.refCount) || !r.u8(loaded))
+            {
+                error = "RPC: truncated module record";
+                return false;
+            }
+            rec.loaded = loaded != 0u;
+            g_sif_module_id_by_path.emplace(rec.pathKey, rec.id);
+            g_sif_modules_by_id.emplace(rec.id, std::move(rec));
+        }
+        uint32_t nextModuleId = 0;
+        if (!r.u32(nextModuleId))
+        {
+            error = "RPC: truncated next module id";
+            return false;
+        }
+        g_next_sif_module_id = static_cast<int32_t>(nextModuleId);
+        return true;
+    }
