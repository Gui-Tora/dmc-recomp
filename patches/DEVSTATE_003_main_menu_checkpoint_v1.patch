+#ifdef _WIN32
+            GetModuleFileNameW(nullptr, path, 1023);
+            hashFileLanes(std::filesystem::path(path), id);
+#else
+            hashFileLanes(std::filesystem::read_symlink("/proc/self/exe"), id);
+#endif
+            computed = true;
+        }
+        return id;
+    }
