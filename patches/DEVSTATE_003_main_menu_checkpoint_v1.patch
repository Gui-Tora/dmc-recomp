+    inline constexpr uint32_t kGsSectionVersion = 1u;
+    inline constexpr uint32_t kIopSectionVersion = 1u;
+    inline constexpr uint32_t kSifRpcSectionVersion = 1u;
+    inline constexpr uint32_t kCdSectionVersion = 1u;
+    inline constexpr uint32_t kMcSectionVersion = 1u;
+    inline constexpr uint32_t kAudioSectionVersion = 1u;
+    inline constexpr uint32_t kPadSectionVersion = 1u;
+    inline constexpr uint32_t kMpegSectionVersion = 1u;
