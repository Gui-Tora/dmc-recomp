+    // --- Safe-point validator ----------------------------------------------
+    CheckpointSafetyResult CheckpointManager::validateSafePoint(PS2Runtime &runtime)
+    {
+        CheckpointSafetyResult res;
+        const EeScheduler::CheckpointQuiescence q =
+            runtime.eeScheduler().collectCheckpointQuiescence();
+        res.vsyncTick = q.vsyncTick;
+        res.pendingInv = q.pendingInv;
+
+        auto fail = [&res](const char *why, uint32_t value)
+        {
+            res.ok = false;
+            res.reason = why;
+            res.failedGateValue = value;
+            return res;
+        };
+
+        if (q.activeInv != 0u)
+            return fail("activeInv != 0", q.activeInv);
+        if (q.pendingInvWithCompletion != 0u)
+            return fail("pending invocation with onComplete", q.pendingInvWithCompletion);
+        if (q.pendingRpcInv != 0u)
+            return fail("pending RPC invocation", q.pendingRpcInv);
+        if (q.activeInvWithCompletion != 0u)
+            return fail("active invocation with onComplete", q.activeInvWithCompletion);
+        if (q.threadsWithResumeCompletion != 0u)
+            return fail("thread resumeCompletion pending", q.threadsWithResumeCompletion);
+        if (q.threadsWithWaitCompletion != 0u)
+            return fail("thread wait completion pending", q.threadsWithWaitCompletion);
+        if (q.queuedEvents != 0u)
+            return fail("queued scheduler events", q.queuedEvents);
+        if (q.pendingTimerIrqMask != 0u)
+            return fail("pending EE timer IRQ", q.pendingTimerIrqMask);
+        // DEVSTATE_001A: pendingInv <= 1 and only the serializable VSync
+        // invocation (kind GsCallback/Interrupt without onComplete). The
+        // completion-free requirement was already checked above.
+        if (q.pendingInv > 1u)
+            return fail("more than one pending invocation", q.pendingInv);
+
+        PS2Memory &mem = runtime.memory();
+        if (!mem.m_pendingGifTransfers.empty())
+            return fail("pendingGifTransfers not empty",
+                        static_cast<uint32_t>(mem.m_pendingGifTransfers.size()));
+        if (!mem.m_pendingVif0Transfers.empty())
+            return fail("pendingVif0Transfers not empty",
+                        static_cast<uint32_t>(mem.m_pendingVif0Transfers.size()));
+        if (!mem.m_pendingVif1Transfers.empty())
+            return fail("pendingVif1Transfers not empty",
+                        static_cast<uint32_t>(mem.m_pendingVif1Transfers.size()));
+        {
+            std::lock_guard<std::mutex> lock(mem.m_completedDmacMutex);
+            if (!mem.m_completedDmacCauses.empty())
+                return fail("completedDmacCauses not empty",
+                            static_cast<uint32_t>(mem.m_completedDmacCauses.size()));
+        }
+
+        // Active DMA channels (CHCR.STR)
+        static constexpr uint32_t kChcrAddrs[10] = {
+            0x10008000u, 0x10009000u, 0x1000A000u, 0x1000B000u, 0x1000B400u,
+            0x1000C000u, 0x1000C400u, 0x1000C800u, 0x1000D000u, 0x1000D400u};
+        for (uint32_t addr : kChcrAddrs)
+        {
+            if ((mem.readIORegister(addr) & 0x100u) != 0u)
+                return fail("DMA channel active", addr);
+        }
+
+        if (!runtime.gifArbiter().empty())
+            return fail("GIF arbiter queue not empty", 1u);
+        {
+            const GSDebugSnapshot gs = runtime.gs().getDebugSnapshot();
+            if (gs.transferTotalPixels > 0u &&
+                gs.transferCopiedPixels < gs.transferTotalPixels)
+                return fail("GS transfer partially complete",
+                            gs.transferTotalPixels - gs.transferCopiedPixels);
+        }
+
+        uint32_t mcOpen = 0, mcPending = 0;
+        ps2_stubs::checkpointProbeMc(mcOpen, mcPending);
+        if (mcOpen != 0u)
+            return fail("memory card fds open", mcOpen);
+        if (mcPending != 0u)
+            return fail("memory card command pending", mcPending);
+        const uint32_t mpeg = ps2_stubs::checkpointProbeMpegMask();
+        if (mpeg != 0u)
+            return fail("MPEG not idle", mpeg);
+        const uint32_t cd = ps2_stubs::checkpointProbeCdMask();
+        if (cd != 0u)
+            return fail("CD stream not idle", cd);
+        const uint32_t audio = ps2_stubs::checkpointProbeAudioMask();
+        if (audio != 0u)
+            return fail("audio HLE not idle", audio);
+        const uint32_t fio = ps2_syscalls::checkpointProbeFioOpenCount();
+        if (fio != 0u)
+            return fail("guest fio files open", fio);
+        {
+            std::string gsReason;
+            if (!runtime.gs().checkpointIdle(gsReason))
+            {
+                res.ok = false;
+                res.reason = gsReason;
+                res.failedGateValue = 1u;
+                return res;
+            }
+        }
+        {
+            std::string rpcReason;
+            if (!ps2_syscalls::checkpointValidateRpcSafe(rpcReason))
+            {
+                res.ok = false;
+                res.reason = rpcReason;
+                res.failedGateValue = 1u;
+                return res;
+            }
+        }
+        if (runtime.m_iopSubsystem)
+        {
+            std::string iopReason;
+            if (!runtime.m_iopSubsystem->validateCheckpointSafe(iopReason))
+            {
+                res.ok = false;
+                res.reason = iopReason;
+                res.failedGateValue = 1u;
+                return res;
+            }
+        }
+
+        res.ok = true;
+        res.reason = "ok";
+        return res;
+    }
+
+    // --- Orchestration -------------------------------------------------------
+    CheckpointError CheckpointManager::save(PS2Runtime &runtime,
+                                            const CheckpointIdentity &identity,
+                                            const std::filesystem::path &finalPath)
+    {
+        const CheckpointSafetyResult safety = validateSafePoint(runtime);
+        if (!safety.ok)
+            return CheckpointError::failure("safe-point validation failed: " + safety.reason);
+
+        CheckpointFileWriter writer(identity);
+        writer.addSection(SectionId::Core, kCoreSectionVersion, kSectionFlagRequired,
+                          serializeCore(runtime));
+        writer.addSection(SectionId::Mem, kMemSectionVersion, kSectionFlagRequired,
+                          serializeMem(runtime));
+        writer.addSection(SectionId::Mmio, kMmioSectionVersion, kSectionFlagRequired,
+                          serializeMmio(runtime));
+        {
+            std::vector<uint8_t> gsPayload;
+            CheckpointError err = serializeGs(runtime, gsPayload);
+            if (!err.ok)
+                return err;
+            writer.addSection(SectionId::Gs, kGsSectionVersion, kSectionFlagRequired,
+                              std::move(gsPayload));
+            std::vector<uint8_t> schedPayload;
+            err = serializeSched(runtime, schedPayload);
+            if (!err.ok)
+                return err;
+            writer.addSection(SectionId::Sched, kSchedSectionVersion, kSectionFlagRequired,
+                              std::move(schedPayload));
+
+            std::vector<uint8_t> payload;
+            err = serializeIop(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Iop, kIopSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializeSifRpc(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::SifRpc, kSifRpcSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializeCd(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Cd, kCdSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializeMc(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Mc, kMcSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializeAudio(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Audio, kAudioSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializePad(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Pad, kPadSectionVersion, kSectionFlagRequired, std::move(payload));
+
+            err = serializeMpeg(runtime, payload);
+            if (!err.ok) return err;
+            writer.addSection(SectionId::Mpeg, kMpegSectionVersion, kSectionFlagRequired, std::move(payload));
+        }
+
+        const uint64_t savedAt = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::system_clock::now().time_since_epoch())
+                .count());
+        return writer.commit(finalPath, savedAt);
+    }
+
+    CheckpointError CheckpointManager::loadPartial(PS2Runtime &runtime,
+                                                   const CheckpointIdentity &expected,
+                                                   const std::filesystem::path &path,
+                                                   ParsedCheckpoint &outParsed)
+    {
+        CheckpointError err =
+            CheckpointFileReader::parseAndValidate(path, expected, outParsed);
+        if (!err.ok)
+            return err;
+
+        // Real restore order (design §7): MEM -> MMIO -> GS -> CORE/VU ->
+        // SCHED. Guest execution is NEVER started here; PartialRestore is
+        // the terminal stage of the DEVSTATE_003x phases.
+        std::vector<uint8_t> payload;
+        err = CheckpointFileReader::readSectionPayload(outParsed, SectionId::Mem, payload);
+        if (!err.ok)
+            return err;
+        err = deserializeMem(runtime, payload);
+        if (!err.ok)
+            return err;
+        err = CheckpointFileReader::readSectionPayload(outParsed, SectionId::Mmio, payload);
+        if (!err.ok)
+            return err;
+        err = deserializeMmio(runtime, payload);
+        if (!err.ok)
+            return err;
+        err = CheckpointFileReader::readSectionPayload(outParsed, SectionId::Core, payload);
+        if (!err.ok)
+            return err;
+        err = deserializeCore(runtime, payload);
+        if (!err.ok)
+            return err;
+        outParsed.stage = CheckpointLoadStage::CoreMemMmioRestored;
+
+        err = CheckpointFileReader::readSectionPayload(outParsed, SectionId::Gs, payload);
+        if (!err.ok)
+            return err;
+        err = deserializeGs(runtime, payload);
+        if (!err.ok)
+            return err;
+        err = CheckpointFileReader::readSectionPayload(outParsed, SectionId::Sched, payload);
+        if (!err.ok)
+            return err;
+        err = deserializeSched(runtime, payload);
+        if (!err.ok)
+            return err;
+        outParsed.stage = CheckpointLoadStage::SchedGsRestored;
+
+        outParsed.stage = CheckpointLoadStage::PartialRestore;
+        return CheckpointError::success();
+    }
+
+    // --- DEVSTATE_003C: full v1 load (all 12 sections) ----------------------
+    CheckpointError CheckpointManager::loadFull(PS2Runtime &runtime,
+                                                const CheckpointIdentity &expected,
+                                                const std::filesystem::path &path,
+                                                ParsedCheckpoint &outParsed)
+    {
+        // Step 0: complete file validation, no mutation (parseAndValidate
+        // already checks header/identity/arch/section-table bounds/required
+        // sections/every payload checksum before returning).
+        CheckpointError err = CheckpointFileReader::parseAndValidate(path, expected, outParsed);
+        if (!err.ok)
+            return err;
+
+        auto restoreSection = [&](SectionId id, CheckpointError (*deserializeFn)(PS2Runtime &, const std::vector<uint8_t> &)) -> CheckpointError
+        {
+            std::vector<uint8_t> payload;
+            CheckpointError e = CheckpointFileReader::readSectionPayload(outParsed, id, payload);
+            if (!e.ok)
+                return e;
+            return deserializeFn(runtime, payload);
+        };
+
+        // Steps 2-6: MEM -> MMIO -> CORE/VU -> GS -> SCHED (design §7 order;
+        // host objects/cross-pointers/callback infrastructure were already
+        // created normally by initialize()+loadELF() before this call, per
+        // the cold-load sequence -- see the DEVSTATE_003C report PART 9/10:
+        // no second init or reset happens here or after).
+        if (!(err = restoreSection(SectionId::Mem, &deserializeMem)).ok) return err;
+        if (!(err = restoreSection(SectionId::Mmio, &deserializeMmio)).ok) return err;
+        if (!(err = restoreSection(SectionId::Core, &deserializeCore)).ok) return err;
+        if (!(err = restoreSection(SectionId::Gs, &deserializeGs)).ok) return err;
+        if (!(err = restoreSection(SectionId::Sched, &deserializeSched)).ok) return err;
+        outParsed.stage = CheckpointLoadStage::CoreMemMmioRestored;
+
+        // Steps 7-13: IOP -> SIF_RPC -> CD -> MC -> AUDIO -> PAD -> MPEG.
+        if (!(err = restoreSection(SectionId::Iop, &deserializeIop)).ok) return err;
+        if (!(err = restoreSection(SectionId::SifRpc, &deserializeSifRpc)).ok) return err;
+        if (!(err = restoreSection(SectionId::Cd, &deserializeCd)).ok) return err;
+        if (!(err = restoreSection(SectionId::Mc, &deserializeMc)).ok) return err;
+        if (!(err = restoreSection(SectionId::Audio, &deserializeAudio)).ok) return err;
+        if (!(err = restoreSection(SectionId::Pad, &deserializePad)).ok) return err;
+        if (!(err = restoreSection(SectionId::Mpeg, &deserializeMpeg)).ok) return err;
+        outParsed.stage = CheckpointLoadStage::SchedGsRestored;
+
+        // Step 14 (REBIND HOST): a no-op by construction. m_gifArbiter/VU
+        // callbacks/m_iopHost/m_iopSubsystem/GS->privRegs+VRAM pointers were
+        // all wired by the normal initialize()+loadELF() call that already
+        // ran before loadFull() (same call, same order, as the cold path).
+        // None of those pointers are touched by MEM/MMIO/CORE/GS/SCHED/IOP/
+        // ... deserialize (they write into already-allocated buffers and
+        // already-constructed objects), so nothing is stale.
+        //
+        // Step 15 (RECONSTRUCT DERIVED STATE): GS::deserializeCheckpointState
+        // already invalidated the presentation snapshot/preferred-source
+        // latch/host frame/debug history (regenerated by the next
+        // latchHostPresentationFrame() call in the render loop). CD disk
+        // indices are RECONSTRUCT_ON_LOAD (lazy; untouched here, rebuilt on
+        // first use exactly like cold boot). VU derived caches: none beyond
+        // the code-generation counters already restored in MMIO.
+        //
+        // Step 16 (INPUT RECONCILE): PAD deserialize already neutralized
+        // lastInput/lastData/transient per-call state.
+
+        outParsed.stage = CheckpointLoadStage::PartialRestore;
+        return CheckpointError::success();
+    }
+}
diff --git a/ps2xRuntime/src/lib/checkpoint/checkpoint_selftest.cpp b/ps2xRuntime/src/lib/checkpoint/checkpoint_selftest.cpp
