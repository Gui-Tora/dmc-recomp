index 0000000..f256332
--- /dev/null
+++ b/ps2xRuntime/include/runtime/checkpoint/checkpoint_format.h
@@ -0,0 +1,99 @@
+// DEVSTATE_003A: checkpoint on-disk format (framing only).
+// Normative design: analysis/notes/DEVSTATE_002_CHECKPOINT_SERIALIZATION_DESIGN.md
+//
+// v1 policy: strict build identity (runtime_build_id must match), explicit
+// integer widths everywhere, little-endian x86-64 only, no compression, and
+// deterministic byte output (all payloads are written field-by-field or from
+// containers with a defined order; no raw struct dumps of types that contain
+// padding bytes).
+
+#ifndef PS2X_CHECKPOINT_FORMAT_H
+#define PS2X_CHECKPOINT_FORMAT_H
+
+#include <cstdint>
+#include <cstddef>
+
+namespace ps2x::checkpoint
+{
+    inline constexpr uint32_t kMagic = 0x4B434D44u; // "DMCK" little-endian
+    inline constexpr uint32_t kFormatVersion = 1u;
+    inline constexpr uint32_t kArchitectureId = 1u; // 1 = x86_64 little-endian
+    inline constexpr uint32_t kSafePointMainMenuV1 = 1u;
+
+    // Section identifiers. Values are part of the on-disk format; never reuse.
+    enum class SectionId : uint32_t
+    {
+        Core = 1u, // R5900Context + VU0/VU1 VU1State
+        Mem = 2u,  // RDRAM/SPR/IOP RAM/VU mems/GS VRAM/arenas/modules
+        Mmio = 3u, // ioRegisters/dma/vif/gs_regs/TLB/EE timers/etc.
+        // Reserved for later phases (design DEVSTATE_002 §8):
+        Sched = 4u,
+        Gs = 5u,
+        Iop = 6u,
+        SifRpc = 7u,
+        Cd = 8u,
+        Mc = 9u,
+        Audio = 10u,
+        Pad = 11u,
+        Mpeg = 12u,
+    };
+
+    inline constexpr uint32_t kSectionFlagRequired = 0x1u;
+
+    // Fixed-size, padding-free on-disk records. Verified by static_asserts.
+    struct FileHeader
+    {
+        uint32_t magic;
+        uint32_t formatVersion;
+        uint32_t architectureId;
+        uint32_t safePointId;
+        uint8_t gameId[32];        // NUL-padded ASCII, e.g. "SLES_503.58"
+        uint8_t elfSha256[32];     // raw digest bytes
+        uint8_t runtimeBuildId[32]; // raw digest bytes (exe identity)
+        uint64_t savedAtUnixMs;    // informational ONLY; excluded from
+                                   // idempotency comparisons (design §8)
+        uint32_t sectionCount;
+        uint32_t headerCrc32;      // CRC of all header bytes with this field 0
+    };
+    static_assert(sizeof(FileHeader) == 4u * 4u + 32u + 32u + 32u + 8u + 4u + 4u,
+                  "FileHeader must stay padding-free");
+
+    struct SectionEntry
+    {
+        uint32_t id;      // SectionId
+        uint32_t version; // per-section payload version
+        uint64_t offset;  // absolute file offset of payload
+        uint64_t size;    // payload size in bytes
+        uint32_t crc32;   // CRC-32 of payload bytes
+        uint32_t flags;   // kSectionFlag*
+    };
+    static_assert(sizeof(SectionEntry) == 4u + 4u + 8u + 8u + 4u + 4u,
+                  "SectionEntry must stay padding-free");
