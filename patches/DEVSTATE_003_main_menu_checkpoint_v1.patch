+// DEVSTATE_003A: checkpoint infrastructure API (HEADER/CORE/MEM/MMIO only).
+// Design: analysis/notes/DEVSTATE_002_CHECKPOINT_SERIALIZATION_DESIGN.md
+//
+// Scope guard: this phase deliberately implements SAVE of the mechanical
+// sections and a full validating LOAD *parser* with staged restore. There is
+// intentionally NO path that resumes guest execution from a partial restore:
+// CheckpointLoadStage::Complete is unreachable until SCHED/GS/IOP sections
+// exist (later phases), and nothing in this unit starts the EE scheduler.
+
+#ifndef PS2X_CHECKPOINT_H
+#define PS2X_CHECKPOINT_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <filesystem>
+
+#include "runtime/checkpoint/checkpoint_format.h"
+
+class PS2Runtime;
+struct R5900Context;
+
+namespace ps2x::checkpoint
+{
+    struct CheckpointIdentity
+    {
+        std::string gameId;              // "SLES_503.58"
+        uint8_t elfSha256[32]{};         // digest of the boot ELF
+        uint8_t runtimeBuildId[32]{};    // digest identifying this build
+    };
+
+    // Result of the safe-point quiescence validation (DEVSTATE_001A contract
+    // turned into code). `ok == false` means SAVE must not proceed.
+    struct CheckpointSafetyResult
+    {
+        bool ok = false;
+        std::string reason;              // first failed gate, human-readable
+        // minimal diagnostics (values at the boundary)
+        uint64_t vsyncTick = 0;
+        uint32_t pendingInv = 0;
+        uint32_t failedGateValue = 0;
+    };
+
+    // Load pipeline stage. Guest resume in future phases must require
+    // Complete; this phase can only ever reach PartialRestore.
+    enum class CheckpointLoadStage : uint32_t
+    {
+        None = 0,
+        Parsed = 1,              // file validated + section table parsed
+        PartialRestore = 2,      // all implemented sections applied; guest
+                                 // MUST NOT run (terminal in DEVSTATE_003x)
+        Complete = 3,            // unreachable until every section + resume
+                                 // path exist (NO assignment to this value
+                                 // may exist in the codebase yet)
+        CoreMemMmioRestored = 4, // DEVSTATE_003B intermediate stage
+        SchedGsRestored = 5,     // DEVSTATE_003B intermediate stage
+    };
+
+    struct SectionInfo
+    {
+        SectionId id{};
+        uint32_t version = 0;
+        uint64_t offset = 0;
+        uint64_t size = 0;
+        uint32_t crc32 = 0;
+        uint32_t flags = 0;
+    };
+
+    struct ParsedCheckpoint
+    {
+        FileHeader header{};
+        std::vector<SectionInfo> sections;
+        std::filesystem::path path;
+        CheckpointLoadStage stage = CheckpointLoadStage::None;
+    };
+
+    struct CheckpointError
+    {
+        bool ok = true;
+        std::string message;
+        static CheckpointError success() { return {}; }
+        static CheckpointError failure(std::string msg)
+        {
+            return CheckpointError{false, std::move(msg)};
+        }
+    };
+
+    // Low-level deterministic byte sink/source used by all sections.
+    class ByteWriter
+    {
+    public:
+        void u8(uint8_t v);
+        void u16(uint16_t v);
+        void u32(uint32_t v);
+        void u64(uint64_t v);
+        void f32(float v);
+        void bytes(const void *data, size_t size);
+        const std::vector<uint8_t> &buffer() const { return m_buffer; }
+        std::vector<uint8_t> take() { return std::move(m_buffer); }
+
+    private:
+        std::vector<uint8_t> m_buffer;
+    };
+
+    class ByteReader
+    {
+    public:
+        ByteReader(const uint8_t *data, size_t size) : m_data(data), m_size(size) {}
+        bool u8(uint8_t &v);
+        bool u16(uint16_t &v);
+        bool u32(uint32_t &v);
+        bool u64(uint64_t &v);
+        bool f32(float &v);
+        bool bytes(void *out, size_t size);
+        bool skip(size_t size);
+        size_t remaining() const { return m_size - m_pos; }
+        bool atEnd() const { return m_pos == m_size; }
+
+    private:
+        const uint8_t *m_data = nullptr;
+        size_t m_size = 0;
+        size_t m_pos = 0;
+    };
+
+    // File-level writer: accumulates section payloads, then commits the whole
+    // file via temp file + atomic rename (design §14: all-or-nothing SAVE).
+    class CheckpointFileWriter
+    {
+    public:
+        explicit CheckpointFileWriter(CheckpointIdentity identity);
+        void addSection(SectionId id, uint32_t version, uint32_t flags,
+                        std::vector<uint8_t> payload);
+        CheckpointError commit(const std::filesystem::path &finalPath,
+                               uint64_t savedAtUnixMs);
+
+    private:
+        CheckpointIdentity m_identity;
+        struct PendingSection
+        {
+            SectionId id;
+            uint32_t version;
+            uint32_t flags;
+            std::vector<uint8_t> payload;
+        };
+        std::vector<PendingSection> m_sections;
+    };
+
+    // File-level reader/validator: validates magic/version/arch/identity,
+    // section table bounds and every section checksum BEFORE any state is
+    // mutated (design §14: fail-fast, validate-all-first).
+    class CheckpointFileReader
+    {
+    public:
+        static CheckpointError parseAndValidate(const std::filesystem::path &path,
+                                                const CheckpointIdentity &expected,
+                                                ParsedCheckpoint &out);
+        static CheckpointError readSectionPayload(const ParsedCheckpoint &pc,
+                                                  SectionId id,
+                                                  std::vector<uint8_t> &out);
+    };
+
+    // High-level orchestration over a PS2Runtime. Friend of PS2Runtime.
+    class CheckpointManager
+    {
+    public:
+        // Serializes CORE+MEM+MMIO. Refuses (returns failure, writes nothing)
+        // unless validateSafePoint(runtime) passes. Caller must already be at
+        // the certified MAIN_MENU_V1 boundary with the EE executor parked.
+        static CheckpointError save(PS2Runtime &runtime,
+                                    const CheckpointIdentity &identity,
+                                    const std::filesystem::path &finalPath);
+
+        // Parses+validates the file, then applies CORE/MEM/MMIO into the
+        // runtime. Leaves the checkpoint at PartialRestore. NEVER starts the
+        // guest; callers must not either (enforced by stage gating in future
+        // phases).
+        static CheckpointError loadPartial(PS2Runtime &runtime,
+                                           const CheckpointIdentity &expected,
+                                           const std::filesystem::path &path,
+                                           ParsedCheckpoint &outParsed);
+
+        // DEVSTATE_001A quiescence contract as code (design §2/§14).
+        static CheckpointSafetyResult validateSafePoint(PS2Runtime &runtime);
+
+        // Section codecs (exposed for self-tests; deterministic by contract).
+        static std::vector<uint8_t> serializeCore(const PS2Runtime &runtime);
+        static CheckpointError deserializeCore(PS2Runtime &runtime,
+                                               const std::vector<uint8_t> &payload);
+        static std::vector<uint8_t> serializeMem(const PS2Runtime &runtime);
+        static CheckpointError deserializeMem(PS2Runtime &runtime,
+                                              const std::vector<uint8_t> &payload);
+        static std::vector<uint8_t> serializeMmio(const PS2Runtime &runtime);
+        static CheckpointError deserializeMmio(PS2Runtime &runtime,
+                                               const std::vector<uint8_t> &payload);
+        // DEVSTATE_003B: SCHED/GS sections (codecs live on EeScheduler / GS).
+        static CheckpointError serializeSched(PS2Runtime &runtime,
+                                              std::vector<uint8_t> &out);
+        static CheckpointError deserializeSched(PS2Runtime &runtime,
+                                                const std::vector<uint8_t> &payload);
+        static CheckpointError serializeGs(PS2Runtime &runtime,
+                                           std::vector<uint8_t> &out);
+        static CheckpointError deserializeGs(PS2Runtime &runtime,
+                                             const std::vector<uint8_t> &payload);
+
+        // DEVSTATE_003C: remaining v1-required sections.
+        static CheckpointError serializeIop(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeIop(PS2Runtime &runtime,
+                                              const std::vector<uint8_t> &payload);
+        static CheckpointError serializeSifRpc(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeSifRpc(PS2Runtime &runtime,
+                                                 const std::vector<uint8_t> &payload);
+        static CheckpointError serializeCd(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeCd(PS2Runtime &runtime,
+                                             const std::vector<uint8_t> &payload);
+        static CheckpointError serializeMc(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeMc(PS2Runtime &runtime,
+                                             const std::vector<uint8_t> &payload);
+        static CheckpointError serializeAudio(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeAudio(PS2Runtime &runtime,
+                                                const std::vector<uint8_t> &payload);
+        static CheckpointError serializePad(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializePad(PS2Runtime &runtime,
+                                              const std::vector<uint8_t> &payload);
+        static CheckpointError serializeMpeg(PS2Runtime &runtime, std::vector<uint8_t> &out);
+        static CheckpointError deserializeMpeg(PS2Runtime &runtime,
+                                               const std::vector<uint8_t> &payload);
+
+        // Full v1 load: parses+validates, then restores ALL 12 sections in
+        // the design order (MEM->MMIO->CORE->GS->SCHED->IOP->SIF_RPC->CD->
+        // MC->AUDIO->PAD->MPEG) and performs host rebind + derived-state
+        // reconstruction (steps 14-15). Leaves stage at PartialRestore
+        // (renamed meaning for 003C: "every implemented section applied,
+        // host rebound, guest NOT yet dispatched"). The caller (gameThread)
+        // is the ONLY place allowed to set stage to Complete, immediately
+        // before invoking EeScheduler::run().
+        static CheckpointError loadFull(PS2Runtime &runtime,
+                                        const CheckpointIdentity &expected,
+                                        const std::filesystem::path &path,
+                                        ParsedCheckpoint &outParsed);
+    };
+
+    // Shared R5900 context codec (used by CORE and by the SCHED section's
+    // per-thread/per-invocation contexts; field-by-field, no padding).
+    void writeR5900Context(ByteWriter &w, const R5900Context &c);
+    bool readR5900Context(ByteReader &r, R5900Context &c);
+
+    // Process-wide checkpoint identity, registered once by main() so any
+    // save trigger (scheduler request, hotkey) can use it without touching
+    // PS2Runtime's shared header.
+    void setProcessIdentity(const CheckpointIdentity &identity);
+    const CheckpointIdentity &processIdentity();
+    bool hasProcessIdentity();
+
+    // Computes this process's runtime build identity (hash of the running
+    // executable image file). Cached after first call.
+    const uint8_t *runtimeBuildId();
+
+    // Digest (same 4-lane FNV-1a-64 construction as runtimeBuildId) of an
+    // arbitrary file -- used for the boot ELF identity.
+    void computeFileDigest(const std::filesystem::path &path, uint8_t out[32]);
+
+    // Self-tests for the infrastructure (DEVSTATE_003A PARTE 7, tests 1-10).
+    // Returns 0 on success, nonzero (count of failures) otherwise. Only run
+    // when explicitly requested (env DMC_CHECKPOINT_SELFTEST=1 in main).
+    int runSelfTests(const std::filesystem::path &tempDir);
+    // Variant used by main: supplies the constructed (not running) runtime so
+    // the CORE/MEM/MMIO determinism tests (6-9) can execute.
+    int runSelfTestsWithRuntime(PS2Runtime *runtime, const std::filesystem::path &tempDir);
+}
+
+#endif // PS2X_CHECKPOINT_H
diff --git a/ps2xRuntime/include/runtime/checkpoint/checkpoint_format.h b/ps2xRuntime/include/runtime/checkpoint/checkpoint_format.h
