 namespace ps2_syscalls
 {
+    // DEVSTATE_003C checkpoint codec for EE-side RPC state. Debug history
+    // (g_sif_rpc_debug_history/next_seq) is intentionally NOT serialized --
+    // it is diagnostics only (DEVSTATE_002 §11 policy), never consulted for
+    // guest-observable behavior. Safe-point gate: no RpcClientState may have
+    // `busy == true` (an RPC call in flight) -- matches the PART 2
+    // "SAVE invariant: no RPC invocation in flight".
+    bool checkpointValidateRpcSafe(std::string &reason)
+    {
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
+        for (const auto &kv : g_rpc_clients)
+        {
+            if (kv.second.busy)
+            {
+                reason = "RPC client busy (call in flight)";
+                return false;
+            }
+        }
+        return true;
+    }
