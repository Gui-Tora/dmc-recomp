+    void appendU32(std::vector<uint8_t> &out, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+    bool readU32(const uint8_t *d, size_t size, size_t &pos, uint32_t &v)
+    {
+        if (size - pos < 4u)
+            return false;
+        v = 0;
+        for (int i = 0; i < 4; ++i)
+            v |= static_cast<uint32_t>(d[pos + i]) << (8 * i);
+        pos += 4;
+        return true;
+    }
+}
