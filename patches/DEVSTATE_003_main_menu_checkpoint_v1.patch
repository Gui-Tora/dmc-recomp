+EeScheduler::CheckpointQuiescence EeScheduler::collectCheckpointQuiescence() const
+{
+    // DEVSTATE_003A: same counting rules as the DEVSTATE_001A probe that
+    // certified the safe point. Read-only.
+    CheckpointQuiescence q;
+    q.vsyncTick = m_vsyncTick;
+    q.pendingInv = static_cast<uint32_t>(m_pendingInvocations.size());
+    for (const GuestInvocation &inv : m_pendingInvocations)
+    {
+        if (inv.onComplete)
+            ++q.pendingInvWithCompletion;
+        if (inv.kind == GuestInvocationKind::RpcCallback)
+            ++q.pendingRpcInv;
+    }
+    for (const auto &kv : m_threads)
+    {
+        const GuestThread &th = kv.second;
+        q.activeInv += static_cast<uint32_t>(th.invocations.size());
+        for (const GuestInvocation &inv : th.invocations)
+            if (inv.onComplete)
+                ++q.activeInvWithCompletion;
+        if (th.resumeCompletion)
+            ++q.threadsWithResumeCompletion;
+        if (th.wait.completion)
+            ++q.threadsWithWaitCompletion;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_eventMutex);
+        q.queuedEvents = static_cast<uint32_t>(m_events.size());
+    }
+    q.pendingTimerIrqMask = m_pendingEeTimerInterrupts;
+    q.alarms = static_cast<uint32_t>(m_alarms.size());
+    return q;
+}
+
+// ======================================================================
+// DEVSTATE_003B: SCHED checkpoint codec + real-save request handling.
+// ======================================================================
+namespace
+{
+    using ps2x::checkpoint::ByteReader;
+    using ps2x::checkpoint::ByteWriter;
+
+    void writeWaitPayload(ByteWriter &w, const EeWaitPayload &payload)
+    {
+        if (std::holds_alternative<std::monostate>(payload))
+        {
+            w.u8(0u);
+        }
+        else if (const auto *sem = std::get_if<EeSemaphoreWait>(&payload))
+        {
+            w.u8(1u);
+            w.u32(static_cast<uint32_t>(sem->id));
+        }
+        else if (const auto *evf = std::get_if<EeEventFlagWait>(&payload))
+        {
+            w.u8(2u);
+            w.u32(static_cast<uint32_t>(evf->id));
+            w.u32(evf->bits);
+            w.u32(evf->mode);
+            w.u32(evf->resultAddress);
+        }
+        else if (const auto *vs = std::get_if<EeVSyncWait>(&payload))
+        {
+            w.u8(3u);
+            w.u64(vs->afterTick);
+            w.u32(static_cast<uint32_t>(vs->fixedResult));
+        }
+        else if (const auto *ext = std::get_if<EeExternalWait>(&payload))
+        {
+            w.u8(4u);
+            w.u32(ext->type);
+            w.u64(ext->token);
+        }
+    }
+
+    bool readWaitPayload(ByteReader &r, EeWaitPayload &payload)
+    {
+        uint8_t tag = 0;
+        if (!r.u8(tag))
+            return false;
+        switch (tag)
+        {
+        case 0u:
+            payload = std::monostate{};
+            return true;
+        case 1u:
+        {
+            EeSemaphoreWait v{};
+            uint32_t id = 0;
+            if (!r.u32(id))
+                return false;
+            v.id = static_cast<int>(id);
+            payload = v;
+            return true;
+        }
+        case 2u:
+        {
+            EeEventFlagWait v{};
+            uint32_t id = 0;
+            if (!r.u32(id) || !r.u32(v.bits) || !r.u32(v.mode) || !r.u32(v.resultAddress))
+                return false;
+            v.id = static_cast<int>(id);
+            payload = v;
+            return true;
+        }
+        case 3u:
+        {
+            EeVSyncWait v{};
+            uint32_t fixed = 0;
+            if (!r.u64(v.afterTick) || !r.u32(fixed))
+                return false;
+            v.fixedResult = static_cast<int>(fixed);
+            payload = v;
+            return true;
+        }
+        case 4u:
+        {
+            EeExternalWait v{};
+            if (!r.u32(v.type) || !r.u64(v.token))
+                return false;
+            payload = v;
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
+
+    template <typename MapT>
+    std::vector<int> sortedKeys(const MapT &map)
+    {
+        std::vector<int> keys;
+        keys.reserve(map.size());
+        for (const auto &kv : map)
+            keys.push_back(kv.first);
+        std::sort(keys.begin(), keys.end());
+        return keys;
+    }
+}
+
+bool EeScheduler::serializeCheckpointState(ps2x::checkpoint::ByteWriter &w,
+                                           std::string &error) const
+{
+    using ps2x::checkpoint::writeR5900Context;
+
+    // Threads (sorted by id for determinism)
+    const std::vector<int> threadIds = sortedKeys(m_threads);
+    w.u32(static_cast<uint32_t>(threadIds.size()));
+    for (int id : threadIds)
+    {
+        const GuestThread &th = m_threads.at(id);
+        if (th.wait.completion)
+        {
+            error = "thread wait completion pending (thread " + std::to_string(id) + ")";
+            return false;
+        }
+        if (th.resumeCompletion)
+        {
+            error = "thread resumeCompletion pending (thread " + std::to_string(id) + ")";
+            return false;
+        }
+        w.u32(static_cast<uint32_t>(th.id));
+        writeR5900Context(w, th.context);
+        w.u32(th.entry);
+        w.u32(th.stack);
+        w.u32(th.stackSize);
+        w.u32(th.gp);
+        w.u32(th.attr);
+        w.u32(th.option);
+        w.u32(th.arg);
+        w.u32(static_cast<uint32_t>(th.initialPriority));
+        w.u32(static_cast<uint32_t>(th.currentPriority));
+        w.u8(static_cast<uint8_t>(th.status));
+        w.u32(static_cast<uint32_t>(th.suspendCount));
+        w.u32(th.wakeupCount);
+        w.u8(th.ownsStack ? 1u : 0u);
+        w.u32(th.tlsBase);
+        w.u8(static_cast<uint8_t>(th.wait.reason));
+        writeWaitPayload(w, th.wait.payload);
+        w.u32(static_cast<uint32_t>(th.invocations.size()));
+        for (const GuestInvocation &inv : th.invocations)
+        {
+            if (inv.onComplete)
+            {
+                error = "active invocation with onComplete (thread " + std::to_string(id) + ")";
+                return false;
+            }
+            w.u8(static_cast<uint8_t>(inv.kind));
+            w.u64(inv.sequence);
+            w.u64(inv.tag);
+            writeR5900Context(w, inv.context);
+        }
+    }
+
+    // Ready queues (order matters)
+    for (const auto &queue : m_readyQueues)
+    {
+        w.u32(static_cast<uint32_t>(queue.size()));
+        for (int id : queue)
+            w.u32(static_cast<uint32_t>(id));
+    }
+
+    // Semaphores
+    {
+        const std::vector<int> ids = sortedKeys(m_semaphores);
+        w.u32(static_cast<uint32_t>(ids.size()));
+        for (int id : ids)
+        {
+            const EeSemaphore &s = m_semaphores.at(id);
+            w.u32(static_cast<uint32_t>(s.id));
+            w.u32(static_cast<uint32_t>(s.count));
+            w.u32(static_cast<uint32_t>(s.maxCount));
+            w.u32(static_cast<uint32_t>(s.initCount));
+            w.u32(s.attr);
+            w.u32(s.option);
+            w.u32(static_cast<uint32_t>(s.waiters.size()));
+            for (int wid : s.waiters)
+                w.u32(static_cast<uint32_t>(wid));
+        }
+    }
+
+    // Event flags
+    {
+        const std::vector<int> ids = sortedKeys(m_eventFlags);
+        w.u32(static_cast<uint32_t>(ids.size()));
+        for (int id : ids)
+        {
+            const EeEventFlag &f = m_eventFlags.at(id);
+            w.u32(static_cast<uint32_t>(f.id));
+            w.u32(f.attr);
+            w.u32(f.option);
+            w.u32(f.initBits);
+            w.u32(f.bits);
+            w.u32(static_cast<uint32_t>(f.waiters.size()));
+            for (int wid : f.waiters)
+                w.u32(static_cast<uint32_t>(wid));
+        }
+    }
+
+    // Alarms (guest handler addresses only; deadlines are in the deadline
+    // list below as logical cycles)
+    {
+        const std::vector<int> ids = sortedKeys(m_alarms);
+        w.u32(static_cast<uint32_t>(ids.size()));
+        for (int id : ids)
+        {
+            const EeAlarm &a = m_alarms.at(id);
+            w.u32(static_cast<uint32_t>(a.id));
+            w.u16(a.ticks);
+            w.u32(a.handler);
+            w.u32(a.argument);
+            w.u32(a.gp);
+            w.u32(a.sp);
+        }
+    }
+
+    // INTC/DMAC handlers
+    auto writeHandlers = [&w](const std::unordered_map<int, EeIrqHandler> &map)
+    {
+        std::vector<int> ids;
+        ids.reserve(map.size());
+        for (const auto &kv : map)
+            ids.push_back(kv.first);
+        std::sort(ids.begin(), ids.end());
+        w.u32(static_cast<uint32_t>(ids.size()));
+        for (int id : ids)
+        {
+            const EeIrqHandler &h = map.at(id);
+            w.u32(static_cast<uint32_t>(h.id));
+            w.u32(h.cause);
+            w.u32(h.handler);
+            w.u32(h.argument);
+            w.u32(h.gp);
+            w.u32(h.sp);
+            w.u8(h.enabled ? 1u : 0u);
+            w.u32(static_cast<uint32_t>(h.order));
+        }
+    };
+    writeHandlers(m_intcHandlers);
+    writeHandlers(m_dmacHandlers);
+
+    // Allocators / ordering / masks / dispatch state
+    w.u32(static_cast<uint32_t>(m_nextThreadId));
+    w.u32(static_cast<uint32_t>(m_nextInvocationThreadId));
+    w.u32(static_cast<uint32_t>(m_nextSemaphoreId));
+    w.u32(static_cast<uint32_t>(m_nextEventFlagId));
+    w.u32(static_cast<uint32_t>(m_nextAlarmId));
+    w.u32(static_cast<uint32_t>(m_nextIntcHandlerId));
+    w.u32(static_cast<uint32_t>(m_nextDmacHandlerId));
+    w.u32(static_cast<uint32_t>(m_intcHeadOrder));
+    w.u32(static_cast<uint32_t>(m_intcTailOrder));
+    w.u32(static_cast<uint32_t>(m_dmacHeadOrder));
+    w.u32(static_cast<uint32_t>(m_dmacTailOrder));
+    w.u32(m_enabledIntcMask);
+    w.u32(m_enabledDmacMask);
+    w.u32(static_cast<uint32_t>(m_currentThreadId));
+    w.u8(m_rescheduleRequested ? 1u : 0u);
+    w.u8(m_timeSliceExpired ? 1u : 0u);
+    w.u8(m_insideInterrupt ? 1u : 0u);
+    w.u32(m_pendingEeTimerInterrupts);
+    w.u64(m_eeCycle);
+    w.u64(m_sliceEndCycle);
+    w.u32(m_debugPublishCountdown);
+
+    // Pending invocations (context-only; onComplete must be absent)
+    w.u32(static_cast<uint32_t>(m_pendingInvocations.size()));
+    for (const GuestInvocation &inv : m_pendingInvocations)
+    {
+        if (inv.onComplete)
+        {
+            error = "pending invocation with onComplete";
+            return false;
+        }
+        w.u8(static_cast<uint8_t>(inv.kind));
+        w.u64(inv.sequence);
+        w.u64(inv.tag);
+        writeR5900Context(w, inv.context);
+    }
+
+    // VSync / sequences / invocation stack tops
+    w.u64(m_vsyncTick);
+    w.u32(m_vsyncFlagAddress);
+    w.u32(m_vsyncTickAddress);
+    w.u32(m_gsVSyncCallback);
+    w.u32(m_gsVSyncCallbackGp);
+    w.u32(m_gsVSyncCallbackSp);
+    w.u64(m_eventSequence);
+    w.u64(m_invocationSequence);
+    {
+        std::vector<uint64_t> keys;
+        keys.reserve(m_invocationStackTops.size());
+        for (const auto &kv : m_invocationStackTops)
+            keys.push_back(kv.first);
+        std::sort(keys.begin(), keys.end());
+        w.u32(static_cast<uint32_t>(keys.size()));
+        for (uint64_t k : keys)
+        {
+            w.u64(k);
+            w.u32(m_invocationStackTops.at(k));
+        }
+    }
+
+    // Queued events must be empty at the safe point (design §3.2)
+    {
+        std::lock_guard<std::mutex> lock(m_eventMutex);
+        if (!m_events.empty())
+        {
+            error = "queued scheduler events present";
+            return false;
+        }
+        w.u32(0u);
+    }
+
+    // Deadlines: logical cycles + event + sequence ONLY. hostDeadline is
+    // host state and is re-derived on load (design §3.2 / PARTE 3).
+    w.u32(static_cast<uint32_t>(m_deadlines.size()));
+    for (const ScheduledEvent &d : m_deadlines)
+    {
+        w.u64(d.deadlineCycle);
+        w.u64(d.sequence);
+        w.u8(static_cast<uint8_t>(d.event.type));
+        w.u32(d.event.id);
+        w.u64(d.event.value);
+    }
+
+    return true;
+}
+
+bool EeScheduler::deserializeCheckpointState(ps2x::checkpoint::ByteReader &r,
+                                             std::string &error)
+{
+    using ps2x::checkpoint::readR5900Context;
+    auto fail = [&error](const char *what)
+    {
+        error = what;
+        return false;
+    };
+
+    uint32_t threadCount = 0;
+    if (!r.u32(threadCount) || threadCount > 1024u)
+        return fail("SCHED: bad thread count");
+    m_threads.clear();
+    for (uint32_t i = 0; i < threadCount; ++i)
+    {
+        GuestThread th{};
+        uint32_t v32 = 0;
+        uint8_t v8 = 0;
+        if (!r.u32(v32))
+            return fail("SCHED: truncated thread id");
+        th.id = static_cast<int>(v32);
+        if (!readR5900Context(r, th.context))
+            return fail("SCHED: truncated thread context");
+        if (!r.u32(th.entry) || !r.u32(th.stack) || !r.u32(th.stackSize) || !r.u32(th.gp) ||
+            !r.u32(th.attr) || !r.u32(th.option) || !r.u32(th.arg))
+            return fail("SCHED: truncated thread fields");
+        if (!r.u32(v32))
+            return fail("SCHED: truncated thread prio");
+        th.initialPriority = static_cast<int>(v32);
+        if (!r.u32(v32))
+            return fail("SCHED: truncated thread prio2");
+        th.currentPriority = static_cast<int>(v32);
+        if (!r.u8(v8))
+            return fail("SCHED: truncated thread status");
+        th.status = static_cast<EeThreadStatus>(v8);
+        if (!r.u32(v32))
+            return fail("SCHED: truncated suspendCount");
+        th.suspendCount = static_cast<int>(v32);
+        if (!r.u32(th.wakeupCount))
+            return fail("SCHED: truncated wakeupCount");
+        if (!r.u8(v8))
+            return fail("SCHED: truncated ownsStack");
+        th.ownsStack = v8 != 0;
+        if (!r.u32(th.tlsBase))
+            return fail("SCHED: truncated tlsBase");
+        if (!r.u8(v8))
+            return fail("SCHED: truncated wait reason");
+        th.wait.reason = static_cast<EeWaitReason>(v8);
+        if (!readWaitPayload(r, th.wait.payload))
+            return fail("SCHED: truncated wait payload");
+        uint32_t invCount = 0;
+        if (!r.u32(invCount) || invCount > 64u)
+            return fail("SCHED: bad invocation count");
+        th.invocations.clear();
+        for (uint32_t j = 0; j < invCount; ++j)
+        {
+            GuestInvocation inv{};
+            if (!r.u8(v8))
+                return fail("SCHED: truncated invocation kind");
+            inv.kind = static_cast<GuestInvocationKind>(v8);
+            if (!r.u64(inv.sequence) || !r.u64(inv.tag))
+                return fail("SCHED: truncated invocation ids");
+            if (!readR5900Context(r, inv.context))
+                return fail("SCHED: truncated invocation context");
+            th.invocations.push_back(std::move(inv));
+        }
+        m_threads.emplace(th.id, std::move(th));
+    }
+
+    for (auto &queue : m_readyQueues)
+    {
+        uint32_t count = 0;
+        if (!r.u32(count) || count > 1024u)
+            return fail("SCHED: bad ready queue count");
+        queue.clear();
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            uint32_t id = 0;
+            if (!r.u32(id))
+                return fail("SCHED: truncated ready queue");
+            queue.push_back(static_cast<int>(id));
+        }
+    }
+
+    uint32_t semCount = 0;
+    if (!r.u32(semCount) || semCount > 4096u)
+        return fail("SCHED: bad semaphore count");
+    m_semaphores.clear();
+    for (uint32_t i = 0; i < semCount; ++i)
+    {
+        EeSemaphore s{};
+        uint32_t v32 = 0;
+        if (!r.u32(v32))
+            return fail("SCHED: truncated sem id");
+        s.id = static_cast<int>(v32);
+        if (!r.u32(v32))
+            return fail("SCHED: truncated sem count");
+        s.count = static_cast<int>(v32);
+        if (!r.u32(v32))
+            return fail("SCHED: truncated sem max");
+        s.maxCount = static_cast<int>(v32);
+        if (!r.u32(v32))
+            return fail("SCHED: truncated sem init");
+        s.initCount = static_cast<int>(v32);
+        if (!r.u32(s.attr) || !r.u32(s.option))
+            return fail("SCHED: truncated sem attr");
+        uint32_t wcount = 0;
+        if (!r.u32(wcount) || wcount > 1024u)
+            return fail("SCHED: bad sem waiters");
+        for (uint32_t j = 0; j < wcount; ++j)
+        {
+            uint32_t wid = 0;
+            if (!r.u32(wid))
+                return fail("SCHED: truncated sem waiter");
+            s.waiters.push_back(static_cast<int>(wid));
+        }
+        m_semaphores.emplace(s.id, std::move(s));
+    }
+
+    uint32_t evfCount = 0;
+    if (!r.u32(evfCount) || evfCount > 4096u)
+        return fail("SCHED: bad eventflag count");
+    m_eventFlags.clear();
+    for (uint32_t i = 0; i < evfCount; ++i)
+    {
+        EeEventFlag f{};
+        uint32_t v32 = 0;
+        if (!r.u32(v32))
+            return fail("SCHED: truncated evf id");
+        f.id = static_cast<int>(v32);
+        if (!r.u32(f.attr) || !r.u32(f.option) || !r.u32(f.initBits) || !r.u32(f.bits))
+            return fail("SCHED: truncated evf fields");
+        uint32_t wcount = 0;
+        if (!r.u32(wcount) || wcount > 1024u)
+            return fail("SCHED: bad evf waiters");
+        for (uint32_t j = 0; j < wcount; ++j)
+        {
+            uint32_t wid = 0;
+            if (!r.u32(wid))
+                return fail("SCHED: truncated evf waiter");
+            f.waiters.push_back(static_cast<int>(wid));
+        }
+        m_eventFlags.emplace(f.id, std::move(f));
+    }
+
+    uint32_t alarmCount = 0;
+    if (!r.u32(alarmCount) || alarmCount > 4096u)
+        return fail("SCHED: bad alarm count");
+    m_alarms.clear();
+    for (uint32_t i = 0; i < alarmCount; ++i)
+    {
+        EeAlarm a{};
+        uint32_t v32 = 0;
+        if (!r.u32(v32))
+            return fail("SCHED: truncated alarm id");
+        a.id = static_cast<int>(v32);
+        if (!r.u16(a.ticks) || !r.u32(a.handler) || !r.u32(a.argument) || !r.u32(a.gp) ||
+            !r.u32(a.sp))
+            return fail("SCHED: truncated alarm fields");
+        m_alarms.emplace(a.id, a);
+    }
+
+    auto readHandlers = [&](std::unordered_map<int, EeIrqHandler> &map) -> bool
+    {
+        uint32_t count = 0;
+        if (!r.u32(count) || count > 4096u)
+            return false;
+        map.clear();
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            EeIrqHandler h{};
+            uint32_t v32 = 0;
+            uint8_t v8 = 0;
+            if (!r.u32(v32))
+                return false;
+            h.id = static_cast<int>(v32);
+            if (!r.u32(h.cause) || !r.u32(h.handler) || !r.u32(h.argument) || !r.u32(h.gp) ||
+                !r.u32(h.sp) || !r.u8(v8))
+                return false;
+            h.enabled = v8 != 0;
+            if (!r.u32(v32))
+                return false;
+            h.order = static_cast<int>(v32);
+            map.emplace(h.id, h);
+        }
+        return true;
+    };
+    if (!readHandlers(m_intcHandlers))
+        return fail("SCHED: truncated intc handlers");
+    if (!readHandlers(m_dmacHandlers))
+        return fail("SCHED: truncated dmac handlers");
+
+    uint32_t v32 = 0;
+    uint8_t v8 = 0;
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextThreadId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextInvocationThreadId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextSemaphoreId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextEventFlagId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextAlarmId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextIntcHandlerId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated allocators");
+    m_nextDmacHandlerId = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated orders");
+    m_intcHeadOrder = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated orders");
+    m_intcTailOrder = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated orders");
+    m_dmacHeadOrder = static_cast<int>(v32);
+    if (!r.u32(v32))
+        return fail("SCHED: truncated orders");
+    m_dmacTailOrder = static_cast<int>(v32);
+    if (!r.u32(m_enabledIntcMask) || !r.u32(m_enabledDmacMask))
+        return fail("SCHED: truncated masks");
+    if (!r.u32(v32))
+        return fail("SCHED: truncated current thread");
+    m_currentThreadId = static_cast<int>(v32);
+    if (!r.u8(v8))
+        return fail("SCHED: truncated flags");
+    m_rescheduleRequested = v8 != 0;
+    if (!r.u8(v8))
+        return fail("SCHED: truncated flags");
+    m_timeSliceExpired = v8 != 0;
+    if (!r.u8(v8))
+        return fail("SCHED: truncated flags");
+    m_insideInterrupt = v8 != 0;
+    if (!r.u32(m_pendingEeTimerInterrupts) || !r.u64(m_eeCycle) || !r.u64(m_sliceEndCycle) ||
+        !r.u32(m_debugPublishCountdown))
+        return fail("SCHED: truncated dispatch state");
+
+    uint32_t pendingCount = 0;
+    if (!r.u32(pendingCount) || pendingCount > 1024u)
+        return fail("SCHED: bad pending invocation count");
+    m_pendingInvocations.clear();
+    for (uint32_t i = 0; i < pendingCount; ++i)
+    {
+        GuestInvocation inv{};
+        if (!r.u8(v8))
+            return fail("SCHED: truncated pending kind");
+        inv.kind = static_cast<GuestInvocationKind>(v8);
+        if (!r.u64(inv.sequence) || !r.u64(inv.tag))
+            return fail("SCHED: truncated pending ids");
+        if (!readR5900Context(r, inv.context))
+            return fail("SCHED: truncated pending context");
+        m_pendingInvocations.push_back(std::move(inv));
+    }
+
+    if (!r.u64(m_vsyncTick) || !r.u32(m_vsyncFlagAddress) || !r.u32(m_vsyncTickAddress) ||
+        !r.u32(m_gsVSyncCallback) || !r.u32(m_gsVSyncCallbackGp) || !r.u32(m_gsVSyncCallbackSp) ||
+        !r.u64(m_eventSequence) || !r.u64(m_invocationSequence))
+        return fail("SCHED: truncated vsync state");
+    uint32_t stackTops = 0;
+    if (!r.u32(stackTops) || stackTops > 65536u)
+        return fail("SCHED: bad stack top count");
+    m_invocationStackTops.clear();
+    for (uint32_t i = 0; i < stackTops; ++i)
+    {
+        uint64_t key = 0;
+        uint32_t value = 0;
+        if (!r.u64(key) || !r.u32(value))
+            return fail("SCHED: truncated stack tops");
+        m_invocationStackTops.emplace(key, value);
+    }
+
+    uint32_t eventCount = 0;
+    if (!r.u32(eventCount))
+        return fail("SCHED: truncated events");
+    if (eventCount != 0u)
+        return fail("SCHED: checkpoint contains queued events (unsupported)");
+    {
+        std::lock_guard<std::mutex> lock(m_eventMutex);
+        m_events.clear();
+    }
+
+    // Deadlines: re-derive hostDeadline from remaining emulated cycles
+    // relative to the restored m_eeCycle (PARTE 3 contract).
+    uint32_t deadlineCount = 0;
+    if (!r.u32(deadlineCount) || deadlineCount > 4096u)
+        return fail("SCHED: bad deadline count");
+    m_deadlines.clear();
+    const auto hostNow = std::chrono::steady_clock::now();
+    for (uint32_t i = 0; i < deadlineCount; ++i)
+    {
+        ScheduledEvent d{};
+        uint8_t type = 0;
+        if (!r.u64(d.deadlineCycle) || !r.u64(d.sequence) || !r.u8(type) ||
+            !r.u32(d.event.id) || !r.u64(d.event.value))
+            return fail("SCHED: truncated deadline");
+        d.event.type = static_cast<EeEventType>(type);
+        const uint64_t remaining =
+            d.deadlineCycle > m_eeCycle ? d.deadlineCycle - m_eeCycle : 0ull;
+        d.hostDeadline = hostNow + eeCyclesToHostDuration(remaining);
+        m_deadlines.push_back(d);
+    }
+    updateNextDeadline();
+    return true;
+}
+
+std::vector<EeScheduler::CheckpointDeadlineView> EeScheduler::checkpointDeadlineViews() const
+{
+    std::vector<CheckpointDeadlineView> out;
+    const auto now = std::chrono::steady_clock::now();
+    out.reserve(m_deadlines.size());
+    for (const ScheduledEvent &d : m_deadlines)
+    {
+        CheckpointDeadlineView v;
+        v.deadlineCycle = d.deadlineCycle;
+        v.sequence = d.sequence;
+        v.eventType = static_cast<uint8_t>(d.event.type);
+        v.remainingCycles = d.deadlineCycle > m_eeCycle ? d.deadlineCycle - m_eeCycle : 0ull;
+        v.hostDelayNanos = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                               d.hostDeadline - now)
+                               .count();
+        out.push_back(v);
+    }
+    return out;
+}
+
+void EeScheduler::debugEnqueueInvocationForTest(GuestInvocationKind kind, uint64_t tag,
+                                                bool withCompletion)
+{
+    GuestInvocation inv{};
+    inv.kind = kind;
+    inv.sequence = ++m_invocationSequence;
+    inv.tag = tag;
+    if (withCompletion)
+        inv.onComplete = [](const R5900Context &, R5900Context &) {};
+    m_pendingInvocations.push_back(std::move(inv));
+}
+
+void EeScheduler::debugClearPendingInvocationsForTest()
+{
+    m_pendingInvocations.clear();
+}
+
+bool EeScheduler::debugSetWaitCompletionForTest(int threadId, bool set)
+{
+    auto it = m_threads.find(threadId);
+    if (it == m_threads.end())
+        return false;
+    if (set)
+        it->second.wait.completion = [](R5900Context &) {};
+    else
+        it->second.wait.completion = {};
+    return true;
+}
+
+bool EeScheduler::requestCheckpoint(const std::filesystem::path &finalPath,
+                                    const ps2x::checkpoint::CheckpointIdentity &identity)
+{
+    {
+        std::lock_guard<std::mutex> lock(m_checkpointRequestMutex);
+        if (m_checkpointRequestStatus.state == CheckpointRequestState::Pending ||
+            m_checkpointRequestStatus.state == CheckpointRequestState::Saving)
+        {
+            return false;
+        }
+        m_checkpointRequestPath = finalPath;
+        m_checkpointRequestIdentity = identity;
+        m_checkpointRequestStatus = CheckpointRequestStatus{};
+        m_checkpointRequestStatus.state = CheckpointRequestState::Pending;
+    }
+    m_checkpointRequestPending.store(true, std::memory_order_release);
+    // Nudge the executor in case it is parked in waitForEvent().
+    m_eventCv.notify_all();
+    return true;
+}
+
+EeScheduler::CheckpointRequestStatus EeScheduler::checkpointRequestStatus() const
+{
+    std::lock_guard<std::mutex> lock(m_checkpointRequestMutex);
+    return m_checkpointRequestStatus;
+}
+
+void EeScheduler::handleCheckpointRequestAtBoundary()
+{
+    assertExecutor();
+    std::filesystem::path path;
+    ps2x::checkpoint::CheckpointIdentity identity;
+    {
+        std::lock_guard<std::mutex> lock(m_checkpointRequestMutex);
+        path = m_checkpointRequestPath;
+        identity = m_checkpointRequestIdentity;
+        m_checkpointRequestStatus.state = CheckpointRequestState::Saving;
+    }
+
+    const auto t0 = std::chrono::steady_clock::now();
+    const ps2x::checkpoint::CheckpointError err =
+        ps2x::checkpoint::CheckpointManager::save(m_runtime, identity, path);
+    const auto t1 = std::chrono::steady_clock::now();
+
+    uint64_t fileSize = 0;
+    if (err.ok)
+    {
+        std::error_code ec;
+        fileSize = static_cast<uint64_t>(std::filesystem::file_size(path, ec));
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(m_checkpointRequestMutex);
+        m_checkpointRequestStatus.state =
+            err.ok ? CheckpointRequestState::Success : CheckpointRequestState::Failed;
+        m_checkpointRequestStatus.message = err.ok ? "ok" : err.message;
+        m_checkpointRequestStatus.completedTick = m_vsyncTick;
+        m_checkpointRequestStatus.fileSizeBytes = fileSize;
+        m_checkpointRequestStatus.saveMillis =
+            std::chrono::duration<double, std::milli>(t1 - t0).count();
+    }
+    m_checkpointRequestPending.store(false, std::memory_order_release);
+
+    std::fprintf(stderr,
+                 "[CKPT:REQUEST] %s tick=%llu path=%s size=%llu ms=%.2f%s%s\n",
+                 err.ok ? "SUCCESS" : "FAILED",
+                 static_cast<unsigned long long>(m_vsyncTick),
+                 path.string().c_str(),
+                 static_cast<unsigned long long>(fileSize),
+                 std::chrono::duration<double, std::milli>(t1 - t0).count(),
+                 err.ok ? "" : " reason=",
+                 err.ok ? "" : err.message.c_str());
+}
+
+void EeScheduler::prepareForRestore(uint8_t *rdram)
+{
+    m_executorThread = std::this_thread::get_id();
+    m_rdram = rdram;
