+// DEVSTATE_003A: read-only quiescence probes used by the checkpoint
+// safe-point validator (DEVSTATE_001A contract). Each function is defined
+// inside the stub translation unit that owns the state it reads, so no
+// shared state moves and no semantics change. All are cheap and lock the
+// owning mutex where one exists.
+
+#ifndef PS2X_CHECKPOINT_PROBES_H
+#define PS2X_CHECKPOINT_PROBES_H
+
+#include <cstdint>
+#include <string>
+
+namespace ps2x::checkpoint
+{
+    class ByteWriter;
+    class ByteReader;
+}
+
+namespace ps2_stubs
+{
+    // 0x0 == no playbacks, no decoder, no buffered PSS bytes, no callbacks.
+    uint32_t checkpointProbeMpegMask();
+    // 0x0 == stream inactive, not paused, no produced-but-unconsumed sectors.
+    uint32_t checkpointProbeCdMask();
+    // 0x0 == no incomplete voice transfers, no active block transfers.
+    uint32_t checkpointProbeAudioMask();
+    // openFiles == guest MC FDs currently open; pending == command pending.
+    void checkpointProbeMc(uint32_t &openFiles, uint32_t &pending);
+    // DEVSTATE_003C: MC section codec (MemoryCard.cpp). Gate: openFiles==0 && !pending.
+    void checkpointSerializeMc(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeMc(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // DEVSTATE_003C: SIF-layer EE-side state codec (SIF.cpp). No safe-point
+    // gate of its own (SIF DMA transfers apply synchronously; see §16-bis).
+    void checkpointSerializeSif(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeSif(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // DEVSTATE_003C: CD section codec (CD.cpp). Gate: checkpointProbeCdMask()==0.
+    void checkpointSerializeCd(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeCd(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // DEVSTATE_003C: AUDIO HLE (voice/block transfer) codec (Audio.cpp).
+    // Gate: checkpointProbeAudioMask()==0. The sample bank itself is
+    // PS2AudioBackend::serializeCheckpointSampleBank (ps2_audio.h).
+    void checkpointSerializeAudioHle(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeAudioHle(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // DEVSTATE_003C: PAD section codec (Pad.cpp). No safe-point gate (guest
+    // protocol state is always representable; physical input is never
+    // serialized and is neutralized on load).
+    void checkpointSerializePad(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializePad(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // DEVSTATE_003C: MPEG section codec (MPEG.cpp). Gate:
+    // checkpointProbeMpegMask()==0.
+    void checkpointSerializeMpeg(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeMpeg(ps2x::checkpoint::ByteReader &r, std::string &error);
+}
+
+namespace ps2_syscalls
+{
+    // DEVSTATE_003C: RPC-layer EE-side state codec (RPC.cpp). Gate: no
+    // RpcClientState may be `busy` (call in flight).
+    bool checkpointValidateRpcSafe(std::string &reason);
+    void checkpointSerializeRpc(ps2x::checkpoint::ByteWriter &w);
+    bool checkpointDeserializeRpc(ps2x::checkpoint::ByteReader &r, std::string &error);
+
+    // Number of open guest fio file descriptors (host FILE* table). The v1
+    // safe point requires 0 (DEVSTATE_003A finding: FileIO Syscalls keep a
+    // process-wide fd->FILE* table; FILE* is FORBIDDEN_HOST_STATE).
+    uint32_t checkpointProbeFioOpenCount();
+}
