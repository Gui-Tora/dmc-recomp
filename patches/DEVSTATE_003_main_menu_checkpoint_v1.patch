+                if (!r.u32(k) || !r.u32(v))
+                    return false;
+                m.emplace(k, v);
+            }
+            return true;
+        };
+        if (!readMap(g_sifRegs)) { error = "SIF: truncated g_sifRegs"; return false; }
+        if (!readMap(g_sifSregs)) { error = "SIF: truncated g_sifSregs"; return false; }
+        if (!readMap(g_sifCmdHandlers)) { error = "SIF: truncated g_sifCmdHandlers"; return false; }
+        uint32_t heapCount = 0;
+        if (!r.u32(heapCount) || heapCount > 1000000u)
+        {
+            error = "SIF: truncated g_sifHeapAllocations count";
+            return false;
+        }
+        g_sifHeapAllocations.clear();
+        for (uint32_t i = 0; i < heapCount; ++i)
+        {
+            uint32_t k = 0, v = 0;
+            if (!r.u32(k) || !r.u32(v))
+            {
+                error = "SIF: truncated g_sifHeapAllocations entry";
+                return false;
+            }
+            g_sifHeapAllocations.emplace(k, v);
+        }
+        if (!r.bytes(g_sifHeapStorage.data(), g_sifHeapStorage.size()))
+        {
+            error = "SIF: truncated g_sifHeapStorage";
+            return false;
+        }
+        uint8_t initialized = 0;
+        if (!r.u32(g_sifCmdBuffer) || !r.u32(g_sifSysCmdBuffer) || !r.u8(initialized) ||
+            !r.u32(g_nextSifDmaTransferId))
+        {
+            error = "SIF: truncated scalars";
+            return false;
+        }
+        g_sifCmdInitialized = initialized != 0u;
+        return true;
+    }
