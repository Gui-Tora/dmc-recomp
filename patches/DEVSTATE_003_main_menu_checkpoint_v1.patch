+    // --- runtime build identity -------------------------------------------
+    // Non-cryptographic but strongly collision-resistant-in-practice identity
+    // of the running executable image: 4 independent 64-bit FNV-1a lanes over
+    // the file bytes (lane i seeds differ). v1 policy only needs equality of
+    // the exact same build (design §15 strict build-id).
+    namespace
+    {
+        void hashFileLanes(const std::filesystem::path &p, uint8_t out[32])
+        {
+            uint64_t lanes[4] = {1469598103934665603ull ^ 0x11111111u,
+                                 1469598103934665603ull ^ 0x22222222u,
+                                 1469598103934665603ull ^ 0x33333333u,
+                                 1469598103934665603ull ^ 0x44444444u};
+            std::ifstream in(p, std::ios::binary);
+            std::vector<char> buf(1u << 16);
+            uint64_t index = 0;
+            while (in)
+            {
+                in.read(buf.data(), static_cast<std::streamsize>(buf.size()));
+                const std::streamsize got = in.gcount();
+                for (std::streamsize i = 0; i < got; ++i, ++index)
+                {
+                    const uint8_t b = static_cast<uint8_t>(buf[i]);
+                    uint64_t &lane = lanes[index & 3u];
+                    lane ^= b;
+                    lane *= 1099511628211ull;
+                }
+            }
+            std::memcpy(out, lanes, 32);
+        }
+    }
+
+    void computeFileDigest(const std::filesystem::path &path, uint8_t out[32])
+    {
+        hashFileLanes(path, out);
+    }
