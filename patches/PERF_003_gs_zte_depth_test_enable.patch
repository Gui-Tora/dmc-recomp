+
+    // Depth-test helpers: frame at block 0, depth at block 512, both 64 pixels wide. Words are preset and read back
+    // raw through the storage layout of the format (CT32 for 32/24-bit frames, Z32 for Z32/Z24 depth) so that bits
+    // a format cannot write are observable. (9, 9) lies inside every primitive drawn, (20, 20) outside all of them.
+    struct RawSetup
+    {
+        uint32_t fpsm = GS_PSM_CT32;
+        uint32_t presetFrame = 0x11223344u;
+        uint32_t fbmsk = 0u;
+        uint32_t zpsmField = 0u;
+        bool zmsk = false;
+        uint32_t presetZ = 0xFFFFu;
+    };
+
+    struct RawDraw
+    {
+        uint64_t test = 0u;
+        uint32_t z = 0x100u;
+        uint32_t prim = GS_PRIM_SPRITE;
+        uint32_t red = 0xAAu;
+    };
+
+    struct RawResult
+    {
+        uint32_t frame;
+        uint32_t z;
+        uint32_t frameOutside;
+        uint32_t zOutside;
+    };
+
+    uint32_t to5551(uint32_t rgba)
+    {
+        return ((rgba >> 3) & 0x1Fu) | (((rgba >> 11) & 0x1Fu) << 5) | (((rgba >> 19) & 0x1Fu) << 10) |
+               ((rgba & 0x80000000u) ? 0x8000u : 0u);
+    }
+
+    RawResult drawRaw(const RawSetup &s, const std::vector<RawDraw> &draws)
+    {
+        constexpr uint32_t kZbp = 16u;
+        std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+        GS gs;
+        gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+        const uint32_t frameStorage = (s.fpsm == GS_PSM_CT24) ? static_cast<uint32_t>(GS_PSM_CT32) : s.fpsm;
+        const uint32_t zpsm = s.zpsmField | 0x30u;
+        const uint32_t zStorage = (zpsm == GS_PSM_Z24) ? static_cast<uint32_t>(GS_PSM_Z32) : zpsm;
+        for (uint32_t c : {9u, 20u})
+        {
+            gs.WriteVram(frameStorage, 0u, 1u, c, c, s.presetFrame);
+            gs.WriteVram(zStorage, kZbp << 5u, 1u, c, c, s.presetZ);
+        }
+        gs.writeRegister(GS_REG_FRAME_1, (1ull << 16) | (static_cast<uint64_t>(s.fpsm) << 24) |
+                                             (static_cast<uint64_t>(s.fbmsk) << 32));
+        gs.writeRegister(GS_REG_ZBUF_1, kZbp | (static_cast<uint64_t>(s.zpsmField) << 24) | ((s.zmsk ? 1ull : 0ull) << 32));
+        gs.writeRegister(GS_REG_SCISSOR_1, (63ull << 16) | (63ull << 48));
+        gs.writeRegister(GS_REG_XYOFFSET_1, 0ull);
+        for (const RawDraw &d : draws)
+        {
+            gs.writeRegister(GS_REG_TEST_1, d.test);
+            gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(d.prim));
+            gs.writeRegister(GS_REG_RGBAQ, d.red | (0xBBull << 8) | (0xCCull << 16) | (0x80ull << 24) | (0x3F800000ull << 32));
+            const auto xyz = [&](uint64_t x, uint64_t y)
+            {
+                gs.writeRegister(GS_REG_XYZ2, (x * 16) | ((y * 16) << 16) | (static_cast<uint64_t>(d.z) << 32));
+            };
+            if (d.prim == GS_PRIM_TRIANGLE)
+            {
+                xyz(8, 8);
+                xyz(16, 8);
+                xyz(8, 16);
+            }
+            else if (d.prim == GS_PRIM_LINE)
+            {
+                xyz(8, 9);
+                xyz(14, 9);
+            }
+            else
+            {
+                xyz(8, 8);
+                xyz(12, 12);
+            }
+        }
+        return {gs.ReadVram(frameStorage, 0u, 1u, 9u, 9u), gs.ReadVram(zStorage, kZbp << 5u, 1u, 9u, 9u),
+                gs.ReadVram(frameStorage, 0u, 1u, 20u, 20u), gs.ReadVram(zStorage, kZbp << 5u, 1u, 20u, 20u)};
+    }
 }
 
