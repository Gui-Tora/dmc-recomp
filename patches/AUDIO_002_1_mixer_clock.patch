diff --git a/ps2xRuntime/src/lib/audio/audio_mixer.h b/ps2xRuntime/src/lib/audio/audio_mixer.h
new file mode 100644
index 0000000..51d6a90
--- /dev/null
+++ b/ps2xRuntime/src/lib/audio/audio_mixer.h
@@ -0,0 +1,699 @@
+#pragma once
+// AUDIO_002-1/2 (patch 37, experimental): guest-timed audio mixer (header-only, private to the runtime).
+// Not included by recompiled EE code. No raylib dependency: the device glue lives in ps2_iop_host.cpp.
+//
+// Threads and ownership
+//   executor (guest) thread : AudioMixer::onVBlank (render + WAV + device-ring producer), addSource/removeSource
+//                             (RPC handlers run on the executor; a mutex also covers teardown from other threads).
+//   device callback thread  : AudioMixer::deviceRender (device-ring consumer and free-ring consumer). Never locks,
+//                             never allocates, never waits.
+//   service worker threads  : AudioMixer::pushFree (one producer per free ring at a time).
+//
+// SpscFrameRing protocol (stereo s16 frames, capacity a power of two). Indices are monotonic 64-bit counters.
+//   W (write) is stored only by the producer, R (read) only by the consumer.
+//   Producer: free = cap - (W - R.acquire); copies at most `free` frames into [W, W+n); W.release = W+n.
+//             Frames that do not fit are dropped (newest) and counted. The producer never touches R.
+//   Consumer: avail = W.acquire - R; reads [R, R+n) ; R.release = R+n.
+//             Overflow policy "drop oldest" is applied by the CONSUMER: if avail > maxFill it advances its own R to
+//             W - targetFill before reading (counted as trimmed).
+//   Flush (checkpoint restore, stream stop): the producer side stores flushTo = W (release) and then increments
+//             flushSeq (release). The consumer, on seeing a new flushSeq (acquire), sets R = max(R, flushTo).
+//             flushTo <= W at all times, so R <= W holds; the consumer stays the only writer of R.
+//   Happens-before: producer writes slot data before W.release; consumer W.acquire precedes its reads. Consumer
+//   finishes reading slots before R.release; producer R.acquire precedes overwriting them. So a slot is never
+//   written while it is being read.
+//
+// DeviceGate (callback vs. shutdown): the callback does enter (seq_cst ++inside) -> load target (seq_cst) -> use ->
+//   exit (--inside). detach stores target = nullptr (seq_cst) then waits for inside == 0. In the seq_cst total order
+//   either the callback's load follows the null store (it sees nullptr) or its increment precedes detach's read of
+//   `inside`, which then waits for its exit. After detach() returns nothing can touch the old target.
+
+#include "ps2x/iop/audio_dsp.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace ps2audio
+{
+    using ps2x::iop::audio::AudioGroup;
+    using ps2x::iop::audio::AudioRenderSource;
+    using ps2x::iop::audio::DeviceMode;
+    using ps2x::iop::audio::kAudioGroupCount;
+    using ps2x::iop::audio::kMixRate;
+
+    inline int16_t saturate16(int32_t v)
+    {
+        return static_cast<int16_t>(v < -32768 ? -32768 : (v > 32767 ? 32767 : v));
+    }
+
+    class SpscFrameRing
+    {
+    public:
+        // capacityFrames is rounded up to a power of two. maxFill/targetFill: consumer-side trimming (0 = none).
+        explicit SpscFrameRing(size_t capacityFrames, size_t maxFill = 0u, size_t targetFill = 0u)
+        {
+            size_t cap = 1u;
+            while (cap < capacityFrames)
+                cap <<= 1u;
+            m_cap = cap;
+            m_mask = cap - 1u;
+            m_data.assign(cap * 2u, int16_t{0});
+            m_maxFill = maxFill;
+            m_targetFill = targetFill < maxFill ? targetFill : maxFill;
+        }
+
+        [[nodiscard]] size_t capacity() const { return m_cap; }
+
+        // Producer side.
+        size_t push(const int16_t *stereo, size_t frames)
+        {
+            const uint64_t w = m_w.load(std::memory_order_relaxed);
+            const uint64_t r = m_r.load(std::memory_order_acquire);
+            const size_t space = m_cap - static_cast<size_t>(w - r);
+            const size_t n = frames < space ? frames : space;
+            for (size_t i = 0; i < n; ++i)
+            {
+                const size_t slot = static_cast<size_t>((w + i) & m_mask) * 2u;
+                m_data[slot] = stereo[i * 2u];
+                m_data[slot + 1u] = stereo[i * 2u + 1u];
+            }
+            m_w.store(w + n, std::memory_order_release);
+            if (n < frames)
+                m_dropped.fetch_add(frames - n, std::memory_order_relaxed);
+            m_pushed.fetch_add(n, std::memory_order_relaxed);
+            return n;
+        }
+
+        [[nodiscard]] size_t freeSpace() const
+        {
+            return m_cap - static_cast<size_t>(m_w.load(std::memory_order_relaxed) - m_r.load(std::memory_order_acquire));
+        }
+
+        void requestFlush()
+        {
+            m_flushTo.store(m_w.load(std::memory_order_relaxed), std::memory_order_release);
+            m_flushSeq.fetch_add(1u, std::memory_order_release);
+        }
+
+        // Consumer side: reads up to `frames` frames into dst (interleaved stereo); returns frames read.
+        size_t pop(int16_t *dst, size_t frames)
+        {
+            uint64_t r = m_r.load(std::memory_order_relaxed);
+            const uint32_t seq = m_flushSeq.load(std::memory_order_acquire);
+            if (seq != m_seenFlushSeq)
+            {
+                m_seenFlushSeq = seq;
+                const uint64_t to = m_flushTo.load(std::memory_order_acquire);
+                if (to > r)
+                {
+                    m_flushed.fetch_add(to - r, std::memory_order_relaxed);
+                    r = to;
+                }
+            }
+            const uint64_t w = m_w.load(std::memory_order_acquire);
+            size_t avail = static_cast<size_t>(w - r);
+            if (m_maxFill != 0u && avail > m_maxFill)
+            {
+                const size_t drop = avail - m_targetFill;
+                r += drop;
+                avail -= drop;
+                m_trimmed.fetch_add(drop, std::memory_order_relaxed);
+            }
+            const size_t n = frames < avail ? frames : avail;
+            for (size_t i = 0; i < n; ++i)
+            {
+                const size_t slot = static_cast<size_t>((r + i) & m_mask) * 2u;
+                dst[i * 2u] = m_data[slot];
+                dst[i * 2u + 1u] = m_data[slot + 1u];
+            }
+            m_r.store(r + n, std::memory_order_release);
+            if (n < frames)
+                m_underrun.fetch_add(frames - n, std::memory_order_relaxed);
+            return n;
+        }
+
+        struct Stats
+        {
+            uint64_t pushed, dropped, trimmed, flushed, underrun, fill;
+        };
+        [[nodiscard]] Stats stats() const
+        {
+            return {m_pushed.load(), m_dropped.load(), m_trimmed.load(), m_flushed.load(), m_underrun.load(),
+                    m_w.load() - m_r.load()};
+        }
+
+    private:
+        size_t m_cap = 0, m_mask = 0, m_maxFill = 0, m_targetFill = 0;
+        std::vector<int16_t> m_data;
+        alignas(64) std::atomic<uint64_t> m_w{0};
+        alignas(64) std::atomic<uint64_t> m_r{0};
+        uint32_t m_seenFlushSeq = 0; // consumer-owned
+        alignas(64) std::atomic<uint64_t> m_flushTo{0};
+        std::atomic<uint32_t> m_flushSeq{0};
+        std::atomic<uint64_t> m_pushed{0}, m_dropped{0}, m_trimmed{0}, m_flushed{0}, m_underrun{0};
+    };
+
+    template <typename T>
+    class DeviceGate
+    {
+    public:
+        void attach(T *target) { m_target.store(target); }
+        // Callback side.
+        template <typename Fn, typename Fallback>
+        void with(Fn &&fn, Fallback &&fallback)
+        {
+            m_inside.fetch_add(1);
+            T *target = m_target.load();
+            if (target)
+                fn(*target);
+            else
+                fallback();
+            m_inside.fetch_sub(1);
+        }
+        void detach()
+        {
+            m_target.store(nullptr);
+            while (m_inside.load() != 0)
+                std::this_thread::yield();
+        }
+        [[nodiscard]] bool attached() const { return m_target.load() != nullptr; }
+
+    private:
+        std::atomic<T *> m_target{nullptr};
+        std::atomic<int> m_inside{0};
+    };
+
+    // RIFF/WAVE PCM s16 stereo 48 kHz. Blocks are buffered (64 KB) and the RIFF sizes are rewritten every
+    // `headerEvery` blocks, so a file cut by process termination stays readable up to the last rewrite.
+    class WavSink
+    {
+    public:
+        ~WavSink() { close(); }
+
+        bool open(const std::string &path)
+        {
+            close();
+            m_path = path;
+            m_file = std::fopen(path.c_str(), "wb");
+            if (!m_file)
+            {
+                ++m_errors;
+                return false;
+            }
+            m_dataBytes = 0;
+            m_buffer.clear();
+            m_buffer.reserve(kBufferBytes);
+            writeHeader();
+            return true;
+        }
+
+        [[nodiscard]] bool isOpen() const { return m_file != nullptr; }
+
+        void append(const int16_t *stereo, size_t frames)
+        {
+            if (!m_file)
+                return;
+            const auto t0 = std::chrono::steady_clock::now();
+            const size_t bytes = frames * 4u;
+            const auto *p = reinterpret_cast<const uint8_t *>(stereo);
+            m_buffer.insert(m_buffer.end(), p, p + bytes);
+            m_dataBytes += bytes;
+            if (m_buffer.size() >= kBufferBytes)
+                flushBuffer();
+            if (++m_blocks % m_headerEvery == 0u)
+                checkpointHeader();
+            m_writeNs += static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+        }
+
+        void close()
+        {
+            if (!m_file)
+                return;
+            flushBuffer();
+            checkpointHeader();
+            std::fclose(m_file);
+            m_file = nullptr;
+        }
+
+        void setHeaderEvery(uint64_t blocks) { m_headerEvery = blocks == 0u ? 50u : blocks; }
+        [[nodiscard]] uint64_t dataBytes() const { return m_dataBytes; }
+        [[nodiscard]] uint64_t writeNs() const { return m_writeNs; }
+        [[nodiscard]] uint64_t errors() const { return m_errors; }
+
+        static void encodeHeader(uint8_t out[44], uint32_t dataBytes)
+        {
+            auto u32 = [&](size_t at, uint32_t v) { for (int i = 0; i < 4; ++i) out[at + i] = uint8_t(v >> (8 * i)); };
+            auto u16 = [&](size_t at, uint16_t v) { out[at] = uint8_t(v); out[at + 1] = uint8_t(v >> 8); };
+            std::memcpy(out, "RIFF", 4); u32(4, 36u + dataBytes); std::memcpy(out + 8, "WAVEfmt ", 8);
+            u32(16, 16u); u16(20, 1u); u16(22, 2u); u32(24, kMixRate); u32(28, kMixRate * 4u); u16(32, 4u);
+            u16(34, 16u); std::memcpy(out + 36, "data", 4); u32(40, dataBytes);
+        }
+
+    private:
+        static constexpr size_t kBufferBytes = 64u * 1024u;
+
+        void writeHeader()
+        {
+            uint8_t h[44];
+            encodeHeader(h, static_cast<uint32_t>(m_written));
+            if (std::fseek(m_file, 0, SEEK_SET) != 0 || std::fwrite(h, 1, 44, m_file) != 44)
+                ++m_errors;
+            std::fseek(m_file, 0, SEEK_END);
+        }
+        void flushBuffer()
+        {
+            if (!m_buffer.empty())
+            {
+                if (std::fwrite(m_buffer.data(), 1, m_buffer.size(), m_file) != m_buffer.size())
+                    ++m_errors;
+                m_written += m_buffer.size();
+                m_buffer.clear();
+            }
+        }
+        void checkpointHeader()
+        {
+            flushBuffer();
+            writeHeader();
+            std::fflush(m_file);
+        }
+
+        std::string m_path;
+        std::FILE *m_file = nullptr;
+        std::vector<uint8_t> m_buffer;
+        uint64_t m_dataBytes = 0, m_written = 0, m_blocks = 0, m_headerEvery = 50u, m_writeNs = 0, m_errors = 0;
+    };
+
+    struct MixerConfig
+    {
+        bool device = true;                                   // PS2X_AUDIO_DEVICE (0 = no device output at all)
+        std::array<DeviceMode, kAudioGroupCount> modes{DeviceMode::Free, DeviceMode::Guest, DeviceMode::Guest,
+                                                       DeviceMode::Guest};
+        std::string wavPath;                                  // PS2X_AUDIO_WAV
+        uint64_t wavFrom = 0u, wavTo = UINT64_MAX;            // PS2X_AUDIO_WAV_TICKS=a:b (fields [a, b))
+        uint32_t fieldHz = 50u;                               // PS2X_AUDIO_FIELD_HZ (DMC PAL: 50 -> 960 frames)
+        size_t deviceRingFrames = 16384u;                     // ~341 ms
+        size_t deviceMaxFill = 12000u;                        // 250 ms: above this the consumer trims ...
+        size_t deviceTargetFill = 2880u;                      // ... to 60 ms
+        size_t freeRingFrames = 24576u;                       // ~512 ms per free stream
+        uint64_t statsEveryFields = 500u;                     // PS2X_AUDIO_STATS_TICKS
+
+        static DeviceMode parseMode(const char *v, DeviceMode fallback)
+        {
+            if (!v) return fallback;
+            const std::string s(v);
+            if (s == "guest") return DeviceMode::Guest;
+            if (s == "free") return DeviceMode::Free;
+            if (s == "off") return DeviceMode::Off;
+            return fallback;
+        }
+
+        static MixerConfig fromEnv()
+        {
+            MixerConfig c;
+            if (const char *v = std::getenv("PS2X_AUDIO_DEVICE"))
+                c.device = std::string(v) != "0";
+            c.modes[0] = parseMode(std::getenv("PS2X_AUDIO_XAG_MODE"), DeviceMode::Free);
+            if (const char *v = std::getenv("PS2X_AUDIO_WAV"))
+                c.wavPath = v;
+            if (const char *v = std::getenv("PS2X_AUDIO_WAV_TICKS"))
+            {
+                const std::string s(v);
+                const size_t colon = s.find(':');
+                c.wavFrom = std::strtoull(s.substr(0, colon).c_str(), nullptr, 0);
+                if (colon != std::string::npos && colon + 1 < s.size())
+                    c.wavTo = std::strtoull(s.substr(colon + 1).c_str(), nullptr, 0);
+            }
+            if (const char *v = std::getenv("PS2X_AUDIO_FIELD_HZ"))
+            {
+                const unsigned long hz = std::strtoul(v, nullptr, 0);
+                if (hz >= 24u && hz <= 120u)
+                    c.fieldHz = static_cast<uint32_t>(hz);
+            }
+            if (const char *v = std::getenv("PS2X_AUDIO_STATS_TICKS"))
+                c.statsEveryFields = std::strtoull(v, nullptr, 0);
+            return c;
+        }
+    };
+
+    class AudioMixer
+    {
+    public:
+        static constexpr size_t kMaxFieldFrames = 2048u; // fieldHz >= 24
+        static constexpr uint32_t kFreeStreams = 2u;
+
+        explicit AudioMixer(MixerConfig config)
+            : m_config(std::move(config)),
+              m_deviceRing(m_config.deviceRingFrames, m_config.deviceMaxFill, m_config.deviceTargetFill)
+        {
+            for (auto &ring : m_freeRings)
+                ring = std::make_unique<SpscFrameRing>(m_config.freeRingFrames);
+            m_scratch.assign(kMaxFieldFrames * 2u, 0);
+            m_accWav.assign(kMaxFieldFrames * 2u, 0);
+            m_accDev.assign(kMaxFieldFrames * 2u, 0);
+            m_outWav.assign(kMaxFieldFrames * 2u, 0);
+            m_outDev.assign(kMaxFieldFrames * 2u, 0);
+            m_wav.setHeaderEvery(m_config.fieldHz);
+        }
+
+        ~AudioMixer() { shutdown(); }
+
+        [[nodiscard]] const MixerConfig &config() const { return m_config; }
+
+        // Effective device mode of a group (global device switch applied).
+        [[nodiscard]] DeviceMode mode(AudioGroup group) const
+        {
+            if (!m_config.device)
+                return DeviceMode::Off;
+            return m_config.modes[static_cast<size_t>(group)];
+        }
+
+        uint64_t addSource(AudioGroup group, std::unique_ptr<AudioRenderSource> source)
+        {
+            if (!source)
+                return 0u;
+            noteThread();
+            std::lock_guard<std::mutex> lock(m_sourceMutex);
+            const uint64_t id = ++m_nextId;
+            m_sources.push_back(Entry{id, group, std::move(source)});
+            ++m_sourcesAdded;
+            return id;
+        }
+
+        void removeSource(uint64_t id)
+        {
+            if (id == 0u)
+                return;
+            noteThread();
+            std::unique_ptr<AudioRenderSource> doomed;
+            {
+                std::lock_guard<std::mutex> lock(m_sourceMutex);
+                for (auto it = m_sources.begin(); it != m_sources.end(); ++it)
+                {
+                    if (it->id == id)
+                    {
+                        doomed = std::move(it->source);
+                        m_sources.erase(it);
+                        ++m_sourcesRemoved;
+                        break;
+                    }
+                }
+            }
+        }
+
+        [[nodiscard]] size_t sourceCount()
+        {
+            std::lock_guard<std::mutex> lock(m_sourceMutex);
+            return m_sources.size();
+        }
+
+        // Frames of field `field` (48000 / fieldHz, remainder carried so no drift for rates not dividing 48000).
+        size_t framesForNextField()
+        {
+            const uint64_t total = static_cast<uint64_t>(kMixRate) + m_remainder;
+            const size_t frames = static_cast<size_t>(total / m_config.fieldHz);
+            m_remainder = static_cast<uint32_t>(total % m_config.fieldHz);
+            return frames;
+        }
+
+        // Executor thread, at VBlankStart with the new tick T: renders field T-1.
+        void onVBlank(uint64_t tick)
+        {
+            if (m_shutdown)
+                return;
+            m_executor = std::this_thread::get_id();
+            const auto t0 = std::chrono::steady_clock::now();
+            if (m_haveTick && tick != m_lastTick + 1u)
+                discontinuity(m_lastTick, tick);
+            m_haveTick = true;
+            m_lastTick = tick;
+            if (tick == 0u)
+                return;
+            const uint64_t field = tick - 1u;
+            const size_t frames = framesForNextField();
+            renderField(field, frames);
+            ++m_fields;
+            const uint64_t ns = static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+            m_renderNs += ns;
+            if (ns > m_renderMaxNs)
+                m_renderMaxNs = ns;
+            if (m_config.statsEveryFields != 0u && m_fields % m_config.statsEveryFields == 0u)
+                logStats("periodic");
+        }
+
+        // Device callback thread.
+        void deviceRender(int16_t *out, size_t frames) noexcept
+        {
+            constexpr size_t kChunk = 256u;
+            int16_t tmp[kChunk * 2u];
+            int32_t acc[kChunk * 2u];
+            size_t done = 0;
+            while (done < frames)
+            {
+                const size_t n = frames - done < kChunk ? frames - done : kChunk;
+                std::memset(acc, 0, n * 2u * sizeof(int32_t));
+                const size_t g = m_deviceRing.pop(tmp, n);
+                for (size_t i = 0; i < g * 2u; ++i)
+                    acc[i] += tmp[i];
+                for (auto &ring : m_freeRings)
+                {
+                    const size_t f = ring->pop(tmp, n);
+                    for (size_t i = 0; i < f * 2u; ++i)
+                        acc[i] += tmp[i];
+                }
+                for (size_t i = 0; i < n * 2u; ++i)
+                    out[(done * 2u) + i] = saturate16(acc[i]);
+                done += n;
+            }
+            m_deviceFrames.fetch_add(frames, std::memory_order_relaxed);
+        }
+
+        // Service worker thread: real-time copy for a Free-mode group. Waits (2 ms steps) while the ring is full;
+        // returns false when cancelled or when there is no device to consume it.
+        bool pushFree(uint32_t stream, const int16_t *stereo, size_t frames, const std::atomic<bool> *cancel)
+        {
+            if (stream >= kFreeStreams || !m_deviceAttached.load() || m_shutdown)
+                return false;
+            SpscFrameRing &ring = *m_freeRings[stream];
+            size_t done = 0;
+            while (done < frames)
+            {
+                const size_t space = ring.freeSpace();
+                if (space == 0u)
+                {
+                    if ((cancel && cancel->load()) || m_shutdown || !m_deviceAttached.load())
+                        return false;
+                    m_freeWaits.fetch_add(1u, std::memory_order_relaxed);
+                    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+                    continue;
+                }
+                const size_t n = frames - done < space ? frames - done : space;
+                ring.push(stereo + done * 2u, n);
+                done += n;
+            }
+            return true;
+        }
+
+        void flushFree(uint32_t stream)
+        {
+            if (stream < kFreeStreams)
+                m_freeRings[stream]->requestFlush();
+        }
+
+        void setDeviceAttached(bool attached) { m_deviceAttached.store(attached); }
+        [[nodiscard]] bool deviceAttached() const { return m_deviceAttached.load(); }
+
+        // Destroys all sources and closes the WAV. The device must be detached by the caller first.
+        void shutdown()
+        {
+            if (m_shutdown)
+                return;
+            m_shutdown = true;
+            logStats("final");
+            std::vector<Entry> doomed;
+            {
+                std::lock_guard<std::mutex> lock(m_sourceMutex);
+                doomed.swap(m_sources);
+            }
+            doomed.clear();
+            m_wav.close();
+        }
+
+        [[nodiscard]] SpscFrameRing &deviceRing() { return m_deviceRing; }
+        [[nodiscard]] SpscFrameRing &freeRing(uint32_t i) { return *m_freeRings[i]; }
+        [[nodiscard]] uint64_t fieldsRendered() const { return m_fields; }
+        [[nodiscard]] uint64_t wavFields() const { return m_wavFields; }
+        [[nodiscard]] uint64_t discontinuities() const { return m_discontinuities; }
+        [[nodiscard]] const WavSink &wav() const { return m_wav; }
+        [[nodiscard]] uint64_t offThreadCalls() const { return m_offThread.load(); }
+
+        void logStats(const char *why)
+        {
+            const auto dev = m_deviceRing.stats();
+            uint64_t freePushed = 0, freeUnder = 0, freeFlushed = 0;
+            for (auto &ring : m_freeRings)
+            {
+                const auto s = ring->stats();
+                freePushed += s.pushed;
+                freeUnder += s.underrun;
+                freeFlushed += s.flushed;
+            }
+            std::fprintf(stderr,
+                         "[AUDIO:mix] %s tick=%llu fields=%llu frames=%llu sources=%zu added=%llu removed=%llu "
+                         "render_avg_us=%.2f render_max_us=%.1f wav_fields=%llu wav_bytes=%llu wav_write_ms=%.2f "
+                         "wav_err=%llu dev{pushed=%llu dropped=%llu trimmed=%llu flushed=%llu underrun=%llu fill=%llu} "
+                         "free{pushed=%llu underrun=%llu flushed=%llu waits=%llu} device_frames=%llu disc=%llu "
+                         "offthread=%llu\n",
+                         why, static_cast<unsigned long long>(m_lastTick), static_cast<unsigned long long>(m_fields),
+                         static_cast<unsigned long long>(m_framesRendered), m_sources.size(),
+                         static_cast<unsigned long long>(m_sourcesAdded),
+                         static_cast<unsigned long long>(m_sourcesRemoved),
+                         m_fields ? double(m_renderNs) / double(m_fields) / 1000.0 : 0.0, double(m_renderMaxNs) / 1000.0,
+                         static_cast<unsigned long long>(m_wavFields), static_cast<unsigned long long>(m_wav.dataBytes()),
+                         double(m_wav.writeNs()) / 1e6, static_cast<unsigned long long>(m_wav.errors()),
+                         static_cast<unsigned long long>(dev.pushed), static_cast<unsigned long long>(dev.dropped),
+                         static_cast<unsigned long long>(dev.trimmed), static_cast<unsigned long long>(dev.flushed),
+                         static_cast<unsigned long long>(dev.underrun), static_cast<unsigned long long>(dev.fill),
+                         static_cast<unsigned long long>(freePushed), static_cast<unsigned long long>(freeUnder),
+                         static_cast<unsigned long long>(freeFlushed),
+                         static_cast<unsigned long long>(m_freeWaits.load()),
+                         static_cast<unsigned long long>(m_deviceFrames.load()),
+                         static_cast<unsigned long long>(m_discontinuities),
+                         static_cast<unsigned long long>(m_offThread.load()));
+            std::fflush(stderr);
+        }
+
+    private:
+        struct Entry
+        {
+            uint64_t id;
+            AudioGroup group;
+            std::unique_ptr<AudioRenderSource> source;
+        };
+
+        void noteThread()
+        {
+            if (m_haveTick && std::this_thread::get_id() != m_executor)
+                m_offThread.fetch_add(1u, std::memory_order_relaxed);
+        }
+
+        void discontinuity(uint64_t from, uint64_t to)
+        {
+            ++m_discontinuities;
+            m_deviceRing.requestFlush();
+            m_remainder = 0u;
+            // A checkpoint load jumps the tick: restart an open WAV so that sample = (field - first_field) * 960
+            // keeps holding (explicit PS2X_AUDIO_WAV_TICKS ranges after the load are not affected).
+            const bool restartWav = m_wav.isOpen();
+            if (restartWav)
+            {
+                m_wav.open(m_config.wavPath);
+                m_wavFields = 0;
+                m_wavFirstPending = true;
+            }
+            std::fprintf(stderr, "[AUDIO:mix] tick discontinuity %llu -> %llu: device ring flushed%s\n",
+                         static_cast<unsigned long long>(from), static_cast<unsigned long long>(to),
+                         restartWav ? ", wav restarted" : "");
+        }
+
+        void renderField(uint64_t field, size_t frames)
+        {
+            std::fill_n(m_accWav.begin(), frames * 2u, 0);
+            std::fill_n(m_accDev.begin(), frames * 2u, 0);
+            bool anyDevice = false;
+            {
+                std::lock_guard<std::mutex> lock(m_sourceMutex);
+                for (Entry &e : m_sources)
+                {
+                    const size_t got = e.source->render(m_scratch.data(), frames);
+                    const bool toDevice = mode(e.group) == DeviceMode::Guest;
+                    for (size_t i = 0; i < got * 2u; ++i)
+                    {
+                        m_accWav[i] += m_scratch[i];
+                        if (toDevice)
+                            m_accDev[i] += m_scratch[i];
+                    }
+                    anyDevice = anyDevice || toDevice;
+                }
+                // Sources that ended are dropped here (their owners' removeSource then finds nothing).
+                for (auto it = m_sources.begin(); it != m_sources.end();)
+                {
+                    if (it->source->finished())
+                    {
+                        it = m_sources.erase(it);
+                        ++m_sourcesRemoved;
+                    }
+                    else
+                        ++it;
+                }
+            }
+            for (size_t i = 0; i < frames * 2u; ++i)
+                m_outWav[i] = saturate16(m_accWav[i]);
+            m_framesRendered += frames;
+            if (!m_config.wavPath.empty() && field >= m_config.wavFrom && field < m_config.wavTo)
+            {
+                if (!m_wav.isOpen() && !m_wavDone)
+                {
+                    if (m_wav.open(m_config.wavPath))
+                        std::fprintf(stderr, "[AUDIO:mix] wav open %s first_field=%llu frames_per_field=%zu\n",
+                                     m_config.wavPath.c_str(), static_cast<unsigned long long>(field), frames);
+                    else
+                        m_wavDone = true;
+                }
+                if (m_wav.isOpen())
+                {
+                    if (m_wavFirstPending)
+                    {
+                        m_wavFirstPending = false;
+                        std::fprintf(stderr, "[AUDIO:mix] wav first_field=%llu\n", static_cast<unsigned long long>(field));
+                    }
+                    m_wav.append(m_outWav.data(), frames);
+                    ++m_wavFields;
+                }
+            }
+            else if (m_wav.isOpen() && field >= m_config.wavTo)
+            {
+                m_wav.close();
+                m_wavDone = true;
+                std::fprintf(stderr, "[AUDIO:mix] wav closed at field %llu (%llu fields)\n",
+                             static_cast<unsigned long long>(field), static_cast<unsigned long long>(m_wavFields));
+            }
+            if (m_deviceAttached.load() && m_config.device)
+            {
+                (void)anyDevice;
+                for (size_t i = 0; i < frames * 2u; ++i)
+                    m_outDev[i] = saturate16(m_accDev[i]);
+                m_deviceRing.push(m_outDev.data(), frames);
+            }
+        }
+
+        MixerConfig m_config;
+        SpscFrameRing m_deviceRing;
+        std::array<std::unique_ptr<SpscFrameRing>, kFreeStreams> m_freeRings;
+        std::mutex m_sourceMutex;
+        std::vector<Entry> m_sources;
+        std::vector<int16_t> m_scratch, m_outWav, m_outDev;
+        std::vector<int32_t> m_accWav, m_accDev;
+        WavSink m_wav;
+        bool m_wavDone = false;
+        bool m_wavFirstPending = true;
+        bool m_haveTick = false;
+        std::atomic<bool> m_shutdown{false};
+        uint64_t m_lastTick = 0, m_fields = 0, m_wavFields = 0, m_framesRendered = 0, m_discontinuities = 0;
+        uint64_t m_renderNs = 0, m_renderMaxNs = 0, m_nextId = 0, m_sourcesAdded = 0, m_sourcesRemoved = 0;
+        uint32_t m_remainder = 0;
+        std::thread::id m_executor{};
+        std::atomic<bool> m_deviceAttached{false};
+        std::atomic<uint64_t> m_freeWaits{0}, m_deviceFrames{0}, m_offThread{0};
+    };
+}
