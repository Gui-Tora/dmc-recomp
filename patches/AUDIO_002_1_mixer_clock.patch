+
+// ---------------------------------------------------------------------------
+// AUDIO_002-1/2 (patch 37): guest-timed mixer glue. One 48 kHz s16 stereo raylib stream; its callback reaches the
+// mixer only through the DeviceGate (no lock, no allocation, no wait on the guest). Opened lazily on the first
+// VBlank (the adapter is built before InitAudioDevice).
+namespace
+{
+    ps2audio::DeviceGate<ps2audio::AudioMixer> g_audioGate;
+    AudioStream g_mixStream{};
+
+    void mixerDeviceCallback(void *buffer, unsigned int frames)
+    {
+        auto *out = static_cast<int16_t *>(buffer);
+        g_audioGate.with([&](ps2audio::AudioMixer &mixer) { mixer.deviceRender(out, frames); },
+                         [&] { std::memset(out, 0, static_cast<size_t>(frames) * 4u); });
+    }
+}
+
+bool PS2IopHostAdapter::audioMixerEnabled() const
+{
+    return m_mixer != nullptr;
+}
+
+ps2x::iop::audio::DeviceMode PS2IopHostAdapter::audioDeviceMode(ps2x::iop::audio::AudioGroup group) const
+{
+    return m_mixer ? m_mixer->mode(group) : ps2x::iop::audio::DeviceMode::Off;
+}
+
+uint64_t PS2IopHostAdapter::addGuestAudioSource(ps2x::iop::audio::AudioGroup group,
+                                                std::unique_ptr<ps2x::iop::audio::AudioRenderSource> source)
+{
+    return m_mixer ? m_mixer->addSource(group, std::move(source)) : 0u;
+}
+
+void PS2IopHostAdapter::removeGuestAudioSource(uint64_t id)
+{
+    if (m_mixer)
+        m_mixer->removeSource(id);
+}
+
+bool PS2IopHostAdapter::pushFreeRunningPcm(uint32_t streamId, const int16_t *stereo48k, size_t frames,
+                                           const std::atomic<bool> *cancel)
+{
+    return m_mixer && m_mixer->pushFree(streamId, stereo48k, frames, cancel);
+}
+
+void PS2IopHostAdapter::flushFreeRunningPcm(uint32_t streamId)
+{
+    if (m_mixer)
+        m_mixer->flushFree(streamId);
+}
+
+void PS2IopHostAdapter::hostVBlankObserver(void *self, uint64_t tick)
+{
+    auto *adapter = static_cast<PS2IopHostAdapter *>(self);
+    if (!adapter || !adapter->m_mixer)
+        return;
+    if (!adapter->m_audioDeviceTried && adapter->m_mixer->config().device)
+    {
+        adapter->m_audioDeviceTried = true;
+        if (IsAudioDeviceReady())
+        {
+            g_mixStream = LoadAudioStream(ps2audio::kMixRate, 16, 2);
+            SetAudioStreamCallback(g_mixStream, mixerDeviceCallback);
+            g_audioGate.attach(adapter->m_mixer.get());
+            adapter->m_mixer->setDeviceAttached(true);
+            PlayAudioStream(g_mixStream);
+            adapter->m_audioDeviceOpen = true;
+            std::fprintf(stderr, "[AUDIO:mix] device stream open: 48000 Hz s16 stereo (first tick %llu)\n",
+                         static_cast<unsigned long long>(tick));
+        }
+        else
+        {
+            std::fprintf(stderr, "[AUDIO:mix] no audio device: WAV only\n");
+        }
+    }
+    adapter->m_mixer->onVBlank(tick);
+}
+
+void PS2IopHostAdapter::shutdownAudio()
+{
+    if (!m_mixer)
+        return;
+    if (m_audioDeviceOpen)
+    {
+        m_mixer->setDeviceAttached(false); // free-stream producers stop waiting
+        g_audioGate.detach();              // after this the callback can no longer reach the mixer
+        StopAudioStream(g_mixStream);
+        UnloadAudioStream(g_mixStream);
+        m_audioDeviceOpen = false;
+    }
+    m_mixer->shutdown(); // destroys the sources (they close their host files) and closes the WAV
+}
