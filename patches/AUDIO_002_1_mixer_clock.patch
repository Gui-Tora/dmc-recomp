+            std::vector<int16_t> out(2 * 256);
+            size_t got = 0;
+            for (int i = 0; i < 2000 && got < 4096; ++i)
+            {
+                m.deviceRender(out.data(), 256);
+                got += 256;
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+            worker2.join();
+            t.IsTrue(result.load(), "completes when the device consumes");
+            t.Equals(m.freeRing(1).stats().pushed, uint64_t(4096), "all frames delivered");
+            m.flushFree(1);
+            m.deviceRender(out.data(), 256);
+            t.Equals(m.freeRing(1).stats().fill, uint64_t(0), "flush empties the stream");
+        });
+    });
+}
