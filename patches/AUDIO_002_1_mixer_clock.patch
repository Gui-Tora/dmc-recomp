diff --git a/ps2xTest/src/audio_mixer_tests.cpp b/ps2xTest/src/audio_mixer_tests.cpp
new file mode 100644
index 0000000..82e72d3
--- /dev/null
+++ b/ps2xTest/src/audio_mixer_tests.cpp
@@ -0,0 +1,590 @@
+// AUDIO_002-1/2 (patch 37): guest-timed mixer, SPSC device ring, device gate, WAV sink, resampler, XAG reader.
+#include "MiniTest.h"
+#include "audio/audio_mixer.h"
+
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+using namespace ps2audio;
+using ps2x::iop::audio::CubicResampler;
+using ps2x::iop::audio::XagClipLayout;
+using ps2x::iop::audio::XagClipReader;
+
+namespace
+{
+    struct ConstSource final : AudioRenderSource
+    {
+        int16_t l, r;
+        size_t remaining;
+        ConstSource(int16_t left, int16_t right, size_t frames = SIZE_MAX) : l(left), r(right), remaining(frames) {}
+        size_t render(int16_t *out, size_t frames) override
+        {
+            const size_t n = frames < remaining ? frames : remaining;
+            for (size_t i = 0; i < n; ++i)
+            {
+                out[i * 2] = l;
+                out[i * 2 + 1] = r;
+            }
+            remaining -= n;
+            return n;
+        }
+        bool finished() const override { return remaining == 0; }
+    };
+
+    struct RampSource final : AudioRenderSource
+    {
+        uint32_t n = 0;
+        size_t render(int16_t *out, size_t frames) override
+        {
+            for (size_t i = 0; i < frames; ++i, ++n)
+            {
+                out[i * 2] = int16_t(n * 7);
+                out[i * 2 + 1] = int16_t(n * 13);
+            }
+            return frames;
+        }
+        bool finished() const override { return false; }
+    };
+
+    std::vector<int16_t> resampleAll(const std::vector<int16_t> &in, uint32_t ch, uint32_t inRate, size_t block)
+    {
+        CubicResampler rs(inRate, 48000u, ch);
+        size_t pos = 0;
+        auto pull = [&](int16_t *dst, size_t max) -> size_t {
+            const size_t frames = in.size() / ch;
+            const size_t n = std::min(max, frames - pos);
+            std::memcpy(dst, in.data() + pos * ch, n * ch * sizeof(int16_t));
+            pos += n;
+            return n;
+        };
+        std::vector<int16_t> out;
+        std::vector<int16_t> buf(block * 2);
+        for (;;)
+        {
+            const size_t got = rs.produce(buf.data(), block, pull);
+            out.insert(out.end(), buf.begin(), buf.begin() + got * 2);
+            if (got < block)
+                break;
+        }
+        return out;
+    }
+
+    MixerConfig quietConfig()
+    {
+        MixerConfig c;
+        c.statsEveryFields = 0;
+        return c;
+    }
+
+    std::vector<uint8_t> readFile(const std::string &path)
+    {
+        std::vector<uint8_t> data;
+        if (std::FILE *f = std::fopen(path.c_str(), "rb"))
+        {
+            std::fseek(f, 0, SEEK_END);
+            data.resize(static_cast<size_t>(std::ftell(f)));
+            std::fseek(f, 0, SEEK_SET);
+            if (!data.empty())
+                (void)std::fread(data.data(), 1, data.size(), f);
+            std::fclose(f);
+        }
+        return data;
+    }
+
+    uint32_t le32(const std::vector<uint8_t> &d, size_t at)
+    {
+        return d[at] | (d[at + 1] << 8) | (d[at + 2] << 16) | (uint32_t(d[at + 3]) << 24);
+    }
+
+    std::string tempPath(const char *name)
+    {
+        return (std::filesystem::temp_directory_path() / name).string();
+    }
