@@ -0,0 +1,276 @@
+#pragma once
+// AUDIO_002-1/2: audio building blocks shared by IOP sound services and the runtime mixer (header-only).
+// Not included by recompiled EE code.
+//   * decodeSpuAdpcm: SPU ADPCM (16-byte frames of 28 samples, filters 0-4). Moved verbatim from TSNDDRVM's XAG
+//     decoder; same output bit for bit.
+//   * CubicResampler: integer Catmull-Rom resampler (32.32 phase, Q16 interpolation fraction). Fully integer, so the
+//     output is identical on every host and thread and can be reproduced by an independent reference.
+//   * AudioRenderSource: a source the mixer pulls at the mix rate (48 kHz, interleaved stereo s16).
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::audio
+{
+    inline constexpr uint32_t kMixRate = 48000u;
+
+    // Mixer groups: each has its own device mode (AUDIO_002-1/2) and, later, its own master gain.
+    enum class AudioGroup : uint8_t
+    {
+        Xag = 0,
+        Pss = 1,
+        Se = 2,
+        Bgm = 3,
+    };
+    inline constexpr size_t kAudioGroupCount = 4u;
+
+    inline const char *audioGroupName(AudioGroup group)
+    {
+        switch (group)
+        {
+        case AudioGroup::Xag: return "xag";
+        case AudioGroup::Pss: return "pss";
+        case AudioGroup::Se: return "se";
+        case AudioGroup::Bgm: return "bgm";
+        }
+        return "?";
+    }
+
+    // Device mode of a group:
+    //   Guest: the guest-timed mix (960 frames per PAL field) is also sent to the device.
+    //   Free:  the guest-timed mix goes to the WAV only; the service feeds the device with an independent
+    //          real-time copy (XAG transition path, keeps today's continuous voice).
+    //   Off:   WAV only.
+    enum class DeviceMode : uint8_t
+    {
+        Guest = 0,
+        Free = 1,
+        Off = 2,
+    };
+
+    struct AdpcmChannelState
+    {
+        int32_t s1 = 0;
+        int32_t s2 = 0;
+    };
+
+    inline void decodeSpuAdpcm(const uint8_t *data, size_t bytes, AdpcmChannelState &state, int16_t *out, size_t stride)
+    {
+        static constexpr int32_t kCoef[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+        for (size_t frame = 0; frame + 16u <= bytes; frame += 16u)
+        {
+            const uint8_t head = data[frame];
+            const int shift = head & 0x0F;
+            const int filter = std::min(head >> 4, 4);
+            for (size_t i = 2; i < 16u; ++i)
+            {
+                const uint8_t byte = data[frame + i];
+                for (int nibbleIndex = 0; nibbleIndex < 2; ++nibbleIndex)
+                {
+                    int32_t nibble = nibbleIndex == 0 ? (byte & 0x0F) : (byte >> 4);
+                    if (nibble >= 8)
+                        nibble -= 16;
+                    int32_t value = shift <= 12 ? ((nibble << 12) >> shift) : 0;
+                    value += (state.s1 * kCoef[filter][0] + state.s2 * kCoef[filter][1]) >> 6;
+                    value = std::clamp(value, -32768, 32767);
+                    state.s2 = state.s1;
+                    state.s1 = value;
+                    *out = static_cast<int16_t>(value);
+                    out += stride;
+                }
+            }
+        }
+    }
+
+    // Pulled by the mixer. render() fills up to `frames` interleaved stereo frames at kMixRate and returns how many
+    // it produced (the rest of the block is silence). Called on one thread at a time; must not call into the guest.
+    class AudioRenderSource
+    {
+    public:
+        virtual ~AudioRenderSource() = default;
+        virtual size_t render(int16_t *stereo, size_t frames) = 0;
+        [[nodiscard]] virtual bool finished() const = 0;
+    };
+
+    // Streaming resampler, 1 or 2 input channels -> interleaved stereo at outRate.
+    // Output frame k is the Catmull-Rom interpolation at input position k * step / 2^32 between input frames
+    // floor(pos) and floor(pos) + 1 (the frame before input 0 and the frames after the end are 0). Production
+    // stops once floor(pos) reaches the input length, so the output length is ceil(N * 2^32 / step) for N input
+    // frames, step = floor(inRate * 2^32 / outRate). With inRate == outRate the output equals the input.
+    class CubicResampler
+    {
+    public:
+        CubicResampler(uint32_t inRate, uint32_t outRate, uint32_t channels)
+            : m_channels(channels == 1u ? 1u : 2u),
+              m_step(outRate == 0u ? (1ull << 32) : (static_cast<uint64_t>(inRate) << 32) / outRate)
+        {
+        }
+
+        [[nodiscard]] uint64_t step() const { return m_step; }
+        [[nodiscard]] bool finished() const { return m_ended && m_p1Index >= m_inputFrames; }
+        [[nodiscard]] uint64_t inputFramesSeen() const { return m_inputFrames; }
+
+        // pull(int16_t *dst, size_t maxFrames) -> size_t: copies up to maxFrames interleaved input frames
+        // (m_channels samples each) and returns the count; 0 means end of input.
+        template <typename Pull>
+        size_t produce(int16_t *out, size_t frames, Pull &&pull)
+        {
+            if (!m_primed)
+            {
+                m_primed = true;
+                for (int i = 1; i < 4; ++i)
+                    shiftIn(pull);
+                m_p1Index = 0; // p1 holds input frame 0
+            }
+            size_t produced = 0;
+            while (produced < frames)
+            {
+                while (m_frac >= kOne)
+                {
+                    shiftIn(pull);
+                    ++m_p1Index;
+                    m_frac -= kOne;
+                }
+                if (m_ended && m_p1Index >= m_inputFrames)
+                    break;
+                const int64_t t = static_cast<int64_t>(m_frac >> 16); // Q16
+                for (uint32_t c = 0; c < 2u; ++c)
+                {
+                    const uint32_t ch = m_channels == 1u ? 0u : c;
+                    out[produced * 2u + c] = interpolate(m_win[0][ch], m_win[1][ch], m_win[2][ch], m_win[3][ch], t);
+                }
+                ++produced;
+                m_frac += m_step;
+            }
+            return produced;
+        }
+
+        static int16_t interpolate(int64_t p0, int64_t p1, int64_t p2, int64_t p3, int64_t t)
+        {
+            // y = p1 + t/2 * ((p2 - p0) + t * ((2p0 - 5p1 + 4p2 - p3) + t * (-p0 + 3p1 - 3p2 + p3))), t in Q16.
+            // Arithmetic right shifts round toward minus infinity (C++20).
+            const int64_t a = -p0 + 3 * p1 - 3 * p2 + p3;
+            const int64_t b = 2 * p0 - 5 * p1 + 4 * p2 - p3;
+            const int64_t c = p2 - p0;
+            int64_t v = (a * t) >> 16;
+            v = ((v + b) * t) >> 16;
+            v = ((v + c) * t) >> 16;
+            const int64_t y = p1 + (v >> 1);
+            return static_cast<int16_t>(std::clamp<int64_t>(y, -32768, 32767));
+        }
+
+    private:
+        static constexpr uint64_t kOne = 1ull << 32;
+
+        template <typename Pull>
+        void shiftIn(Pull &pull)
+        {
+            m_win[0][0] = m_win[1][0]; m_win[0][1] = m_win[1][1];
+            m_win[1][0] = m_win[2][0]; m_win[1][1] = m_win[2][1];
+            m_win[2][0] = m_win[3][0]; m_win[2][1] = m_win[3][1];
+            int16_t frame[2] = {0, 0};
+            if (!m_ended)
+            {
+                if (pull(frame, 1u) == 1u)
+                    ++m_inputFrames;
+                else
+                {
+                    m_ended = true;
+                    frame[0] = frame[1] = 0;
+                }
+            }
+            m_win[3][0] = frame[0];
+            m_win[3][1] = m_channels == 1u ? frame[0] : frame[1];
+        }
+
+        uint32_t m_channels;
+        uint64_t m_step;
+        uint64_t m_frac = 0u;
+        uint64_t m_inputFrames = 0u;
+        uint64_t m_p1Index = 0u;
+        bool m_primed = false;
+        bool m_ended = false;
+        int32_t m_win[4][2] = {};
+    };
+
+    // Reads an XAG clip (TSNDDRVM layout) from a host file: chunks of `channels` blocks of `blockBytes` SPU ADPCM,
+    // one block per channel; produces interleaved frames of `channels` samples. Buffers are sized once.
+    // readAt(offset, dst, size, &got) -> bool is the host file read.
+    struct XagClipLayout
+    {
+        uint64_t base = 0u;       // byte offset of the clip in the file
+        uint64_t bytes = 0u;      // clip length in bytes
+        uint32_t blockBytes = 0u; // per-channel block, multiple of 16
+        uint32_t channels = 0u;   // 1 or 2
+        uint32_t sampleRate = 0u;
+    };
+
+    class XagClipReader
+    {
+    public:
+        explicit XagClipReader(const XagClipLayout &layout)
+            : m_layout(layout),
+              m_framesPerChunk(layout.blockBytes / 16u * 28u),
+              m_chunk(static_cast<size_t>(layout.blockBytes) * layout.channels),
+              m_pcm(static_cast<size_t>(layout.blockBytes / 16u * 28u) * layout.channels)
+        {
+        }
+
+        [[nodiscard]] uint32_t channels() const { return m_layout.channels; }
+        [[nodiscard]] uint64_t chunksRead() const { return m_chunksRead; }
+
+        // Copies up to maxFrames frames; returns 0 at the end of the clip or on a read failure.
+        template <typename ReadAt>
+        size_t read(int16_t *dst, size_t maxFrames, ReadAt &&readAt)
+        {
+            size_t done = 0;
+            while (done < maxFrames)
+            {
+                if (m_pcmPos == m_pcmFrames && !refill(readAt))
+                    break;
+                const size_t n = std::min(maxFrames - done, m_pcmFrames - m_pcmPos);
+                std::copy_n(m_pcm.data() + m_pcmPos * m_layout.channels, n * m_layout.channels,
+                            dst + done * m_layout.channels);
+                m_pcmPos += n;
+                done += n;
+            }
+            return done;
+        }
+
+    private:
+        template <typename ReadAt>
+        bool refill(ReadAt &readAt)
+        {
+            const uint64_t chunkBytes = m_chunk.size();
+            if (m_failed || chunkBytes == 0u || m_done >= m_layout.bytes)
+                return false;
+            size_t got = 0;
+            if (!readAt(m_layout.base + m_done, m_chunk.data(), m_chunk.size(), got) || got == 0u)
+            {
+                m_failed = true;
+                return false;
+            }
+            const size_t blocks = got / m_layout.blockBytes;
+            std::fill(m_pcm.begin(), m_pcm.end(), int16_t{0});
+            for (uint32_t ch = 0; ch < m_layout.channels && ch < blocks; ++ch)
+                decodeSpuAdpcm(m_chunk.data() + static_cast<size_t>(ch) * m_layout.blockBytes, m_layout.blockBytes,
+                               m_state[ch], m_pcm.data() + ch, m_layout.channels);
+            m_pcmFrames = m_framesPerChunk;
+            m_pcmPos = 0;
+            m_done += chunkBytes;
+            ++m_chunksRead;
+            return true;
+        }
+
+        XagClipLayout m_layout;
+        size_t m_framesPerChunk;
+        std::vector<uint8_t> m_chunk;
+        std::vector<int16_t> m_pcm;
+        AdpcmChannelState m_state[2] = {};
+        size_t m_pcmFrames = 0, m_pcmPos = 0;
+        uint64_t m_done = 0, m_chunksRead = 0;
+        bool m_failed = false;
+    };
+}
