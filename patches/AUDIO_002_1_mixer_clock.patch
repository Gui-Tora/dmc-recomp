+        tc.Run("SPSC stress: no duplicate, reordered or torn frame; exact accounting", [](TestCase &t) {
+            constexpr uint64_t kFrames = 10000000;
+            SpscFrameRing ring(4096, 3000, 500);
+            std::atomic<bool> producerDone{false};
+            std::atomic<uint64_t> accepted{0};
+            std::atomic<uint64_t> offered{0};
+            std::thread producer([&] {
+                std::mt19937 rng(1);
+                std::vector<int16_t> buf(2 * 1024);
+                uint64_t seq = 0, sent = 0, pushes = 0;
+                while (seq < kFrames)
+                {
+                    const size_t n = 1 + rng() % 1024;
+                    for (size_t i = 0; i < n; ++i)
+                    {
+                        const uint64_t s = seq + i;
+                        buf[i * 2] = int16_t(s & 0xFFFF);
+                        buf[i * 2 + 1] = int16_t((s >> 16) & 0xFFFF);
+                    }
+                    const size_t k = ring.push(buf.data(), n);
+                    seq += k; // only accepted frames get sequence numbers
+                    sent += n;
+                    ++pushes;
+                    if (seq / 1000000 != (seq - k) / 1000000)
+                        ring.requestFlush(); // ~10 flushes over the run
+                    if (k < n)
+                        std::this_thread::yield(); // full: let the consumer run (the rest was dropped and counted)
+                }
+                accepted = seq;
+                offered = sent;
+                producerDone = true;
+            });
+            uint64_t consumed = 0, last = UINT64_MAX, errors = 0;
+            std::vector<int16_t> buf(2 * 777);
+            std::mt19937 rng(2);
+            auto drain = [&](size_t n) {
+                const size_t got = ring.pop(buf.data(), n);
+                for (size_t i = 0; i < got; ++i)
+                {
+                    const uint64_t s = uint64_t(uint16_t(buf[i * 2])) | (uint64_t(uint16_t(buf[i * 2 + 1])) << 16);
+                    const uint64_t expectHigh = last == UINT64_MAX ? 0 : (last & ~0xFFFFFFFFull);
+                    uint64_t full = expectHigh | s;
+                    if (last != UINT64_MAX && full <= last)
+                        full += 1ull << 32;
+                    if (last != UINT64_MAX && full <= last)
+                        ++errors;
+                    last = full;
+                }
+                consumed += got;
+                return got;
+            };
+            while (!producerDone.load())
+            {
+                drain(1 + rng() % 777);
+                if (rng() % 16 == 0)
+                    std::this_thread::sleep_for(std::chrono::microseconds(50));
+            }
+            producer.join();
+            while (drain(777) != 0)
+            {
+            }
+            const auto s = ring.stats();
+            t.Equals(errors, uint64_t(0), "strictly increasing sequence");
+            t.IsTrue(last == UINT64_MAX || last < accepted.load(), "never beyond what was accepted");
+            t.Equals(consumed + s.trimmed + s.flushed, accepted.load(), "consumed + trimmed + flushed = accepted");
+            t.Equals(s.pushed + s.dropped, offered.load(), "accepted + dropped = offered");
+            t.IsTrue(consumed > 100000 && s.trimmed > 0 && s.flushed > 0 && s.dropped > 0, "every path (read, trim, flush, drop) exercised");
+            std::printf("    (accepted %llu consumed %llu trimmed %llu flushed %llu dropped %llu)\n",
+                        (unsigned long long)accepted.load(), (unsigned long long)consumed,
+                        (unsigned long long)s.trimmed, (unsigned long long)s.flushed, (unsigned long long)s.dropped);
+        });
+        tc.Run("SPSC stress, lossless (waiting producer, no trim): contiguous sequence of 10^7 frames", [](TestCase &t) {
+            constexpr uint64_t kFrames = 10000000;
+            SpscFrameRing ring(4096);
+            std::thread producer([&] {
+                std::mt19937 rng(3);
+                std::vector<int16_t> buf(2 * 1024);
+                uint64_t seq = 0;
+                while (seq < kFrames)
+                {
+                    const size_t n = static_cast<size_t>(std::min<uint64_t>(1 + rng() % 1024, kFrames - seq));
+                    for (size_t i = 0; i < n; ++i)
+                    {
+                        buf[i * 2] = int16_t((seq + i) & 0xFFFF);
+                        buf[i * 2 + 1] = int16_t(((seq + i) >> 16) & 0xFFFF);
+                    }
+                    size_t done = 0;
+                    while (done < n)
+                    {
+                        const size_t space = ring.freeSpace();
+                        if (space == 0)
+                        {
+                            std::this_thread::yield();
+                            continue;
+                        }
+                        const size_t k = std::min(space, n - done);
+                        done += ring.push(buf.data() + done * 2, k);
+                    }
+                    seq += n;
+                }
+            });
+            uint64_t expect = 0, errors = 0;
+            std::vector<int16_t> buf(2 * 513);
