index 0000000000000000000000000000000000000000..0797fb5726a924b06755b3dfa06a887f02e074b4
--- /dev/null
+++ b/ps2xRuntime/include/ps2_vu0_mac.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// VU0 MAC flag register for COP2 macro-mode FMAC instructions (included by generated code that uses it).
+//
+// Layout (PCSX2 VUflags.cpp, VU_MAC_UPDATE; shift x=3, y=2, z=1, w=0):
+//   Z (zero)      0x0001 << shift     S (sign)     0x0010 << shift
+//   U (underflow) 0x0100 << shift     O (overflow) 0x1000 << shift
+// Per written field: S = sign bit of the result; result == +/-0 -> Z; exponent 0 with a non-zero mantissa -> Z|U;
+// exponent 255 (Inf/NaN on the host) -> O; otherwise only S. Fields the instruction does not write are cleared
+// (applyBinaryMACOp/applyTernaryMACOp: VU_MACx_CLEAR...), except OPMULA/OPMSUB, which write x/y/z and leave the w
+// bits untouched. Only the flags are modelled here; result values are not altered.
+
+#include <cstdint>
+#include <cstring>
+#include <xmmintrin.h>
+
+inline uint32_t ps2Vu0MacFieldBits(uint32_t bits)
+{
+    const uint32_t exponent = bits & 0x7F800000u;
+    uint32_t flags = (bits & 0x80000000u) ? 0x0010u : 0u;
+    if ((bits & 0x7FFFFFFFu) == 0u)
+        flags |= 0x0001u;
+    else if (exponent == 0u)
+        flags |= 0x0101u;
+    else if (exponent == 0x7F800000u)
+        flags |= 0x1000u;
+    return flags;
+}
+
+// lanes: VU field mask (x = 0x8, y = 0x4, z = 0x2, w = 0x1) of the fields written by the instruction.
+// keep:  MAC bits carried over from the previous value (0 for every FMAC except OPMULA/OPMSUB: 0x1111, the w bits).
+inline uint32_t ps2Vu0MacUpdate(uint32_t oldMac, __m128 result, uint32_t lanes, uint32_t keep)
+{
+    uint32_t v[4];
+    std::memcpy(v, &result, sizeof(v));
+    uint32_t mac = oldMac & keep;
+    for (uint32_t i = 0; i < 4u; ++i)
+    {
+        if (lanes & (0x8u >> i))
+            mac |= ps2Vu0MacFieldBits(v[i]) << (3u - i);
+    }
+    return mac & 0xFFFFu;
+}
