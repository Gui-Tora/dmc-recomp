+    // Literal port of PCSX2 VUflags.cpp VU_MAC_UPDATE / VU_MACx_CLEAR and VUops.cpp applyBinaryMACOp,
+    // _vuOPMULA/_vuOPMSUB (flags only), used as the oracle for ps2_vu0_mac.h.
+    void pcsx2MacUpdate(uint32_t &macflag, int shift, uint32_t v)
+    {
+        float f;
+        std::memcpy(&f, &v, sizeof(f));
+        const int exp = (v >> 23) & 0xff;
+        const uint32_t s = v & 0x80000000u;
+        if (s)
+            macflag |= 0x0010u << shift;
+        else
+            macflag &= ~(0x0010u << shift);
+        if (f == 0)
+        {
+            macflag = (macflag & ~(0x1100u << shift)) | (0x0001u << shift);
+            return;
+        }
+        switch (exp)
+        {
+        case 0:
+            macflag = (macflag & ~(0x1000u << shift)) | (0x0101u << shift);
+            return;
+        case 255:
+            macflag = (macflag & ~(0x0101u << shift)) | (0x1000u << shift);
+            return;
+        default:
+            macflag = (macflag & ~(0x1101u << shift));
+            return;
+        }
+    }
+    uint32_t pcsx2ApplyMac(uint32_t macflag, const uint32_t v[4], uint32_t lanes, bool outerProduct)
+    {
+        for (int i = 0; i < 4; ++i)
+        {
+            const int shift = 3 - i;
+            const bool written = outerProduct ? (i < 3) : ((lanes & (0x8u >> i)) != 0u);
+            if (written)
+                pcsx2MacUpdate(macflag, shift, v[i]);
+            else if (!outerProduct) // _vuOPMULA/_vuOPMSUB never touch the w bits
+                macflag &= ~(0x1111u << shift);
+        }
+        return macflag & 0xFFFFu;
+    }
+    __m128 bitsToVec(const uint32_t v[4])
+    {
+        __m128 r;
+        std::memcpy(&r, v, sizeof(r));
+        return r;
+    }
