+        // COP2 macro-mode FMAC instructions update the VU0 MAC flag register (read back by CFC2 $vi17).
+        // Special1 (fmt CO, function < 0x3C) writes vf[fd]; Special2 (function >= 0x3C) writes ACC. Both tables use
+        // the same codes for the MAC-writing group: ADD/SUB/MADD/MSUB bc (0x00-0x0F), MUL bc/q (0x18-0x1C), MULi
+        // (0x1E), q/i forms (0x20-0x27), ADD/MADD/MUL/SUB/MSUB (0x28-0x2A, 0x2C, 0x2D) and OPMSUB/OPMULA (0x2E).
+        // MAX/MINI, ABS, MOVE/MR32, FTOI/ITOF, CLIP, DIV/SQRT/RSQRT, NOP and the integer ops leave MAC unchanged
+        // (PCSX2 VUops.cpp: only applyBinaryMACOp/applyTernaryMACOp and _vuOPMULA/_vuOPMSUB call VU_MAC*_UPDATE).
+        bool isVu0MacWritingCode(uint32_t code)
+        {
+            return code <= 0x0Fu || (code >= 0x18u && code <= 0x1Cu) || code == 0x1Eu ||
+                   (code >= 0x20u && code <= 0x2Au) || code == 0x2Cu || code == 0x2Du || code == 0x2Eu;
+        }
+
+        // Appends the MAC update after the translated FMAC statement, computed from the destination as written
+        // (before CodeGenerator::translateInstruction discards a write to the hardwired vf0, so `op.w $vf0, ...`
+        // still sets the flags of its result, as PCSX2 does through RDzero).
+        std::string appendVu0MacUpdate(const Instruction &inst, std::string code)
+        {
+            if (inst.opcode != OPCODE_COP2 || inst.rs < COP2_CO)
+                return code;
+            const uint32_t special1 = inst.function & 0x3Fu;
+            const bool special2 = special1 >= 0x3Cu;
+            const uint32_t fn = special2 ? ((((inst.raw >> 6) & 0x1Fu) << 2) | (inst.raw & 0x3u)) : special1;
+            if (!isVu0MacWritingCode(fn))
+                return code;
+            const std::string target = special2 ? "ctx->vu0_acc" : fmt::format("ctx->vu0_vf[{}]", inst.sa);
+            if (code.find(target + " =") == std::string::npos)
+                return code; // the instruction was not translated as a write of its destination; leave MAC alone
+            const bool outerProduct = fn == 0x2Eu; // OPMULA / OPMSUB: x, y, z written, w flags preserved
+            const uint32_t lanes = outerProduct ? 0xEu : (inst.vectorInfo.vectorField & 0xFu);
+            const uint32_t keep = outerProduct ? 0x1111u : 0u;
+            code += fmt::format(" ctx->vu0_mac_flags = ps2Vu0MacUpdate(ctx->vu0_mac_flags, {}, 0x{:X}u, 0x{:X}u);",
+                                target, lanes, keep);
+            return code;
+        }
+    }
