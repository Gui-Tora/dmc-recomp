+namespace
+{
+    // F9 checkpoint destination. PS2X_CHECKPOINT_SAVE_PATH selects the file
+    // (default keeps the historical dmc_checkpoint_mainmenu_v2.dmck name). An
+    // existing file is never overwritten: a numeric suffix is appended instead.
+    std::filesystem::path &lastCheckpointRequestPath()
+    {
+        static std::filesystem::path path;
+        return path;
+    }
+
+    std::filesystem::path checkpointSaveRequestPathNoOverwrite()
+    {
+        const char *env = std::getenv("PS2X_CHECKPOINT_SAVE_PATH");
+        std::filesystem::path base = (env && *env) ? std::filesystem::path(env)
+                                                   : std::filesystem::path("dmc_checkpoint_mainmenu_v2.dmck");
+        std::filesystem::path candidate = base;
+        std::error_code ec;
+        for (unsigned n = 1; std::filesystem::exists(candidate, ec) && n < 1000u; ++n)
+        {
+            candidate = base.parent_path() / (base.stem().string() + "_" + std::to_string(n) + base.extension().string());
+        }
+        lastCheckpointRequestPath() = candidate;
+        return candidate;
+    }
+}
