@@ -0,0 +1,271 @@
+// AUDIO_002-5 (patch 40): SPU2 ADMA block source for PSS movie PCM (libsd BlockTrans) and its guest clock.
+#include "MiniTest.h"
+#include "audio/audio_mixer.h"
+#include "audio/pss_audio.h"
+
+#include <cstring>
+#include <memory>
+#include <vector>
+
+using namespace ps2audio;
+
+namespace
+{
+    constexpr uint32_t kBase = 0x00020000u;  // IOP buffer address as the guest sees it
+    constexpr uint32_t kArea = 0x6000u;      // SLES_503.58 MoviePcmInit: 24 blocks
+    constexpr uint32_t kFieldHz = 50u;       // 960 frames per field
+
+    // Interleaved stereo s16 stream as the PSS stores it: blocks of 512 B left + 512 B right.
+    std::vector<uint8_t> makeBody(size_t blocks, uint32_t seed)
+    {
+        std::vector<uint8_t> body(blocks * kAdmaBlockBytes);
+        uint32_t x = seed;
+        for (size_t i = 0; i < body.size(); i += 2)
+        {
+            x = x * 1103515245u + 12345u;
+            const int16_t s = static_cast<int16_t>(x >> 16);
+            std::memcpy(body.data() + i, &s, 2);
+        }
+        return body;
+    }
+
+    int16_t bodySample(const std::vector<uint8_t> &body, uint64_t frame, int channel)
+    {
+        const size_t at = static_cast<size_t>(frame / kAdmaBlockFrames) * kAdmaBlockBytes +
+                          (channel ? kAdmaHalfBytes : 0u) + static_cast<size_t>(frame % kAdmaBlockFrames) * 2u;
+        int16_t s;
+        std::memcpy(&s, body.data() + at, 2);
+        return s;
+    }
+
+    struct FakeIop
+    {
+        std::vector<uint8_t> mem = std::vector<uint8_t>(kArea, 0u);
+        uint64_t reads = 0;
+        bool fail = false;
+        AdmaBlockSource::ReadFn reader()
+        {
+            return [this](uint32_t address, void *dst, size_t size) {
+                ++reads;
+                if (fail || address < kBase || address + size > kBase + mem.size())
+                    return false;
+                std::memcpy(dst, mem.data() + (address - kBase), size);
+                return true;
+            };
+        }
+    };
+
+    std::shared_ptr<AdmaVolume> unity()
+    {
+        auto v = std::make_shared<AdmaVolume>();
+        v->left = 0x7FFF;
+        v->right = 0x7FFF;
+        return v;
+    }
+
+    // Literal model of SLES_503.58 audiodec (audioDecSendToIOP + iopGetArea + sendToIOP2area) against the stub clock:
+    // preset fills the whole area, BlockTrans(loop) starts at tick t0, at VBlank T the mixer renders field T-1, then
+    // every second tick the guest reads the block status and refills [last, status - 0x400) from its stream.
+    // Returns the rendered PCM; `stopFeedingAt` (tick) simulates a guest that stops refilling.
+    std::vector<int16_t> simulateMovie(const std::vector<uint8_t> &body, uint64_t ticks, AdmaVolume *volOut = nullptr,
+                                       uint64_t stopFeedingAt = UINT64_MAX)
+    {
+        FakeIop iop;
+        size_t sent = 0;
+        std::memcpy(iop.mem.data(), body.data(), kArea); // preset
+        sent = kArea;
+        uint32_t last = 0;
+        auto vol = unity();
+        AdmaBlockSource src(kBase, kArea, 0u, true, vol, iop.reader());
+        std::vector<int16_t> out;
+        const uint64_t t0 = 1000;
+        std::vector<int16_t> field(960 * 2);
+        for (uint64_t t = t0 + 1; t <= t0 + ticks; ++t)
+        {
+            const size_t got = src.render(field.data(), 960);
+            out.insert(out.end(), field.begin(), field.begin() + static_cast<std::ptrdiff_t>(got) * 2);
+            if ((t - t0) % 2u == 0u && (t - t0) < stopFeedingAt)
+            {
+                const uint32_t pos = admaOffset(0u, admaFramesAfterFields(t - t0, kFieldHz), kArea, true);
+                const uint32_t area = (pos + kArea - last - kAdmaBlockBytes) % kArea; // iopGetArea, block aligned
+                const uint32_t want = area - area % kAdmaBlockBytes;
+                for (uint32_t i = 0; i < want && sent < body.size(); ++i, ++sent)
+                    iop.mem[(last + i) % kArea] = body[sent];
+                last = (last + want) % kArea;
+            }
+        }
+        if (volOut)
+        {
+            volOut->left = vol->left.load();
+            volOut->right = vol->right.load();
+        }
+        return out;
+    }
+}
+
+void register_audio_pss_tests()
+{
+    MiniTest::Case("AudioPssAdma", [](TestCase &tc) {
+        tc.Run("a block is 512 bytes of left then 512 bytes of right, little-endian s16", [](TestCase &t) {
+            FakeIop iop;
+            const auto body = makeBody(kArea / kAdmaBlockBytes, 7u);
+            std::memcpy(iop.mem.data(), body.data(), kArea);
+            AdmaBlockSource src(kBase, kArea, 0u, true, unity(), iop.reader());
+            std::vector<int16_t> out(2 * 600);
+            t.Equals(src.render(out.data(), 600), size_t(600), "renders all requested frames");
+            bool ok = true;
+            for (uint64_t f = 0; f < 600; ++f)
+                ok = ok && out[f * 2] == applyAdmaVolume(bodySample(body, f, 0), 0x7FFF) &&
+                     out[f * 2 + 1] == applyAdmaVolume(bodySample(body, f, 1), 0x7FFF);
+            t.IsTrue(ok, "frame f = (L[f % 256], R[f % 256]) of block f / 256");
+        });
+
+        tc.Run("clock: 960 frames per PAL field, one 1024-byte block per 256 frames, loop wraps the area", [](TestCase &t) {
+            t.Equals(admaFramesAfterFields(1, 50), uint64_t(960), "one field");
+            t.Equals(admaFramesAfterFields(50, 50), uint64_t(48000), "one second");
+            t.Equals(admaFramesAfterFields(7, 47), uint64_t(7 * 48000 / 47), "rates not dividing 48000 floor");
+            t.Equals(admaOffset(0, 960, kArea, true), uint32_t(3 * 1024), "3.75 blocks -> block 3");
+            t.Equals(admaOffset(0, 24 * 256, kArea, true), uint32_t(0), "24 blocks wrap to 0");
+            t.Equals(admaOffset(0x5C00, 256, kArea, true), uint32_t(0), "resume at the last block wraps");
+            t.Equals(admaOffset(0, 100 * 256, kArea, false), kArea, "a non-loop transfer stops at the end");
+            t.Equals(admaOffset(0, 256, 0x200, true), uint32_t(0), "area smaller than a block");
+        });
+
+        tc.Run("guest protocol model: the WAV is the PCM stream, in order, nothing lost or repeated", [](TestCase &t) {
+            const auto body = makeBody(600, 11u); // 600 blocks = 3.2 s
+            const auto out = simulateMovie(body, 150);
+            bool ok = out.size() == 150u * 960u * 2u;
+            for (uint64_t f = 0; ok && f < 150u * 960u; ++f)
+                ok = out[f * 2] == applyAdmaVolume(bodySample(body, f, 0), 0x7FFF) &&
+                     out[f * 2 + 1] == applyAdmaVolume(bodySample(body, f, 1), 0x7FFF);
+            t.IsTrue(ok, "150 fields equal the stream (the block being played is never refilled)");
+        });
+
+        tc.Run("deterministic replay of the same stream", [](TestCase &t) {
+            const auto body = makeBody(400, 3u);
+            t.IsTrue(simulateMovie(body, 100) == simulateMovie(body, 100), "identical PCM");
+        });
+
+        tc.Run("underflow: a guest that stops refilling replays the stale area (no block, no crash)", [](TestCase &t) {
+            const auto body = makeBody(600, 5u);
+            const auto out = simulateMovie(body, 120, nullptr, 60);
+            const uint64_t lastFed = admaFramesAfterFields(58, kFieldHz); // last refill at tick t0 + 58
+            t.Equals(out.size(), size_t(120 * 960 * 2), "the source keeps producing");
+            bool fresh = true;
+            for (uint64_t f = 0; f < lastFed; ++f)
+                fresh = fresh && out[f * 2] == applyAdmaVolume(bodySample(body, f, 0), 0x7FFF);
+            t.IsTrue(fresh, "everything up to the last refill is the stream");
+            // Once the refills stop the source keeps looping over the area: one loop (24 blocks) later the same
+            // slot, with the same stale content, is played again.
+            const uint64_t f = 110u * 960u, g = f - 24u * 256u;
+            t.IsTrue(out[f * 2] == out[g * 2] && out[f * 2 + 1] == out[g * 2 + 1], "stale area replayed one loop later");
+        });
+
+        tc.Run("volume: unity, mute, signed values below zero, latched per render call", [](TestCase &t) {
+            t.Equals(int(applyAdmaVolume(1000, 0x7FFF)), int((1000 * 0x7FFF) >> 15), "0x7FFF");
+            t.Equals(int(applyAdmaVolume(-32768, 0x7FFF)), -32767, "0x7FFF on -32768");
+            t.Equals(int(applyAdmaVolume(12345, 0)), 0, "mute");
+            t.Equals(int(applyAdmaVolume(1000, static_cast<int16_t>(0xF77F))), int((1000 * -0x881) >> 15),
+                     "0xF77F (u16 wrap of the game's fade) is negative");
+            t.Equals(int(applyAdmaVolume(-32768, -32768)), 32767, "saturates");
+            FakeIop iop;
+            const auto body = makeBody(24, 9u);
+            std::memcpy(iop.mem.data(), body.data(), kArea);
+            auto vol = std::make_shared<AdmaVolume>();
+            vol->left = 0x4000;
+            vol->right = 0;
+            AdmaBlockSource src(kBase, kArea, 0u, true, vol, iop.reader());
+            std::vector<int16_t> out(2 * 100);
+            src.render(out.data(), 50);
+            vol->left = 0;
+            src.render(out.data() + 100, 50);
+            t.Equals(out[0], applyAdmaVolume(bodySample(body, 0, 0), 0x4000), "left half volume");
+            t.Equals(int(out[1]), 0, "right muted");
+            t.Equals(int(out[100]), 0, "new volume from the next render call");
+        });
+
+        tc.Run("empty or unreadable buffer gives silence and is counted", [](TestCase &t) {
+            FakeIop iop;
+            iop.fail = true;
+            AdmaBlockSource src(kBase, kArea, 0u, true, unity(), iop.reader());
+            std::vector<int16_t> out(2 * 960, 7);
+            t.Equals(src.render(out.data(), 960), size_t(960), "keeps the clock");
+            bool silent = true;
+            for (int16_t s : out)
+                silent = silent && s == 0;
+            t.IsTrue(silent, "silence");
+            t.Equals(src.readFailures(), uint64_t(4), "one failure per block read (3.75 blocks)");
+            AdmaBlockSource none(kBase, 0x200u, 0u, true, unity(), iop.reader());
+            t.Equals(none.render(out.data(), 960), size_t(0), "an area smaller than a block produces nothing");
+            t.IsTrue(none.finished(), "and finishes");
+        });
+
+        tc.Run("block lengths: area and start offset are aligned down to blocks; non-loop transfer ends", [](TestCase &t) {
+            FakeIop iop;
+            const auto body = makeBody(24, 21u);
+            std::memcpy(iop.mem.data(), body.data(), kArea);
+            AdmaBlockSource src(kBase, kArea + 100u, 0x400u + 17u, false, unity(), iop.reader());
+            std::vector<int16_t> out(2 * 256 * 30);
+            const size_t got = src.render(out.data(), 256 * 30);
+            t.Equals(got, size_t(23 * 256), "23 blocks from block 1 to the end of a 24-block area");
+            t.IsTrue(src.finished(), "finished");
+            t.Equals(out[0], applyAdmaVolume(bodySample(body, 256, 0), 0x7FFF), "starts at block 1");
+        });
+
+        tc.Run("pause/resume: a transfer entered at the pause block continues the stream", [](TestCase &t) {
+            FakeIop iop;
+            const auto body = makeBody(24, 33u);
+            std::memcpy(iop.mem.data(), body.data(), kArea);
+            AdmaBlockSource a(kBase, kArea, 0u, true, unity(), iop.reader());
+            std::vector<int16_t> first(2 * 960 * 2), second(2 * 960);
+            a.render(first.data(), 960 * 2);
+            const uint32_t pause = admaOffset(0u, 960u * 2u, kArea, true); // STOP status: block 7
+            AdmaBlockSource b(kBase, kArea, pause, true, unity(), iop.reader());
+            b.render(second.data(), 960);
+            t.Equals(second[0], applyAdmaVolume(bodySample(body, 7 * 256, 0), 0x7FFF), "resumes at block 7");
+        });
+
+        tc.Run("mixer: movie change and interruption leave exactly one source; removal stops the PCM", [](TestCase &t) {
+            MixerConfig cfg;
+            cfg.device = false;
+            AudioMixer mixer(cfg);
+            FakeIop iopA, iopB;
+            const auto bodyA = makeBody(24, 41u), bodyB = makeBody(24, 42u);
+            std::memcpy(iopA.mem.data(), bodyA.data(), kArea);
+            std::memcpy(iopB.mem.data(), bodyB.data(), kArea);
+            const uint64_t a = mixer.addSource(AudioGroup::Pss,
+                                               std::make_unique<AdmaBlockSource>(kBase, kArea, 0u, true, unity(), iopA.reader()));
+            for (uint64_t tick = 1; tick <= 5; ++tick)
+                mixer.onVBlank(tick);
+            mixer.removeSource(a); // STOP of the first movie
+            const uint64_t b = mixer.addSource(AudioGroup::Pss,
+                                               std::make_unique<AdmaBlockSource>(kBase, kArea, 0u, true, unity(), iopB.reader()));
+            t.Equals(mixer.sourceCount(), size_t(1), "one source after the change");
+            const uint64_t readsA = iopA.reads;
+            for (uint64_t tick = 6; tick <= 8; ++tick)
+                mixer.onVBlank(tick);
+            t.Equals(iopA.reads, readsA, "the old movie's buffer is no longer read");
+            t.IsTrue(iopB.reads > 0, "the new one is");
+            mixer.removeSource(b);
+            mixer.removeSource(b); // idempotent (STOP after a reset)
+            t.Equals(mixer.sourceCount(), size_t(0), "no source left");
+        });
+
+        tc.Run("close with an active transfer: mixer shutdown destroys the source", [](TestCase &t) {
+            MixerConfig cfg;
+            cfg.device = false;
+            auto mixer = std::make_unique<AudioMixer>(cfg);
+            FakeIop iop;
+            mixer->addSource(AudioGroup::Pss, std::make_unique<AdmaBlockSource>(kBase, kArea, 0u, true, unity(), iop.reader()));
+            mixer->onVBlank(1);
+            mixer->onVBlank(2);
+            mixer->shutdown();
+            t.Equals(mixer->sourceCount(), size_t(0), "sources destroyed");
+            const uint64_t reads = iop.reads;
+            mixer->onVBlank(3);
+            t.Equals(iop.reads, reads, "nothing rendered after shutdown");
+            mixer.reset();
+            t.IsTrue(true, "destroyed cleanly");
+        });
+    });
+}
