+#pragma once
+// AUDIO_002-5 (patch 40, experimental): PSS movie PCM through the SPU2 ADMA block transfer of libsd (header-only,
+// private to the runtime; not included by recompiled EE code).
+//
+// Guest contract (SLES_503.58, Sony ezmpeg audiodec): the EE copies 16-bit little-endian PCM to an IOP buffer in blocks
+// of 1024 bytes = 512 bytes of left (256 samples) followed by 512 bytes of right, starts sceSdBlockTrans (loop) on the
+// buffer and refills the part behind sceSdBlockTransStatus. The SPU2 consumes one block per 256 frames at 48 kHz.
+//
+// Two clocks:
+//   guest clock  : the transfer position is a function of the emulated time only -- frames = fields * 48000 / fieldHz
+//                  since the BlockTrans call, the same rate as the patch-37 mixer -- so what the guest sees, what it
+//                  refills and what the WAV contains do not depend on host speed.
+//   device clock : the mixer forwards the guest-timed mix to the device (group Pss, DeviceMode::Guest); there is no
+//                  free-running copy: the PCM only exists once the guest has sent it.
+
+#include "ps2x/iop/audio_dsp.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <string>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <cstdio>
+#include <functional>
+#include <memory>
+
+namespace ps2_stubs
+{
+    // Kernel/Stubs/SIF.cpp: true when PS2X_IOP_HEAP_ALIAS holds a valid 24-bit window.
+    bool sifIopHeapAliasActive();
