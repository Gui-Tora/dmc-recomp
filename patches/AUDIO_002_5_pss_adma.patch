+    struct SdAdmaDebugState
+    {
+        bool active = false;
+        bool loop = false;
+        bool hasSource = false;
+        bool clockStarted = false;
+        uint32_t base = 0u;
+        uint32_t size = 0u;
+        int32_t bvolLeft = 0;
+        int32_t bvolRight = 0;
+    };
+    SdAdmaDebugState sdAdmaDebugState(uint32_t core);
+}
+
+namespace ps2audio
+{
+    // PS2X_SD_ADMA=1 enables the guest-clocked BlockTrans, the Pss mixer source and the retention of audio PES
+    // packets until their callback returns. Off by default: the libsd stub keeps its previous behaviour (+1024 bytes
+    // per status call) and the demux keeps dropping audio callbacks that return 0. It needs IOP buffer addresses that
+    // fit in 24 bits (PS2X_IOP_HEAP_ALIAS); without them the guest never refills the buffer, and with retention the
+    // movie would wait forever for its audio ring to drain.
+    //
+    // Effective only together with an active PS2X_IOP_HEAP_ALIAS: PS2X_SD_ADMA=1 alone is ignored with a notice
+    // (AUDIO_002-5 final gate), so that configuration behaves exactly like the default one.
+    inline bool sdAdmaEnabled()
+    {
+        static const bool enabled = [] {
+            const char *v = std::getenv("PS2X_SD_ADMA");
+            if (!v || std::string(v) != "1")
+                return false;
+            if (!ps2_stubs::sifIopHeapAliasActive())
+            {
+                std::fprintf(stderr, "[AUDIO:adma] PS2X_SD_ADMA=1 ignored: it needs a valid PS2X_IOP_HEAP_ALIAS "
+                                     "(IOP buffers must be 24-bit addresses for libsd's transfer status)\n");
+                return false;
+            }
+            return true;
+        }();
+        return enabled;
+    }
+
+    inline constexpr uint32_t kAdmaBlockBytes = 1024u;  // 512 B left + 512 B right
+    inline constexpr uint32_t kAdmaHalfBytes = 512u;
+    inline constexpr uint32_t kAdmaBlockFrames = 256u;
+
+    // Frames the ADMA has consumed after `fields` complete fields (floor, like the mixer's per-field split).
+    inline uint64_t admaFramesAfterFields(uint64_t fields, uint32_t fieldHz)
+    {
+        return fieldHz == 0u ? 0u : fields * ps2x::iop::audio::kMixRate / fieldHz;
+    }
+
+    // Block-aligned byte offset of the block being played after `frames` frames, inside an area of `areaBytes`
+    // (multiple of 1024) entered at block-aligned `startOffset`. A non-loop transfer stops at the end of the area.
+    inline uint32_t admaOffset(uint32_t startOffset, uint64_t frames, uint32_t areaBytes, bool loop)
+    {
+        if (areaBytes < kAdmaBlockBytes)
+            return 0u;
+        const uint64_t bytes = static_cast<uint64_t>(startOffset) + (frames / kAdmaBlockFrames) * kAdmaBlockBytes;
+        if (loop)
+            return static_cast<uint32_t>(bytes % areaBytes);
+        return static_cast<uint32_t>(std::min<uint64_t>(bytes, areaBytes));
+    }
+
+    // SPU2 core input volume of the ADMA data (libsd SD_P_BVOLL / SD_P_BVOLR), as written by the guest.
+    struct AdmaVolume
+    {
+        std::atomic<int32_t> left{0};
+        std::atomic<int32_t> right{0};
+    };
+
+    // Signed 16-bit volume, 0x7FFF ~ unity: (x * v) >> 15 (arithmetic), saturated.
+    inline int16_t applyAdmaVolume(int16_t sample, int16_t volume)
+    {
+        const int32_t v = (static_cast<int32_t>(sample) * static_cast<int32_t>(volume)) >> 15;
+        return static_cast<int16_t>(std::clamp(v, -32768, 32767));
+    }
+
+    // Mixer source for one SPU2 core's ADMA block transfer. Frame k of the source is frame k of the transfer, so the
+    // mixer's render of field T-1 at VBlank T reads exactly the blocks the guest saw being played during tick T-1.
+    // The block being played is never refilled by the guest (it writes up to status - 0x400), and the source reads
+    // each block when it renders it (no caching across fields). read(address, dst, size) reads the IOP buffer.
+    class AdmaBlockSource final : public ps2x::iop::audio::AudioRenderSource
+    {
+    public:
+        using ReadFn = std::function<bool(uint32_t address, void *dst, size_t size)>;
+
+        AdmaBlockSource(uint32_t base, uint32_t areaBytes, uint32_t startOffset, bool loop,
+                        std::shared_ptr<const AdmaVolume> volume, ReadFn read)
+            : m_base(base),
+              m_area(areaBytes - areaBytes % kAdmaBlockBytes),
+              m_start(startOffset - startOffset % kAdmaBlockBytes),
+              m_loop(loop),
+              m_volume(std::move(volume)),
+              m_read(std::move(read))
+        {
+            if (m_area != 0u)
+                m_start %= m_area;
+        }
+
+        size_t render(int16_t *stereo, size_t frames) override
+        {
+            const int16_t volL = m_volume ? static_cast<int16_t>(m_volume->left.load(std::memory_order_relaxed)) : 0;
+            const int16_t volR = m_volume ? static_cast<int16_t>(m_volume->right.load(std::memory_order_relaxed)) : 0;
+            uint64_t cachedBlock = UINT64_MAX;
+            size_t done = 0;
+            while (done < frames && !m_finished)
+            {
+                if (m_area == 0u)
+                {
+                    m_finished = true;
+                    break;
+                }
+                const uint64_t block = m_frame / kAdmaBlockFrames;
+                const uint64_t byteInArea = static_cast<uint64_t>(m_start) + block * kAdmaBlockBytes;
+                if (!m_loop && byteInArea >= m_area)
+                {
+                    m_finished = true;
+                    break;
+                }
+                if (block != cachedBlock)
+                {
+                    const uint32_t offset = static_cast<uint32_t>(byteInArea % m_area);
+                    if (!m_read || !m_read(m_base + offset, m_block.data(), m_block.size()))
+                    {
+                        m_block.fill(0u);
+                        ++m_readFailures;
+                    }
+                    cachedBlock = block;
+                }
+                const uint32_t n = static_cast<uint32_t>(m_frame % kAdmaBlockFrames);
+                const size_t take = std::min<size_t>(frames - done, kAdmaBlockFrames - n);
+                for (size_t i = 0; i < take; ++i)
+                {
+                    int16_t l, r;
+                    std::memcpy(&l, m_block.data() + 2u * (n + i), 2u);
+                    std::memcpy(&r, m_block.data() + kAdmaHalfBytes + 2u * (n + i), 2u);
+                    stereo[(done + i) * 2u] = applyAdmaVolume(l, volL);
+                    stereo[(done + i) * 2u + 1u] = applyAdmaVolume(r, volR);
+                }
+                done += take;
+                m_frame += take;
+            }
+            return done;
+        }
+
+        [[nodiscard]] bool finished() const override { return m_finished; }
+        [[nodiscard]] uint64_t framesRendered() const { return m_frame; }
+        [[nodiscard]] uint64_t readFailures() const { return m_readFailures; }
+
+    private:
+        uint32_t m_base;
+        uint32_t m_area;
+        uint32_t m_start;
+        bool m_loop;
+        std::shared_ptr<const AdmaVolume> m_volume;
+        ReadFn m_read;
+        std::array<uint8_t, kAdmaBlockBytes> m_block{};
+        uint64_t m_frame = 0u;
+        uint64_t m_readFailures = 0u;
+        bool m_finished = false;
+    };
+
+    // Bridge to the IOP host's mixer (defined in ps2_iop_host.cpp; the host registers itself on construction).
+    namespace bridge
+    {
+        [[nodiscard]] bool mixerEnabled();
+        [[nodiscard]] uint32_t fieldHz();
+        uint64_t addSource(ps2x::iop::audio::AudioGroup group,
+                           std::unique_ptr<ps2x::iop::audio::AudioRenderSource> source);
+        void removeSource(uint64_t id);
+    }
+}
