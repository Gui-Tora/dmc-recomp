+        // AUDIO_002-5 (patch 40): 24-bit alias of the start of the SIF heap. libsd reports SPU2 transfer positions
+        // as 24-bit IOP addresses (sceSdBlockTransStatus), and games subtract the address returned by
+        // sceSifAllocIopHeap from them (SLES_503.58 iopGetArea@0x47A320). Real IOP heap addresses are below 2 MiB;
+        // 0x04xxxxxx is not representable, so the subtraction is always negative. Blocks whose storage offset fits
+        // in the alias are handed out at kIopHeapAliasBase + offset instead (the storage, the allocation map keys and
+        // the checkpoint codec stay canonical, 0x04xxxxxx). The alias lies in EE kernel memory (0x00000000-0x0007FFFF):
+        // games cannot allocate there, and the runtime only uses 0x2F0-0x2F8 and the syscall mirror at 0x11F80 +/- 4n.
+        //
+        // Opt-in: PS2X_IOP_HEAP_ALIAS=base:limit (hex or decimal), e.g. 0x00020000:0x00080000 for SLES_503.58. The
+        // window must be 64-byte aligned and below 16 MiB; it aliases EE RDRAM numerically, so it must be a range the
+        // game never uses as an EE address (that is why it is not on by default: the upstream invariant is that IOP
+        // heap addresses lie outside EE RDRAM). Unset or invalid: no alias, previous behaviour.
+        struct IopHeapAliasWindow
+        {
+            uint32_t base = 0u;
+            uint32_t limit = 0u;
+        };
+
+        const IopHeapAliasWindow &iopHeapAliasWindow()
+        {
+            static const IopHeapAliasWindow window = [] {
+                IopHeapAliasWindow w{};
+                const char *v = std::getenv("PS2X_IOP_HEAP_ALIAS");
+                if (!v)
+                    return w;
+                char *end = nullptr;
+                const unsigned long long base = std::strtoull(v, &end, 0);
+                if (!end || *end != ':')
+                    return w;
+                char *limitEnd = nullptr;
+                const unsigned long long limit = std::strtoull(end + 1, &limitEnd, 0);
+                // base 0 would hand out the first block as address 0, which the guest reads as a failed allocation.
+                if (!limitEnd || *limitEnd != '\0' || base == 0u || base >= limit || limit > 0x01000000ull ||
+                    (base % kIopHeapAlign) != 0u ||
+                    (limit % kIopHeapAlign) != 0u || limit - base > static_cast<unsigned long long>(kIopHeapLimit - kIopHeapBase))
+                {
+                    std::fprintf(stderr, "[SIF:heap] PS2X_IOP_HEAP_ALIAS=%s ignored (need base:limit, 64-byte aligned, "
+                                         "0<base<limit<=0x1000000, at most the heap size)\n", v);
+                    return w;
+                }
+                w.base = static_cast<uint32_t>(base);
+                w.limit = static_cast<uint32_t>(limit);
+                std::fprintf(stderr, "[SIF:heap] 24-bit alias 0x%08X-0x%08X -> 0x%08X\n", w.base, w.limit, kIopHeapBase);
+                return w;
+            }();
+            return window;
+        }
