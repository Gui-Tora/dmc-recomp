+++ b/ps2xTest/src/pss_sif_libsd_tests.cpp
@@ -0,0 +1,690 @@
+// AUDIO_002-5 (patch 40) final gate: the production SIF heap alias (PS2X_IOP_HEAP_ALIAS) and the guest-clocked libsd
+// BlockTrans (PS2X_SD_ADMA), exercised through the real stubs (sceSifAllocIopHeap/FreeIopHeap/SetDma, the IOP host
+// adapter, the SIF and AUDIO checkpoint codecs, sceSdRemote/sceSdRemoteInit).
+//
+// Both switches are read once per process, so these tests take their expectations from the environment the process
+// was started with; the whole suite is meant to be run four times (alias off/on x ADMA off/on). The oracle below is
+// written independently of the runtime: the alias is active for a well-formed window, and ADMA takes effect only
+// when the alias is active (PS2X_SD_ADMA=1 alone is ignored, see the runtime's [AUDIO:adma] notice).
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_iop_host.h"
+#include "ps2_stubs.h"
+#include "Kernel/Stubs/SIF.h"
+#include "runtime/ee_scheduler.h"
+#include "runtime/checkpoint/checkpoint.h"
+#include "runtime/checkpoint/checkpoint_probes.h"
+#include "audio/pss_audio.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace ps2_stubs
+{
+    void resetSifState();
+}
+
+namespace
+{
+    constexpr uint32_t kHeapBase = 0x04000000u; // canonical SIF heap (Support.h kIopHeapBase)
+    constexpr uint32_t kHeapLimit = 0x04500000u;
+    constexpr uint32_t kDescAddr = 0x00200000u; // EE user memory, outside any alias window
+    constexpr uint32_t kEeData = 0x00200100u;
+    constexpr uint32_t kEeBack = 0x00210000u;
+    constexpr uint32_t kStackAddr = 0x00300000u;
+
+    struct GateConfig
+    {
+        bool aliasActive = false;
+        uint32_t aliasBase = 0u;
+        uint32_t aliasLimit = 0u;
+        bool admaRequested = false;
+        bool admaExpected = false;
+    };
+
+    // Test-side oracle (not the runtime parser): "base:limit", both parsed completely, base != 0, 64-byte aligned,
+    // base < limit <= 16 MiB, window no larger than the heap.
+    const GateConfig &gateConfig()
+    {
+        static const GateConfig cfg = [] {
+            GateConfig c;
+            if (const char *v = std::getenv("PS2X_IOP_HEAP_ALIAS"))
+            {
+                char *end = nullptr;
+                const unsigned long long b = std::strtoull(v, &end, 0);
+                if (end && *end == ':')
+                {
+                    char *end2 = nullptr;
+                    const unsigned long long l = std::strtoull(end + 1, &end2, 0);
+                    if (end2 && *end2 == '\0' && b != 0u && b < l && l <= 0x01000000ull && b % 64u == 0u &&
+                        l % 64u == 0u && l - b <= kHeapLimit - kHeapBase)
+                    {
+                        c.aliasActive = true;
+                        c.aliasBase = static_cast<uint32_t>(b);
+                        c.aliasLimit = static_cast<uint32_t>(l);
+                    }
+                }
+            }
+            const char *a = std::getenv("PS2X_SD_ADMA");
+            c.admaRequested = a && std::string(a) == "1";
+            c.admaExpected = c.admaRequested && c.aliasActive;
+            std::fprintf(stderr, "[PssGate] alias=%d (0x%08X-0x%08X) adma_requested=%d adma_expected=%d\n",
+                         c.aliasActive ? 1 : 0, c.aliasBase, c.aliasLimit, c.admaRequested ? 1 : 0,
+                         c.admaExpected ? 1 : 0);
+            return c;
+        }();
+        return cfg;
+    }
+
+    std::string hx(uint64_t v)
+    {
+        char b[32];
+        std::snprintf(b, sizeof(b), "0x%llX", static_cast<unsigned long long>(v));
+        return b;
+    }
+
+    void setReg(R5900Context &ctx, int reg, uint32_t value)
+    {
+        ctx.r[reg] = _mm_set_epi64x(0, static_cast<int64_t>(value));
+    }
+
+    struct SifEnv
+    {
+        std::vector<uint8_t> rdram;
+        R5900Context ctx{};
+        PS2Runtime runtime;
+        SifEnv() : rdram(PS2_RAM_SIZE, 0u) { ps2_stubs::resetSifState(); }
+        ~SifEnv() { ps2_stubs::resetSifState(); }
+
+        uint32_t alloc(uint32_t size)
+        {
+            setReg(ctx, 4, size);
+            ps2_stubs::sceSifAllocIopHeap(rdram.data(), &ctx, &runtime);
+            return ::getRegU32(&ctx, 2);
+        }
+        bool release(uint32_t address)
+        {
+            setReg(ctx, 4, address);
+            ps2_stubs::sceSifFreeIopHeap(rdram.data(), &ctx, &runtime);
+            return static_cast<int32_t>(::getRegU32(&ctx, 2)) == 0;
+        }
+        // One-descriptor sceSifSetDma; returns the transfer id (0 = rejected).
+        int32_t dma(uint32_t src, uint32_t dst, uint32_t size)
+        {
+            const uint32_t desc[4] = {src, dst, size, 0u};
+            std::memcpy(rdram.data() + kDescAddr, desc, sizeof(desc));
+            setReg(ctx, 4, kDescAddr);
+            setReg(ctx, 5, 1u);
+            ps2_stubs::sceSifSetDma(rdram.data(), &ctx, &runtime);
+            return static_cast<int32_t>(::getRegU32(&ctx, 2));
+        }
+        std::vector<uint8_t> pattern(uint32_t at, uint32_t size, uint8_t seed)
+        {
+            std::vector<uint8_t> p(size);
+            for (uint32_t i = 0; i < size; ++i)
+                p[i] = static_cast<uint8_t>(seed + i * 7u);
+            std::memcpy(rdram.data() + at, p.data(), size);
+            return p;
+        }
+    };
+
+    uint32_t canonical(uint32_t address)
+    {
+        const GateConfig &c = gateConfig();
+        return (c.aliasActive && address >= c.aliasBase && address < c.aliasLimit) ? kHeapBase + (address - c.aliasBase)
+                                                                                    : address;
+    }
+
+    // Window where SIF heap addresses are expected to be handed out first.
+    std::pair<uint32_t, uint32_t> firstWindow()
+    {
+        const GateConfig &c = gateConfig();
+        return c.aliasActive ? std::make_pair(c.aliasBase, c.aliasLimit) : std::make_pair(kHeapBase, kHeapLimit);
+    }
+
+    bool contains(const std::vector<uint8_t> &blob, uint32_t a, uint32_t b)
+    {
+        uint8_t pat[8];
+        std::memcpy(pat, &a, 4);
+        std::memcpy(pat + 4, &b, 4);
+        return std::search(blob.begin(), blob.end(), pat, pat + 8) != blob.end();
+    }
+
+    // ---- libsd ----------------------------------------------------------------------------------------------------
+
+    constexpr uint32_t kSdBase = 0x00020000u; // 24-bit IOP address as the guest passes it
+    constexpr uint32_t kSdArea = 0x6000u;     // SLES_503.58 audiodec: 24 blocks of 1024 bytes
+    constexpr uint32_t kSdLoop = 0x10u;
+    constexpr uint32_t kSdStop = 0x02u;
+    constexpr uint32_t kBank = 1u << 24;
+
+    // Independent model of the guest-visible ADMA clock: one 1024-byte block per 256 frames at 48 kHz, 50 fields/s
+    // (the test process runs with the default PS2X_AUDIO_FIELD_HZ), block granularity, loop wraps, bank = upper half.
+    uint32_t modelStatus(uint32_t base, uint32_t area, uint32_t startOffset, uint64_t fields, bool loop)
+    {
+        const uint64_t blocks = fields * 960u / 256u;
+        uint64_t off = (startOffset & ~0x3FFu) + blocks * 0x400u;
+        off = loop ? off % area : std::min<uint64_t>(off, area);
+        const uint32_t bank = (loop && off >= area / 2u) ? kBank : 0u;
+        return bank | ((base + static_cast<uint32_t>(off)) & 0x00FFFFFFu);
+    }
+
+    struct SdEnv
+    {
+        std::vector<uint8_t> rdram;
+        PS2Runtime runtime;
+        R5900Context initCtx{};
+        SdEnv() : rdram(PS2_RAM_SIZE, 0u)
+        {
+            R5900Context mainContext{};
+            runtime.eeScheduler().reset(rdram.data(), mainContext);
+            ps2_stubs::sceSdRemoteInit(rdram.data(), &initCtx, &runtime);
+        }
+        ~SdEnv() { ps2_stubs::sceSdRemoteInit(rdram.data(), &initCtx, &runtime); } // drop sources while the host lives
+
+        // Sets the scheduler VSync tick through its own checkpoint codec (no test hook in the runtime).
+        bool setTick(uint64_t tick)
+        {
+            constexpr uint32_t kFlagMark = 0x001F7F00u;
+            constexpr uint32_t kTickMark = 0x001F7F40u;
+            EeScheduler &s = runtime.eeScheduler();
+            s.setVSyncFlag(kFlagMark, kTickMark);
+            ps2x::checkpoint::ByteWriter w;
+            std::string error;
+            if (!s.serializeCheckpointState(w, error))
+            {
+                std::fprintf(stderr, "[PssGate] SCHED serialize failed: %s\n", error.c_str());
+                return false;
+            }
+            std::vector<uint8_t> b = w.take();
+            uint8_t pat[8];
+            std::memcpy(pat, &kFlagMark, 4);
+            std::memcpy(pat + 4, &kTickMark, 4);
+            const auto it = std::search(b.begin(), b.end(), pat, pat + 8);
+            if (it == b.end() || it - b.begin() < 8)
+                return false;
+            std::memcpy(&*(it - 8), &tick, 8);
+            ps2x::checkpoint::ByteReader r(b.data(), b.size());
+            if (!s.deserializeCheckpointState(r, error))
+            {
+                std::fprintf(stderr, "[PssGate] SCHED deserialize failed: %s\n", error.c_str());
+                return false;
+            }
+            return s.currentVSyncTick() == tick;
+        }
+
+        uint32_t remote(uint32_t cmd, uint32_t core, uint32_t mode, uint32_t a4 = 0u, uint32_t a5 = 0u, uint32_t a6 = 0u)
+        {
+            R5900Context ctx{};
+            setReg(ctx, 29, kStackAddr);
+            setReg(ctx, 4, 1u);
+            setReg(ctx, 5, cmd);
+            setReg(ctx, 6, core);
+            setReg(ctx, 7, mode);
+            setReg(ctx, 8, a4);
+            setReg(ctx, 9, a5);
+            setReg(ctx, 10, a6);
+            ps2_stubs::sceSdRemote(rdram.data(), &ctx, &runtime);
+            return ::getRegU32(&ctx, 2);
+        }
+        uint32_t start(uint32_t core, uint32_t mode, uint32_t base, uint32_t size, uint32_t pause = 0u)
+        {
+            return remote(0x80E0u, core, mode, base, size, pause);
+        }
+        uint32_t stop(uint32_t core) { return remote(0x80E0u, core, kSdStop); }
+        uint32_t status(uint32_t core) { return remote(0x8100u, core, 0u); }
+    };
+
+    // Observed mode: the guest-clocked position does not move between two polls in the same field; the legacy stub
+    // advances 1024 bytes per poll.
+    bool admaObserved()
+    {
+        SdEnv e;
+        e.setTick(10u);
+        e.start(1u, kSdLoop, kSdBase, kSdArea);
+        const uint32_t a = e.status(1u);
+        const uint32_t b = e.status(1u);
+        e.stop(1u);
+        return a == b;
+    }
+}
+
+void register_pss_sif_libsd_tests()
+{
+    MiniTest::Case("PssGateSif", [](TestCase &tc) {
+        tc.Run("configuration: the alias is active exactly for a well-formed PS2X_IOP_HEAP_ALIAS", [](TestCase &t) {
+            const GateConfig &c = gateConfig();
+            SifEnv e;
+            const uint32_t a = e.alloc(0x40u);
+            if (c.aliasActive)
+            {
+                t.Equals(a, c.aliasBase, "the first block is handed out at the alias base");
+                t.IsTrue(ps2_stubs::isSifIopHeapAddress(c.aliasBase), "the alias base is classified as IOP heap");
+                t.IsFalse(ps2_stubs::isSifIopHeapAddress(c.aliasLimit), "the alias limit is exclusive");
+            }
+            else
+            {
+                t.Equals(a, kHeapBase, "without alias the first block is the canonical heap base");
+                t.IsTrue(a >= PS2_RAM_SIZE, "upstream invariant: IOP heap addresses lie outside EE RDRAM");
+                t.IsFalse(ps2_stubs::isSifIopHeapAddress(0x00020000u), "EE kernel addresses are not IOP heap");
+            }
+        });
+
+        tc.Run("allocations are 64-byte aligned, disjoint, ascending and inside the expected window", [](TestCase &t) {
+            SifEnv e;
+            const auto [lo, hi] = firstWindow();
+            const uint32_t sizes[] = {0x6000u, 0x880u, 0x100u, 0x41u, 0x40u, 0x800u};
+            std::vector<std::pair<uint32_t, uint32_t>> blocks;
+            for (uint32_t s : sizes)
+            {
+                const uint32_t a = e.alloc(s);
+                const uint32_t aligned = (s + 63u) & ~63u;
+                t.IsTrue(a != 0u, "allocation of " + hx(s) + " succeeds");
+                t.Equals(a % 64u, 0u, "address " + hx(a) + " is 64-byte aligned");
+                t.IsTrue(a >= lo && a + aligned <= hi, "block " + hx(a) + "+" + hx(aligned) + " lies in the window");
+                if (gateConfig().aliasActive)
+                    t.IsTrue(a + aligned <= 0x01000000u, "aliased blocks are 24-bit addresses");
+                for (const auto &[b, bs] : blocks)
+                    t.IsTrue(a >= b + bs || a + aligned <= b, "block " + hx(a) + " does not overlap " + hx(b));
+                if (!blocks.empty())
+                    t.IsTrue(a > blocks.back().first, "first-fit hands out ascending addresses on a fresh heap");
+                blocks.emplace_back(a, aligned);
+            }
+        });
+
+        tc.Run("free and reuse through the address the guest holds", [](TestCase &t) {
+            SifEnv e;
+            const uint32_t a = e.alloc(0x1000u), b = e.alloc(0x1000u), c = e.alloc(0x1000u);
+            t.IsTrue(e.release(b), "freeing the middle block succeeds");
+            t.IsFalse(e.release(b), "a second free of the same block fails");
+            t.Equals(e.alloc(0x1000u), b, "the hole is reused at the same guest address");
+            t.IsTrue(e.release(a) && e.release(b) && e.release(c), "all blocks free");
+            t.Equals(e.alloc(0x40u), firstWindow().first, "an empty heap starts again at the window base");
+            if (gateConfig().aliasActive)
+                t.IsFalse(e.release(gateConfig().aliasBase + 0x20000u), "freeing an unallocated alias address fails");
+        });
+
+        tc.Run("EE->IOP DMA through the guest address; alias and canonical name the same IOP bytes", [](TestCase &t) {
+            SifEnv e;
+            const uint32_t x = e.alloc(0x6000u);
+            const auto payload = e.pattern(kEeData, 0x400u, 0x31u);
+            t.IsTrue(e.dma(kEeData, x + 0x800u, 0x400u) > 0, "EE->IOP DMA into the block is accepted");
+            std::vector<uint8_t> back(0x400u);
+            t.IsTrue(ps2_stubs::readSifIopHeap(x + 0x800u, back.data(), back.size()) && back == payload,
+                     "the IOP heap read through the guest address returns the payload");
+            std::fill(back.begin(), back.end(), 0u);
+            t.IsTrue(ps2_stubs::readSifIopHeap(canonical(x) + 0x800u, back.data(), back.size()) && back == payload,
+                     "the canonical address " + hx(canonical(x)) + " names the same bytes");
+            t.IsTrue(e.dma(x + 0x800u, kEeBack, 0x400u) > 0, "IOP->EE DMA from the block is accepted");
+            t.IsTrue(std::memcmp(e.rdram.data() + kEeBack, payload.data(), payload.size()) == 0,
+                     "the payload round-trips to EE RDRAM");
+
+            PS2IopHostAdapter host(e.runtime);
+            auto scope = host.enterCall(&e.ctx, e.rdram.data());
+            uint32_t normalized = 0u;
+            t.IsTrue(host.normalizeGuestAddress(x, normalized) && normalized == x,
+                     "IOP modules keep the guest's heap address");
+            std::fill(back.begin(), back.end(), 0u);
+            t.IsTrue(host.readGuest(x + 0x800u, back.data(), back.size()) && back == payload,
+                     "IOP modules read the heap backing through the guest address");
+        });
+
+        tc.Run("no SIF/IOP-host path writes EE RDRAM in the alias window", [](TestCase &t) {
+            SifEnv e;
+            constexpr uint32_t kWinLo = 0x00020000u, kWinHi = 0x00080000u; // the SLES_503.58 window
+            std::memset(e.rdram.data() + kWinLo, 0xA5, kWinHi - kWinLo);
+            const uint32_t x = e.alloc(0x6000u);
+            const uint32_t y = e.alloc(0x880u);
+            e.pattern(kEeData, 0x800u, 0x11u);
+            e.dma(kEeData, x, 0x800u);
+            e.dma(kEeData, y + 0x80u, 0x400u);
+            e.dma(x, kEeBack, 0x800u);
+            {
+                PS2IopHostAdapter host(e.runtime);
+                auto scope = host.enterCall(&e.ctx, e.rdram.data());
+                const uint8_t junk[64] = {1, 2, 3};
+                host.writeGuest(y, junk, sizeof(junk));
+                host.zeroGuest(x + 0x1000u, 0x400u);
+            }
+            ps2_stubs::zeroSifIopHeap(x, 0x6000u);
+            e.release(x);
+            e.release(y);
+            const bool untouched = std::all_of(e.rdram.begin() + kWinLo, e.rdram.begin() + kWinHi,
+                                               [](uint8_t b) { return b == 0xA5u; });
+            t.IsTrue(untouched, "EE RDRAM 0x00020000-0x0007FFFF keeps its sentinel");
+        });
+
+        tc.Run("out-of-bounds ranges are rejected without partial writes", [](TestCase &t) {
+            SifEnv e;
+            const GateConfig &c = gateConfig();
+            const uint32_t x = e.alloc(0x100u);
+            e.pattern(kEeData, 0x200u, 0x55u);
+            t.Equals(e.dma(kEeData, x + 0xC0u, 0x80u), 0, "a transfer that runs past the block is rejected");
+            std::vector<uint8_t> back(0x100u, 0xEEu);
+            t.IsTrue(ps2_stubs::readSifIopHeap(x, back.data(), back.size()) &&
+                         std::all_of(back.begin(), back.end(), [](uint8_t b) { return b == 0u; }),
+                     "the rejected transfer wrote nothing");
+            if (c.aliasActive)
+            {
+                const uint32_t hole = c.aliasBase + 0x20000u;
+                std::memset(e.rdram.data() + hole, 0x3C, 0x40u);
+                t.Equals(e.dma(kEeData, hole, 0x40u), 0, "a transfer to an unallocated alias address is rejected");
+                t.IsTrue(e.rdram[hole] == 0x3Cu && e.rdram[hole + 0x3Fu] == 0x3Cu,
+                         "the EE bytes at that address are untouched");
+                // Fill the alias exactly, then place a canonical block right after it in storage.
+                SifEnv f;
+                const uint32_t span = c.aliasLimit - c.aliasBase;
+                const uint32_t big = f.alloc(span - 0x100u);
+                const uint32_t last = f.alloc(0x100u);
+                const uint32_t after = f.alloc(0x100u);
+                t.Equals(big, c.aliasBase, "the big block starts at the alias base");
+                t.Equals(last, c.aliasLimit - 0x100u, "the last aliased block ends at the alias limit");
+                t.Equals(after, kHeapBase + span, "the next block is canonical, contiguous in storage");
+                f.pattern(kEeData, 0x100u, 0x66u);
+                t.Equals(f.dma(kEeData, c.aliasLimit - 0x80u, 0x100u), 0,
+                         "a range that starts in the alias and crosses its limit is rejected");
+                t.IsTrue(f.dma(kEeData, after, 0x100u) > 0, "the canonical block after the alias is usable");
+            }
+        });
+
+        tc.Run("exhausting the alias falls back to canonical addresses that still work", [](TestCase &t) {
+            SifEnv e;
+            const GateConfig &c = gateConfig();
+            e.pattern(kEeData, 0x1800u, 0x77u);
+            std::vector<uint32_t> blocks;
+            if (c.aliasActive)
+            {
+                const uint32_t span = c.aliasLimit - c.aliasBase;
+                const uint32_t n = span / 0x1000u;
+                for (uint32_t i = 0; i + 1u < n; ++i)
+                    blocks.push_back(e.alloc(0x1000u));
+                t.IsTrue(std::all_of(blocks.begin(), blocks.end(),
+                                     [&](uint32_t a) { return a >= c.aliasBase && a + 0x1000u <= c.aliasLimit; }),
+                         hx(n - 1u) + " blocks of 4 KiB are aliased");
+                const uint32_t straddle = e.alloc(0x1800u);
+                t.Equals(straddle, kHeapBase + (n - 1u) * 0x1000u,
+                         "a block that would cross the alias limit is handed out canonical");
+                t.IsTrue(e.dma(kEeData, straddle, 0x1800u) > 0, "and accepts DMA over its whole size");
+                t.IsTrue(e.release(straddle), "free it");
+                const uint32_t last = e.alloc(0x1000u);
+                t.Equals(last, c.aliasLimit - 0x1000u, "the last 4 KiB of the alias are still handed out aliased");
+                const uint32_t next = e.alloc(0x1000u);
+                t.Equals(next, kHeapBase + span, "with the alias full the next block is canonical (outside EE RDRAM)");
+                t.IsTrue(next >= PS2_RAM_SIZE, "fallback address " + hx(next));
+                t.IsTrue(e.dma(kEeData, next, 0x1000u) > 0, "the fallback block accepts DMA");
+            }
+            else
+            {
+                for (uint32_t i = 0; i < 8u; ++i)
+                    blocks.push_back(e.alloc(0x1000u));
+                t.IsTrue(std::all_of(blocks.begin(), blocks.end(), [](uint32_t a) { return a >= kHeapBase; }),
+                         "without alias every block is canonical");
+            }
+            const uint32_t mid = blocks[blocks.size() / 2u];
+            t.IsTrue(e.release(mid), "freeing a block in the middle");
+            t.Equals(e.alloc(0x1000u), mid, "the freed slot is reused at the same guest address");
+            t.Equals(e.alloc(kHeapLimit - kHeapBase), 0u, "an allocation larger than the free heap fails (returns 0)");
+        });
+
+        tc.Run("disabled alias keeps EE addresses in EE RDRAM; enabled alias owns its window", [](TestCase &t) {
+            SifEnv e;
+            const GateConfig &c = gateConfig();
+            // An EE address inside the configured window (the SLES_503.58 one when the alias is off).
+            const uint32_t kLow = (c.aliasActive ? c.aliasBase : 0x00020000u) + 0x10100u, kLow2 = kLow + 0x100u;
+            e.pattern(kLow, 0x40u, 0x21u);
+            std::memset(e.rdram.data() + kLow2, 0, 0x40u);
+            const int32_t id = e.dma(kLow, kLow2, 0x40u);
+            if (!c.aliasActive)
+            {
+                t.IsTrue(id > 0 && std::memcmp(e.rdram.data() + kLow, e.rdram.data() + kLow2, 0x40u) == 0,
+                         "an EE->EE copy at " + hx(kLow) + " works as before");
+            }
+            else
+            {
+                t.Equals(id, 0, "inside the alias window an unallocated EE address is not reachable through SIF");
+                t.IsTrue(e.rdram[kLow2] == 0u, "and nothing is written there");
+            }
+        });
+
+        tc.Run("SIF checkpoint keeps canonical keys and restores the bytes behind the guest address", [](TestCase &t) {
+            SifEnv e;
+            const uint32_t x = e.alloc(0x6000u);
+            const auto payload = e.pattern(kEeData, 0x200u, 0x42u);
+            e.dma(kEeData, x + 0x400u, 0x200u);
+            ps2x::checkpoint::ByteWriter w;
+            ps2_stubs::checkpointSerializeSif(w);
+            const std::vector<uint8_t> blob = w.take();
+            t.IsTrue(contains(blob, kHeapBase, 0x6000u), "the allocation map is serialized with the canonical key");
+            if (gateConfig().aliasActive)
+                t.IsFalse(contains(blob, x, 0x6000u), "the alias address is not part of the codec");
+            ps2_stubs::resetSifState();
+            std::vector<uint8_t> back(0x200u);
+            t.IsFalse(ps2_stubs::readSifIopHeap(x + 0x400u, back.data(), back.size()), "reset drops the block");
+            ps2x::checkpoint::ByteReader r(blob.data(), blob.size());
+            std::string error;
+            t.IsTrue(ps2_stubs::checkpointDeserializeSif(r, error), "deserialize: " + error);
+            t.IsTrue(ps2_stubs::readSifIopHeap(x + 0x400u, back.data(), back.size()) && back == payload,
+                     "after the load the guest address reads the saved bytes");
+            t.IsTrue(e.release(x), "and the guest can free it with the address it holds");
+        });
+    });
+
+    MiniTest::Case("PssGateLibSd", [](TestCase &tc) {
+        tc.Run("configuration: PS2X_SD_ADMA takes effect only together with a valid alias", [](TestCase &t) {
+            const GateConfig &c = gateConfig();
+            {
+                SdEnv e;
+                t.IsTrue(e.setTick(5u), "the test can place the scheduler at a given VSync tick");
+            }
+            t.Equals(admaObserved(), c.admaExpected,
+                     std::string("guest-clocked BlockTrans ") + (c.admaExpected ? "on" : "off") +
+                         " (requested=" + (c.admaRequested ? "1" : "0") + ", alias=" + (c.aliasActive ? "1" : "0") +
+                         ")");
+        });
+
+        tc.Run("start, position from the guest clock, idempotent polls, loop wrap and bank bit", [](TestCase &t) {
+            SdEnv e;
+            e.setTick(100u);
+            t.Equals(e.start(1u, kSdLoop, kSdBase, kSdArea), 0u, "BlockTrans start returns 0");
+            if (!gateConfig().admaExpected)
+            {
+                const uint32_t a = e.status(1u);
+                e.setTick(150u);
+                t.Equals(e.status(1u), a + 0x400u, "legacy stub: +1024 bytes per poll, independent of the clock");
+                return;
+            }
+            t.Equals(e.status(1u), kSdBase, "at the start tick the position is the area base");
+            t.Equals(e.status(1u), kSdBase, "a second poll in the same field does not move it");
+            bool ok = true;
+            uint64_t firstBad = 0;
+            for (uint64_t f = 0; f <= 400u; ++f)
+            {
+                e.setTick(100u + f);
+                const uint32_t s = e.status(1u);
+                if (s != modelStatus(kSdBase, kSdArea, 0u, f, true) && ok)
+                {
+                    ok = false;
+                    firstBad = f;
+                }
+            }
+            t.IsTrue(ok, "400 fields follow the model (first mismatch at field " + hx(firstBad) + ")");
+            e.setTick(101u);
+            t.Equals(e.status(1u), kSdBase + 0xC00u, "field 1: 960 frames -> 3 whole blocks");
+            e.setTick(104u);
+            t.Equals(e.status(1u), kBank | (kSdBase + 0x3C00u), "field 4: block 15 is in the upper half (bank 1)");
+            e.setTick(107u);
+            t.Equals(e.status(1u), kSdBase + 0x800u, "field 7: 26 blocks wrap to block 2 (bank 0)");
+        });
+
+        tc.Run("non-loop transfer stops at the end of its area", [](TestCase &t) {
+            SdEnv e;
+            if (!gateConfig().admaExpected)
+                return t.IsTrue(true, "ADMA off: covered by the upstream sceSdRemote tests");
+            e.setTick(100u);
+            e.start(1u, 0x00u, kSdBase, kSdArea);
+            e.setTick(105u);
+            t.Equals(e.status(1u), kSdBase + 0x4800u, "field 5: block 18, no bank bit without loop");
+            e.setTick(107u);
+            t.Equals(e.status(1u), kSdBase + kSdArea, "past the end the position stays at the area end");
+            e.setTick(300u);
+            t.Equals(e.status(1u), kSdBase + kSdArea, "and does not wrap");
+        });
+
+        tc.Run("pause (STOP) returns the live position; resume continues from the paused block", [](TestCase &t) {
+            SdEnv e;
+            if (!gateConfig().admaExpected)
+                return t.IsTrue(true, "ADMA off: covered by the upstream sceSdRemote tests");
+            e.setTick(100u);
+            e.start(1u, 0x13u, kSdBase, kSdArea);
+            e.setTick(103u);
+            const uint32_t paused = e.stop(1u);
+            t.Equals(paused, kSdBase + 0x2C00u, "STOP at field 3 returns block 11 (2880 frames)");
+            t.Equals(e.status(1u), 0u, "a stopped core reports no live position");
+            e.setTick(110u);
+            t.Equals(e.status(1u), 0u, "and does not advance while paused");
+            t.Equals(e.start(1u, 0x13u, kSdBase, kSdArea, kSdBase + 0x2C00u), 0u, "resume at the paused address");
+            t.Equals(e.status(1u), kSdBase + 0x2C00u, "the resumed position is the paused block");
+            e.setTick(111u);
+            t.Equals(e.status(1u), kBank | (kSdBase + 0x3800u), "one field later: +3 blocks, upper half");
+            e.setTick(112u);
+            e.stop(1u);
+            t.Equals(e.start(1u, 0x13u, kSdBase, kSdArea, kSdBase + 0x2C10u), 0u, "resume at a non-aligned address");
+            t.Equals(e.status(1u), kSdBase + 0x2C00u, "the position is reported at block granularity");
+        });
+
+        tc.Run("a second BlockTrans replaces the first and restarts the clock", [](TestCase &t) {
+            SdEnv e;
+            if (!gateConfig().admaExpected)
+                return t.IsTrue(true, "ADMA off: covered by the upstream sceSdRemote tests");
+            constexpr uint32_t kBase2 = 0x00030000u, kArea2 = 0x3000u;
