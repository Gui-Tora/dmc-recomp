+            e.setTick(104u);
+            t.Equals(e.status(1u), kBase2 + 0xC00u, "its clock starts at the replacing call");
+            e.setTick(107u);
+            t.Equals(e.status(1u), kBase2 + 0xC00u, "and wraps its own area (15 blocks mod 12, lower half)");
