diff --git a/ps2xTest/src/audio_xag_checkpoint_tests.cpp b/ps2xTest/src/audio_xag_checkpoint_tests.cpp
new file mode 100644
index 0000000..85280dd
--- /dev/null
+++ b/ps2xTest/src/audio_xag_checkpoint_tests.cpp
@@ -0,0 +1,195 @@
+// AUDIO_002-4 (patch 39): what a TSNDDRVM checkpoint v3 relaunch relies on -- a deterministic replay of the XAG
+// decoder/resampler to a position (same state hash, same continuation) and a gain renderer that resumes exactly
+// from its saved XagVolumeState (mid-ramp, mid-fade, mid-fade-out).
+#include "MiniTest.h"
+#include "ps2x/iop/audio_dsp.h"
+
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+using namespace ps2x::iop::audio;
+
+namespace
+{
+    // A synthetic XAG clip: 2 channels, blocks of 0x400 bytes per channel, 40 chunks of pseudo-random ADPCM.
+    struct FakeClip
+    {
+        std::vector<uint8_t> bytes;
+        XagClipLayout layout{};
+        FakeClip()
+        {
+            layout.base = 0u;
+            layout.blockBytes = 0x400u;
+            layout.channels = 2u;
+            layout.sampleRate = 44098u;
+            layout.bytes = 40u * 2u * layout.blockBytes;
+            bytes.resize(static_cast<size_t>(layout.bytes));
+            uint32_t x = 12345u;
+            for (size_t i = 0; i < bytes.size(); ++i)
+            {
+                x = x * 1103515245u + 12345u;
+                bytes[i] = static_cast<uint8_t>(x >> 16);
+                if (i % 16u == 0u)
+                    bytes[i] = static_cast<uint8_t>((bytes[i] & 0x0Fu) % 13u | ((bytes[i] >> 4) % 5u) << 4);
+            }
+        }
+        bool readAt(uint64_t offset, void *out, size_t size, size_t &got) const
+        {
+            if (offset >= bytes.size())
+            {
+                got = 0;
+                return true;
+            }
+            got = std::min<size_t>(size, bytes.size() - static_cast<size_t>(offset));
+            std::memcpy(out, bytes.data() + offset, got);
+            return true;
+        }
+    };
+
+    struct Stream
+    {
+        XagClipReader reader;
+        CubicResampler resampler;
+        const FakeClip &clip;
+        explicit Stream(const FakeClip &c)
+            : reader(c.layout), resampler(c.layout.sampleRate, kMixRate, c.layout.channels), clip(c)
+        {
+        }
+        size_t produce(int16_t *out, size_t frames)
+        {
+            return resampler.produce(out, frames, [this](int16_t *dst, size_t n) {
+                return reader.read(dst, n, [this](uint64_t o, void *b, size_t s, size_t &g) {
+                    return clip.readAt(o, b, s, g);
+                });
+            });
+        }
+        uint64_t hash() const { return reader.stateHash(resampler.stateHash()); }
+    };
+
+    std::vector<int16_t> sineLaw()
+    {
+        std::vector<int16_t> law(kXagPanLawSize);
+        for (size_t p = 0; p < law.size(); ++p)
+            law[p] = static_cast<int16_t>(std::lround(4096.0 * std::sin(static_cast<double>(p) * 3.14159265358979323846 / 256.0)));
+        return law;
+    }
+}
+
+void register_audio_xag_checkpoint_tests()
+{
+    MiniTest::Case("XagCheckpoint", [](TestCase &tc) {
+        tc.Run("replay to a position gives the same state hash and continuation as continuous rendering", [](TestCase &t) {
+            const FakeClip clip;
+            const uint64_t positions[] = {1u, 960u, 960u * 37u + 17u, 960u * 80u};
+            for (uint64_t position : positions)
+            {
+                Stream live(clip);
+                std::vector<int16_t> buf(2u * 960u);
+                uint64_t done = 0;
+                while (done < position)
+                {
+                    const size_t n = static_cast<size_t>(std::min<uint64_t>(960u, position - done));
+                    done += live.produce(buf.data(), n);
+                }
+                Stream replay(clip);
+                std::vector<int16_t> scratch(2u * 4096u);
+                uint64_t skipped = 0;
+                while (skipped < position)
+                {
+                    const size_t n = static_cast<size_t>(std::min<uint64_t>(4096u, position - skipped));
+                    skipped += replay.produce(scratch.data(), n);
+                }
+                t.IsTrue(live.hash() == replay.hash(), "same decoder/resampler state hash");
+                std::vector<int16_t> a(2u * 3000u), b(2u * 3000u);
+                live.produce(a.data(), 3000u);
+                replay.produce(b.data(), 3000u);
+                t.IsTrue(a == b, "same continuation");
+            }
+            Stream other(clip);
+            std::vector<int16_t> buf(2u * 961u);
+            other.produce(buf.data(), 961u);
+            Stream ref(clip);
+            ref.produce(buf.data(), 960u);
+            t.IsTrue(other.hash() != ref.hash(), "the hash distinguishes neighbouring positions");
+        });
+        tc.Run("a renderer rebuilt from its saved state continues bit-exactly (mid-ramp, mid-fade, fade-out)", [](TestCase &t) {
+            const std::vector<int16_t> law = sineLaw();
+            XagVoiceParams p{};
+            p.panLaw = law.data();
+            XagVolumeState s{};
+            s.vol = 0x4000;
+            s.masterVol = 0x3FFF;
+            xagPrepare(s, p);
+            const std::vector<XagVolumeCommand> cmds = {
+                {XagVolumeCommand::Op::SetVol, 0x1000, 0u, false, 960u * 2u},
+                {XagVolumeCommand::Op::SetFade, 0x3800, 40u, false, 960u * 10u},
+                {XagVolumeCommand::Op::Fadeout, 0, 90u, false, 960u * 30u},
+            };
+            // Save points: inside the SetVol ramp, inside the fade, inside the fade-out.
+            const uint64_t saves[] = {960u * 2u + 960u, 960u * 12u, 960u * 40u};
+            const size_t total = 960u * 80u;
+            auto run = [&](XagGainRenderer &g, size_t from, size_t to, std::vector<int16_t> &out) {
+                size_t next = 0;
+                while (next < cmds.size() && cmds[next].position < from)
+                    ++next;
+                std::vector<int16_t> buf(2u * 960u);
+                for (size_t pos = from; pos < to && !g.stopped();)
+                {
+                    const size_t n = std::min<size_t>(960u, to - pos);
+                    for (size_t i = 0; i < n; ++i)
+                    {
+                        buf[i * 2u] = static_cast<int16_t>(((pos + i) * 7919u) & 0x7FFFu);
+                        buf[i * 2u + 1u] = static_cast<int16_t>(-static_cast<int32_t>(((pos + i) * 104729u) & 0x7FFFu));
+                    }
+                    const size_t got = g.process(buf.data(), n, [&](uint64_t k, XagVolumeCommand &c) {
+                        if (next == cmds.size() || cmds[next].position > k)
+                            return false;
+                        c = cmds[next++];
+                        return true;
+                    });
+                    out.insert(out.end(), buf.begin(), buf.begin() + static_cast<std::ptrdiff_t>(got * 2u));
+                    pos += got;
+                    if (got < n)
+                        break;
+                }
+            };
+            std::vector<int16_t> continuous;
+            XagGainRenderer whole(p, s, 0u);
+            run(whole, 0u, total, continuous);
+            for (uint64_t save : saves)
+            {
+                XagGainRenderer first(p, s, 0u);
+                std::vector<int16_t> head;
+                run(first, 0u, static_cast<size_t>(save), head);
+                // The service serialises XagVolumeState (ramp included); the relaunch rebuilds the renderer from it.
+                XagGainRenderer resumed(p, first.state(), save);
+                std::vector<int16_t> tail;
+                run(resumed, static_cast<size_t>(save), total, tail);
+                head.insert(head.end(), tail.begin(), tail.end());
+                t.IsTrue(head == continuous, "resumed output equals continuous output");
+            }
+            // Inside the final 200-frame ramp after the fade-out's stopping atick (payload v4 "final ramp").
+            XagGainRenderer probe(p, s, 0u);
+            std::vector<int16_t> probeOut;
+            run(probe, 0u, total, probeOut);
+            const uint64_t stopAtick = probe.state().rampStart; // last change = the stopping atick (regs -> 0)
+            t.IsTrue(probe.stopped() && probe.position() == stopAtick + kXagATickFrames, "fade-out ends 200 frames after its atick");
+            for (uint64_t into : {1u, 100u, 199u})
+            {
+                const uint64_t save = stopAtick + into;
+                XagGainRenderer first(p, s, 0u);
+                std::vector<int16_t> head;
+                run(first, 0u, static_cast<size_t>(save), head);
+                XagVolumeState tailState = first.state();
+                XagGainRenderer resumed(p, tailState, save);
+                resumed.resumeStopping(tailState.rampStart + kXagATickFrames);
+                std::vector<int16_t> tail;
+                run(resumed, static_cast<size_t>(save), total, tail);
+                head.insert(head.end(), tail.begin(), tail.end());
+                t.IsTrue(head == continuous, "resumed inside the final ramp equals continuous output");
+                t.IsTrue(resumed.stopped(), "resumed ramp ends");
+            }
+        });
+    });
+}
