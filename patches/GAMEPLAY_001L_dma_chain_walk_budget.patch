+        tc.Run("DMA source chain longer than 4096 tags is walked to its END", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            constexpr uint32_t kGifCh = 0x1000A000u;
+            constexpr uint32_t kBase = 0x00100000u;
+            constexpr uint32_t kTags = 10000u; // DMC office chains measure 9,248-16,620 tags per frame
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < kTags; ++i)
+            {
+                const uint32_t at = kBase + i * 32u;
+                writeDmaTag(rdram, at, makeDmaTag(1u, 1u, 0u, false)); // CNT qwc=1
+                std::memset(rdram + at + 16u, static_cast<int>(i & 0xFFu), 16u);
+            }
+            writeDmaTag(rdram, kBase + kTags * 32u, makeDmaTag(0u, 7u, 0u, false)); // END
+            size_t bytes = 0;
+            bool lastPayloadOk = false;
+            mem.setGifPacketCallback([&](const uint8_t *data, uint32_t sizeBytes)
+            {
+                bytes += sizeBytes;
