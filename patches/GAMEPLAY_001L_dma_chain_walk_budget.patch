+    // Source-chain walk limits. A chain that reaches the same tag with the same CALL stack (ASP, ASR0, ASR1)
+    // loops forever, so cycles are detected exactly; the tag budget only bounds pathological acyclic chains.
+    // Measured: Devil May Cry's office scene sends VIF1 chains of 9,248-16,620 tags per frame; the budget is
+    // 16x that maximum, rounded up to a power of two.
+    constexpr uint32_t kDmaChainTagBudget = 1u << 18;
+
+    struct DmaChainState
+    {
+        uint32_t tadr;
+        uint32_t asp;
+        uint32_t asr0;
+        uint32_t asr1;
+        bool operator==(const DmaChainState &o) const
+        {
+            return tadr == o.tadr && asp == o.asp && asr0 == o.asr0 && asr1 == o.asr1;
+        }
+    };
+
+    struct DmaChainStateHash
+    {
+        size_t operator()(const DmaChainState &s) const noexcept
+        {
+            uint64_t h = (static_cast<uint64_t>(s.tadr) << 2) | s.asp;
+            h ^= static_cast<uint64_t>(s.asr0) * 0x9E3779B97F4A7C15ull;
+            h ^= static_cast<uint64_t>(s.asr1) * 0xC2B2AE3D27D4EB4Full;
+            return static_cast<size_t>(h ^ (h >> 29));
+        }
+    };
+
