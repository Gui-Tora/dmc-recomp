+#ifndef PS2_IPU_H
+#define PS2_IPU_H
+
+// IPU (MPEG-2 image processing unit) and the DMAC channels around it: D3 fromIPU, D4 toIPU and D8 fromSPR.
+// Private runtime header: not included by generated code. The module has no dependency on PS2Memory; the
+// memory side plugs in through ps2_ipu::Host so the decoder and the device can be tested standalone.
+//
+// Implemented: input/output FIFOs, BCLR, IDEC (RGB32 output), FDEC, SETIQ, SETVQ, SETTH, IPU_CTRL.RST,
+// D4 normal/source-chain transfers, D3 normal transfers and D8 normal/interleave transfers.
+// Everything else (VDEC, BDEC, CSC, PACK, IDEC modes other than the ones listed in IdecConfig::unsupported)
+// is reported through Host::error and left undone; no placeholder output is produced.
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ps2_ipu
+{
+    constexpr uint32_t kIpuCmd = 0x10002000u;
+    constexpr uint32_t kIpuCtrl = 0x10002010u;
+    constexpr uint32_t kIpuBp = 0x10002020u;
+    constexpr uint32_t kIpuTop = 0x10002030u;
+    constexpr uint32_t kIpuOutFifo = 0x10007000u;
+    constexpr uint32_t kIpuInFifo = 0x10007010u;
+
+    constexpr uint32_t kDmaFromIpu = 0x1000B000u; // D3
+    constexpr uint32_t kDmaToIpu = 0x1000B400u;   // D4
+    constexpr uint32_t kDmaFromSpr = 0x1000D000u; // D8
+    constexpr uint32_t kDmaSqwc = 0x1000E030u;
+
+    // IDEC parameters: IPU_CMD IDEC fields, IPU_CTRL fields and the SETTH thresholds.
+    struct IdecConfig
+    {
+        uint32_t fb = 0;  // bits skipped before the first macroblock
+        uint32_t qsc = 0; // initial quantiser_scale_code
+        bool dtd = false;
+        bool sgn = false;
+        bool dte = false;
+        bool ofm = false; // 0: RGB32, 1: RGB16
+        uint32_t idp = 0; // intra DC precision (8 + idp bits)
+        bool as = false;  // alternate scan
+        bool ivf = false; // intra VLC format (table B.15)
+        bool qst = false; // non-linear quantiser scale
+        bool mp1 = false; // MPEG-1 bitstream
+        uint32_t th0 = 0;
+        uint32_t th1 = 0;
+
+        // Returns an empty string when the decoder supports this configuration, otherwise the reason.
+        std::string unsupported() const;
+    };
+
+    enum class IdecStatus
+    {
+        Done,           // stopped on a start code (IPU_CTRL.SCD)
+        NeedData,       // ran out of input before the start code; nothing was produced
+        BitstreamError, // invalid VLC or coefficient overflow (IPU_CTRL.ECD)
+    };
+
+    struct IdecResult
+    {
+        IdecStatus status = IdecStatus::NeedData;
+        uint32_t macroblocks = 0;
+        uint64_t endBit = 0; // bit position where decoding stopped (before the start code)
+        std::string message;
+    };
+
+    // Decodes intra macroblocks starting at bit startBit of data[0, size) (MSB first) until a start code sits at
+    // the macroblock_address_increment position. Appends 1024 bytes per macroblock (16x16 RGBA, raster order) to
+    // out only when the result is Done. intraIq is the intra quantiser matrix in natural (row-major) order.
+    // The configuration must be supported (IdecConfig::unsupported() empty).
+    IdecResult decodeIdec(const uint8_t *data, size_t size, uint64_t startBit, const IdecConfig &config,
+                          const std::array<uint8_t, 64> &intraIq, std::vector<uint8_t> &out);
+
+    // Zigzag scan order (scan index -> natural index); SETIQ loads matrices in this order.
+    extern const std::array<uint8_t, 64> kZigzag;
+
+    struct Host
+    {
+        // DMA address space: bit 31 selects scratchpad (offset & 0x3FF0), otherwise physical RAM.
+        std::function<bool(uint32_t dmaAddr, uint8_t *dst16)> readQword;
+        std::function<bool(uint32_t dmaAddr, const uint8_t *src16)> writeQword;
+        // Plain DMAC register storage (no side effects).
+        std::function<uint32_t(uint32_t reg)> readReg;
+        std::function<void(uint32_t reg, uint32_t value)> writeReg;
+        // A DMAC channel finished: set D_STAT.CIS<channel> and queue the completion cause.
+        std::function<void(uint32_t channel)> channelComplete;
+        std::function<void(const std::string &message)> error;
+    };
+
+    class Device
+    {
+    public:
+        explicit Device(Host host);
+
+        void reset(); // IPU_CTRL.RST
+
+        void writeCmd(uint32_t value);
+        uint64_t readCmd();  // DATA in bits 0-31, BUSY in bit 63
+        void writeCtrl(uint32_t value);
+        uint32_t readCtrl();
+        uint32_t readBp();
+        uint64_t readTop();  // BSTOP in bits 0-31, BUSY in bit 63
+        void writeInFifo(const uint8_t *qword16);
+
+        // CHCR written with STR set (start) or cleared (stop) for D3/D4.
+        void toIpuChcrWritten(uint32_t chcr);
+        void fromIpuChcrWritten(uint32_t chcr);
+
+        // Observability for tests.
+        size_t outputBytes() const;
+        uint64_t inputBitsAvailable() const;
+        uint32_t lastMacroblocks() const;
+
+    private:
+        struct Channel
+        {
+            bool active = false;
+            bool chain = false;
+            bool endAfterBlock = false; // current block is the last one (end/refe/irq tag or normal mode)
+            uint32_t madr = 0;
+            uint32_t qwc = 0; // qwords left in the current block
+            uint32_t tadr = 0;
+        };
+
+        bool pullToIpuBlock(); // moves the rest of the current toIPU block (fetching tags as needed) into input
+        void finishToIpu();
+        void drainFromIpu();
+        void runPending();
+        bool executeCommand(uint32_t cmd); // false: needs more input
+        bool ensureBits(uint64_t bits);    // makes `bits` bits available after the read position, pulling D4
+        uint32_t peekBits(uint32_t count) const;
+        void compactInput();
+        void reportUnsupported(const std::string &what);
+
+        Host m_host;
+        mutable std::recursive_mutex m_mutex;
+
+        std::vector<uint8_t> m_in; // buffered input bytes
+        uint64_t m_bitPos = 0;     // read position in m_in
+        std::vector<uint8_t> m_out;
+        size_t m_outPos = 0;
+
+        uint32_t m_cmdData = 0;
+        uint32_t m_ctrl = 0; // writable fields + SCD/ECD
+        bool m_pending = false;
+        uint32_t m_pendingCmd = 0;
+        std::array<uint8_t, 64> m_intraIq{};
+        std::array<uint8_t, 64> m_nonIntraIq{};
+        std::array<uint16_t, 16> m_vqclut{};
+        uint32_t m_th0 = 0;
+        uint32_t m_th1 = 0;
+        uint32_t m_lastMacroblocks = 0;
+
+        Channel m_toIpu;
+        Channel m_fromIpu;
+    };
+
+    // D8 fromSPR started with CHCR.STR: normal and interleave (D_SQWC) modes; chain mode is reported unsupported.
+    void runFromSpr(Host &host, uint32_t chcr);
+
+    // Guest addresses used by the sceIpuInit HLE: libipu's setD4_CHCR helper and the IQ (0x50 bytes) and VQCLUT
+    // (0x20 bytes) tables that sceIpuInit streams into the input FIFO. They are game data; the defaults are the
+    // values the stub has always used and a game override sets the ones read from its own ELF.
+    struct LibIpuInitLayout
+    {
+        uint32_t setD4ChcrEntry = 0x126428u;
+        uint32_t iqTable = 0x1721E0u;
+        uint32_t vqTable = 0x172230u;
+    };
+
+    void setLibIpuInitLayout(const LibIpuInitLayout &layout);
+    LibIpuInitLayout libIpuInitLayout();
+}
+
+#endif
