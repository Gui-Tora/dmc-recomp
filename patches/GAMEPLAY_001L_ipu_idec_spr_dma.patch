+        tc.Run("fromSPR interleave transfers TQWC qwords and skips SQWC on the memory side", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            uint8_t *spr = mem.getScratchpad();
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < 0x400u; ++i)
+                spr[0x100u + i] = static_cast<uint8_t>(i * 7u + 1u);
+            std::memset(rdram + 0x20000u, 0xCC, 0x1000u);
+            constexpr uint32_t kDst = 0x20000u;
+            mem.write32(kDSqwc, 2u | (4u << 16)); // SQWC=2, TQWC=4
+            mem.write32(kD8 + 0x80u, 0x100u);     // SADR
+            mem.write32(kD8 + 0x10u, kDst);
+            mem.write32(kD8 + 0x20u, 10u); // 4 + 4 + 2 qwords
+            mem.consumeCompletedDmacCauses();
+            mem.write32(kD8 + 0x00u, 0x108u); // MOD=interleave, DIR=0, STR
+
+            uint32_t src = 0x100u, dst = kDst;
+            bool layoutOk = true;
+            for (uint32_t block : {4u, 4u, 2u})
+            {
+                layoutOk = layoutOk && std::memcmp(rdram + dst, spr + src, block * 16u) == 0;
+                src += block * 16u;
+                dst += block * 16u;
+                if (block == 4u)
+                    layoutOk = layoutOk && std::all_of(rdram + dst, rdram + dst + 32u, [](uint8_t b) { return b == 0xCC; });
+                dst += 2u * 16u;
+            }
+            t.IsTrue(layoutOk, "each TQWC block lands at MADR and SQWC qwords are skipped untouched");
+            t.Equals(mem.m_ioRegisters[kD8 + 0x10u], kDst + (4u + 2u) * 16u * 2u + (2u + 2u) * 16u,
+                     "MADR advances by transferred plus skipped qwords after every block");
+            t.Equals(mem.m_ioRegisters[kD8 + 0x80u], 0x100u + 10u * 16u, "SADR advances by the transferred qwords");
+            t.Equals(mem.m_ioRegisters[kD8 + 0x20u], 0u, "QWC reaches zero");
+            t.Equals(mem.m_ioRegisters[kD8 + 0x00u] & 0x100u, 0u, "STR clears at the end of the transfer");
+            t.IsTrue((mem.readIORegister(kDStat) & (1u << 8)) != 0u, "D_STAT.CIS8 is raised");
+            t.IsTrue(hasCause(mem.consumeCompletedDmacCauses(), 8u), "the fromSPR completion cause is queued");
+        });
+
+        tc.Run("fromSPR normal mode copies QWC qwords; chain mode is reported and not executed", [](TestCase &t)
