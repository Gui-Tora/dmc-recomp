+
+        // Lookup table indexed by the next `bits` bits: entry = (length << 16) | (index + 1); 0 = invalid code.
+        struct Lut
+        {
+            uint32_t bits = 0;
+            std::vector<uint32_t> entries;
+        };
+
+        template <typename T, size_t N>
+        Lut buildLut(const T (&codes)[N], uint32_t bits)
+        {
+            Lut lut;
+            lut.bits = bits;
+            lut.entries.assign(size_t(1) << bits, 0u);
+            for (size_t i = 0; i < N; ++i)
+            {
+                const uint32_t shift = bits - codes[i].len;
+                const uint32_t base = uint32_t(codes[i].code) << shift;
+                for (uint32_t k = 0; k < (1u << shift); ++k)
+                    lut.entries[base | k] = (uint32_t(codes[i].len) << 16) | uint32_t(i + 1);
+            }
+            return lut;
+        }
