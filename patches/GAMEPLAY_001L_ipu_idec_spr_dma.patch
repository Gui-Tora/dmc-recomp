+        // Integer IDCT (MSSG reference fast IDCT, IEEE 1180 compliant), 64-bit intermediates.
+        constexpr int64_t W1 = 2841, W2 = 2676, W3 = 2408, W5 = 1609, W6 = 1108, W7 = 565;
+
+        inline int64_t iclp(int64_t v) { return v < -256 ? -256 : (v > 255 ? 255 : v); }
+
+        void idctRow(int64_t *b)
+        {
+            int64_t x1 = b[4] << 11, x2 = b[6], x3 = b[2], x4 = b[1], x5 = b[7], x6 = b[5], x7 = b[3];
+            if (!(x1 | x2 | x3 | x4 | x5 | x6 | x7))
+            {
+                const int64_t v = b[0] << 3;
+                for (int i = 0; i < 8; ++i)
+                    b[i] = v;
+                return;
+            }
