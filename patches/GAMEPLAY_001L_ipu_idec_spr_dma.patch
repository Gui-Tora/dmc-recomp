+            BitReader(const uint8_t *data, size_t size, uint64_t pos) : m_data(data), m_bits(uint64_t(size) * 8u), m_pos(pos) {}
+
+            uint64_t pos() const { return m_pos; }
+            uint64_t bits() const { return m_bits; }
+
+            // Next `count` (<= 32) bits, zero-filled past the end of the data.
+            uint32_t peek(uint32_t count) const
+            {
+                uint64_t window = 0;
+                const uint64_t byte = m_pos >> 3;
+                for (uint32_t i = 0; i < 5; ++i)
+                {
+                    const uint64_t b = byte + i;
+                    window = (window << 8) | ((b < (m_bits >> 3)) ? m_data[b] : 0u);
+                }
+                window <<= 24;                 // 40 bits of window at the top of 64
+                window <<= (m_pos & 7u);
+                return uint32_t(window >> (64 - count));
+            }
+
+            uint32_t get(uint32_t count)
+            {
+                if (count == 0)
+                    return 0;
+                if (m_pos + count > m_bits)
+                    throw NeedData{};
+                const uint32_t v = peek(count);
+                m_pos += count;
+                return v;
+            }
+
+            void skip(uint64_t count)
+            {
+                if (m_pos + count > m_bits)
+                    throw NeedData{};
+                m_pos += count;
+            }
+
+            uint32_t vlc(const Lut &lut, const char *what)
+            {
+                const uint32_t e = lut.entries[peek(lut.bits)];
+                if (e == 0)
+                {
+                    if (m_pos + lut.bits > m_bits)
+                        throw NeedData{};
+                    std::ostringstream s;
+                    s << "invalid " << what << " VLC at bit " << m_pos;
+                    throw BadStream{s.str()};
+                }
+                const uint32_t len = e >> 16;
+                if (m_pos + len > m_bits)
+                    throw NeedData{};
+                m_pos += len;
+                return (e & 0xFFFFu) - 1u;
+            }
+
+            // Zero bits up to the next byte boundary followed by 0x000001.
+            bool startCodeAhead() const
+            {
+                const uint64_t pad = (8u - (m_pos & 7u)) & 7u;
+                if (m_pos + pad + 24 > m_bits)
+                    throw NeedData{};
+                if (pad && (peek(uint32_t(pad)) != 0u))
+                    return false;
+                const uint64_t byte = (m_pos + pad) >> 3;
+                return m_data[byte] == 0 && m_data[byte + 1] == 0 && m_data[byte + 2] == 1;
+            }
