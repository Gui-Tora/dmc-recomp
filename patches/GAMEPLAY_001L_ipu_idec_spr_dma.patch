+            const uint8_t bad[16] = {0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0, 0, 0, 0, 0, 0, 0, 0};
+            pushFifo(mem, bad);
+            mem.write32(kIpuCmd, 0x10010000u);
+            t.Equals(mem.read32(kIpuCtrl) & 0xC000u, 0x4000u, "an invalid macroblock_type sets ECD");
+
+            mem.write32(kD3 + 0x10u, 0x80000000u);
+            mem.write32(kD3 + 0x20u, 4u);
+            mem.write32(kD3 + 0x00u, 0x104u); // chain mode
+            t.Equals(mem.m_ioRegisters[kD3 + 0x20u], 4u, "fromIPU chain mode is reported and not executed");
+        });
+
+        tc.Run("SETIQ matrices survive IPU_CTRL.RST and drive IDEC dequantisation", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            // One macroblock whose first luma block has AC run 0 / level +1 ("110") after DC size 0.
+            const uint8_t stream[16] = {0xCD, 0x4A, 0x52, 0x22, 0x00, 0x00, 0x01, 0xB0,
+                                        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+            std::vector<std::vector<uint8_t>> outputs;
+            for (uint8_t weight : {uint8_t(16u), uint8_t(64u)})
+            {
+                mem.write32(kIpuCtrl, 0x40000000u);
+                uint8_t iq[16];
+                std::memset(iq, weight, sizeof(iq));
+                for (int i = 0; i < 4; ++i)
+                    pushFifo(mem, iq);
+                mem.write32(kIpuCmd, 0x50000000u);
+                mem.write32(kIpuCtrl, 0x40000000u); // RST must keep the matrix
+                pushFifo(mem, stream);
+                mem.write32(kIpuCmd, 0x10100000u); // QSC=16: the level-1 coefficient survives the IDCT
+                t.Equals(mem.read32(kIpuCtrl) & 0xC000u, 0x8000u, "IDEC ends on the start code");
+                mem.write32(kD3 + 0x10u, 0x80000000u);
+                mem.write32(kD3 + 0x20u, 64u);
+                mem.write32(kD3 + 0x00u, 0x100u);
+                outputs.emplace_back(mem.getScratchpad(), mem.getScratchpad() + 1024u);
+            }
+            t.IsFalse(allPixels(outputs[0].data(), 256u, outputs[0][0]), "the AC coefficient shapes the luma block");
+            t.IsTrue(outputs[0] != outputs[1], "a larger intra matrix weight changes the decoded pixels");
+            const size_t block3Pixel = (12u * 16u + 12u) * 4u; // y 12, x 12: luma block 3, DC only
+            t.IsTrue(allPixels(outputs[0].data() + block3Pixel, 1u, 130u) &&
+                         allPixels(outputs[1].data() + block3Pixel, 1u, 130u),
+                     "blocks without AC coefficients stay flat gray 130 with either matrix");
+        });
+    });
+}
