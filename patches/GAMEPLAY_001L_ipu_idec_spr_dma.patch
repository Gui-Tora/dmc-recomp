+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kIpuCmd = 0x10002000u;
+    constexpr uint32_t kIpuCtrl = 0x10002010u;
+    constexpr uint32_t kIpuInFifo = 0x10007010u;
+    constexpr uint32_t kD3 = 0x1000B000u;
+    constexpr uint32_t kD4 = 0x1000B400u;
+    constexpr uint32_t kD8 = 0x1000D000u;
+    constexpr uint32_t kDSqwc = 0x1000E030u;
+    constexpr uint32_t kDStat = 0x1000E010u;
+
+    // IDEC bitstreams (fb=0, QSC=1, IPU_CTRL=0): intra macroblocks with DC only, then 00 00 01 B0.
+    // One macroblock: every DC differential 0 -> gray RGB 130.
+    const uint8_t kOneMacroblock[16] = {0xCA, 0x52, 0x91, 0x10, 0x00, 0x00, 0x01, 0xB0,
+                                        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+    // Two macroblocks: the second raises the luma DC predictor by 3 -> gray RGB 134.
+    const uint8_t kTwoMacroblocks[16] = {0xCA, 0x52, 0x91, 0x16, 0xF4, 0xA5, 0x22, 0x20,
+                                         0x00, 0x00, 0x01, 0xB0, 0x00, 0x00, 0x00, 0x00};
+
+    void setRegU32(R5900Context &ctx, int reg, uint32_t value)
+    {
+        ctx.r[reg] = _mm_set_epi64x(0, static_cast<int64_t>(value));
+    }
+
+    void writeTag(uint8_t *rdram, uint32_t at, uint32_t id, uint32_t qwc, uint32_t addr)
+    {
+        const uint64_t tag = (static_cast<uint64_t>(addr) << 32) | (static_cast<uint64_t>(id) << 28) | qwc;
+        std::memset(rdram + at, 0, 16);
+        std::memcpy(rdram + at, &tag, sizeof(tag));
+    }
+
+    void pushFifo(PS2Memory &mem, const uint8_t *qword16)
+    {
+        mem.write128(kIpuInFifo, _mm_loadu_si128(reinterpret_cast<const __m128i *>(qword16)));
+    }
+
+    bool allPixels(const uint8_t *rgba, uint32_t count, uint8_t gray)
+    {
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            const uint8_t *p = rgba + i * 4u;
+            if (p[0] != gray || p[1] != gray || p[2] != gray || p[3] != 0x80u)
+                return false;
+        }
+        return true;
+    }
+
+    bool hasCause(const std::vector<uint32_t> &causes, uint32_t cause)
+    {
+        return std::find(causes.begin(), causes.end(), cause) != causes.end();
+    }
+
+    // toIPU ref chain at tagAddr for the 16-byte stream copied to dataAddr, then IDEC (QSC=1).
+    void decodeThroughToIpu(PS2Memory &mem, const uint8_t *stream, uint32_t tagAddr, uint32_t dataAddr)
+    {
+        uint8_t *rdram = mem.getRDRAM();
+        std::memcpy(rdram + dataAddr, stream, 16);
+        writeTag(rdram, tagAddr, 3u, 1u, dataAddr); // ref
+        mem.write32(kIpuCtrl, 0x40000000u);
+        mem.write32(kIpuCmd, 0u); // BCLR
+        mem.write32(kD4 + 0x30u, tagAddr);
+        mem.write32(kD4 + 0x20u, 0u);
+        mem.write32(kD4 + 0x00u, 0x105u);
+        mem.write32(kIpuCtrl, 0u);
+        mem.write32(kIpuCmd, 0x10010000u); // IDEC FB=0 QSC=1
+    }
+}
