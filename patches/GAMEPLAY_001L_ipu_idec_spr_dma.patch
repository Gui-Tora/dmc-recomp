+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < 64u; ++i)
+                spr[0x3FE0u + (i & 31u)] = static_cast<uint8_t>(0xA0u + i);
+            for (uint32_t i = 0; i < 32u; ++i)
