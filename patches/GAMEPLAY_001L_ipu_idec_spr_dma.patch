+            x4 = (181 * (x4 - x5) + 128) >> 8;
+            b[0] = (x7 + x1) >> 8;
+            b[1] = (x3 + x2) >> 8;
+            b[2] = (x0 + x4) >> 8;
+            b[3] = (x8 + x6) >> 8;
+            b[4] = (x8 - x6) >> 8;
+            b[5] = (x0 - x4) >> 8;
+            b[6] = (x3 - x2) >> 8;
+            b[7] = (x7 - x1) >> 8;
+        }
+
+        void idctCol(int64_t *b)
+        {
+            int64_t x1 = b[8 * 4] << 8, x2 = b[8 * 6], x3 = b[8 * 2], x4 = b[8 * 1], x5 = b[8 * 7], x6 = b[8 * 5],
+                    x7 = b[8 * 3];
+            if (!(x1 | x2 | x3 | x4 | x5 | x6 | x7))
+            {
+                const int64_t v = iclp((b[0] + 32) >> 6);
+                for (int i = 0; i < 8; ++i)
+                    b[8 * i] = v;
+                return;
+            }
+            int64_t x0 = (b[0] << 8) + 8192;
+            int64_t x8 = W7 * (x4 + x5) + 4;
+            x4 = (x8 + (W1 - W7) * x4) >> 3;
+            x5 = (x8 - (W1 + W7) * x5) >> 3;
+            x8 = W3 * (x6 + x7) + 4;
+            x6 = (x8 - (W3 - W5) * x6) >> 3;
+            x7 = (x8 - (W3 + W5) * x7) >> 3;
+            x8 = x0 + x1;
+            x0 -= x1;
+            x1 = W6 * (x3 + x2) + 4;
+            x2 = (x1 - (W2 + W6) * x2) >> 3;
+            x3 = (x1 + (W2 - W6) * x3) >> 3;
+            x1 = x4 + x6;
+            x4 -= x6;
+            x6 = x5 + x7;
+            x5 -= x7;
+            x7 = x8 + x3;
+            x8 -= x3;
+            x3 = x0 + x2;
+            x0 -= x2;
+            x2 = (181 * (x4 + x5) + 128) >> 8;
+            x4 = (181 * (x4 - x5) + 128) >> 8;
+            b[8 * 0] = iclp((x7 + x1) >> 14);
+            b[8 * 1] = iclp((x3 + x2) >> 14);
+            b[8 * 2] = iclp((x0 + x4) >> 14);
+            b[8 * 3] = iclp((x8 + x6) >> 14);
+            b[8 * 4] = iclp((x8 - x6) >> 14);
+            b[8 * 5] = iclp((x0 - x4) >> 14);
+            b[8 * 6] = iclp((x3 - x2) >> 14);
+            b[8 * 7] = iclp((x7 - x1) >> 14);
+        }
+
+        inline uint8_t clamp8(int64_t v) { return uint8_t(v < 0 ? 0 : (v > 255 ? 255 : v)); }
+
+        // YCbCr (4:2:0, nearest chroma) to RGBA; alpha 0x80 (SETTH thresholds 0).
+        void macroblockToRgb32(const int64_t (&blocks)[6][64], uint8_t *dst)
+        {
+            for (int y = 0; y < 16; ++y)
+            {
+                for (int x = 0; x < 16; ++x)
+                {
+                    const int64_t *yb = blocks[(y >> 3) * 2 + (x >> 3)];
+                    const int64_t lumaSample = clamp8(yb[(y & 7) * 8 + (x & 7)]);
+                    const int64_t cb = int64_t(clamp8(blocks[4][(y >> 1) * 8 + (x >> 1)])) - 128;
+                    const int64_t cr = int64_t(clamp8(blocks[5][(y >> 1) * 8 + (x >> 1)])) - 128;
+                    const int64_t lum = (149 * std::max<int64_t>(0, lumaSample - 16)) >> 6;
+                    uint8_t *p = dst + (y * 16 + x) * 4;
+                    p[0] = clamp8((lum + ((204 * cr) >> 6) + 1) >> 1);
+                    p[1] = clamp8((lum + ((-104 * cr) >> 6) + ((-50 * cb) >> 6) + 1) >> 1);
+                    p[2] = clamp8((lum + ((258 * cb) >> 6) + 1) >> 1);
+                    p[3] = 0x80;
+                }
+            }
+        }
+    }
+
+    std::string IdecConfig::unsupported() const
+    {
+        if (ofm)
+            return "IDEC OFM=1 (RGB16 output)";
+        if (dtd)
+            return "IDEC DTD=1 (dct_type decoding)";
+        if (sgn)
+            return "IDEC SGN=1";
+        if (dte)
+            return "IDEC DTE=1 (dithering)";
+        if (as)
+            return "IPU_CTRL.AS=1 (alternate scan)";
+        if (qst)
+            return "IPU_CTRL.QST=1 (non-linear quantiser scale)";
+        if (mp1)
+            return "IPU_CTRL.MP1=1 (MPEG-1 bitstream)";
+        if (th0 || th1)
+            return "SETTH thresholds other than 0 in IDEC";
+        return {};
+    }
+
+    IdecResult decodeIdec(const uint8_t *data, size_t size, uint64_t startBit, const IdecConfig &config,
+                          const std::array<uint8_t, 64> &intraIq, std::vector<uint8_t> &out)
+    {
+        const Tables &t = tables();
+        const Lut &acLut = config.ivf ? t.acB15 : t.acB14;
+        const AcCode *acCodes = config.ivf ? kAcTableB15 : kAcTableB14;
+        BitReader b(data, size, startBit);
+        IdecResult result;
+        std::vector<uint8_t> produced;
+        try
+        {
+            b.skip(config.fb);
+            int64_t lastDc[3];
+            lastDc[0] = lastDc[1] = lastDc[2] = int64_t(1) << (7 + config.idp);
+            int64_t qscale = int64_t(config.qsc) << 1;
+            uint32_t mbs = 0;
+            for (;;)
+            {
+                if (b.startCodeAhead())
+                    break;
+                if (mbs)
+                {
+                    uint32_t increment = 0;
+                    for (;;)
+                    {
+                        const uint32_t i = b.vlc(t.mba, "macroblock_address_increment");
+                        if (i == kMbaStuffing)
+                            continue;
+                        if (i == kMbaEscape)
+                        {
+                            increment += 33;
+                            continue;
+                        }
+                        increment += i + 1;
+                        break;
+                    }
+                    if (increment != 1)
+                    {
+                        std::ostringstream s;
+                        s << "macroblock_address_increment " << increment << " in IDEC at bit " << b.pos();
+                        throw BadStream{s.str()};
+                    }
+                }
+                bool quant = false;
+                if (!b.get(1))
+                {
+                    if (!b.get(1))
+                    {
+                        std::ostringstream s;
+                        s << "invalid I macroblock_type at bit " << b.pos();
+                        throw BadStream{s.str()};
+                    }
+                    quant = true;
+                }
+                if (quant)
+                    qscale = int64_t(b.get(5)) << 1;
+
+                int64_t blocks[6][64];
+                for (int n = 0; n < 6; ++n)
+                {
+                    int64_t *blk = blocks[n];
+                    std::fill(blk, blk + 64, 0);
+                    const int comp = n < 4 ? 0 : (n & 1) + 1;
+                    const uint32_t dcSize = b.vlc(n < 4 ? t.dcLuma : t.dcChroma, "dct_dc_size");
+                    int64_t diff = 0;
+                    if (dcSize)
+                    {
+                        diff = b.get(dcSize);
+                        if (diff < (int64_t(1) << (dcSize - 1)))
+                            diff -= (int64_t(1) << dcSize) - 1;
+                    }
+                    lastDc[comp] += diff;
+                    blk[0] = lastDc[comp] << (3 - config.idp);
+                    uint32_t i = 0;
+                    for (;;)
+                    {
+                        const AcCode &c = acCodes[b.vlc(acLut, "DCT coefficient")];
+                        if (c.run == kAcEob)
+                            break;
+                        uint32_t run;
+                        int64_t level;
+                        if (c.run == kAcEscape)
+                        {
+                            run = b.get(6) + 1;
+                            level = b.get(12);
+                            if (level >= 2048)
+                                level -= 4096;
+                        }
+                        else
+                        {
+                            run = uint32_t(c.run) + 1;
+                            level = c.level;
+                            if (b.get(1))
+                                level = -level;
+                        }
+                        i += run;
+                        if (i > 63)
+                        {
+                            std::ostringstream s;
+                            s << "coefficient index overflow at bit " << b.pos();
+                            throw BadStream{s.str()};
+                        }
+                        const uint32_t j = kZigzag[i];
+                        const int64_t a = ((level < 0 ? -level : level) * qscale * intraIq[j]) >> 4;
+                        blk[j] = level < 0 ? -a : a;
+                    }
+                    int64_t sum = 0;
+                    for (int k = 0; k < 64; ++k)
+                    {
+                        blk[k] = std::clamp<int64_t>(blk[k], -2048, 2047);
+                        sum += blk[k];
+                    }
+                    if ((sum & 1) == 0)
+                        blk[63] ^= 1;
+                    for (int r = 0; r < 8; ++r)
+                        idctRow(blk + r * 8);
+                    for (int c = 0; c < 8; ++c)
+                        idctCol(blk + c);
+                }
+                const size_t at = produced.size();
+                produced.resize(at + 1024);
+                macroblockToRgb32(blocks, produced.data() + at);
+                ++mbs;
+            }
+            result.status = IdecStatus::Done;
+            result.macroblocks = mbs;
+            result.endBit = b.pos();
+            out.insert(out.end(), produced.begin(), produced.end());
+        }
+        catch (const NeedData &)
+        {
+            result.status = IdecStatus::NeedData;
+            result.endBit = startBit;
+        }
+        catch (const BadStream &e)
+        {
+            result.status = IdecStatus::BitstreamError;
+            result.macroblocks = uint32_t(produced.size() / 1024);
+            result.endBit = b.pos();
+            result.message = e.message;
+        }
+        return result;
+    }
+
+    // ---------------------------------------------------------------------------------------------------------
+    // Device
+
+    namespace
+    {
+        constexpr uint32_t kChcrStr = 0x100u;
+        constexpr uint32_t kCtrlWritable = 0x07F30000u; // IDP, AS, IVF, QST, MP1, PCT
+        constexpr uint32_t kCtrlEcd = 1u << 14;
+        constexpr uint32_t kCtrlScd = 1u << 15;
+        constexpr uint32_t kCtrlRst = 1u << 30;
+        constexpr uint32_t kCtrlBusy = 1u << 31;
+
+        std::string hex(uint32_t v)
+        {
+            std::ostringstream s;
+            s << "0x" << std::hex << v;
+            return s.str();
+        }
+    }
+
+    Device::Device(Host host) : m_host(std::move(host)) {}
+
+    void Device::reset()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        m_in.clear();
+        m_bitPos = 0;
+        m_out.clear();
+        m_outPos = 0;
+        m_cmdData = 0;
+        m_ctrl = 0;
+        m_pending = false;
+        m_pendingCmd = 0;
+    }
+
+    void Device::reportUnsupported(const std::string &what)
+    {
+        if (m_host.error)
+            m_host.error("[IPU] unsupported: " + what + "\n");
+    }
+
+    void Device::writeCmd(uint32_t value)
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        if (m_pending)
+            reportUnsupported("IPU_CMD " + hex(value) + " written while command " + hex(m_pendingCmd) + " is busy");
+        m_pending = true;
+        m_pendingCmd = value;
+        runPending();
+    }
+
+    uint64_t Device::readCmd()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        return uint64_t(m_cmdData) | (m_pending ? (uint64_t(1) << 63) : 0u);
+    }
+
+    void Device::writeCtrl(uint32_t value)
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        if (value & kCtrlRst)
+            reset();
+        m_ctrl = (m_ctrl & ~kCtrlWritable) | (value & kCtrlWritable);
+    }
+
+    uint32_t Device::readCtrl()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        const uint64_t unread = (uint64_t(m_in.size()) * 8u > m_bitPos) ? (uint64_t(m_in.size()) * 8u - m_bitPos) : 0u;
+        const uint32_t ifc = uint32_t(std::min<uint64_t>(8u, (unread + 127u) / 128u));
+        const uint32_t ofc = uint32_t(std::min<size_t>(8u, (m_out.size() - m_outPos) / 16u));
+        return (m_ctrl & (kCtrlWritable | kCtrlEcd | kCtrlScd)) | ifc | (ofc << 4) | (m_pending ? kCtrlBusy : 0u);
+    }
+
+    uint32_t Device::readBp()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        const uint64_t qwStart = m_bitPos & ~uint64_t(127);
+        const uint64_t bits = uint64_t(m_in.size()) * 8u;
+        const uint64_t qwords = bits > qwStart ? (bits - qwStart) / 128u : 0u;
+        const uint32_t fp = uint32_t(std::min<uint64_t>(2u, qwords));
+        const uint32_t ifc = uint32_t(std::min<uint64_t>(8u, qwords - fp));
+        return uint32_t(m_bitPos & 127u) | (ifc << 8) | (fp << 16);
+    }
+
+    uint64_t Device::readTop()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        const bool ready = ensureBits(32);
+        return uint64_t(peekBits(32)) | (ready ? 0u : (uint64_t(1) << 63));
+    }
+
+    void Device::writeInFifo(const uint8_t *qword16)
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        m_in.insert(m_in.end(), qword16, qword16 + 16);
+        runPending();
+    }
+
+    size_t Device::outputBytes() const
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        return m_out.size() - m_outPos;
+    }
+
+    uint64_t Device::inputBitsAvailable() const
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        const uint64_t bits = uint64_t(m_in.size()) * 8u;
+        return bits > m_bitPos ? bits - m_bitPos : 0u;
+    }
+
+    uint32_t Device::lastMacroblocks() const
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        return m_lastMacroblocks;
+    }
+
+    uint32_t Device::peekBits(uint32_t count) const
+    {
+        BitReader r(m_in.data(), m_in.size(), m_bitPos);
+        return r.peek(count);
+    }
+
+    bool Device::ensureBits(uint64_t bits)
+    {
+        while (uint64_t(m_in.size()) * 8u < m_bitPos + bits)
+        {
+            if (!pullToIpuBlock())
+                return false;
+        }
+        return true;
+    }
+
+    void Device::compactInput()
+    {
+        const uint64_t dropBytes = (m_bitPos >> 7) << 4;
+        if (dropBytes >= 4096u && dropBytes <= m_in.size())
+        {
+            m_in.erase(m_in.begin(), m_in.begin() + static_cast<std::ptrdiff_t>(dropBytes));
+            m_bitPos -= dropBytes * 8u;
+        }
+    }
+
+    void Device::runPending()
+    {
+        if (m_pending && executeCommand(m_pendingCmd))
+        {
+            m_pending = false;
+            compactInput();
+        }
+        drainFromIpu();
+    }
+
+    bool Device::executeCommand(uint32_t cmd)
+    {
+        const uint32_t op = cmd >> 28;
+        switch (op)
+        {
+        case 0x0: // BCLR
+            m_in.clear();
+            m_bitPos = cmd & 0x7Fu;
+            return true;
+        case 0x1: // IDEC
+        {
+            IdecConfig config;
+            config.fb = cmd & 0x3Fu;
+            config.qsc = (cmd >> 16) & 0x1Fu;
+            config.dtd = (cmd >> 24) & 1u;
+            config.sgn = (cmd >> 25) & 1u;
+            config.dte = (cmd >> 26) & 1u;
+            config.ofm = (cmd >> 27) & 1u;
+            config.idp = (m_ctrl >> 16) & 3u;
+            config.as = (m_ctrl >> 20) & 1u;
+            config.ivf = (m_ctrl >> 21) & 1u;
+            config.qst = (m_ctrl >> 22) & 1u;
+            config.mp1 = (m_ctrl >> 23) & 1u;
+            config.th0 = m_th0;
+            config.th1 = m_th1;
+            const std::string why = config.unsupported();
+            if (!why.empty())
+            {
+                reportUnsupported(why + " (IDEC " + hex(cmd) + ", IPU_CTRL " + hex(m_ctrl) + ")");
+                m_ctrl |= kCtrlEcd;
+                return true;
+            }
+            for (;;)
+            {
+                const IdecResult r = decodeIdec(m_in.data(), m_in.size(), m_bitPos, config, m_intraIq, m_out);
+                if (r.status == IdecStatus::NeedData)
+                {
+                    if (pullToIpuBlock())
+                        continue;
+                    return false;
+                }
+                m_bitPos = r.endBit;
+                m_lastMacroblocks = r.macroblocks;
+                if (r.status == IdecStatus::Done)
+                {
+                    m_ctrl = (m_ctrl & ~kCtrlEcd) | kCtrlScd;
+                }
+                else
+                {
+                    m_ctrl |= kCtrlEcd;
+                    if (m_host.error)
+                        m_host.error("[IPU] IDEC bitstream error: " + r.message + "\n");
+                }
+                return true;
+            }
+        }
+        case 0x4: // FDEC
+        {
+            const uint32_t fb = cmd & 0x3Fu;
+            if (!ensureBits(uint64_t(fb) + 32u))
+                return false;
+            m_bitPos += fb;
+            m_cmdData = peekBits(32);
+            return true;
+        }
+        case 0x5: // SETIQ
+        {
+            const uint32_t fb = cmd & 0x3Fu;
+            if (!ensureBits(uint64_t(fb) + 512u))
+                return false;
+            m_bitPos += fb;
+            std::array<uint8_t, 64> &iq = ((cmd >> 27) & 1u) ? m_nonIntraIq : m_intraIq;
+            for (uint32_t i = 0; i < 64; ++i)
+            {
+                iq[kZigzag[i]] = uint8_t(peekBits(8));
+                m_bitPos += 8;
+            }
+            return true;
+        }
+        case 0x6: // SETVQ: VQCLUT stored for completeness; no implemented command uses it
+            if (!ensureBits(256u))
+                return false;
+            for (uint32_t i = 0; i < 16; ++i)
+            {
+                m_vqclut[i] = uint16_t(peekBits(16));
+                m_bitPos += 16;
+            }
+            return true;
+        case 0x9: // SETTH
+            m_th0 = cmd & 0x1FFu;
+            m_th1 = (cmd >> 16) & 0x1FFu;
+            return true;
+        default:
+        {
+            static const char *const kNames[16] = {"BCLR", "IDEC", "BDEC", "VDEC", "FDEC", "SETIQ", "SETVQ", "CSC",
+                                                   "PACK", "SETTH", "0xA", "0xB", "0xC", "0xD", "0xE", "0xF"};
+            reportUnsupported(std::string("IPU command ") + kNames[op] + " (" + hex(cmd) + ")");
+            m_ctrl |= kCtrlEcd;
+            return true;
+        }
+        }
+    }
+
+    // --- D4 toIPU: data is pulled on demand, one DMA block at a time, so tags are only fetched when the IPU needs
+    // more input (a chain whose data outlasts the command stays active, as on hardware with a full FIFO).
+
+    void Device::toIpuChcrWritten(uint32_t chcr)
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        if (!(chcr & kChcrStr))
+        {
+            m_toIpu.active = false;
+            return;
+        }
+        const uint32_t mode = (chcr >> 2) & 3u;
+        if (mode > 1u || (chcr & 0x40u))
+        {
+            reportUnsupported("toIPU CHCR " + hex(chcr) + (mode > 1u ? " (mode)" : " (TTE)"));
+            m_toIpu.active = false;
+            return;
+        }
+        m_toIpu = Channel{};
+        m_toIpu.active = true;
+        m_toIpu.chain = (mode == 1u);
+        m_toIpu.madr = m_host.readReg(kDmaToIpu + 0x10u);
+        m_toIpu.qwc = m_host.readReg(kDmaToIpu + 0x20u) & 0xFFFFu;
+        m_toIpu.tadr = m_host.readReg(kDmaToIpu + 0x30u);
+        m_toIpu.endAfterBlock = !m_toIpu.chain;
+        if (!m_toIpu.chain && m_toIpu.qwc == 0u)
+        {
+            finishToIpu();
+            return;
+        }
+        runPending();
+    }
+
+    void Device::finishToIpu()
+    {
+        m_toIpu.active = false;
+        m_host.writeReg(kDmaToIpu + 0x00u, m_host.readReg(kDmaToIpu + 0x00u) & ~kChcrStr);
+        m_host.writeReg(kDmaToIpu + 0x20u, 0u);
+        if (m_host.channelComplete)
+            m_host.channelComplete(4u);
+    }
+
+    bool Device::pullToIpuBlock()
+    {
+        while (m_toIpu.active)
+        {
+            if (m_toIpu.qwc > 0u)
+            {
+                uint8_t qw[16];
+                for (uint32_t i = 0; i < m_toIpu.qwc; ++i)
+                {
+                    if (!m_host.readQword(m_toIpu.madr + i * 16u, qw))
+                    {
+                        reportUnsupported("toIPU read from " + hex(m_toIpu.madr + i * 16u));
+                        m_toIpu.active = false;
+                        return false;
+                    }
+                    m_in.insert(m_in.end(), qw, qw + 16);
+                }
+                m_toIpu.madr += m_toIpu.qwc * 16u;
+                m_toIpu.qwc = 0u;
+                m_host.writeReg(kDmaToIpu + 0x10u, m_toIpu.madr);
+                m_host.writeReg(kDmaToIpu + 0x20u, 0u);
+                if (m_toIpu.endAfterBlock)
+                    finishToIpu();
+                return true;
+            }
+            if (m_toIpu.endAfterBlock)
+            {
+                finishToIpu();
+                return false;
+            }
+            uint8_t tagBytes[16];
+            if (!m_host.readQword(m_toIpu.tadr, tagBytes))
+            {
+                reportUnsupported("toIPU tag read from " + hex(m_toIpu.tadr));
+                m_toIpu.active = false;
+                return false;
+            }
+            uint64_t tag = 0;
+            std::memcpy(&tag, tagBytes, sizeof(tag));
+            const uint32_t qwc = uint32_t(tag & 0xFFFFu);
+            const uint32_t id = uint32_t((tag >> 28) & 7u);
+            const bool irq = ((tag >> 31) & 1u) != 0u;
+            const uint32_t addr = uint32_t((tag >> 32) & 0xFFFFFFF0u);
+            const uint32_t chcr = m_host.readReg(kDmaToIpu + 0x00u);
+            m_host.writeReg(kDmaToIpu + 0x00u, (chcr & 0xFFFFu) | (uint32_t(tag) & 0xFFFF0000u));
+            switch (id)
+            {
+            case 0: // refe
+                m_toIpu.madr = addr;
+                m_toIpu.tadr += 16u;
+                m_toIpu.endAfterBlock = true;
+                break;
+            case 1: // cnt
+                m_toIpu.madr = m_toIpu.tadr + 16u;
+                m_toIpu.tadr = m_toIpu.madr + qwc * 16u;
+                break;
+            case 2: // next
+                m_toIpu.madr = m_toIpu.tadr + 16u;
+                m_toIpu.tadr = addr;
+                break;
+            case 3: // ref
+            case 4: // refs
+                m_toIpu.madr = addr;
+                m_toIpu.tadr += 16u;
+                break;
+            case 7: // end
+                m_toIpu.madr = m_toIpu.tadr + 16u;
+                m_toIpu.endAfterBlock = true;
+                break;
+            default:
+                reportUnsupported("toIPU chain tag id " + std::to_string(id) + " at " + hex(m_toIpu.tadr));
+                m_toIpu.active = false;
+                return false;
+            }
+            if (irq && (chcr & 0x80u))
+                m_toIpu.endAfterBlock = true;
+            m_toIpu.qwc = qwc;
+            m_host.writeReg(kDmaToIpu + 0x10u, m_toIpu.madr);
+            m_host.writeReg(kDmaToIpu + 0x20u, m_toIpu.qwc);
+            m_host.writeReg(kDmaToIpu + 0x30u, m_toIpu.tadr);
+        }
+        return false;
+    }
+
+    // --- D3 fromIPU: normal mode, drains the output FIFO to MADR (scratchpad when bit 31 is set).
+
+    void Device::fromIpuChcrWritten(uint32_t chcr)
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        if (!(chcr & kChcrStr))
+        {
+            m_fromIpu.active = false;
+            return;
+        }
+        const uint32_t mode = (chcr >> 2) & 3u;
+        if (mode != 0u)
+        {
+            reportUnsupported("fromIPU CHCR " + hex(chcr) + " (mode)");
+            m_fromIpu.active = false;
+            return;
+        }
+        m_fromIpu = Channel{};
+        m_fromIpu.active = true;
+        m_fromIpu.madr = m_host.readReg(kDmaFromIpu + 0x10u);
+        m_fromIpu.qwc = m_host.readReg(kDmaFromIpu + 0x20u) & 0xFFFFu;
+        drainFromIpu();
+    }
+
+    void Device::drainFromIpu()
+    {
+        if (!m_fromIpu.active)
+            return;
+        while (m_fromIpu.qwc > 0u && m_out.size() - m_outPos >= 16u)
+        {
+            if (!m_host.writeQword(m_fromIpu.madr, m_out.data() + m_outPos))
+            {
+                reportUnsupported("fromIPU write to " + hex(m_fromIpu.madr));
+                m_fromIpu.active = false;
+                return;
+            }
+            m_outPos += 16u;
+            m_fromIpu.madr += 16u;
+            --m_fromIpu.qwc;
+        }
+        if (m_outPos == m_out.size())
+        {
+            m_out.clear();
+            m_outPos = 0;
+        }
+        m_host.writeReg(kDmaFromIpu + 0x10u, m_fromIpu.madr);
+        m_host.writeReg(kDmaFromIpu + 0x20u, m_fromIpu.qwc);
+        if (m_fromIpu.qwc == 0u)
+        {
+            m_fromIpu.active = false;
+            m_host.writeReg(kDmaFromIpu + 0x00u, m_host.readReg(kDmaFromIpu + 0x00u) & ~kChcrStr);
+            if (m_host.channelComplete)
+                m_host.channelComplete(3u);
+        }
+    }
+
+    // --- D8 fromSPR
+
+    void runFromSpr(Host &host, uint32_t chcr)
+    {
+        if (!(chcr & kChcrStr))
+            return;
+        const uint32_t mode = (chcr >> 2) & 3u;
+        uint32_t madr = host.readReg(kDmaFromSpr + 0x10u);
+        uint32_t qwc = host.readReg(kDmaFromSpr + 0x20u) & 0xFFFFu;
+        uint32_t sadr = host.readReg(kDmaFromSpr + 0x80u) & 0x3FF0u;
+        uint32_t tqwc = qwc;
+        uint32_t sqwc = 0;
+        if (mode == 2u)
+        {
+            const uint32_t dsqwc = host.readReg(kDmaSqwc);
+            sqwc = dsqwc & 0xFFu;
+            tqwc = (dsqwc >> 16) & 0xFFu;
+            if (tqwc == 0u)
+            {
+                if (host.error)
+                    host.error("[IPU] unsupported: fromSPR interleave with D_SQWC.TQWC=0\n");
+                return;
+            }
+        }
+        else if (mode != 0u)
+        {
+            if (host.error)
+                host.error("[IPU] unsupported: fromSPR CHCR " + hex(chcr) + " (mode)\n");
+            return;
+        }
+        uint8_t qw[16];
+        while (qwc > 0u)
+        {
+            const uint32_t block = std::min(tqwc, qwc);
+            for (uint32_t i = 0; i < block; ++i)
+            {
+                if (!host.readQword(0x80000000u | sadr, qw) || !host.writeQword(madr + i * 16u, qw))
+                {
+                    if (host.error)
+                        host.error("[IPU] unsupported: fromSPR transfer to " + hex(madr + i * 16u) + "\n");
+                    return;
+                }
+                sadr = (sadr + 16u) & 0x3FF0u;
+            }
+            qwc -= block;
+            // Interleave skips SQWC qwords on the memory side after every transferred block (PCSX2 _SPR0interleave).
+            madr += (block + sqwc) * 16u;
+        }
+        host.writeReg(kDmaFromSpr + 0x10u, madr);
+        host.writeReg(kDmaFromSpr + 0x20u, 0u);
+        host.writeReg(kDmaFromSpr + 0x80u, sadr);
+        host.writeReg(kDmaFromSpr + 0x00u, chcr & ~kChcrStr);
+        if (host.channelComplete)
+            host.channelComplete(8u);
+    }
+
+    namespace
+    {
+        std::mutex g_layoutMutex;
+        LibIpuInitLayout g_layout;
+    }
+
+    void setLibIpuInitLayout(const LibIpuInitLayout &layout)
+    {
+        std::lock_guard<std::mutex> lock(g_layoutMutex);
+        g_layout = layout;
+    }
+
+    LibIpuInitLayout libIpuInitLayout()
+    {
+        std::lock_guard<std::mutex> lock(g_layoutMutex);
+        return g_layout;
+    }
+}
