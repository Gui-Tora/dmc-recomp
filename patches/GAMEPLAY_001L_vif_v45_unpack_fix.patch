+            struct Case { uint16_t in; uint32_t x, y, z, w; const char *what; };
+            const Case cases[] = {
+                {0x0000u, 0u, 0u, 0u, 0u, "0x0000: all zero"},
+                {0xFFFFu, 248u, 248u, 248u, 128u, "0xFFFF: RGB=248 A=128"},
+                {0x001Fu, 248u, 0u, 0u, 0u, "0x001F: only R"},
+                {0x03E0u, 0u, 248u, 0u, 0u, "0x03E0: only G"},
+                {0x7C00u, 0u, 0u, 248u, 0u, "0x7C00: only B"},
+                {0x8000u, 0u, 0u, 0u, 128u, "0x8000: only A"},
