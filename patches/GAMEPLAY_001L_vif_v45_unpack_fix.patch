+                {0x801Fu, 248u, 0u, 0u, 128u, "DMC weights 31,0,0 A=1"},
+                {0xCDCDu, 104u, 112u, 152u, 128u, "DMC weights 13,14,19 A=1"},
+            };
+            constexpr uint32_t kCount = sizeof(cases) / sizeof(cases[0]);
