diff --git a/ps2xIOP/src/modules/tsnddrvm_xag.cpp b/ps2xIOP/src/modules/tsnddrvm_xag.cpp
new file mode 100644
index 0000000..899c59f
--- /dev/null
+++ b/ps2xIOP/src/modules/tsnddrvm_xag.cpp
@@ -0,0 +1,866 @@
+// TSNDDRVM.IRX (Capcom TSND sound driver, SHA-256 c00b17f07aa0dfed089a517498074eec251c7b571f58a7649414ef88be7f31fd,
+// shipped by Devil May Cry PAL SLES_503.58) -- XAG stream channels.
+//
+// Reconstructed from the IRX's own .text/.symtab (GAMEPLAY_001J):
+//   SID 0 (TsndFunc@0x4D14): fno 0 carries packed commands terminated by 0xFF; tsndReqFunc@0x4C08 dispatches on
+//     (opcode & 0xF0): 0x30/0x70 -> treq_XAG@0x36EC (jump table .rodata 0xA678). Command lengths are the EE
+//     packers' (sending_req@0x3CD870 in the ELF).
+//   SID 1 (TsndPutFunc@0x4D88): function = 0x80000000 (priority boost only) | fno; (fno & 0xFF) - 1 indexes a
+//     17-entry jump table (.rodata 0xA7E0): fno 1 XagChkStandby@0x7E44, fno 2 XagChkPlay@0x7EDC. The answer is the
+//     first word of a static 16-byte result buffer (0x1E5E0) the SIF returns to the EE receive buffer.
+// Channel record (0x1E3B0 + ch * 0xA8): byte 0 = state. 0 idle (XagControlExitFin@0x8C40), 1 preparing (first
+// store of XagControl@0x8D64, the per-core thread XagStandby2 starts), 2 start requested (XagStart@0x7CB8),
+// 3 playing (XagControl after WaitSema(standby) at 0x91C4), 4/5 end-of-stream phases, then 0 via XagControlExit.
+//
+// Modelled (phase 2a, guest-visible progression; no SPU output yet):
+//   * TsndInitXag (0x77) / XagAllocBuff (0x75) / XagSetBuff (0x74): per-core channel limit and stream buffer size.
+//   * XagStandby2 (0x3D) runs XagControl's validation (channels = min(entry, core limit), block alignment, file size,
+//     SPU slot range, ring slots >= 2). On failure the IRX exits through XagControlExitFin: state 0, no semaphores.
+//     On success XagCdRead reads the clip [A4, A4 + A6) chunks set by XagSetSkip3 (0x79); its standby semaphore
+//     (created with count 0, max 1) is signalled once two chunks are buffered (0x853C) or the clip has been read
+//     (0x877C). CD reads are synchronous in this host, so a valid clip is in standby on the next query.
+//   * XagStart (0x32): state 2, and XagControl (priority 0x1A, above the RPC thread) consumes the standby semaphore
+//     and enters state 3 at once. The clip then plays for its ADPCM duration (28 samples per 16-byte block per
+//     channel, rate = 48000 * pitch / 0x1000 with the entry's pitch) measured in emulated VSync ticks.
+//   * XagStop (0x33): clear_sema + ReleaseWaitThread -> XagControlExit -> state 0.
+// Audible output (phase 2b): instead of XagTrans's SPU double buffering, XagStart starts a worker that reads the
+// clip from the CD image, decodes its SPU ADPCM (per-channel blocks of the entry's block size inside each chunk,
+// 16-byte frames of 28 samples, filters 0-4) and queues interleaved s16 PCM on the host stream of the core
+// (IopHost::streamPcm) at the entry's pitch rate. The host plays it in real time, so it is not synchronised with a
+// slower-than-real-time guest (known limitation). DMC_TSND_AUDIO=0 disables it. XagStop/reset cancel and silence
+// the stream.
+// Not modelled yet: loop count (XagSetSkip), pause, fades, per-channel volume; the 4/5 end phases are folded
+// into "playing" (XagChkPlay keeps answering >= 0 until the clip has elapsed).
+#include "../module_factories.h"
+#include "../checkpoint_bytes.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kCommandSid = 0x00000000u;
+        constexpr uint32_t kStateSid = 0x00000001u;
+        constexpr uint32_t kCommandFunction = 0x00000000u;
+        constexpr uint32_t kMaxCommandBytes = 0x200u; // makebuff* bound in the EE packers
+        constexpr uint32_t kChkStandby = 1u;
+        constexpr uint32_t kChkPlay = 2u;
+        constexpr uint32_t kStateFunctionCount = 17u; // TsndPutFunc jump table size
+        constexpr int32_t kBadFunctionResult = -10;    // TsndPutFunc default case (0x515C)
+        constexpr uint32_t kSpuLimit = 0x001E7800u;    // XagControl slot range check (0x8F84)
+        constexpr uint32_t kMaxBlockBytes = 0x00020000u;
+        constexpr uint8_t kStateIdle = 0u;
+        constexpr uint8_t kStatePreparing = 1u;
+        constexpr uint8_t kStateStartRequested = 2u;
+        constexpr uint8_t kStatePlaying = 3u;
+
+        struct XagChannel
+        {
+            uint8_t state = kStateIdle;
+            uint8_t entry = 0xFFu;
+            uint16_t volume = 0u;
+            uint16_t skipStart = 0u;  // record +0xA4 (XagSetSkip3 a0 / XagSetSkip2)
+            uint16_t skipCount = 0u;  // record +0xA6 (XagSetSkip3 a1; 0 = to the end of the file)
+            int16_t loopCount = 0;    // record +0x94 (XagSetSkip)
+            uint8_t standbyCount = 0u;
+            uint8_t hasSemaphores = 0u;
+            uint64_t clipSamples = 0u;
+            uint64_t clipOffset = 0u; // bytes from the start of the stream file
+            uint64_t clipBytes = 0u;
+            uint64_t playStartTick = 0u;
+            uint64_t playEndTick = 0u;
+        };
+
+        // Bytes occupied by one packed command, opcode included (EE sending_req / makebuff* in SLES_503.58).
+        // 0 = a length the EE cannot produce in a fixed size; the stream is then not parsed further.
+        uint32_t commandLength(uint8_t opcode)
+        {
+            switch (opcode & 0xF0u)
+            {
+            case 0x00u: // makebuff_tq
+                return 4u + (opcode & 1u) + ((opcode & 2u) ? 1u : 0u) + ((opcode & 4u) ? 2u : 0u);
+            case 0x10u:
+                return opcode == 0x11u ? 3u : 1u;
+            case 0x20u:
+                return (opcode == 0x20u || (opcode >= 0x22u && opcode <= 0x24u)) ? 3u : 2u;
+            case 0x30u:
+            case 0x70u:
+                switch (opcode)
+                {
+                case 0x30u: case 0x31u: case 0x38u: case 0x71u: case 0x73u:
+                    return 2u;
+                case 0x37u: case 0x39u: case 0x3Au: case 0x3Bu: case 0x3Du: case 0x72u: case 0x75u: case 0x78u:
+                    return 3u;
+                case 0x36u: case 0x74u:
+                    return 4u;
+                case 0x3Cu: case 0x3Eu: case 0x77u: case 0x79u:
+                    return 5u;
+                case 0x35u: // makebuff_vmix: 4 + 3 bytes
+                case 0x3Fu:
+                    return 7u;
+                default:
+                    return 1u;
+                }
+            case 0x40u:
+                if ((opcode >= 0x47u && opcode <= 0x4Au) || opcode == 0x41u || opcode == 0x42u)
+                    return 2u;
+                if (opcode == 0x4Bu || opcode == 0x4Du || opcode == 0x4Eu) // 0x4D/0x4E: makebuff_ext, 3 bytes
+                    return 3u;
+                if (opcode == 0x45u || opcode == 0x4Cu)
+                    return 4u;
+                if (opcode == 0x44u || opcode == 0x4Fu)
+                    return 6u;
+                return 1u;
+            case 0x50u:
+            case 0x60u:
+                return 2u;
+            default:
+                return 0u;
+            }
+        }
+
+        // PS2 SPU ADPCM: 16-byte frames (shift/filter, flags, 14 bytes = 28 samples).
+        struct AdpcmChannel
+        {
+            int32_t s1 = 0;
+            int32_t s2 = 0;
+        };
+
+        void decodeAdpcm(const uint8_t *data, size_t bytes, AdpcmChannel &state, int16_t *out, size_t stride)
+        {
+            static constexpr int32_t kCoef[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+            for (size_t frame = 0; frame + 16u <= bytes; frame += 16u)
+            {
+                const uint8_t head = data[frame];
+                const int shift = head & 0x0F;
+                const int filter = std::min(head >> 4, 4);
+                for (size_t i = 2; i < 16u; ++i)
+                {
+                    const uint8_t byte = data[frame + i];
+                    for (int nibbleIndex = 0; nibbleIndex < 2; ++nibbleIndex)
+                    {
+                        int32_t nibble = nibbleIndex == 0 ? (byte & 0x0F) : (byte >> 4);
+                        if (nibble >= 8)
+                            nibble -= 16;
+                        int32_t value = shift <= 12 ? ((nibble << 12) >> shift) : 0;
+                        value += (state.s1 * kCoef[filter][0] + state.s2 * kCoef[filter][1]) >> 6;
+                        value = std::clamp(value, -32768, 32767);
+                        state.s2 = state.s1;
+                        state.s1 = value;
+                        *out = static_cast<int16_t>(value);
+                        out += stride;
+                    }
+                }
+            }
+        }
+
+        uint32_t alignUp(uint32_t value, uint32_t alignment)
+        {
+            return (value + alignment - 1u) & ~(alignment - 1u);
+        }
+
+        class TsnddrvmXagService final : public IopService
+        {
+        public:
+            TsnddrvmXagService(IopHost &host, TsnddrvmBindings bindings)
+                : m_host(host), m_bindings(std::move(bindings))
+            {
+                resetLocked();
+            }
+
+            ~TsnddrvmXagService() override
+            {
+                for (uint32_t core = 0; core < 2u; ++core)
+                    stopAudio(core);
+            }
+
+            [[nodiscard]] std::string_view name() const override
+            {
+                return m_bindings.serviceName;
+            }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override
+            {
+                return m_sids;
+            }
+
+            void reset() override
+            {
+                for (uint32_t core = 0; core < 2u; ++core)
+                    stopAudio(core);
+                std::lock_guard<std::mutex> lock(m_mutex);
+                resetLocked();
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result{};
+                if (request.sid == kCommandSid)
+                {
+                    if (request.function == kCommandFunction)
+                    {
+                        std::array<uint8_t, kMaxCommandBytes> bytes{};
+                        const uint32_t size = std::min<uint32_t>(request.send.size, kMaxCommandBytes);
+                        if (size != 0u && m_host.readGuest(request.send.address, bytes.data(), size))
+                        {
+                            std::array<AudioClip, 2> starts{};
+                            std::array<bool, 2> stops{};
+                            {
+                                std::lock_guard<std::mutex> lock(m_mutex);
+                                advanceLocked();
+                                applyCommandStreamLocked(std::span<const uint8_t>(bytes.data(), size));
+                                takeAudioRequestsLocked(starts, stops);
+                            }
+                            for (uint32_t core = 0; core < 2u; ++core)
+                            {
+                                if (stops[core] || starts[core].valid)
+                                    stopAudio(core);
+                                if (starts[core].valid)
+                                    startAudio(core, starts[core]);
+                            }
+                        }
+                    }
+                    // TsndFunc returns a pointer to its own status word; the EE passes no receive buffer.
+                    result.handled = true;
+                    return result;
+                }
+
+                if (request.sid == kStateSid)
+                {
+                    const uint32_t fno = request.function & 0xFFu;
+                    if (fno != kChkStandby && fno != kChkPlay && fno >= 1u && fno <= kStateFunctionCount)
+                    {
+                        // Not reconstructed yet: keep the runtime fallback (and its trace) for these.
+                        return result;
+                    }
+                    uint32_t argument = 0u;
+                    if (request.send.address != 0u && request.send.size >= sizeof(argument))
+                    {
+                        (void)m_host.readGuest(request.send.address, &argument, sizeof(argument));
+                    }
+                    std::array<uint32_t, 4> answer{};
+                    {
+                        std::lock_guard<std::mutex> lock(m_mutex);
+                        advanceLocked();
+                        int32_t value = kBadFunctionResult;
+                        if (fno == kChkStandby)
+                            value = chkStandbyLocked(argument);
+                        else if (fno == kChkPlay)
+                            value = chkPlayLocked(argument);
+                        m_result[0] = static_cast<uint32_t>(value);
+                        answer = m_result;
+                        traceQueryLocked(fno, argument, value);
+                    }
+                    if (request.receive.address != 0u && request.receive.size != 0u)
+                    {
+                        const uint32_t bytes = std::min<uint32_t>(request.receive.size, sizeof(answer));
+                        (void)m_host.writeGuest(request.receive.address, answer.data(), bytes);
+                        if (request.receive.size > bytes)
+                            (void)m_host.zeroGuest(request.receive.address + bytes, request.receive.size - bytes);
+                        result.resultAddress = request.receive.address;
+                    }
+                    // Completion: the EE's end callback (cb_sifRpc -> iSignalSema) is run by the runtime
+                    // default path; signalling here as well would double-signal SdrGetState's semaphore.
+                    result.handled = true;
+                    return result;
+                }
+                return result;
+            }
+
+            void serializeCheckpointState(std::vector<uint8_t> &out) const override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                appendU8(out, 2u); // payload version
+                appendU8(out, m_currentCore);
+                appendU8(out, m_initialized ? 1u : 0u);
+                for (int core = 0; core < 2; ++core)
+                {
+                    appendU8(out, m_maxChannels[core]);
+                    appendU32(out, m_bufferBytes[core]);
+                }
+                for (const XagChannel &channel : m_channels)
+                {
+                    appendU8(out, channel.state);
+                    appendU8(out, channel.entry);
+                    appendU16(out, channel.volume);
+                    appendU16(out, channel.skipStart);
+                    appendU16(out, channel.skipCount);
+                    appendU16(out, static_cast<uint16_t>(channel.loopCount));
+                    appendU8(out, channel.standbyCount);
+                    appendU8(out, channel.hasSemaphores);
+                    appendU64(out, channel.clipSamples);
+                    appendU64(out, channel.playStartTick);
+                    appendU64(out, channel.playEndTick);
+                }
+                for (uint32_t word : m_result)
+                    appendU32(out, word);
+            }
+
+            bool deserializeCheckpointState(const uint8_t *data, size_t size, size_t &consumed,
+                                            std::string &error) override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                size_t pos = 0;
+                uint8_t version = 0, core = 0, initialized = 0;
+                std::array<uint8_t, 2> maxChannels{};
+                std::array<uint32_t, 2> bufferBytes{};
+                std::array<XagChannel, 2> channels{};
+                std::array<uint32_t, 4> words{};
+                bool ok = readU8(data, size, pos, version) && version == 2u && readU8(data, size, pos, core) &&
+                          readU8(data, size, pos, initialized);
+                for (int c = 0; c < 2; ++c)
+                    ok = ok && readU8(data, size, pos, maxChannels[c]) && readU32(data, size, pos, bufferBytes[c]);
+                for (XagChannel &channel : channels)
+                {
+                    uint16_t loop = 0;
+                    ok = ok && readU8(data, size, pos, channel.state) && readU8(data, size, pos, channel.entry) &&
+                         readU16(data, size, pos, channel.volume) && readU16(data, size, pos, channel.skipStart) &&
+                         readU16(data, size, pos, channel.skipCount) && readU16(data, size, pos, loop) &&
+                         readU8(data, size, pos, channel.standbyCount) &&
+                         readU8(data, size, pos, channel.hasSemaphores) &&
+                         readU64(data, size, pos, channel.clipSamples) &&
+                         readU64(data, size, pos, channel.playStartTick) &&
+                         readU64(data, size, pos, channel.playEndTick);
+                    channel.loopCount = static_cast<int16_t>(loop);
+                }
+                for (uint32_t &word : words)
+                    ok = ok && readU32(data, size, pos, word);
+                consumed = pos;
+                if (!ok)
+                {
+                    error = "TSNDDRVM: truncated or unknown payload";
+                    return false;
+                }
+                m_currentCore = core & 1u;
+                m_initialized = initialized != 0u;
+                m_maxChannels = maxChannels;
+                m_bufferBytes = bufferBytes;
+                m_channels = channels;
+                m_result = words;
+                return true;
+            }
+
+        private:
+            struct AudioClip
+            {
+                bool valid = false;
+                uint32_t lba = 0u;
+                uint64_t offset = 0u;
+                uint64_t bytes = 0u;
+                uint32_t blockBytes = 0u;
+                uint32_t channels = 0u;
+                uint32_t sampleRate = 0u;
+            };
+
+            struct AudioWorker
+            {
+                std::thread thread;
+                std::atomic<bool> cancel{false};
+            };
+
+            void takeAudioRequestsLocked(std::array<AudioClip, 2> &starts, std::array<bool, 2> &stops)
+            {
+                for (uint32_t core = 0; core < 2u; ++core)
+                {
+                    stops[core] = m_pendingAudioStop[core];
+                    m_pendingAudioStop[core] = false;
+                    if (!m_pendingAudioStart[core])
+                        continue;
+                    m_pendingAudioStart[core] = false;
+                    const XagChannel &channel = m_channels[core];
+                    const std::array<uint32_t, 9> *entry = entryLocked(channel.entry);
+                    TsnddrvmFile file{};
+                    if (!entry || (*entry)[0] == 0xFFFFFFFFu || !fileLocked((*entry)[0], file))
+                        continue; // IOP-memory streams are not rendered
+                    AudioClip &clip = starts[core];
+                    clip.valid = true;
+                    clip.lba = file.lba;
+                    clip.offset = channel.clipOffset;
+                    clip.bytes = channel.clipBytes;
+                    clip.blockBytes = (*entry)[4];
+                    clip.channels = ((*entry)[3] >> 8) & 0xFFu;
+                    const uint32_t pitch = ((*entry)[2] >> 16) & 0xFFFFu;
+                    clip.sampleRate = (48000u * pitch + 2048u) / 4096u;
+                }
+            }
+
+            void stopAudio(uint32_t core)
+            {
+                AudioWorker &worker = m_audio[core];
+                if (worker.thread.joinable())
+                {
+                    worker.cancel = true;
+                    worker.thread.join();
+                }
+                worker.cancel = false;
+                m_host.stopPcmStream(core);
+            }
+
+            void startAudio(uint32_t core, AudioClip clip)
+            {
+                const char *flag = std::getenv("DMC_TSND_AUDIO");
+                if (flag && *flag == '0')
+                    return;
+                if (clip.channels == 0u || clip.channels > 2u || clip.blockBytes == 0u || (clip.blockBytes % 16u) != 0u)
+                    return;
+                const std::string imagePath = m_host.hostPath(HostPathKind::CdImage);
+                const uint64_t handle = imagePath.empty() ? 0u : m_host.openHostFile(imagePath);
+                if (handle == 0u)
+                {
+                    logAudio(LogLevel::Warning, "XAG audio core=%u: CD image unavailable, stream not rendered", core);
+                    return;
+                }
+                AudioWorker &worker = m_audio[core];
+                worker.cancel = false;
+                worker.thread = std::thread([this, core, clip, handle, &worker]() {
+                    const uint64_t chunkBytes = static_cast<uint64_t>(clip.blockBytes) * clip.channels;
+                    const size_t framesPerChunk = clip.blockBytes / 16u * 28u;
+                    std::vector<uint8_t> chunk(static_cast<size_t>(chunkBytes));
+                    std::vector<int16_t> pcm(framesPerChunk * clip.channels);
+                    std::array<AdpcmChannel, 2> state{};
+                    const uint64_t base = static_cast<uint64_t>(clip.lba) * 2048u + clip.offset;
+                    uint64_t done = 0u;
+                    uint64_t frames = 0u;
+                    bool output = true;
+                    while (done < clip.bytes && !worker.cancel && output)
+                    {
+                        size_t got = 0;
+                        if (!m_host.readHostFile(handle, base + done, chunk.data(), chunk.size(), got) || got == 0u)
+                            break;
+                        const size_t blocks = got / clip.blockBytes;
+                        for (uint32_t ch = 0; ch < clip.channels && ch < blocks; ++ch)
+                            decodeAdpcm(chunk.data() + ch * clip.blockBytes, clip.blockBytes, state[ch],
+                                        pcm.data() + ch, clip.channels);
+                        output = m_host.streamPcm(core, clip.sampleRate, clip.channels, pcm.data(), framesPerChunk);
+                        frames += framesPerChunk;
+                        done += chunkBytes;
+                    }
+                    m_host.closeHostFile(handle);
+                    logAudio(LogLevel::Info, "XAG audio core=%u: queued %llu frames at %u Hz (%s)", core,
+                             static_cast<unsigned long long>(frames), clip.sampleRate,
+                             !output ? "host has no audio output" : (worker.cancel ? "cancelled" : "complete"));
+                });
+            }
+
+            template <typename... Args>
+            void logAudio(LogLevel level, const char *format, Args... args)
+            {
+                char text[256];
+                std::snprintf(text, sizeof(text), format, args...);
+                m_host.log(level, std::string("[TSNDDRVM] ") + text);
+            }
+
+            void resetLocked()
+            {
+                m_channels = {};
+                m_currentCore = m_bindings.initialCore & 1u;
+                m_initialized = false;
+                m_maxChannels = {};
+                m_bufferBytes = {};
+                m_result = {};
+                m_lastQuery = {};
+                m_loggedOpcodes = {};
+            }
+
+            uint32_t selectChannelLocked(uint32_t argument) const
+            {
+                // XagChkStandby/XagChkPlay: a channel >= 2 means "the current core".
+                return argument < 2u ? argument : (m_currentCore & 1u);
+            }
+
+            // Ends clips whose duration has elapsed (XagControl -> XagControlExit -> state 0).
+            void advanceLocked()
+            {
+                const uint64_t now = m_host.vsyncTick();
+                for (int core = 0; core < 2; ++core)
+                {
+                    XagChannel &channel = m_channels[core];
+                    if (channel.state == kStatePlaying && channel.playEndTick != 0u && now >= channel.playEndTick)
+                    {
+                        channel.state = kStateIdle;
+                        channel.hasSemaphores = 0u;
+                        channel.standbyCount = 0u;
+                        logLocked(LogLevel::Info, "XAG core=%d clip finished at tick %llu (started %llu) -> state 0",
+                                  core, static_cast<unsigned long long>(now),
+                                  static_cast<unsigned long long>(channel.playStartTick));
+                    }
+                }
+            }
+
+            int32_t chkPlayLocked(uint32_t argument) const
+            {
+                switch (m_channels[selectChannelLocked(argument)].state)
+                {
+                case 0u:
+                    return -1;
+                case 3u:
+                    return 1;
+                case 4u:
+                    return 2;
+                case 5u:
+                    return 3;
+                default:
+                    return 0;
+                }
+            }
+
+            int32_t chkStandbyLocked(uint32_t argument) const
+            {
+                const XagChannel &channel = m_channels[selectChannelLocked(argument)];
+                if (!channel.hasSemaphores)
+                    return -1;
+                return channel.standbyCount;
+            }
+
+            const std::array<uint32_t, 9> *entryLocked(uint8_t index) const
+            {
+                return index < m_bindings.xagEntries.size() ? &m_bindings.xagEntries[index] : nullptr;
+            }
+
+            bool fileLocked(uint32_t index, TsnddrvmFile &file) const
+            {
+                for (const TsnddrvmFile &candidate : m_bindings.files)
+                {
+                    if (candidate.index == index)
+                    {
+                        file = candidate;
+                        return true;
+                    }
+                }
+                return false;
+            }
+
+            // XagControl@0x8D64 up to the start of XagCdRead/XagTrans. Returns false where the IRX takes
+            // XagControlExitFin (state 0, no semaphores).
+            bool prepareStreamLocked(int core, XagChannel &channel, const char *&reason)
+            {
+                const std::array<uint32_t, 9> *entry = entryLocked(channel.entry);
+                if (!entry)
+                {
+                    reason = "entry outside the XAG table";
+                    return false;
+                }
+                const uint32_t fileIndex = (*entry)[0];
+                const uint8_t spuSlot = static_cast<uint8_t>((*entry)[3] & 0xFFu);
+                const uint8_t entryChannels = static_cast<uint8_t>(((*entry)[3] >> 8) & 0xFFu);
+                const uint32_t blockBytes = (*entry)[4];
+                const uint32_t channels = std::min<uint32_t>(entryChannels, m_maxChannels[core]);
+                if ((blockBytes & 0xFu) != 0u || blockBytes > kMaxBlockBytes)
+                {
+                    reason = "block size";
+                    return false;
+                }
+                const uint32_t chunkBytes = blockBytes * channels;
+                if (chunkBytes == 0u)
+                {
+                    reason = "no channels (TsndInitXag not received for this core)";
+                    return false;
+                }
+                uint32_t streamBytes = 0u;
+                TsnddrvmFile file{};
+                if (fileIndex == 0xFFFFFFFFu)
+                {
+                    streamBytes = (*entry)[7];
+                }
+                else if (fileLocked(fileIndex, file))
+                {
+                    streamBytes = file.size;
+                }
+                else
+                {
+                    reason = "file index not in the bindings";
+                    return false;
+                }
+                if (streamBytes < chunkBytes * 2u)
+                {
+                    reason = "stream shorter than two chunks";
+                    return false;
+                }
+                if (m_bufferBytes[core] < streamBytes)
+                    streamBytes = m_bufferBytes[core];
+                const uint32_t alignedChunk = alignUp(chunkBytes, 0x40u);
+                if (streamBytes / alignedChunk < 2u)
+                {
+                    reason = "fewer than two ring slots";
+                    return false;
+                }
+                if (spuSlot != 0xFFu)
+                {
+                    if (spuSlot >= m_bindings.spuSlotAddresses.size() ||
+                        m_bindings.spuSlotAddresses[spuSlot] + alignedChunk * 2u > kSpuLimit)
+                    {
+                        reason = "SPU slot range";
+                        return false;
+                    }
+                }
+
+                // XagCdRead@0x821C: clip = [skipStart, skipStart + skipCount) chunks of entryChannels * blockBytes,
+                // or from skipStart to the end of the file when skipCount is 0.
+                const uint64_t readChunk = static_cast<uint64_t>(blockBytes) * entryChannels;
+                const uint64_t fileBytes = fileIndex == 0xFFFFFFFFu ? (*entry)[7] : file.size;
+                const uint64_t start = readChunk * channel.skipStart;
+                uint64_t clipBytes = channel.skipCount != 0u ? readChunk * channel.skipCount
+                                                              : (fileBytes > start ? fileBytes - start : 0u);
+                if (start + clipBytes > fileBytes)
+                    clipBytes = fileBytes > start ? fileBytes - start : 0u;
+                if (clipBytes == 0u)
+                {
+                    reason = "empty clip";
+                    return false;
+                }
+                const uint64_t chunks = (clipBytes + readChunk - 1u) / readChunk;
+                channel.clipSamples = chunks * (blockBytes / 16u) * 28u;
+                channel.clipOffset = start;
+                channel.clipBytes = clipBytes;
+                channel.hasSemaphores = 1u;
+                // Two chunks buffered (0x853C) or the whole (shorter) clip read (0x877C) -> SignalSema(standby).
+                channel.standbyCount = 1u;
+                logLocked(LogLevel::Info,
+                          "XAG core=%d entry=%u file=0x%X lba=0x%X clip chunks=[%u,+%llu) bytes=0x%llX channels=%u "
+                          "samples/ch=%llu -> standby",
+                          core, channel.entry, fileIndex, file.lba, channel.skipStart,
+                          static_cast<unsigned long long>(chunks), static_cast<unsigned long long>(clipBytes),
+                          channels, static_cast<unsigned long long>(channel.clipSamples));
+                return true;
+            }
+
+            uint64_t clipTicksLocked(const XagChannel &channel) const
+            {
+                const std::array<uint32_t, 9> *entry = entryLocked(channel.entry);
+                const uint32_t pitch = entry ? (((*entry)[2] >> 16) & 0xFFFFu) : 0u;
+                if (pitch == 0u || m_bindings.vsyncPerSecond == 0u)
+                    return 0u;
+                // samples / (48000 * pitch / 4096) seconds, in VSync ticks, rounded up.
+                const uint64_t numerator = channel.clipSamples * 4096u * m_bindings.vsyncPerSecond;
+                const uint64_t denominator = 48000u * static_cast<uint64_t>(pitch);
+                return (numerator + denominator - 1u) / denominator;
+            }
+
+            void applyCommandStreamLocked(std::span<const uint8_t> bytes)
+            {
+                size_t pos = 0;
+                while (pos < bytes.size() && bytes[pos] != 0xFFu)
+                {
+                    const uint8_t opcode = bytes[pos];
+                    const uint32_t length = commandLength(opcode);
+                    if (length == 0u || pos + length > bytes.size())
+                    {
+                        logLocked(LogLevel::Warning, "unparsed command byte 0x%02X at offset %zu; rest of stream skipped",
+                                  opcode, pos);
+                        return;
+                    }
+                    applyCommandLocked(bytes.subspan(pos, length));
+                    pos += length;
+                }
+            }
+
+            void applyCommandLocked(std::span<const uint8_t> command)
+            {
+                const uint8_t opcode = command[0];
+                const int core = m_currentCore & 1;
+                XagChannel &channel = m_channels[core];
+                const uint8_t before = channel.state;
+                switch (opcode)
+                {
+                case 0x77u: // TsndInitXag(size << 6, maxCh core0, maxCh core1, -1)
+                {
+                    const uint32_t bytes = ((static_cast<uint32_t>(command[1]) << 8) | command[2]) << 6;
+                    m_initialized = true;
+                    m_pendingAudioStop = {true, true};
+                    m_pendingAudioStart = {false, false};
+                    m_maxChannels = {command[3], command[4]};
+                    m_bufferBytes = {0u, bytes}; // XagAllocBuff -> xag_setbuf(1, size, base, size)
+                    m_currentCore = 1u;
+                    for (XagChannel &each : m_channels)
+                    {
+                        each.state = kStateIdle;
+                        each.hasSemaphores = 0u;
+                        each.standbyCount = 0u;
+                        each.loopCount = 0;
+                    }
+                    logLocked(LogLevel::Info, "TsndInitXag buffer=0x%X maxCh=%u/%u", bytes, command[3], command[4]);
+                    return;
+                }
+                case 0x74u: // XagSetBuff(core, size << 6): refused while semaphores exist (0x7428)
+                {
+                    const unsigned target = command[1] & 1u;
+                    const uint32_t bytes = ((static_cast<uint32_t>(command[2]) << 8) | command[3]) << 6;
+                    if (m_channels[0].hasSemaphores || m_channels[1].hasSemaphores)
+                    {
+                        logLocked(LogLevel::Info, "XagSetBuff core=%u size=0x%X refused (stream active)", target, bytes);
+                        return;
+                    }
+                    const uint32_t total = m_bufferBytes[0] + m_bufferBytes[1];
+                    const uint32_t mine = std::min(bytes, total);
+                    m_bufferBytes[target] = mine;
+                    m_bufferBytes[target ^ 1u] = total - mine;
+                    logLocked(LogLevel::Info, "XagSetBuff core=%u size=0x%X -> buffers 0x%X/0x%X", target, bytes,
+                              m_bufferBytes[0], m_bufferBytes[1]);
+                    return;
+                }
+                case 0x73u: // XagSetCore
+                    m_currentCore = command[1] & 1u;
+                    logLocked(LogLevel::Info, "XagSetCore core=%u", m_currentCore);
+                    return;
+                case 0x71u: // XagSetSkip(loop count, signed byte)
+                    channel.loopCount = static_cast<int8_t>(command[1]);
+                    logLocked(LogLevel::Info, "XagSetSkip core=%d loop=%d", core, channel.loopCount);
+                    return;
+                case 0x78u: // XagSetSkip2(start): +0xA4 = start, +0xA6 = 0
+                    channel.skipStart = static_cast<uint16_t>((command[1] << 8) | command[2]);
+                    channel.skipCount = 0u;
+                    logLocked(LogLevel::Info, "XagSetSkip2 core=%d start=%u", core, channel.skipStart);
+                    return;
+                case 0x79u: // XagSetSkip3(start, count)
+                    channel.skipStart = static_cast<uint16_t>((command[1] << 8) | command[2]);
+                    channel.skipCount = static_cast<uint16_t>((command[3] << 8) | command[4]);
+                    logLocked(LogLevel::Info, "XagSetSkip3 core=%d start=%u count=%u", core, channel.skipStart,
+                              channel.skipCount);
+                    return;
+                case 0x31u: // XagStandby(entry)
+                case 0x3Du: // XagStandby2(entry, volume)
+                {
+                    const uint8_t entry = command[1];
+                    if (entry >= m_bindings.xagEntries.size())
+                    {
+                        logLocked(LogLevel::Info, "XAG standby entry=%u rejected by xag_standby_chk", entry);
+                        return;
+                    }
+                    if (channel.state != kStateIdle)
+                    {
+                        logLocked(LogLevel::Info, "XAG standby core=%d entry=%u ignored (state %u)", core, entry, before);
+                        return;
+                    }
+                    channel.entry = entry;
+                    if (opcode == 0x3Du)
+                    {
+                        const uint16_t raw = command[2] == 0x7Fu ? 0x80u : command[2];
+                        channel.volume = static_cast<uint16_t>((raw << 7) & 0xFF80u);
+                    }
+                    else
+                    {
+                        channel.loopCount = 0; // XagDefault -> xag_default clears +0x94
+                    }
+                    channel.standbyCount = 0u;
+                    channel.hasSemaphores = 0u;
+                    channel.state = kStatePreparing;
+                    const char *reason = "";
+                    if (!prepareStreamLocked(core, channel, reason))
+                    {
+                        channel.state = kStateIdle;
+                        logLocked(LogLevel::Info, "XAG core=%d entry=%u XagControlExitFin: %s -> state 0", core, entry,
+                                  reason);
+                    }
+                    return;
+                }
+                case 0x32u: // XagStart
+                    if (channel.state == kStatePreparing || channel.state == 4u)
+                    {
+                        channel.state = kStateStartRequested;
+                        if (channel.hasSemaphores && channel.standbyCount != 0u)
+                        {
+                            // XagControl wakes, WaitSema(standby) succeeds, state 3 (0x91C4).
+                            channel.standbyCount = 0u;
+                            channel.state = kStatePlaying;
+                            channel.playStartTick = m_host.vsyncTick();
+                            const uint64_t ticks = clipTicksLocked(channel);
+                            channel.playEndTick = ticks != 0u ? channel.playStartTick + ticks : 0u;
+                            if (channel.loopCount != 0)
+                                channel.playEndTick = 0u; // looping not modelled: keep playing
+                            m_pendingAudioStart[core] = true;
+                        }
+                    }
+                    logLocked(LogLevel::Info, "XagStart core=%d state %u->%u start=%llu end=%llu", core, before,
+                              channel.state, static_cast<unsigned long long>(channel.playStartTick),
+                              static_cast<unsigned long long>(channel.playEndTick));
+                    return;
+                case 0x33u: // XagStop -> xag_stop: clear_sema + ReleaseWaitThread -> XagControlExit -> state 0
+                    m_pendingAudioStop[core] = true;
+                    channel.state = kStateIdle;
+                    channel.hasSemaphores = 0u;
+                    channel.standbyCount = 0u;
+                    logLocked(LogLevel::Info, "XagStop core=%d state %u->0", core, before);
+                    return;
+                default:
+                    if ((opcode & 0xF0u) == 0x30u || (opcode & 0xF0u) == 0x70u)
+                        logOnceLocked(command, "XAG command not modelled yet");
+                    else
+                        logOnceLocked(command, "non-XAG command not modelled yet (phase 3)");
+                    return;
+                }
+            }
+
+            void traceQueryLocked(uint32_t fno, uint32_t argument, int32_t value)
+            {
+                const std::array<uint32_t, 3> key{fno, argument, static_cast<uint32_t>(value)};
+                auto &last = m_lastQuery[fno == kChkPlay ? 1 : 0][argument < 2u ? argument : 2u];
+                if (key == last)
+                    return;
+                last = key;
+                logLocked(LogLevel::Info, "%s(ch=%u) -> %d (states %u/%u, tick %llu)",
+                          fno == kChkPlay ? "XagChkPlay" : (fno == kChkStandby ? "XagChkStandby" : "fno?"), argument,
+                          value, m_channels[0].state, m_channels[1].state,
+                          static_cast<unsigned long long>(m_host.vsyncTick()));
+            }
+
+            void logOnceLocked(std::span<const uint8_t> command, const char *what)
+            {
+                const uint8_t opcode = command[0];
+                if (m_loggedOpcodes[opcode])
+                    return;
+                m_loggedOpcodes[opcode] = true;
+                std::string hex;
+                for (uint8_t byte : command)
+                {
+                    char part[4];
+                    std::snprintf(part, sizeof(part), " %02X", byte);
+                    hex += part;
+                }
+                logLocked(LogLevel::Info, "opcode 0x%02X: %s (bytes%s)", opcode, what, hex.c_str());
+            }
+
+            template <typename... Args>
+            void logLocked(LogLevel level, const char *format, Args... args)
+            {
+                char text[320];
+                std::snprintf(text, sizeof(text), format, args...);
+                m_host.log(level, std::string("[TSNDDRVM] ") + text);
+            }
+
+            IopHost &m_host;
+            TsnddrvmBindings m_bindings;
+            mutable std::mutex m_mutex;
+            std::array<XagChannel, 2> m_channels{};
+            uint8_t m_currentCore = 1u;
+            bool m_initialized = false;
+            std::array<uint8_t, 2> m_maxChannels{};
+            std::array<uint32_t, 2> m_bufferBytes{};
+            std::array<uint32_t, 4> m_result{};
+            std::array<std::array<std::array<uint32_t, 3>, 3>, 2> m_lastQuery{};
+            std::array<bool, 256> m_loggedOpcodes{};
+            std::array<bool, 2> m_pendingAudioStart{};
+            std::array<bool, 2> m_pendingAudioStop{};
+            std::array<AudioWorker, 2> m_audio{};
+            const std::array<uint32_t, 2> m_sids = {kCommandSid, kStateSid};
+        };
+    }
+
+    std::unique_ptr<IopService> createTsnddrvmXagService(IopHost &host, TsnddrvmBindings bindings)
+    {
+        return std::make_unique<TsnddrvmXagService>(host, std::move(bindings));
+    }
+}
