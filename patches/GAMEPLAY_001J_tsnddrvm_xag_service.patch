+
+// ---------------------------------------------------------------------------
+// Host PCM streams for IOP services (GAMEPLAY_001J: TSNDDRVM XAG voice/music streams).
+// raylib's AudioCallback carries no user pointer, so each stream id owns one static slot and one callback.
+// The callback runs on the audio thread and pulls interleaved s16 frames; underflow is filled with silence.
+namespace
+{
+    constexpr uint32_t kPcmStreamSlots = 2u;
+
+    struct PcmStreamSlot
+    {
+        std::mutex mutex;
+        std::deque<int16_t> samples;
+        AudioStream stream{};
+        bool open = false;
+        uint32_t sampleRate = 0u;
+        uint32_t channels = 0u;
+    };
+
+    std::array<PcmStreamSlot, kPcmStreamSlots> g_pcmStreams;
+
+    template <uint32_t Slot>
+    void pcmStreamCallback(void *buffer, unsigned int frames)
+    {
+        PcmStreamSlot &slot = g_pcmStreams[Slot];
+        auto *out = static_cast<int16_t *>(buffer);
+        std::lock_guard<std::mutex> lock(slot.mutex);
+        const size_t wanted = static_cast<size_t>(frames) * slot.channels;
+        const size_t available = std::min(wanted, slot.samples.size());
+        for (size_t i = 0; i < available; ++i)
+        {
+            out[i] = slot.samples.front();
+            slot.samples.pop_front();
+        }
+        std::fill(out + available, out + wanted, int16_t{0});
+    }
+
+    constexpr AudioCallback kPcmCallbacks[kPcmStreamSlots] = {pcmStreamCallback<0>, pcmStreamCallback<1>};
+}
+
+bool PS2IopHostAdapter::streamPcm(uint32_t streamId, uint32_t sampleRate, uint32_t channels, const int16_t *frames,
+                                  size_t frameCount)
+{
+    if (streamId >= kPcmStreamSlots || channels == 0u || channels > 2u || sampleRate == 0u || !IsAudioDeviceReady())
+        return false;
+    PcmStreamSlot &slot = g_pcmStreams[streamId];
+    bool reopen = false;
+    {
+        std::lock_guard<std::mutex> lock(slot.mutex);
+        reopen = !slot.open || slot.sampleRate != sampleRate || slot.channels != channels;
+    }
+    if (reopen)
+    {
+        if (slot.open)
+        {
+            StopAudioStream(slot.stream);
+            UnloadAudioStream(slot.stream);
+        }
+        {
+            std::lock_guard<std::mutex> lock(slot.mutex);
+            slot.samples.clear();
+            slot.sampleRate = sampleRate;
+            slot.channels = channels;
+        }
+        slot.stream = LoadAudioStream(sampleRate, 16, channels);
+        SetAudioStreamCallback(slot.stream, kPcmCallbacks[streamId]);
+        PlayAudioStream(slot.stream);
+        slot.open = true;
+    }
+    std::lock_guard<std::mutex> lock(slot.mutex);
+    slot.samples.insert(slot.samples.end(), frames, frames + frameCount * channels);
+    return true;
+}
+
+void PS2IopHostAdapter::stopPcmStream(uint32_t streamId)
+{
+    if (streamId >= kPcmStreamSlots)
+        return;
+    PcmStreamSlot &slot = g_pcmStreams[streamId];
+    std::lock_guard<std::mutex> lock(slot.mutex);
+    slot.samples.clear();
+}
